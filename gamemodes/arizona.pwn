	return SCMF(playerid, COLOR_GREY, "Jus esate nutildyti. Liko %d sekundziu nutildymo laiko.", PI[playerid][pMuteTime]);

stock CancelCuff(playerid)
{
    if(PlayerOfCuff[playerid] != INVALID_PLAYER_ID)
	{
		new targetid = PlayerOfCuff[playerid];
	    PlayerOfCuff[playerid] = INVALID_PLAYER_ID;
	    if(PlayerOfCuff[targetid] == playerid)
		{
	    	TimeOfCuff[targetid] = 0;
	    	PlayerOfCuff[targetid] = INVALID_PLAYER_ID;
		}
		ClearAnimationsEx(playerid);
	}
	return 1;
}
stock GetJobPN(jobid)
{
	static jobname[50];
	switch(jobid)
	{
	    case 1: jobname = "Autobuso vairuotojas";
	    case 2: jobname = "Detektyvas";
	    case 3: jobname = "Prekiu pristatytojas";
	    case 4: jobname = "Mechanikas";
	    case 5: jobname = "Taksistas";
	    case 6: jobname = "Advokatas";
	    case 7: jobname = "Ukininkas";
	    case 8: jobname = "Krupje";
	    case 9: jobname = "Inkasatorius";
	    case 10: jobname = "Narkodiller";
	    case 11: jobname = "Sunkvezimio vairuotojas";
	    case 12: jobname = "Picos pristatytojas";
	    case 13: jobname = "Metalo vezejas";
	    case 14: jobname = "Siuksliavezis";
	    case 15: jobname = "Krovejas";
	    case 16: jobname = "Mokesciu inspektorius";
	    case 17: jobname = "Pradedantis ukininkas";
	    case 18: jobname = "Traktoriaus vairuotojas";
	    case 19: jobname = "Kombainininkas";
	    case 20: jobname = "Purskiancio laukus pilotas";
	    case 21: jobname = "Statybininkas";
		case 22: jobname = "Elektrinio trauikinio masinistas";
	    default: jobname = "None";

	}
	return jobname;
}
