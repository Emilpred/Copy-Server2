        {
            if(!response) // Menu Anti-Cheat
            {
                pAntiCheatSettingsPage{playerid} = 0; // Menu Anti-Cheat
                return 1; // Menu Anti-Cheat
            }

            if(!strcmp(inputtextsave, AC_DIALOG_NEXT_PAGE_TEXT)) // Menu Anti-Cheat
            {
                pAntiCheatSettingsPage{playerid} ++; // Menu Anti-Cheat
            }
            else if(!strcmp(inputtextsave, AC_DIALOG_PREVIOUS_PAGE_TEXT)) // Menu Anti-Cheat
            {
                pAntiCheatSettingsPage{playerid} --; // Menu Anti-Cheat
            }
            else // Menu Anti-Cheat
            {
                pAntiCheatSettingsEditCodeId[playerid] = pAntiCheatSettingsMenuListData[playerid][listitem]; // Menu Anti-Cheat
                return ShowPlayer_AntiCheatEditCode(playerid, pAntiCheatSettingsEditCodeId[playerid]); // Menu Anti-Cheat
            }
            return ShowPlayer_AntiCheatSettings(playerid); // Menu Anti-Cheat
        }
        case DIALOG_ANTICHEAT_EDIT_CODE: // Menu Anti-Cheat
        {
            if(!response) // Menu Anti-Cheat
            {
                pAntiCheatSettingsEditCodeId[playerid] = -1; // Menu Anti-Cheat
                return ShowPlayer_AntiCheatSettings(playerid); // Menu Anti-Cheat
            }

            new
	            item = pAntiCheatSettingsEditCodeId[playerid]; // Menu Anti-Cheat

            if(AC_CODE_TRIGGER_TYPE[item] == listitem) // Anti Cheat
                return ShowPlayer_AntiCheatSettings(playerid); // Menu Anti-Cheat

            if(AC_CODE_TRIGGER_TYPE[item] == AC_CODE_TRIGGER_TYPE_DISABLED && listitem != AC_CODE_TRIGGER_TYPE_DISABLED)
                EnableAntiCheat(item, 1);

            else if(listitem == AC_CODE_TRIGGER_TYPE_DISABLED)
                EnableAntiCheat(item, 0);

            AC_CODE_TRIGGER_TYPE[item] = listitem; // Anti-Cheat

            // Anti cheat
            f(global_str, 100, "UPDATE "AC_TABLE_SETTINGS" SET `"AC_TABLE_FIELD_TRIGGER"` = '%d' WHERE `"AC_TABLE_FIELD_CODE"` = '%d'",
                listitem,
                item);

            mysql_tquery(mysql, global_str); // Siunciame uzklausa i Baze
            return ShowPlayer_AntiCheatSettings(playerid); // Menu Anti-Cheat
        }
