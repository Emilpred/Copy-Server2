stock ShowLicenses(playerid, targetid, dialogid = 0)
{
	global_str = "";

	for new i; i < 9; i++ do
		f(mysql_string, 256, "{FFFFFF}Licencija %s:\t\t%s {AFAFAF}(%s: %s)\n\n", LicensesName[i], GetPlayerLicense(targetid, i) ? "{10F441}Yra" : "{FF6347}Nera", GetPlayerLicense(targetid, i) ? "veikia iki" : "pasibages galiojimo laikas", UNIX_TO_DATE(PI[targetid][LicensesData][i])),
		strcat(global_str, mysql_string);

	return SPD(playerid, dialogid, 0, !"Licencijos", global_str, !"OK", !"");
}

