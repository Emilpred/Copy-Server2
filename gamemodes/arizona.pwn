    	{
			if GetPlayerMobileLauncher(playerid) *then
				ShowButton(playerid, 1);

		    else if IsPlayerCefInit(playerid, 1) *then PlayerNotification(playerid, "info", "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT", 2000);
		    else ShowAttention(playerid, "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT");
    	}
	}

	for new i; i < sizeof BuildInfo; i ++ do
