				InventMenuTD[playerid][8] =  CreatePlayerTextDraw(playerid, X-7.25, Y+14, "LD_SPAC:WHITE");
				InventMenuTD[playerid][9] = CreatePlayerTextDraw(playerid, X-7.25, Y+28.583344, "LD_SPAC:WHITE");
