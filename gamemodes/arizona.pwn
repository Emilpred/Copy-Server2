stock AutoCarSpawn()
{
	foreach(new i: Player)
	{
		if(!PhoneImprovementsData[i][pdSpawnCarMessage])
		{
			SCM(i, COLOR_RED, !"[Serveris]{FFFFFF} Gerbiami zaidejai!");
		    SCM(i, COLOR_RED, !"[Serveris]{FFFFFF} Po 60 sekundziu ivyks transporto respawnas!");
		    SCM(i, COLOR_RED, !"[Serveris]{FFFFFF} Uzimkite automobilius, kad jie neprapultu");
		    GameTextForPlayer(i, !"RESPAWN CARS 60 SEC", 0, 1);
		}
	}
    SetTimer("AutoCarSpawnStart", 60000, false);
    return 1;
}
