				f(global_str, sizeof global_str, "[Game Event] {ffffff}%s ¹%d automatiskai iskrito i valstybe. Kaina, norint isigyti, iveskite /buybiz arba paspauskite N ant zymes.", MPSletId ? "Verslas":"Namas", MPSletId);
				foreach(Player, i) if IsPlayerInRangeOfPoint(i, 10.0, BizData[MPSletId][bEnter_X], BizData[MPSletId][bEnter_Y], BizData[MPSletId][bEnter_Z]) *then
			 		SCM(i,0x40FF00FF, global_str);
			}
			if MPSletTime == -30 *then
			{
			    MPSletOpen = 0;
				MPSletId = -1;
			}
			MPSletTime--;
		}
	}

	if Teleport == 0 *then
