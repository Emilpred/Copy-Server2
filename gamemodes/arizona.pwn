stock CheckNalog(playerid, count, showid = 0)
{
	new ir; global_str = "{FFFFFF}\n";

	switch count do
	{
		case 0:
		{
			for new i = 1; i < OWNABLEBIZES;i ++ do
			{
				if ir < 40 *then
				{
					if BizData[i][bLevel] >= 190000 *then
					    f(global_str,sizeof global_str,"%s%d. Verslas\t\tIskris po: {C9B931}%d{FFFFFF} Payday. Tipas: {C9B931}Paslepta{FFFFFF}\n", global_str, showid ? i:ir+1,floatround(float(216000-BizData[i][bLevel])/3000, floatround_ceil)+1),
//						f(global_str,sizeof global_str,"%s%d. Verslas\t\tIskris po: {C9B931}%d{FFFFFF} Payday. Tipas: {C9B931}Paslepta{FFFFFF}\n", global_str, showid ? i:ir+1,floatround(float(216000-BizData[i][bLevel])/GLS[3], floatround_ceil)+1),
							ir++;

					else if GetString(BizData[i][bOwner], "The State") *then
					{
						if i < 10 *then f(global_str,sizeof global_str,"%s%d. Verslas\t\tID: {C9B931}%d{FFFFFF} [{9ACD32}Iskrito{FFFFFF}] \t\tTipas: {C9B931}%s{FFFFFF}\n", global_str, ir+1, i, BizData[i][bName]);
						else f(global_str,sizeof global_str,"%s%d. Verslas\t\tID: {C9B931}%d{FFFFFF} [{9ACD32}Iskrito{FFFFFF}] \tTipas: {C9B931}%s{FFFFFF}\n", global_str, ir+1, i, BizData[i][bName]);
						ir++;
					}
				}
			}
			if !ir *then
				SPD(playerid, 0, 0, !"", !"Siuo metu prieinamos informacijos nera.", !"Priimti", !"");
			else
			{
				f(global_str,sizeof global_str,"%s\n\nNaudokite {1EA3CC}/findibiz ID{FFFFFF}, noredami rasti jums reikalinga versla. Kaina {1EA3CC}1500$.\
				\n{f57002}ID{FFFFFF} Verslas rodomas tik {f57002}iskritusiuju{FFFFFF} verslu!",global_str);
				SPD(playerid, 0, 0, !"", global_str, !"Priimti", !"");
			}
		}
		case 1:
		{
      		for new i; i < OWNABLEHOUSES; i ++ do
			{
			    if HouseInfo[i][hNoNalogs] == 0 *then
			    {
					if ir < 40 *then
					{
						if !GetString(HouseInfo[i][hOwner], "The State") && HouseInfo[i][hNalog] >= 80000 *then
						{
						    f(global_str, sizeof global_str, "%s%d. Namas\t\tIskris po: {C9B931}%d{FFFFFF} Payday.\n", global_str, ir+1, floatround(float(216000-HouseInfo[i][hNalog])/3000, floatround_ceil)+1);
//							f(global_str, sizeof global_str, "%s%d. Namas\t\tIskris po: {C9B931}%d{FFFFFF} Payday.\n", global_str, ir+1, floatround(float(216000-HouseInfo[i][hNalog])/GLS[2], floatround_ceil)+1);
							ir++;
						}
						else if GetString(HouseInfo[i][hOwner], "The State") *then
						{
							f(global_str, sizeof global_str, "%s%d. Namas\t\tID: {C9B931}%d\t{FFFFFF}[{9ACD32}Iskrito{FFFFFF}]\n", global_str, ir+1, i);
							ir++;
						}
					}
				}
			}
			if strlen(global_str) < 2 *then
				SPD(playerid, 0, 0, !"", !"Siuo metu prieinamos informacijos nera.", !"Priimti", !"");
			else
			{
				f(global_str,sizeof(global_str),"%s\n\nNaudokite {1EA3CC}/findihouse ID{FFFFFF}, noredami rasti jums reikalinga nama. Kaina {1EA3CC}1500$.{FFFFFF}",global_str);
				SPD(playerid, 0, 0, !"{FF6347}Iskrite namai pasirodo tik po PayDay!", global_str, !"Priimti", !"");
			}
		}
	}
	return 0;
}

stock ReRandomRoul(playerid, consT, count)
{
	new s;

	if !consT *then s = 93+random(8);
		else if consT == 1 *then s = 62+random(32);
			else if consT == 2 *then s = random(62);

	if RoulettePrizes[s][Chance] > random(1000) *then
	{
		if RoulettePrizes[s][MaxValue] > 2 *then
			pRouletteCount[playerid][consT][count] = 1+random(RoulettePrizes[s][MaxValue]);
		else
			pRouletteCount[playerid][consT][count] = 1;
		pRoulette[playerid][consT][count] = RoulettePrizes[s][PrizeID];
		return 1;
	}
	return 0;
}
stock SpeedometrSetting(playerid, speed = false)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if IsARC(vehicleid) or IsATrain(vehicleid) *then return false; // Fix Speedometr
	if(CheckSpeed(playerid) or !GetPlayerLauncher(playerid))
	{
		switch speed do
		{
	 		case 0:
	 		{
	 			switch PI[playerid][LauncherData][0] do
	 			{
					case 1: for new i; i < 42; i++ do DestroyPlayerTD(playerid, speedometr[playerid][i]);
				}
			}
			case 1:
			{
				if !IsValidVehicle(vehicleid) *then return 0;

				if IsAPlane(vehicleid) || IsAVelik(vehicleid) *then return 1;

			 	switch PI[playerid][LauncherData][0] do
	 			{

					case 1: {
						CreateSpeed(playerid);
						for new i; i < 42; i++ do ShowPlayerTD(playerid, speedometr[playerid][i]);
					}
				}
			}
		}
	}
	return true;
}

stock GetCarSalon (model)
{
	switch model do
	{
		case 401,404,409,410,413,416,418,419,422,424,428,431,436,438,442,455,457,466,478,479,496,
		504,505,516,517,526,527,528,529,539,540,542,543,546,547,552,555,566,568,573,575,576,609: return 1;
		case 400,402,421,434,447,474,477,482,487,491,492,495,500,507,513,518,533,534,535,545,554,561,562,567,579,580,587,589,600,602,603: return 2;
		case 411,415,420,429,451,461,463,468,471,480,481,490,494,502,503,506,509,510,521,522,541,559,560,581,586,598: return 3;
		case 15416..15436, 15485..15492: return 5;
		default: return 4;
