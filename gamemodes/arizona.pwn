							if id != INVALID_PLAYER_ID *then
							{
								if PI[id][pMoney] >= HouseInfo[i][hAuctionMoney] *then
								{
									DeleteItem(id, 1461, HouseInfo[i][hAuctionMoney]);
									f(global_str, 100, "Sveikiname! Jus laimejote namo {ffff00}¹%d{FFFFFF} aukciona", i);
									SCM(id, -1, global_str);
									///
									id = GetPlayerID(HouseInfo[i][hOwner]);
									if id == INVALID_PLAYER_ID *then
									{
										f(global_str, 256, "UPDATE `accounts` SET `GiveMeBackMyBTC` = '%d' WHERE `NickName` = '%s'", HouseInfo[i][hAuctionMoney], HouseInfo[i][hOwner]);
										mysql_tquery(mysql, global_str);
									}
									else AddItem(id, 1461, HouseInfo[i][hAuctionMoney]);
									///
									SetString(HouseInfo[i][hOwner], HouseInfo[i][hAuctionName]);
								}
       						}
							ResetAuctionHouse(i);
						}
						else UpdateAuctionHouse(i);
					}
				}
			}
		}
