stock UploadAntiCheatSettings()
{
    new
        Cache:cache = mysql_query(mysql, "SELECT * FROM "AC_TABLE_SETTINGS" ORDER BY "AC_TABLE_FIELD_CODE""),
        rows,
        fields;

    cache_get_data(rows, fields);

    if(rows > 0)
    {
        for new i; i < AC_MAX_TRIGGERS; i++ do
    		AC_CODE_TRIGGER_TYPE[i] = cache_get_field_content_int(i, ""AC_TABLE_FIELD_TRIGGER"");

        //printf("  KantiCheat          ->  %d", rows);
    }
    else
    {
        print("[MySQL]: Anti-Cheat nustatymai nerasti duomenu bazeje. Modo ikelimas sustabdytas - sukonfiguruokite Anti-Cheat.");
        return SendRconCommand("exit");
    }

    cache_delete(cache);
    return 1;
}

//new MAX_WARNING_ANTICHEAT[MAX_PLAYERS] = 0;

stock OnCheatDetected(playerid, code)
{
	if(IsPlayerPBot(playerid)) return false;

	AC_CODE_TRIGGERED_COUNT[code] ++;

    switch AC_CODE_TRIGGER_TYPE[code] do
    {
        case AC_CODE_TRIGGER_TYPE_WARNING:
        {
            if(Global_Time - pAntiCheatLastCodeTriggerTime[playerid][code] < AC_TRIGGER_ANTIFLOOD_TIME) return false;
            if(PI[playerid][pLevel] > 4 && PI[playerid][pLevel] < 7)
			{
				f(global_str, 145, "[CHEAT] %s{ff0000}[%d]{D2B88F} /re %d {ff0000}[%d LVL]{D2B88F} itariamas sukciavimui (%s) [Code: %03d].", PN(playerid), playerid, playerid, PI[playerid][pLevel], AC_CODE_NAME[code], code);
				SendAdminsMessage(0xD2B88FFF, global_str);
				return 1;
			}
            if(PI[playerid][pLevel] > 6 && PI[playerid][pLevel] < 11)
			{
				f(global_str, 145, "[CHEAT] %s{ffff00}[%d]{D2B88F} /re %d {ffff00}[%d LVL]{D2B88F} itariamas sukciavimui (%s) [Code: %03d].", PN(playerid), playerid, playerid, PI[playerid][pLevel], AC_CODE_NAME[code], code);
				SendAdminsMessage(0xD2B88FFF, global_str);
				return 1;
			}
            if(PI[playerid][pLevel] > 10)
			{
				f(global_str, 145, "[CHEAT] %s{33aa33}[%d]{D2B88F} /re %d {33aa33}[%d LVL]{D2B88F} itariamas sukciavimui (%s) [Code: %03d].", PN(playerid), playerid, playerid, PI[playerid][pLevel], AC_CODE_NAME[code], code);
				SendAdminsMessage(0xD2B88FFF, global_str);
				return 1;
			}
        }
        case AC_CODE_TRIGGER_TYPE_KICK: ToCheat(code, playerid);
        default: return false;
    }
    return 1;
}

stock ToCheat(type, playerid)
{
	new string[20], days,year,month,hour,minutes;

	getdate(year, month, days);
    gettime(hour,minutes);

	new Float:ssss = NetStats_PacketLossPercent(playerid);

    if(minutes <= 9) f(string, sizeof(string), "%d:0%d %d.%d.%d", hour, minutes, days, month, year);
	else f(string, sizeof(string), "%d:%d %d.%d.%d", hour, minutes, days, month, year);

	f(global_str, 350, "\n\n\
	{FF6347}Buvote ismesti del itarimu, kad naudojate sukciavima\n\
    Noredami isvengti panasiu situaciju ateityje,\n\
	pasalinkite visus CLEO ir kitus zaidimo modifikatorius.\n\n\
	{FFFFFF}Paskyra: %s\n\
	{FFFFFF}Zaidiminis serveris: "Mode_City"\n\
	{FFFFFF}Kodo priezastis: %s (%d / 1)\n\n\
	{FFFFFF}NetStat: %d(%.2f)\n\n\t{FFFFFF}Noredami iseiti is zaidimo, naudokite /q(uit)\n", PN(playerid), AC_CODE_NAME[type], type, NetStats_BytesReceived(playerid), ssss);
	SPD(playerid, 0, 0, string, global_str , !"x", !"");

	/*f(global_str, 250, "[ArizonaAudio_RenamePlayer(Audio_RenamePlayer())-CHEAT] %s[%d] [%d LVL] buvo kickintas uz cheat naudojimus: %s [Code: %03d].", PN(playerid), playerid, PI[playerid][pLevel], AC_CODE_NAME[type], type);
 	SendAdminsMessage(0xD2B88FFF, global_str);*/

	return J_Kick(playerid);
}

