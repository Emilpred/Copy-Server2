}
stock SetPlayerAccessory(playerid, id, slot)
{
	if PlayerModification[playerid] *then
		return SetPlayerModification(playerid, PlayerModification[playerid]);

	new skin = GetPlayerSkin(playerid), item = ItemsInfo[id][ItemModel];

	if skin > 311 *then skin = GetSkinInfo(GetSkinInfo(GetSkinInfo(skin, 4), 3));

	if !AksSlot[playerid][2][slot] *then
		return false;

	if id == 1125 or id == 974 *then
	    return false;

	switch id do
	{
	    case 1447: SetAttachToSkin(playerid, item, slot, -65281, -16777216, id);
	    case 2411: SetAttachToSkin(playerid, item, slot, -1, -16777216, id);
	    case 2412: SetAttachToSkin(playerid, item, slot, -16711936, -16777216, id);
	    case 953..957: SetAttachToSkin(playerid, 364, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
	    case 1438, 1448..1456: SetAttachToSkin(playerid, 1607, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
	    case 1441: SetAttachToSkin(playerid, 16778, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
	    case 1442: SetAttachToSkin(playerid, 18978, slot, 0x000000FF, -1, id);
	    case 1457: SetAttachToSkin(playerid, 19128, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
	    case 1458: SetAttachToSkin(playerid, 1177, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1459: SetAttachToSkin(playerid, 19557, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1460: SetAttachToSkin(playerid, 13667, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1464: SetAttachToSkin(playerid, 12656, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1465: SetAttachToSkin(playerid, 12637, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1466: SetAttachToSkin(playerid, 12636, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1467: SetAttachToSkin(playerid, 12640, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1468: SetAttachToSkin(playerid, 19054, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1469: SetAttachToSkin(playerid, 12661, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1470: SetAttachToSkin(playerid, 12654, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1471: SetAttachToSkin(playerid, 12667, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1472: SetAttachToSkin(playerid, 12634, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
     	case 1121: SetAttachToSkin(playerid, 18868, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
		default: SetAttachToSkin(playerid, item, slot, ItemsInfo[id][ItemColorAks], ItemsInfo[id][ItemColorAks], id);
	}

	return GetPlayerAura(playerid);
}

stock SetPlayerModification(playerid, mod)
{
	AksDel[playerid][0] = AksDel[playerid][1] = AksDel[playerid][2] = AksDel[playerid][3] = AksDel[playerid][4] = AksDel[playerid][5] = AksDel[playerid][6] = AksDel[playerid][7] = 1;

	new skin = GetPlayerSkin(playerid);

	switch mod do
	{
		case 958:
		{
			if !(skin == 68) *then return false;

			SetPlayerAttachedObjectEx(playerid, 4, 324, 2, -0.0030, 0.1469, -0.0789, 0.0000, 76.1999, 164.9000, 0.9390, 1.2189, 0.3759, 0, 0);
			SetPlayerAttachedObjectEx(playerid, 5, 324, 1, -0.5830, -0.2709, -0.4239, 113.4999, 98.1999, -25.6000, 1.4079, 10.4469, 4.7259, 0, 0);
			SetPlayerAttachedObjectEx(playerid, 6, 18646, 14, 0.4529, -0.7260, -0.0270, 96.3000, 7.8000, 0.0000, 0.2109, 0.2339, 8.9059, 0, 0);
			SetPlayerAttachedObjectEx(playerid, 3, 19022, 2, 0.0599, 0.0609, 0.0030, 107.4000, -68.1000, -162.3000, 1.0000, 1.2130, 1.2369, 0, 0);
			SetPlayerAttachedObjectEx(playerid, 2, 19163, 2, 0.0649, 0.0349, 0.0000, 0.0000, 83.5000, -179.8000, 1.2609, 1.1389, 1.2809, 0, 0);
			SetPlayerAttachedObjectEx(playerid, 0, 18967, 2, 0.0439, -0.0020, 0.0019, 74.5999, 68.0000, 13.8999, 0.9139, 1.6009, 1.8389, 0, 0);
		}
		case 959:
		{
