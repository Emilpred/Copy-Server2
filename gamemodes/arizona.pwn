	    if(MusorCount[musor] < 1) return SCM(playerid, 0xAFAFAFFF, "[Klaida] {FFFFFF}Siame konteineryje nera siuksliu.");
	    else if(CarMusorCount[carid] >= 100)
		{
			SCM(playerid, COLOR_BLUE, !"[Uzuomina] {FFFFFF}Vaziuokite i savartyna, kad iskrautumete siuksliavezi.");
			SCM(playerid, COLOR_BLUE, !"[Uzuomina] {FFFFFF}Jusu miesto savartynas zemelapyje pazymetas raudona zyma.");
