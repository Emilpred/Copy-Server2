stock ShowAddVIP(playerid)
{
	if AddVIPOpen{playerid} *then return false;

	#include ../library/addvip.inc

	for new i; i < 10; i++ do
		ShowPlayerTD(playerid, addvipka[playerid][i]);

	AddVIPOpen{playerid} = true;

    if PI[playerid][pAddVipInfninity] == 1 *then
    {
        PlayerTextDrawSetString(playerid, addvipka[playerid][4], "FOREVER");
		PlayerTextDrawSetString(playerid, addvipka[playerid][0], "FOREVER");
    }
    else
    {
	    f(global_str, 25,"%i_DAY", (PI[playerid][pAddVIP]-Global_Time)/3600/24);
		PlayerTextDrawSetString(playerid, addvipka[playerid][4], global_str);
		PlayerTextDrawSetString(playerid, addvipka[playerid][0], global_str);
	}

	return 1;
}
stock HideAddVIP(playerid)
{
    if(!AddVIPOpen{playerid}) return false;

    AddVIPOpen{playerid} = false;

	for new i; i < 10; i++ do
		DestroyPlayerTD(playerid, addvipka[playerid][i]);

    return 1;
}
stock ShowAttention(playerid, zagl[], text[], type = 0)
{
/*	if(GetPlayerLauncher(playerid)) return false;
	if(GetPlayerMobileLauncher(playerid)) return false;
	if AttentionOpen{playerid} *then return false;
	if AttentionOpenn{playerid} *then return false;
	switch(type)
	{
		case 0:
		{
		    #include ../library/attentions/attention2.inc
			for new i; i < 16; i++ do ShowPlayerTD(playerid, attention_a[playerid][i]);

		    PlayerTextDrawSetString(playerid, attention_a[playerid][1], FixText(zagl));
		    PlayerTextDrawSetString(playerid, attention_a[playerid][0], FixText(text));

		    AttentionClose{playerid} = 3;
		    AttentionOpen{playerid} = true;
		}
		case 1:
		{
		    #include ../library/attentions/notify_no.inc
			for new i; i < 16; i++ do ShowPlayerTD(playerid, attention_aa[playerid][i]);

		    PlayerTextDrawSetString(playerid, attention_aa[playerid][1], FixText(zagl));
		    PlayerTextDrawSetString(playerid, attention_aa[playerid][0], FixText(text));

            AttentionClose{playerid} = 2;
            AttentionOpenn{playerid} = true;
		}
		case 2:
		{
		    #include ../library/attentions/attention.inc
		    if AttentionCarOpen{playerid} *then return false;

			for new i; i < 17; i++ do
				ShowPlayerTD(playerid, attention_p[playerid][i]);

		    PlayerTextDrawSetString(playerid, attention_p[playerid][1], FixText(text));

		    AttentionCarOpen{playerid} = true;

		    AttentionCarClose{playerid} = 2;
		}
	}*/

	return 1;
}

