	GetMysqlData(!caseid ? "houses":"businesses",!caseid ? "Name":"opisanie", !caseid ? PI[playerid][pHouseOpen]:BizData[ShowPBiz[playerid]][bID]);

	if !caseid *then
		f(global_str, 256, "{FFFFFF}Dabartinis pavadinimas: %s\n\nNurodykite savo namo pavadinima: (nuo 3 iki 32 simboliu)", mysql_string);
	else
		f(global_str, 256, "{FFFFFF}Dabartinis pavadinimas: %s\n\nNurodykite savo verslo pavadinima: (nuo 3 iki 32 simboliu)", mysql_string);

	SPD(playerid, caseid ? 2433:2432, DIALOG_STYLE_INPUT, !"", global_str, !"Pakeisti", !"Atsaukti");
