							else if(IsPlayerToKvadrat(i,-2929.6589,-2889.1660,-1326.9077,1493.1770)) PI[i][pPrison]=3,SetPlayerVirtualWorld(i, 13);
							else PI[i][pPrison]=2,SetPlayerVirtualWorld(i, 12);

