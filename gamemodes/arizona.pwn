stock UpdateBonusCarId(class, number, zamen){
	if(class == 1){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `lId%i` = '%i'", false, number, zamen); }
	if(class == 2){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `vId%i` = '%i'", false, number, zamen); }
	if(class == 3){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `dId%i` = '%i'", false, number, zamen); }
	if(class == 4){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `gId%i` = '%i'", false, number, zamen); }
	return 1;
}
stock UpdateBonusCarCost(class, number, zamen){
    if(class == 1){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `lCost%i` = '%i'", false, number, zamen); }
	if(class == 2){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `vCost%i` = '%i'", false, number, zamen); }
	if(class == 3){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `dCost%i` = '%i'", false, number, zamen); }
	if(class == 4){ mysql_queryf(mysql, "UPDATE `carsbonus` SET `gCost%i` = '%i'", false, number, zamen); }
	return 1;
}

stock J_SetPlayerPos(playerid, Float:X, Float:Y, Float:Z, int = 0, vv = 0)
{
    SetPlayerInterior(playerid, int);
    SetPlayerVirtualWorld(playerid, vv);
	SetCameraBehindPlayer(playerid);
    Streamer_Update(playerid);
	return SetPlayerPos(playerid, X, Y, Z);
}
stock GetNameID(const Name[])
{
    for(new i; i<MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            new pName[MAX_PLAYER_NAME];
            GetPlayerName(i, pName, sizeof(pName));
            if(strcmp(Name, pName, true)==0)
            {
                return i;
            }
        }
    }
    return -1;
}

stock IsAtMafia(playerid)
{
	new team = GetTeamID(playerid);
	switch(team)
	{
	    case TEAM_RM,TEAM_YAKUZA,TEAM_LCN,TEAM_BIKERS: return 1;
	    default: return 0;
	}
	return 0;
}
stock IsASuccesIP(const ip[], const original[])
{
    static IP[4][16], Or[4][16];
    sscanf(ip, "p<.>s[16]s[16]", IP[0], IP[1]);
    sscanf(original, "p<.>s[16]s[16]", Or[0], Or[1]);
    for(new i; i < 4; i ++)
    {
        if(Or[i][0] == '*') continue;
        if(strval(IP[i]) != strval(Or[i])) return 0;
    }
    return 1;
}

stock CheckIsASuccesIP(playerid)
{
    if(!IsASuccesIP(PlayerRegIP[playerid], PlayerIp[playerid]))
    {
        SCM(playerid, COLOR_OLDRED, !"[Klaida] {cccccc}Stebima isilauzimo bandymas!");
        SAMF(COLOR_OLDRED, "%s[%i] itariama, kad jis isilauze, patikrinkite ji ir suteikite prieiga /acceptadmin [6+ lvl]", PN(playerid), playerid);
        SCM(playerid, COLOR_VALIK, "Naudokite /queryacceptadmin norint gauti sutikima");
        return 1;
    }
    return 0;
}
stock ShowAFKSettings(playerid)
{
	static text1[40], text2[40], text3[40];
    f(text1, sizeof(text1), "%s", PI[playerid][pDescAFK1]);f(text2, sizeof(text2), "%s", PI[playerid][pDescAFK2]);f(text3, sizeof(text3), "%s", PI[playerid][pDescAFK3]);
    f(mysql_string, sizeof(mysql_string),
	"{FFFFFF}[1] \"%s{FFFFFF}\"\t%s\n{FFFFFF}[2] \"%s{FFFFFF}\"\t%s\n{FFFFFF}[3] \"%s{FFFFFF}\"\t%s\n{ECC488}>>> Informacija",
	(!PI[playerid][pCustomAFK1]) ? ("{73B461}AFK {FFFFFF}pasitrauke {73B461}(%%s){FFFFFF}") : (text1), (!PI[playerid][pCustomAFK1]) ? ("{AAAAAA}default") : ("{ECC488}custom"),
	(!PI[playerid][pCustomAFK2]) ? ("Valgo {69B1E4}(5:00+){FFFFFF}") : (text2), (!PI[playerid][pCustomAFK2]) ? ("{AAAAAA}default") : ("{ECC488}custom"),
	(!PI[playerid][pCustomAFK3]) ? ("Isejo i lauka {EC7878}(50:00+){FFFFFF}") : (text3), (!PI[playerid][pCustomAFK3]) ? ("{AAAAAA}default") : ("{ECC488}custom"));
    return SPD(playerid, 25211, DIALOG_STYLE_TABLIST, "{BFBBBA}Uzrasas virs galvos AFK rezime", mysql_string, "Isrinkti", "Atgal");
}
public: @ShowTop(playerid, forbesrussian[])
{
	static NickName[24];

	global_str = !"{ffffff}¹\t\t{ffffff}Pseudonimas\t{ffffff}Reiskimas";
	for new i; i < cache_get_row_count(); i++ do
	{
		cache_get_row(i, 0, NickName, mysql, MAX_PLAYER_NAME);

		strcat(global_str, (str_f("\n%d\t\t%s\t%d", i+1, NickName, cache_get_row_int(i, 1, mysql))));
	}
	return SPD(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, (str_f("{ffffff}Vieta TOPe: - | {ae433d}Forbes ({ffffff}%s{ae433d})", forbesrussian)), global_str, !"x", !"");
}

stock SaveFamGangZone(zoneid, type = 0)
{
	f(global_str, 400, "UPDATE `family_zone` SET `ownerid` = '%d', `Min_X` = '%.4f', `Min_Y` = '%.4f', `Max_X` = '%.4f', `Max_Y` = '%.4f' WHERE `id` = '%i'",
	FamilyZone[zoneid][fZoneOwnerId],
	FamilyZone[zoneid][fZone_Min_X],
	FamilyZone[zoneid][fZone_Min_Y],
	FamilyZone[zoneid][fZone_Max_X],
	FamilyZone[zoneid][fZone_Max_Y],
	zoneid + 1);
	mysql_query(mysql, global_str, false);

	if type == 1 *then
	{
		FamCaptureTime[0]=0; FamCaptureTime[1]=0;
		FamCaptureDef = -1;
		FamCaptureAtac = -1;
		FamCaptureZone = -1;
		FamilyZone[zoneid][famAttack] = false;
		FamilyZone[zoneid][fDay] = -1;
		FamilyZone[zoneid][fHour] = 0;
		FamilyZone[zoneid][fMinut] = 0;
		FamilyZone[zoneid][fAttack] = -1;
		f(global_str, 400, "UPDATE `family_zone` SET `Day` = '%i', `Hour` = '%i', `Minut` = '%d', `Zabiv` = '%i' WHERE `id` = '%i'",
		FamilyZone[zoneid][fDay],
		FamilyZone[zoneid][fHour],
		FamilyZone[zoneid][fMinut],
		FamilyZone[zoneid][fAttack],
		zoneid + 1);
		mysql_query(mysql, global_str, false);

	}
	return 1;
}

stock ShowFamCapture(playerid)
{
	format(global_str, 128, "SELECT DCapture FROM family WHERE id = '%d'", FP_Data[playerid][F_FAMILY_ID]);
	new Cache:result = mysql_query(mysql, global_str), rank;
	rank = cache_get_field_content_int(0, "DCapture");
	cache_delete(result, mysql);
	new z = FamCaptureZone;
	if FCaptureOpen{playerid} *then return false;
	if(FP_Data[playerid][F_FAMILY_RANG] < rank) return false;
	if(IsPlayerToKvadrat(playerid, FamilyZone[z][fZone_Min_X], FamilyZone[z][fZone_Min_Y], FamilyZone[z][fZone_Max_X], FamilyZone[z][fZone_Max_Y]))
	{
		for(new k; k < FAMILYZONES; k++) if !FamilyZone[k][famAttack] *then HideFamCapture(playerid);
	    #include ../library/td/FamilyCapture.inc
	    for(new a; a<13; a++) PlayerTextDrawShow(playerid, CapturePlayer[playerid][a]);
		FCaptureOpen{playerid} = true;
		if FP_Data[playerid][F_FAMILY_ID] == FamCaptureAtac *then SetPlayerColor(playerid, 0xFF0000FF);
		else if FP_Data[playerid][F_FAMILY_ID] == FamCaptureDef *then SetPlayerColor(playerid, 0x00ff00FF);
	}
	else return false;
    return 1;
}

stock HideFamCapture(playerid)
{
    if !FCaptureOpen{playerid} *then return false;
    for(new a; a<13; a++) DestroyPlayerTD(playerid, CapturePlayer[playerid][a]);
	FCaptureOpen{playerid} = false;
    if(IsAtGang(playerid) || IsAtMafia(playerid) || TeamDuty{playerid}) SetPlayerColor(playerid, TeamColors[GetTeamID(playerid)]);
    else SetPlayerColor(playerid, 0xFDFCFC15);
    return 1;
}

stock CheckCapt(playerid)
{
    new num;
    for(new k; k < FAMILYZONES; k++) if(FamilyZone[k][fAttack] == FP_Data[playerid][F_FAMILY_ID]) num++;
    return num;
}

stock GetPlayerFamilyMyZone(playerid, type)
{
    new num;
    for(new i; i < FAMILYZONES; i++)
    {
        if(type == 0) if(FamilyZone[i][fZoneOwnerId] == FP_Data[playerid][F_FAMILY_ID]) num ++;
        if(type == 1) if(FamilyZone[i][fAttack] >= 0) num ++;
    }
    return num;
}

stock ShowPokrasAcs(playerid)
{
    if(ChangeColorOpen{playerid}) return HidePokrasAcs(playerid);

	#include <textdraws/cataloges/changecolor>

	ShowInventoryPage(playerid, 485.299988 - 5.799865 * InventorySize[playerid][0], 138.642853, E_INVENTORY_TYPE_COLOR);

	for new i; i < 30; i++ do
		ShowPlayerTD(playerid, ChangeColor_PTD[playerid][i]);

    ChangeColorOpen{playerid} = true;
    CancelChangeColor{playerid} = false;
    InfoChanColor[playerid] = false;
    SetPVarInt(playerid, "idcolorchange", 0);

	return SelectTextDraw(playerid, PI[playerid][pSelectTD]);
}

stock HidePokrasAcs(playerid)
{
    if(!ChangeColorOpen{playerid}) return false;

    CancelChangeColor{playerid} = false;
    ChangeColorOpen{playerid} = false;
	for new i; i < 30; i++ do
		DestroyPlayerTD(playerid, ChangeColor_PTD[playerid][i]);
    CancelSelectTextDraw(playerid);
    for(new s; s < 3; s++)
    {
	    ItemChangeColor[playerid][s] = 0;
	    InventSlotUse[playerid][SlotChangeColor[playerid][s]] = false;
	}
    if InfoChanColor[playerid] *then
    {
		for(new k; k < 6; k++) DestroyPlayerTD(playerid, InfColorChange[playerid][k]);
		InfoChanColor[playerid] = false;
	}
	if(IsPlayerTextDrawVisible(playerid, ChangeColor_A[playerid])) DestroyPlayerTD(playerid, ChangeColor_A[playerid]);

	for new i; i < 36; i++ do
	{
		DestroyPlayerTD(playerid, Kletka[playerid][i]);
		DestroyPlayerTD(playerid, KletkaText[playerid][i]);
		DestroyPlayerTD(playerid, KletkaLevel[playerid][i]);
		DestroyPlayerTD(playerid, InvColorSlot[playerid][i]);

		if i < 15 *then DestroyPlayerTD(playerid, InvBorderTD[playerid][i]);
		if i < 4 *then DestroyPlayerTD(playerid, InvPageTD[playerid][i]);
	}

	return InventoryPage[playerid] = E_INVENTORY_TYPE_NONE;
}

stock LoadFamilyPickups()
{
	for new i = 0; i < sizeof FamilyPickups; i++ do
	{
	    famparea[i] = CreateDynamicSphere(FamilyPickups[i][famX],FamilyPickups[i][famY],FamilyPickups[i][famZ], 1.5);
	    CreateDynamicPickup(1239, 1, FamilyPickups[i][famX],FamilyPickups[i][famY],FamilyPickups[i][famZ], 0, 0);
	    CreateDynamic3DTextLabel("[ {ffffff}Seimos automobiliu parkas {CD5C5C}]\n\n{cccccc}Paspauskite ALT", 0xCD5C5CFF, FamilyPickups[i][famX],FamilyPickups[i][famY],FamilyPickups[i][famZ], 10.0000);
	}
	mysql_tquery(mysql, "UPDATE family_cars SET playerid = -1");
}

stock ShowFamilyCars(playerid)
{
	if FP_Data[playerid][F_FAMILY_ID] == -1 *then
		return SCM(playerid, COLOR_OLDRED, "[Klaida] {FFFFFF}Jus nesate vienoje is seimu!");

	if Int_GetPlayerData(playerid, "AntiFlood") > Global_Time *then
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Ne FLOODink!");

	SetPVarInt(playerid, "AntiFlood", Global_Time+3);

	format(global_str, 128, "SELECT * FROM family_cars WHERE famid = '%i'",FP_Data[playerid][F_FAMILY_ID]);
	new Cache:result = mysql_query(mysql, global_str), count = 0;

    if !cache_get_row_count(mysql) *then
        return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Jusu seimos automobiliu parkas yra tuscias! Naudokite /buyslot noredami nusipirkti vietu.");

	global_str = " \t \n";

	for new idx; idx < cache_get_row_count(mysql); idx++ do
	{
	    count++;
		ShowCar[playerid][idx] = cache_get_row_int(idx, 0, mysql);


		if cache_get_row_int(idx, 5, mysql) == -1 *then
		    f(global_str, 1024, "%s{ffffff}[%i] %s\t[ yra: nuo %i rango ]\n", global_str,idx+1,GetVehicleName(cache_get_row_int(idx, 3, mysql),true),cache_get_row_int(idx, 4, mysql));

		else
            f(global_str, 1024, "%s{CD5C5C}[%i] %s[carid: %i]\t{CD5C5C}[ paeme %s ]\n", global_str,idx+1,GetVehicleName(cache_get_row_int(idx, 3, mysql),true),Int_GetPlayerData(cache_get_row_int(idx, 5, mysql),"familycarid_server"),PN(cache_get_row_int(idx, 5, mysql)));

	}
	cache_delete(result, mysql);

	f(mysql_string, 72, "{ffff00}Is viso prieinamu vietu: %i vnt.\t{cccccc}(%s)",GetFamilySlot(playerid), GetFamilySlot(playerid) >= 20 ? "maksimaliai" : "paspauskite, kad nusipirktumete papildomai");
	strcat(global_str,mysql_string);

	ShowCar[playerid][count] = -1;

	return SPD(playerid, 8029, DIALOG_STYLE_TABLIST_HEADERS, !"Seimos automobiliu parkas", global_str, !"Isrinkti", !"Atsaukti");

}
stock GetFamilySlot(playerid)
{
	if FP_Data[playerid][F_FAMILY_ID] == -1 *then
	    return false;

	f(mysql_string, 128, "SELECT `slot` FROM family WHERE ID = %d", FP_Data[playerid][F_FAMILY_ID]);
	new slot, Cache:result = mysql_query(mysql, mysql_string);

	if cache_get_row_count() *then
     	slot = cache_get_row_int(0, 0, mysql);

	cache_delete(result, mysql);
	return slot;
}
stock GetFamilyCars(playerid)
{
	if FP_Data[playerid][F_FAMILY_ID] == -1 *then
	    return false;

	f(mysql_string, 128, "SELECT COUNT(*) FROM family_cars WHERE famid = %d", FP_Data[playerid][F_FAMILY_ID]);
	new Cache:result = mysql_query(mysql, mysql_string), count;

	count = cache_get_row_int(0, 0, mysql);

	cache_delete(result, mysql);
	return count;
}
stock GetFamilyCarsID(playerid)
{
	if FP_Data[playerid][F_FAMILY_ID] == -1 *then
	    return false;

	f(mysql_string, 128, "SELECT ownableid FROM family_cars WHERE playerid = %d", playerid);
	new Cache:result = mysql_query(mysql, mysql_string), count;

	count = cache_get_row_int(0, 0, mysql);

	cache_delete(result, mysql);
	return count;
}
stock TakeFamilyCar(playerid, mysqlid)
{
	if Int_GetPlayerData(playerid, "familycarid_mysql") *then
	    return SCM(playerid,COLOR_RED, "[Klaida] {ffffff}Jus jau paemete transporta is seimos automobiliu parko!");

	format(global_str, 128, "SELECT id, rank, model FROM family_cars WHERE id = '%i' AND playerid = -1", mysqlid);
	new Cache:result = mysql_query(mysql, global_str),
	id = 0,
	rank = 0,
	model = 0,
	carid = 0,
	spawn = 0;

    if !cache_get_row_count(mysql) *then
        return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Si transporta uzeme kitas zaidejas!");

	if CountVehicles() >= 1999 or (carid = FindFreeCarSlot()) == -1 *then
		return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Serveryje per daug masinu");

	id = cache_get_row_int(0,0,mysql),
	rank = cache_get_row_int(0,1,mysql),
	model = cache_get_row_int(0,2,mysql);

	cache_delete(result, mysql);

	if FP_Data[playerid][F_FAMILY_RANG] < rank *then
	    return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Jusu rangas per zemas siam transportui!");


	new Float:x, Float:y, Float:z, Float:a;
	GetPlayerPos(playerid,x,y,z);


	for new i = 0; i < sizeof FamilyPickups; i++ do {

	    if IsPlayerInRangeOfPoint(playerid, 20.0, FamilyPickups[i][famX],FamilyPickups[i][famY],FamilyPickups[i][famZ]) *then {
	        spawn = i+1;
	        break;
	    }
	}

	switch spawn do {
		case 1: {
			switch random(8) do {
				case 0: x = 1756.4442,y = 409.7640,z = 20.1436,a = 85.1682;
				case 1: x = 1757.2013,y = 415.1861,z = 20.1436,a = 86.0688;
				case 2: x = 1757.7811,y = 423.1520,z = 20.1436,a = 86.2254;
				case 3: x = 1761.1403,y = 425.3650,z = 20.1436,a = 267.1377;
				case 4: x = 1760.8624,y = 422.7744,z = 20.1436,a = 266.3929;
				case 5: x = 1760.9523,y = 420.1530,z = 20.1436,a = 266.8619;
				case 6: x = 1761.1587,y = 417.4573,z = 20.1436,a = 266.4300;
				case 7: x = 1760.9642,y = 412.0390,z = 20.1436,a = 267.5250;
   			}
		}
		case 2:
            x = -2014.3134,y = 425.9878,z = 35.1719,a = 181.2728;

		default:
			return SendErrorMessage(playerid);

	}



	OwnableCar[carid] = J_AddStaticVehicleEx(model, x,y,z,a, random(127), random(127));

	if spawn == 2 *then
	    GetCoordBonnetVehicle(OwnableCar[carid], x, y, z, random(10));

    PutPlayerInVehicle(playerid, OwnableCar[carid], 0);
	SetVehiclePos(OwnableCar[carid], x, y, z);
    CarInfo[OwnableCar[carid]][cFamily] = FP_Data[playerid][F_FAMILY_ID];

	Int_SetPlayerData(playerid, "familycarid_server", OwnableCar[carid]);
	Int_SetPlayerData(playerid, "familycarid_mysql", id);

	SQL("UPDATE family_cars SET playerid = %d WHERE id = %d;", playerid, mysqlid);

	f(global_str,120,"{3399ff}[Family Car] Seimos narys %s[%i] paeme '%s' is seimos automobiliu parko.",PN(playerid),playerid,GetVehicleName(model,true));
	SendFamilyMessage(FP_Data[playerid][F_FAMILY_ID], global_str);
	return SCMF(playerid, COLOR_VALIK, "Jus paemete transporta '%s'. (jei busite ne prie vairo daugiau nei 5 minutes, transportas bus nusiustas i seimos automobiliu parka)",GetVehicleName(model,true));

}
stock DestroyFamilyCar(playerid)
{
	if Int_GetPlayerData(playerid,"familycarid_mysql") *then {
	    DestroyVehicleEx( Int_GetPlayerData(playerid,"familycarid_server") );
	    SQL("UPDATE family_cars SET playerid = -1 WHERE id = %d;", Int_GetPlayerData(playerid,"familycarid_mysql"));
		DPlayerData(playerid,"familycarid_server");
		DPlayerData(playerid,"familycarid_mysql");
	}
}

stock LoadPrivateFraction() {

	new ID,Cache:result = mysql_query(mysql, "SELECT * FROM `private_fraction` ORDER BY ID");

	TOTALFRACTIONS = cache_get_row_count(mysql);

	for new idx; idx < TOTALFRACTIONS; idx++ do
	{
	    ID = cache_get_row_int(idx, 0, mysql);
		PrivateInfo[ID][privateID] = cache_get_row_int(idx, 1, mysql);
		PrivateInfo[ID][privateFamily] = cache_get_row_int(idx, 2, mysql);
		PrivateInfo[ID][privateNalog] = cache_get_row_int(idx, 3, mysql);
		cache_get_row(idx, 4, global_str, mysql),Float_UnPackMassive(global_str, PrivateInfo[ID][privatePickup]);
		cache_get_row(idx, 5, global_str, mysql),Float_UnPackMassive(global_str, PrivateInfo[ID][privateJob]);
		cache_get_row(idx, 6, global_str, mysql),Int_UnPackMassive(global_str, PrivateInfo[ID][privateIntWorld]);
		cache_get_row(idx, 7, global_str, mysql),Int_UnPackMassive(global_str, PrivateInfo[ID][privateMoney_Week]);
		cache_get_row(idx, 8, global_str, mysql),Int_UnPackMassive(global_str, PrivateInfo[ID][privateMoney_Month]);


		if PrivateInfo[ID][privateMoney_Week][0] >= 7 *then {
		    PrivateInfo[ID][privateMoney_Week][0] = 0;
			PrivateInfo[ID][privateMoney_Week][1] = 0;
		}
		if PrivateInfo[ID][privateMoney_Month][0] >= 28 *then {
		    PrivateInfo[ID][privateMoney_Month][0] = 0;
			PrivateInfo[ID][privateMoney_Month][1] = 0;
		}
		PrivateInfo[ID][privateMoney_Month][0] ++;
		PrivateInfo[ID][privateMoney_Week][0] ++;
	}

	cache_delete(result, mysql);

	/* zagruzka teksta */
	for new idx; idx < TOTALFRACTIONS; idx++ do {

        CreateDynamicPickup(1239, 23, PrivateInfo[idx][privatePickup][0],PrivateInfo[idx][privatePickup][1],PrivateInfo[idx][privatePickup][2], 0);
		CreateDynamicPickup(1314, 23, PrivateInfo[idx][privateJob][0],PrivateInfo[idx][privateJob][1],PrivateInfo[idx][privateJob][2], PrivateInfo[idx][privateIntWorld][1], PrivateInfo[idx][privateIntWorld][0]);
		CreateDynamic3DTextLabel("[ Isidarbinimas ]\n{cccccc}Paspauskite ALT", 0x73B461FF, PrivateInfo[idx][privateJob][0],PrivateInfo[idx][privateJob][1],PrivateInfo[idx][privateJob][2], 10.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,PrivateInfo[idx][privateIntWorld][1],PrivateInfo[idx][privateIntWorld][0]);


		format(global_str,127,"[ Privati organizacija ]\n\n{ffffff}Organizacija yra seimos kontroleje: {CD5C5C}%s\n\n{cccccc}Paspauskite ALT", PrivateInfo[idx][privateFamily] ? GetFamilyDataString(PrivateInfo[idx][privateFamily], "name") : "Laisva");
		PrivateInfo[idx][privateText] = CreateDynamic3DTextLabel(global_str, 0xFFFF00FF, PrivateInfo[idx][privatePickup][0],PrivateInfo[idx][privatePickup][1],PrivateInfo[idx][privatePickup][2], 5.0);

		if PrivateInfo[idx][privateFamily] == -1 *then
			StartPrivateAuction(idx);

	}
	return true;
}

stock ShowPrivateFraction(playerid, listitem = -1, type = 0, inputtextsave[] = "default") {

	new list = GetFamilyFraction(FP_Data[playerid][F_FAMILY_ID]);

	if list == -1 *then
        return SCM(playerid,COLOR_RED, "[Klaida] {ffffff}Jusu seima neturi privacios organizacijos!");

	new orgid = PrivateInfo[list][privateID];

	if listitem == -1 && !type *then {
		f(mysql_string,42 + MAX_PLAYER_NAME,"Pasalinti privacios organizacijos lyderi {CD5C5C}[%s]",OrgInfo[orgid][oLeader]);

		f(global_str, 1024 + MAX_PLAYER_NAME,"\
		{CD5C5C}[1] {ffffff}Organizacijos bendra statistika\n\
		{CD5C5C}[2] {ffffff}%s\n\
		{CD5C5C}[3] {ffffff}Organizacijos lyderio / pavaduotoju statistika\n\
		{CD5C5C}[4] {ffffff}Organizacijos nariu sarasas\n\n\
		{CD5C5C}[5] {ffffff}Bankiniu operaciju zurnalas\n\
		{CD5C5C}[6] {ffff00}Surasti privacia organizacija\n\
		{ffff00}[7] {ffffff}Paimti pinigus is organizacijos saskaitos\n\
		{ffff00}[8] {ffffff}Papildyti privacios organizacijos saskaita",GetString(OrgInfo[orgid][oLeader],"Laisva") ? "Paskirti privacios organizacijos lyderi" : mysql_string);

		SPD(playerid,8041, DIALOG_STYLE_LIST, "Privacios organizacijos valdymas",global_str,"Isrinkti","Atsaukti");
	}
	else if listitem != -1 && !type *then {

		if !GetFamilyAcces(PN(playerid), FP_Data[playerid][F_FAMILY_ID]) *then
	    	return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Si panele prieinama tik lyderiui ir pavaduotojui!");

		switch listitem do {

			case 0: ShowPrivateFraction(playerid, -1, 1);
			case 1: {
				if GetString(OrgInfo[orgid][oLeader],"Laisva") *then
					SPD(playerid, 8042, DIALOG_STYLE_INPUT, "Privati organizacija", "Iveskite zaidejo ID, kuri norite paskirti lyderio pareigoms\n\n{cccccc}Pastaba: Zaidejas turi buti salia jusu ir priklausyti privaciai organizacijai", "Toliau", "Atsaukti");


				else {
					f(global_str,100+MAX_PLAYER_NAME,"{FFFFFF}Ar tikrai norite pasalinti esama privacios organizacijos lyderi?\n\nDabartinis lyderis: {CD5C5C}%s",OrgInfo[orgid][oLeader]);
                    SPD(playerid,8042, DIALOG_STYLE_MSGBOX, "Privati organizacija",global_str,"Taip","Atgal");
				}
			}
			case 2: ShowPrivateFraction(playerid, -1, 5);
			case 3: ShowPrivateFraction(playerid, -1, 4);
			case 4: ShowPrivateFraction(playerid, -1, 3);
			case 5: EnableGPSForPlayer(playerid, PrivateInfo[list][privatePickup][0],PrivateInfo[list][privatePickup][1],PrivateInfo[list][privatePickup][2]);
			case 6:
			{
				SetPVarInt(playerid, #prfrac, orgid);
				f(global_str,256,"{ffffff}Privati organizacija: {ffff00}%s{ffffff}\nJusu privacios organizacijos saskaitoje siuo metu: {33aa33}%d${ffffff}\n\nIveskite suma, kuria norite nuskaityti:",OrgInfo[orgid][oName],OrgInfo[orgid][oBank]);
    			SPD(playerid,8175, DIALOG_STYLE_INPUT, "Paimti is saskaitos",global_str,"Toliau","Atsaukti");
			}
			case 7:
			{
				SetPVarInt(playerid, #prfrac, orgid);
				f(global_str,256,"{ffffff}Privati organizacija: {ffff00}%s{ffffff}\nJusu privacios organizacijos saskaitoje siuo metu: {33aa33}%d${ffffff}\n\nIveskite suma papildymui:",OrgInfo[orgid][oName],OrgInfo[orgid][oBank]);
    			SPD(playerid,8176, DIALOG_STYLE_INPUT, "Papildyti saskaita",global_str,"Toliau","Atsaukti");
			}
		}
	}
	else {

		switch type do {

			case 1: {

				f(mysql_string, 50, "SELECT COUNT(*) FROM accounts WHERE Member = %d", orgid);
				new Cache:result = mysql_query(mysql, mysql_string), players;
				players = cache_get_row_int(0, 0, mysql);
				cache_delete(result, mysql);

				f(global_str,400,"\
				{ffffff}Privacios organizacijos pavadinimas: {73B461}%s\n\
				{ffffff}Dabartinis organizacijos lyderis: {CD5C5C}%s\n\
				{ffffff}Bendras zaideju skaicius: {ffff00}%i vnt.\n\n\
				{ffffff}Pelno suma per diena: {9ACD32}+$%i.\n\
				{ffffff}Pelno suma per savaite: {9ACD32}+$%i.\n\
				{ffffff}Pelno suma per menesi: {9ACD32}+$%i.\n\n\
				{ffffff}Dabartine mokesciu suma: {9ACD32}$%i.",OrgInfo[orgid][oName],OrgInfo[orgid][oLeader],players,PrivateInfo[list][privateMoney_Day],PrivateInfo[list][privateMoney_Week][1],PrivateInfo[list][privateMoney_Month][1],PrivateInfo[list][privateNalog]);
                SPD(playerid,8044, DIALOG_STYLE_MSGBOX, "Organizacijos statistika",global_str,"Atgal","");
			}
			case 2: {

                if GetString(OrgInfo[orgid][oLeader],"Laisva") *then
				{

					new id = strval(inputtextsave);

					if(id == INVALID_PLAYER_ID || id == playerid)
						return SCM(playerid, COLOR_GREY, "Zaidejas nerastas!");

	                if !ProxDetectorS(5.0, playerid, id) *then
	                    return SCM(playerid, COLOR_GREY, "Jus turite buti salia zaidejo!");



		            SetString(OrgInfo[orgid][oLeader],PN(id));
		            PI[id][pMember] = orgid;
		            PI[id][pLeader] = orgid;

		            PI[id][pDCTime]=2;
			        SCM(id, COLOR_WHITE, !">> {FF6347} Privati organizacija automatiskai paskirta spawno vieta. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");

		            PI[id][pRank] = OrgInfo[orgid][Max_Rang];
		            f(global_str,124,"Seimos Lyderis/pavaduotojas %s paskyre jus privacios organizacijos lyderiu '%s'",PN(playerid),OrgInfo[orgid][oName]);
		            SCM(id,COLOR_VALIK,global_str);
					f(global_str,156,"{73B461}Seimos Lyderis/pavaduotojas %s paskyre zaideja %s privacios organizacijos lyderiu '%s'",PN(playerid),PN(id),OrgInfo[orgid][oName]);
		            SendFamilyMessage(FP_Data[playerid][F_FAMILY_ID],global_str);


					ResetSpawnInfo(id, orgid);
				}
				else {
				    new id = GetNameID(OrgInfo[orgid][oLeader]);

			    	PlayerUnleader(id, OrgInfo[orgid][oLeader]);

			    	f(global_str, 156, "{73B461}[Informacija] {FFFFFF}Seimos Lyderis/pavaduotojas %s pasalino zaideja %s is privacios organizacijos vadovo pareigu", PN(playerid), OrgInfo[orgid][oLeader]);
			    	SendFamilyMessage(FP_Data[playerid][F_FAMILY_ID], global_str);

			    	SetString(OrgInfo[orgid][oLeader], "Laisva");

				}
			}
			case 3: {
				global_str = "{cccccc}Data ir laikas\t{cccccc}Nick zaidejo\t{cccccc}Veiksmas\n";

				SPD(playerid,8044, DIALOG_STYLE_TABLIST_HEADERS, "Bankiniu operaciju zurnalas",global_str,"Atgal","");
			}
			case 4: {



				f(mysql_string, 156, "SELECT NickName, PlayHour, Online_status, Rank FROM accounts WHERE Member = %d ORDER BY Rank DESC LIMIT 30", orgid);
				new Cache:result = mysql_query(mysql, mysql_string);


				new accounts = cache_get_row_count(mysql), online, hours,status,rank;

				global_str = "{cccccc}Nick\t{cccccc}suzaide per diena\t{cccccc}Suzaide per savaite\t{cccccc}Suzaide per menesi\n";

				for new i = 0; i < accounts; i++ do {

					cache_get_row(i, 0, SQL_GET_ROW_STR[0], mysql);

					hours = cache_get_row_int(i, 1, mysql);
					status = cache_get_row_int(i, 2, mysql);
					rank = cache_get_row_int(i, 3, mysql);

					if status *then
					    online++;

					f(SQL_STRING,200,"{CD5C5C}[%i] {ffffff}%s (%i)\t{cccccc}[ %i val ]\t{cccccc}[ %i val ]\t{cccccc}[ %i val ]\n",i+1,SQL_GET_ROW_STR[0],rank,hours,hours,hours);
					strcat(global_str,SQL_STRING);

				}

				cache_delete(result, mysql);

				if !accounts *then
				    return SCM(playerid,COLOR_RED, "[Klaida] {ffffff}Duomenu bazeje nerasta paskyru!");

				f(mysql_string,64,"Organizacijos dalyviu sarasas (%i online / 30)",online);
				SPD(playerid,8044, DIALOG_STYLE_TABLIST_HEADERS, mysql_string,global_str,"Atgal","");
			}
			case 5: { // lyderio ir pavaduotojo statistika



				f(mysql_string, 156, "SELECT NickName, Rank FROM accounts WHERE Member = %d AND Rank > 8 ORDER BY Rank DESC LIMIT 30", orgid);
				new Cache:result = mysql_query(mysql, mysql_string);


				new accounts = cache_get_row_count(mysql), rank;

				global_str = "{cccccc}Nick\t{cccccc}Prieme per diena\t{cccccc}Prieme per savaite\t{cccccc}Prieme per menesi\n";

				for new i = 0; i < accounts; i++ do {

					cache_get_row(i, 0, SQL_GET_ROW_STR[0], mysql);

					rank = cache_get_row_int(i, 1, mysql);


					f(SQL_STRING,200,"{CD5C5C}[%i] {ffffff}%s (%i)\t{cccccc}[ 0 zaideju ]\t{cccccc}[ 0 zaideju ]\t{cccccc}[ 0 zaideju ]\n",i+1,SQL_GET_ROW_STR[0],rank);
					strcat(global_str,SQL_STRING);

				}

				cache_delete(result, mysql);

				if !accounts *then
				    return SCM(playerid,COLOR_RED, "[Klaida] {ffffff}Duomenu bazeje nerasta paskyru!");

				SPD(playerid,8044, DIALOG_STYLE_TABLIST_HEADERS, "Lyderio ir pavaduotoju statistika",global_str,"Atgal","");
			}
		}

	}
	return true;
}

stock ShowPrivateJob(playerid, response = -1) {

	new i = GetFamilyFraction(FP_Data[playerid][F_FAMILY_ID]);

	if FP_Data[playerid][F_FAMILY_ID] == -1 || i == -1 *then
	    return SendErrorMessage(playerid);

	new orgid = PrivateInfo[i][privateID];



	if response == -1 *then {
	    f(global_str,215,"{FFFFFF}Ar tikrai norite istoti i organizacija {73B461}'%s'{FFFFFF}?\nPo istojimo jus iskart gausite 3-aji ranga.\n\n{cccccc}Pastaba: taip pat galesite bet kada pats atsistatydinti.",OrgInfo[orgid][oName]);
	    SPD(playerid,8043,DIALOG_STYLE_MSGBOX,"Istojimas i organizacija",global_str,"Taip","Atsaukti");
	}


	else if response *then {

		if PI[playerid][pMember] *then
		    return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Jus jau esate organizacijos narys!");


		PI[playerid][pMember] = orgid;
	    PI[playerid][pDCTime] = 2;
	    SCM(playerid, COLOR_WHITE, !">> {FF6347} Spawno vieta automatiskai nustatyta kaip privati organizacija. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");
	    PI[playerid][pRank] = 3;
	    PI[playerid][pFWarns] = 0;

	    f(global_str, 120, "Sveikiname nauja nari musu organizacijoje %s.", PN(playerid));
	    SendTeamMessage(orgid, COLOR_VALIK, global_str);
		ResetSpawnInfo(playerid, orgid);

        GiveFractionMoney(i, 150000);
	}
	return true;
}

stock GetFamilyFraction(family, int = -1)
{
	for new i = 0; i < TOTALFRACTIONS; i++ do {

		if PrivateInfo[i][privateFamily] == family *then {
		    int = i;
			break;
		}
	}

	return int;
}

stock SavePrivateFraction(i) {
    PrivateInfo[i][privateMoney_Week][1] += PrivateInfo[i][privateMoney_Day];
    PrivateInfo[i][privateMoney_Month][1] += PrivateInfo[i][privateMoney_Day];

	f(global_str, 200 , "UPDATE `private_fraction` SET \
	`Family` = '%i', `Nalog` = '%i', `Money_Week` = '%s', `Money_Month` = '%s' WHERE `OrgID` = '%i'",
	PrivateInfo[i][privateFamily],
	PrivateInfo[i][privateNalog],
	Int_PackMassive(0,PrivateInfo[i][privateMoney_Week]),
	Int_PackMassive(0,PrivateInfo[i][privateMoney_Month]),
	PrivateInfo[i][privateID]);

	mysql_tquery(mysql, global_str);

	return true;
}
stock GiveFractionMoney(i, money, find = 0) {


	if find *then {
		for new x = 0; x < TOTALFRACTIONS; x++ do {
			if PrivateInfo[x][privateID] == find *then {
				i = x; break;
			}
		}
	}

	PrivateInfo[i][privateMoney_Day] += money;

	OrgInfo[PrivateInfo[i][privateID]][oBank] += money;
	if(OrgInfo[PrivateInfo[i][privateID]][oBank] > 2000000000) OrgInfo[PrivateInfo[i][privateID]][oBank] = 2000000000;

	SavePrivateFraction(i);

	return true;
}

stock StartPrivateAuction(i) {

    PrivateInfo[i][privateFamily] =
    PrivateInfo[i][privateAuctionFamily] =
    PrivateInfo[i][privateAuctionLast] = 0;
    PrivateInfo[i][privateAuctionTime] = 36000;
	SetString(PrivateInfo[i][privateAuctionDate],UNIX_TO_DATE(PrivateInfo[i][privateAuctionTime]+Global_Time));

	SavePrivateFraction(i);

	return true;
}
stock UpdatePrivateAuction(i) {

	PrivateInfo[i][privateAuctionTime]--;

	if !PrivateInfo[i][privateAuctionTime] *then
	    return EndPrivateAuction(i);

	if PrivateInfo[i][privateAuctionLast] *then
		f(mysql_string,100,"{483D8B}%i SSC\n{ffffff}Padare: {ff6666}%s (Seima: %s)",PrivateInfo[i][privateAuctionLast],PrivateInfo[i][privateAuctionOwner],PrivateInfo[i][privateAuctionFamilyName]);

	f(global_str,330,"\
	[ Vyksta aukcionas ]\n\
	{ffffff}Pradine kaina: {483D8B}20000 SSC\n\
	{ffffff}Minimalus statymas: {483D8B}100 SSC\n\n\
	{ffffff}Paskutinis statymas: {ff6666}%s\n\n\
	{ffffff}Aukciono pabaiga per: {cccccc}%s (%s)\n\nPaspauskite ALT",!PrivateInfo[i][privateAuctionLast] ? "Kol kas niekas nespejo atlikti statymo" : mysql_string, Convert(PrivateInfo[i][privateAuctionTime]),PrivateInfo[i][privateAuctionDate]);
    return UpdateDynamic3DTextLabelText(PrivateInfo[i][privateText],COLOR_YELLOW,global_str);
}

stock EndPrivateAuction(i) {

	if !PrivateInfo[i][privateAuctionLast] *then
	    return StartPrivateAuction(i);

	if GetPlayerID(PrivateInfo[i][privateAuctionOwner]) != INVALID_PLAYER_ID *then
	    SCMF(GetPlayerID(PrivateInfo[i][privateAuctionOwner]),COLOR_VALIK,"[Informacija] {ffffff}Sveikiname! Jus laimejote privacios frakcijos aukciona '%s'.",OrgInfo[PrivateInfo[i][privateID]][oName]);

    PrivateInfo[i][privateFamily] = PrivateInfo[i][privateAuctionFamily];
    PrivateInfo[i][privateNalog] = 0;

	f(global_str,127,"[ Privati organizacija ]\n\n{ffffff}Organizacija kontroleje seimos: {CD5C5C}%s\n\n{cccccc}Paspauskite ALT", GetFamilyDataString(PrivateInfo[i][privateFamily], "name"));
    UpdateDynamic3DTextLabelText(PrivateInfo[i][privateText],COLOR_YELLOW,global_str);

    return SavePrivateFraction(i);
}

stock ShowPrivateAuction(playerid, listitem = -1) {

	if listitem == -1 *then {
		f(global_str,126,"\
		{ff6666}[1] {ffffff}Informacija\n\
		{ff6666}[2] {ffffff}Padaryti statyma\n\
		{ff6666}[3] {ffffff}Isigyti SSC {cccccc}[yra pardavime]");
		SPD(playerid,8046,DIALOG_STYLE_LIST,"Privati organizacija",global_str,"Isrinkti","Atsaukti");
	}
	else {
		switch listitem do {

			case 0: DPlayerData(playerid,"privateid"), ShowPrivateInfo(playerid);
			case 1: {

			    new i = Int_GetPlayerData(playerid,"privateid");

				if PrivateInfo[i][privateAuctionLast] *then
					f(mysql_string,100,"{483D8B}%i SSC\n{ffffff}Padare: {ff6666}%s (Seima: %s)",PrivateInfo[i][privateAuctionLast],PrivateInfo[i][privateAuctionOwner],PrivateInfo[i][privateAuctionFamilyName]);

				f(global_str,310,"\
				{FFFFFF}Organizacija: {73B461}%s\n\
				{FFFFFF}Pradine kaina: {483D8B}20000 SSC\n\
				{FFFFFF}Minimalus statymas: {483D8B}100 SSC\n\n\
				{ffffff}Paskutinis statymas: {ff6666}%s\n\n\
				{cccccc}Iveskite zemiau nurodyta savo statymo suma",OrgInfo[PrivateInfo[i][privateID]][oName],!PrivateInfo[i][privateAuctionLast] ? "Kol kas niekas nespejo atlikti statymo" : mysql_string);

                SPD(playerid,8047,DIALOG_STYLE_INPUT,"Aukcionas",global_str,"Isrinkti","Atsaukti");
			}
			case 2: DPlayerData(playerid,"privateid"), ASC_Dialog_Buy(playerid);

		}

	}
	return true;
}
stock ShowPrivateInfo(playerid) {
	return SPD(playerid,0,DIALOG_STYLE_MSGBOX,"Privacios frakcijos","\
	{ffffff}Visame mieste yra apie {ff6666}9 privaciu frakciju{ffffff}, tokiu kaip:\n\
	- Ligonine Jefferson (NEW);\n\
	- Ligonine SF;\n\
	- Ziniasklaida LV;\n\
	- Ziniasklaida SF;\n\
	- Draudimo kompanija;\n\
	- Mafija LKN;\n\
	- Naktiniai vilkai;\n\
	- Varrios Los Aztecas;\n\
	- Baikeriai Tierra Robada (NEW).\n\n\
	Kiekviena privati frakcija visiskai atitinka iprasta, taciau jos savininkai yra seimos.\n\
	Privati frakcija gali buti isigyta seimos lyderio arba pavaduotojo (10 lygio) prie specialaus Pickup punkto su pacia frakcija,\n\
	kiekviena seima gali tureti tik viena frakcija.\n\n\
	Po pirkimo seimos lyderis, naudodamasis specialiu meniu {ff6666}(/fammenu - Kiti - Privati frakcija) {ffffff}gali paskirti savo frakcijos lyderi,\n\
	tai gali buti bet kuris zaidejas, kuris net nera seimos narys.\n\
	Privaciu frakciju lyderius gali pasalinti tik seimos lyderiai, serverio administracija neturi tokios galimybes.\n\n\
	Visas privacios frakcijos valdymas vykdomas per specialu skyriu seimos meniu.\n\
	Ten lyderis arba pavaduotojas gali perziureti issamia savo frakcijos statistika.\n\
	Pasiekiama si informacija:\n\
	- zmoniu skaicius frakcijoje;\n\
	- pelnas, kuri frakcija gavo per diena, savaite ir menesi;\n\
	- visu frakcijos drabuotoju aktyvumas;\n\
	- i frakcija priimtu zmoniu skaicius pas lyderi ir pavaduotoja;\n\
	- laiko kiekis, dirbtas per diena, savaite ir menesi kiekvienam darbuotojui\n\n\
	Pagrindines privacios frakcijos pajamos gaunamos is paslaugu apmokejimo (Gydymas, draudimo pirkimas, skelbimu talpinimas).\n\n\
	Pavaduotojams ir seimos savininkui, kuris valdo privacia frakcija, interjere yra prieinamas Pickup punktas,\n\
	su kuriuo galima {ff6666}iskart gauti 9 ranga{ffffff}, neiskreipiant i pokalbi (pateikiama salyga, kad jus nesate kitoje frakcijoje).\n\
	Jei naudojantis siuo Pickup punktu bus priimtas lyderis ar pavaduotojas, jam automatiskai bus isduotas {ff6666}9 rangas{ffffff}.\n\
	Jei seimos narys jau priklauso siai frakcijai, jis, prieidamas prie Pickup vietos, gales automatiskai atsistatydinti uz uzimamos pareigos.\n\n\
	Kiekviena privati frakcija apmokestinama. Mokescio suma yra {32CD32}$14 000{FFFFFF} kiekviena PayDay, o mokescio riba yra - {32CD32}$10 000 000{ffffff}.\n\
	Noredami sumoketi mokescius, seimos lyderiui arba pavaduotojui reikia atvykti i banka ir sumoketi juos specialiame punkte - Mokesciu apmokejimas uz frakcija.\n\
	Jei mokesciai nebus sumoketi, privati frakcija bus konfiskuota ir isstatyta {ff6666}10 valandu truksianciam aukcionui su pradine kaina - 20 000 SAG-Coins{ffffff}.\n\n\
	Privacias frakcijas gali buti randami meniu {ff6666}/GPS - Privacios frakcijos{ffffff}.","Uzdaryti","");
}

stock Select_Company(playerid, type) {

    global_str = "";

    new count;

	switch type do {
        case 1: {


        	for new i; i < MAX_VEHICLES; i++ do
			{
			    if !IsPlayerRegCar(playerid, i) *then continue;

                ShowCar[playerid][count] = i;
                format(global_str, 1024, "%s %s(ID: %d)\n", global_str, GetVehicleName(i), i);
                count++;
			}
		}
        case 2: {

        	for new i; i < OWNABLEHOUSES; i++ do
			{
				if !GetString(HouseInfo[i][hOwner], PN(playerid)) *then continue;


                ShowCar[playerid][count] = i;
                format(global_str, 1024, "%s Namas ¹%i\n", global_str, i);
                count++;
			}
		}
        case 3: {

        	for new i = 1; i < OWNABLEBIZES; i++ do
			{
				if !GetString(BizData[i][bOwner], PN(playerid)) *then continue;


                ShowCar[playerid][count] = i;
                format(global_str, 1024, "%s Verslas ¹%i\n", global_str, i);
                count++;
			}
		}
	}
	if !count *then return SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Jus neturite nurodyto tipo nekilnomojo turto!");
    return SPD(playerid, 8037, DIALOG_STYLE_LIST, !"Prasymo pildymas", global_str, !"Isrinkti", !"Atsaukti");
}

stock Show_Company(playerid) {

	global_str = " \t \n";

	switch Int_GetPlayerData(playerid,"strahovka1") do {
		case 0: strcat(global_str,"{ffffff}Turto tipas\t[{afafaf}Isrinkti{ffffff}]");
		case 1: strcat(global_str,"{ffffff}Turto tipas\t[{ffff00}Automobilis{ffffff}]");
		case 2: strcat(global_str,"{ffffff}Turto tipas\t[{ffff00}Namas{ffffff}]");
		case 3: strcat(global_str,"{ffffff}Turto tipas\t[{ffff00}Verslas{ffffff}]");
	}

	strcat(global_str,"\nTurto aprasymas\t[");
	switch Int_GetPlayerData(playerid,"strahovka2") do {
