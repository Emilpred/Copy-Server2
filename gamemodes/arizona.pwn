	}
	for(new i;i < sizeof(MotoCP);i ++)
	{
	    if(i < sizeof(MotoCP)-1) MTest_CP[i] = CreateDynamicRaceCP(0,MotoCP[i][0],MotoCP[i][1],MotoCP[i][2],MotoCP[i+1][0],MotoCP[i+1][1],MotoCP[i+1][2],2.0,-1,-1,-1,1000.0);
