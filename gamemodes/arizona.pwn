				else f(global_str, 150,"Jus jau pagaminote: {DC4747}%d{FFFFFF} medziagu ir uzdirbote {DC4747}%d${FFFFFF}.",CreateMatsCount[playerid],CreateMatsCount[playerid] * 1);

