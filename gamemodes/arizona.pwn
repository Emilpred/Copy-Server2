stock PlayerADDVIPSpawn(playerid)
{
    global_str = "";

    strcat(global_str, "{633169}[1] {FFFFFF}Stotis\n");

    new count = 2;

	for new i; i < OWNABLEHOUSES; i++ do
	{
	    if GetString(HouseInfo[i][hOwner], PlayerName[playerid]) *then
	    	strcat(global_str, (str_f("{633169}[%d] {FFFFFF}Namas ¹%d\n", count, HouseInfo[i][hID]))), test1[count - 2] = i, count ++;
	}

	strcat(global_str, (str_f("{633169}[%d] {FFFFFF}Seimos namas / butas\n{633169}[%d] {FFFFFF}Organizacija %s\n{633169}[%d] {FFFFFF}Issaugota vieta (%.02f, %.02f, %.02f)\n{633169}[%d] {FFFFFF}Paskutine isejimo vieta\n{633169}[%d] {FFFFFF}Priekaba", count, count + 1, OrgInfo[PI[playerid][pMember]][oName], count + 2, PI[playerid][pPremiumPos][0], PI[playerid][pPremiumPos][1], PI[playerid][pPremiumPos][2], count + 3, count + 4)));

    return SPD(playerid, 25528, DIALOG_STYLE_LIST, !"Isrinkti spawno vieta", global_str, !"Isrinkti", !"");
}

stock ShowAutoInviteQuestion(playerid, question = 0)
{
    if question == -1 *then
        return SCMF(playerid, COLOR_OLDRED, "[Klaida] {FFFFFF}Deja, jus neteisingai atsake i %d klausima.", AutoInviteAnswer[playerid]+1), AutoInviteAnswer[playerid] = 0;

	else if !(question == -1) && question < sizeof AutoInvite_Questions *then
		return SPDF(playerid, 8024, DIALOG_STYLE_LIST, (str_f("%s", AutoInvite_Questions[question][aiText])), "%s", !"Isrinkti", !"Atsaukti", AutoInvite_Questions[question][aiAnswers]);

	else if !(question == -1) && question >= sizeof AutoInvite_Questions *then
		return AutoInviteAnswer[playerid] = 0, AutoInvite_Orgs(playerid);

	return false;
}

stock AutoInvite_Orgs(playerid)
{
	global_str = "{FDCF28}Organizacija\t{FDCF28}Statusas";

    for(new i = 1; i < MAX_ORGS; i++) strcat(global_str, (str_f("\n{FFFFFF}%s\t%s\n", OrgInfo[i][oName], OrgInfo[i][oAutoInvite] ? (str_f("{00FF00}[pasiekiama, %d rang]", OrgInfo[i][oAutoRank])) : "{ff6347}[neprieinama]")));

    return SPD(playerid, 8023, DIALOG_STYLE_TABLIST_HEADERS, "Isrinkti organizacija", global_str, "Toliau", "Uzdaryti");
}

