	}
	return 1;
}
stock StartRace(playerid, type)
{
	new r = pTemp[playerid][TruckScore];
	pTemp[playerid][TruckType] = type;
	TruckTime{playerid} = 0;
	SetPVarInt(playerid, "TruckTimer", 1);
	SCM(playerid, COLOR_GREEN, "Jus prijungete krovini. Dabar vaziuokite i sandeli pagal CheckPoints, laikydamiesi keliu eismo taisykliu.");
	switch(type)
	{
		case 1: SetPlayerRaceCheckpoint(playerid, 1, RaceLSDil[r][0], RaceLSDil[r][1], RaceLSDil[r][2], RaceLSDil[r][0], RaceLSDil[r][1], RaceLSDil[r][2], 4.0);
	    case 2: SetPlayerRaceCheckpoint(playerid, 1, RaceLSAngel[r][0], RaceLSAngel[r][1], RaceLSAngel[r][2], RaceLSAngel[r][0], RaceLSAngel[r][1], RaceLSAngel[r][2], 4.0);
	    case 3: SetPlayerRaceCheckpoint(playerid, 1, RaceSFAngel[r][0], RaceSFAngel[r][1], RaceSFAngel[r][2], RaceSFAngel[r][0], RaceSFAngel[r][1], RaceSFAngel[r][2], 4.0);
	    case 4: SetPlayerRaceCheckpoint(playerid, 1, RaceSFLV[r][0], RaceSFLV[r][1], RaceSFLV[r][2], RaceSFLV[r][0], RaceSFLV[r][1], RaceSFLV[r][2], 4.0);
	    case 5: SetPlayerRaceCheckpoint(playerid, 1, RaceLVLV[r][0], RaceLVLV[r][1], RaceLVLV[r][2], RaceLVLV[r][0], RaceLVLV[r][1], RaceLVLV[r][2], 4.0);
	    case 6: SetPlayerRaceCheckpoint(playerid, 1, RaceLVDil[r][0], RaceLVDil[r][1], RaceLVDil[r][2], RaceLVDil[r][0], RaceLVDil[r][1], RaceLVDil[r][2], 4.0);
	}
}
stock GiveTruckZP(playerid)
{
	new car, gruz, zp, zp1, zp2, random_int = random(20)+1;
	switch(GetVehicleModel(TruckCar[playerid]))
	{
	    case 403: car = 4000;
	    case 514: car = 7000;
	    case 515: car = 10000;
	}
	switch(GetVehicleModel(TruckGruz[playerid]))
	{
	    case 584: gruz = 9000;
	    case 591: gruz = 7000;
	    case 435: gruz = 5000;
	}
	if(GetPVarInt(playerid, "VesiOn")) zp = car + gruz;
	else
	{
		zp1 = car + gruz;
		zp2 = (zp1/100)*20;
		zp = zp1 - zp2;
	}
	switch random_int do
	{
	    case 0..50: AddItem(playerid, 2208, randomF(1, 5));
	}
 	if(GetVehicleModel(TruckGruz[playerid]) == 584) f(global_str, sizeof(global_str), "Kuras sekmingai pristatytas! Jusu atlyginimas uz reisa: $%d.", zp);
	else if(GetVehicleModel(TruckGruz[playerid]) == 591) f(global_str, sizeof(global_str), "Medziagos sekmingai pristatytos! Jusu atlyginimas uz reisa: $%d.", zp);
	else if(GetVehicleModel(TruckGruz[playerid]) == 435) f(global_str, sizeof(global_str), "Produktai sekmingai pristatyti! Jusu atlyginimas uz reisa: $%d.", zp);
	SCM(playerid, COLOR_GREEN, global_str);
    //AddItem(playerid, 2308, zp);
	GiveMoney(playerid, zp);
    if(!GetPVarInt(playerid, "VesiOn")) SendError(playerid, "-20 procentu nuo atlyginimo uz svorio patikros praleidima!");
    if(IsPlayerInRangeOfPoint(playerid, 15, 809.8669, -605.8204, 16.3359 )) EnableGPSForPlayer(playerid, 2222.5161,-2660.6062,13.5469);
    else if(IsPlayerInRangeOfPoint(playerid, 15, -2119.9375, -2284.9773, 30.6467 )) EnableGPSForPlayer(playerid, -2258.4177,284.6024,35.3203);
    else if(IsPlayerInRangeOfPoint(playerid, 15, -313.5211,2676.1467,62.6126 )) EnableGPSForPlayer(playerid, 1387.8281,1139.6571,10.8203);
	SCM(playerid, COLOR_GREY, "[Uzuomina]{ffffff} Zemelapyje nustatyta zyme ant artimiausios sunkvezimiu vairuotoju bazes, kurioje galima gauti kita krovini.");
    SetPVarInt(playerid, "TruckStart", 0);
    DestroyVehicle(TruckGruz[playerid]);
	TruckGruz[playerid] = 0;
	pTemp[playerid][TruckScore] = 0;
	pTemp[playerid][TruckType] = 0;
	PI[playerid][pTruckSkill]++;
 	f(global_str, sizeof(global_str), "UPDATE `accounts` SET `TruckSkill` = '%d' WHERE `id` = '%d'", PI[playerid][pTruckSkill], PI[playerid][pID]);
    mysql_tquery(mysql, global_str);

	return 1;
}
public OnPlayerAttachTrailer(playerid,vehicleid,trailerid)
{
	if(vehicleid == TruckCar[playerid] && trailerid == TruckGruz[playerid])
	{
		if(GetPVarInt(playerid, "TruckStart")) return SetRace(playerid, pTemp[playerid][TruckType]);
		else
		{
		    SetPVarInt(playerid, "TruckStart", 1);
		    pTemp[playerid][TruckScore] = 0;
		    switch(pTemp[playerid][TruckCuty])
			{
			    case 1:
			    {
			        switch(random(2))
			        {
			            case 0: StartRace(playerid, 1);
			            case 1: StartRace(playerid, 2);
			        }
			    }
			    case 2:
			    {
                    switch(random(2))
			        {
			            case 0: StartRace(playerid, 3);
			            case 1: StartRace(playerid, 4);
			        }
			    }
			    case 3:
			    {
                    switch(random(2))
			        {
			            case 0: StartRace(playerid, 5);
			            case 1: StartRace(playerid, 6);
			        }
			    }
			}
		}
	}
	else if(trailerid == Trailer[playerid]) return 1;
	else
	{
	    SendError(playerid, "Jus prijungete ne savo priekaba, arba esate ne savo sunkvezimyje!");
	    SetPVarInt(playerid, "TruckTimer", 0);
	}
	return 1;
}

public OnPlayerDeattachTrailer(playerid,vehicleid,trailerid)
{
    if(vehicleid == TruckCar[playerid] && trailerid == TruckGruz[playerid])
	{
		SendError(playerid, "Jus atjungete priekaba, prijunkite ja atgal!");
	    SetPVarInt(playerid, "TruckTimer", 0);
	}
    return 1;
}

stock SearchItemAttach(itemid)
{
	for(new id; id < sizeof Attach; id++)
		if(Attach[id][attachItem] == itemid)
			return id;

	return -1;
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	new type = EditType[playerid], id = SearchItemAttach(modelid);

    switch(response)
	{
		case EDIT_RESPONSE_CANCEL:
		{
  			switch(type)
		    {
          		case 1:
          		{
                	DeletePlayerAccessory(playerid, boneSlot[playerid]);
                	RemovePlayerAttachedObject(playerid, Attach[id][attachBone]);
			    }
			}
		}

		case EDIT_RESPONSE_FINAL:
		{
			switch(type)
			{
			    case 1:
			    {
			        if(fScaleX > Attach[id][attachScale][0]+0.4 || fScaleY > Attach[id][attachScale][1]+0.6 || fScaleZ > Attach[id][attachScale][2]+0.5)
					{
                        DeletePlayerAccessory(playerid, boneSlot[playerid]);
                        RemovePlayerAttachedObject(playerid, Attach[id][attachBone]);

	            		return SCM(playerid, COLOR_RED, !"[Klaida] {ffffff}Aksesuaro matmenys per dideli, padarykite objekta mazesni!");
					}

					SPD(playerid, 26026, DIALOG_STYLE_MSGBOX, !"{bfbbba}Patvirtinimas", "{ffffff}Mes fiksuojame naujas jusu aksesuaru pozicijas, reikalingas jusu patvirtinimas.\n\nPo patvirtinimo pozicijos bus issaugotos ir is jusu bus nurasyta {33aa33}$500.000!", !"Atlikta", !"Atgal");

					Bone[playerid][boneSlot[playerid]][attachOffset][0] = fOffsetX;
					Bone[playerid][boneSlot[playerid]][attachOffset][1] = fOffsetY;
					Bone[playerid][boneSlot[playerid]][attachOffset][2] = fOffsetZ;

					Bone[playerid][boneSlot[playerid]][attachRotation][0] = fRotX;
					Bone[playerid][boneSlot[playerid]][attachRotation][1] = fRotY;
					Bone[playerid][boneSlot[playerid]][attachRotation][2] = fRotZ;

					Bone[playerid][boneSlot[playerid]][attachScale][0] = fScaleX;
					Bone[playerid][boneSlot[playerid]][attachScale][1] = fScaleY;
					Bone[playerid][boneSlot[playerid]][attachScale][2] = fScaleZ;

					FinalRedact[playerid] = boneid;
				}
			}
		}
	}
	return 1;
}

stock ShowObmen(playerid)
{
	if(obmenOpen{playerid}) return 1;
    if(InventoryOpen{playerid}) HideInvent(playerid);
    #include ../library/td/obmen
    TransleteObmenText(playerid);
	for(new i; i < 57; i++) PlayerTextDrawShow(playerid, ObmenTD[playerid][i]);
    obmenOpen{playerid} = true;
	return SelectTextDraw(playerid, 0xFFFFFFAA);
}
stock TransleteObmenText(playerid)
{
    if(PI[playerid][pLanguage])
    {
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][4], FixText("UZDARYTI MAINUS"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][5], ObInfo[PI[playerid][pIDObmen]][obID] != playerid ? FixText("LAUKIAMA_PATVIRTINIMO") : FixText("PATVIRTINTI_MAINUS"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][7], ObInfo[PI[playerid][pIDObmen]][obID] == playerid ? FixText("LAUKIAMA_PATVIRTINIMO") : FixText("PATVIRTINTI_MAINUS"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][10], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][14], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][18], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][22], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][26], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][30], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][34], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][38], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][42], FixText("PRIDETI"));
        PlayerTextDrawSetString(playerid,ObmenTD[playerid][46], FixText("PRIDETI"));
    }
}
stock ResetObmen(id)
{
    if(IsPlayerTextDrawVisible(ObInfo[id][obPlayer], ObmenTD[ObInfo[id][obPlayer]][0])) HideObmen(ObInfo[id][obPlayer]);
    if(IsPlayerTextDrawVisible(ObInfo[id][obID], ObmenTD[ObInfo[id][obID]][0])) HideObmen(ObInfo[id][obID]);
    PI[ObInfo[id][obID]][pIDObmen] = -1;
    PI[ObInfo[id][obPlayer]][pIDObmen] = -1;
    UpdateDynamic3DTextLabelText(ObInfo[id][ob3DText], 0xFFFFFFFFFFFF00FF, "Pradeti turto mainus\n\n{ffffff}Naudokite: 'Veiksma'");
    for(new i; i < 10; i++)
    {
        ObInfo[id][obItem][i] = 0;
        ObInfo[id][obType][i] = 0;
        ObInfo[id][obSlot][i] = 0;
        ObInfo[id][obSharpening][i] = 0;
        ObInfo[id][obMending][i] = 0;
        ObInfo[id][obColor][i] = 0;
        ObInfo[id][obNashivka][i] = 0;
    }
    ObInfo[id][obTime] = -1;
    ObInfo[id][obAccept][0] = 0;
    ObInfo[id][obAccept][1] = 0;
    ObInfo[id][obID] = -1;
    ObInfo[id][obPlayer] = -1;
    return true;
}
stock HideObmen(playerid)
{
	if(!obmenOpen{playerid}) return 1;
	for(new i; i < 57; i++) DestroyPlayerTD(playerid, ObmenTD[playerid][i]);
    obmenOpen{playerid} = false;
	return CancelSelectTextDraw(playerid);
}
stock ChangeTDObmen(playerid, slot, type)
{
    new id = PI[playerid][pIDObmen], fix, item, check[2];
    static const IDkv[][4] = { {11, 10, 9, 8}, {15, 14, 13, 12}, {19, 18, 17, 16}, {23, 22, 21, 20}, {27, 26, 25, 24}, {31, 30, 29, 28}, {35, 34, 33, 32}, {39, 38, 37, 36},{43, 42, 41, 40}, {47, 46, 45, 44}};
    static text[30], text2[5];
    if(!type)
    {
        f(text2, sizeof(text2), "$");
        f(text, sizeof(text), "$%i", ObInfo[id][obItem][slot]);
        item = ObInfo[id][obItem][slot];
    }
    else if(type == 1)
    {
        switch(ObInfo[id][obType][slot])
        {
            case 2: f(text, sizeof(text), "HouseID: %i", ObInfo[id][obItem][slot]), item = 1273;
            case 3: f(text, sizeof(text), "BizID: %i", ObInfo[id][obItem][slot]), item = 1274;
            case 5: f(text, sizeof(text), "%s", GetVehicleName(ObInfo[id][obItem][slot])), item = GetVehicleModelEx(ObInfo[id][obItem][slot]);
            case 6:
            {
                f(text, sizeof(text), "TrailerID: %i", ObInfo[id][obItem][slot]);
                switch(TrailerInfo[ObInfo[id][obItem][slot]][tType]) { case 1: item = 3171; case 2: item = 3168; case 3: item = 3172; }
            }
        }
        text2[0] = EOS;
        PlayerTextDrawSetPreviewModel(playerid, ObmenTD[playerid][IDkv[slot][3]], item );
        PlayerTextDrawShow(playerid, ObmenTD[playerid][IDkv[slot][3]]);
    }
    else if(type == 2)
    {
        item = ObInfo[id][obItem][slot] = 0;
        ObInfo[id][obType][slot] = 0;
        ObInfo[id][obSlot][slot] = 0;
        ObInfo[id][obSharpening][slot] = 0;
        ObInfo[id][obMending][slot] = 0;
        ObInfo[id][obColor][slot] = 0;
        ObInfo[id][obNashivka][slot] = 0;
        text2 = "+", text = "ADD";
        PlayerTextDrawSetPreviewModel(playerid, ObmenTD[playerid][IDkv[slot][3]], 19482);
        PlayerTextDrawShow(playerid, ObmenTD[playerid][IDkv[slot][3]]);
    }
    if(ObInfo[id][obPlayer] == playerid) check[1] = ObInfo[id][obID], check[0] = ObInfo[id][obPlayer];
    else check[1] = ObInfo[id][obPlayer], check[0] = ObInfo[id][obID];
    PlayerTextDrawSetSelectable(check[0], ObmenTD[check[0]][IDkv[slot][3]], 1);
    PlayerTextDrawSetSelectable(check[1], ObmenTD[check[1]][IDkv[slot][3]], item ? 1 : 0);
    PlayerTextDrawShow(check[1], ObmenTD[check[1]][IDkv[slot][3]]);
    PlayerTextDrawShow(check[0], ObmenTD[check[0]][IDkv[slot][3]]);
    PlayerTextDrawSetString(playerid, ObmenTD[playerid][IDkv[slot][0]], text2);
    PlayerTextDrawShow(playerid, ObmenTD[playerid][IDkv[slot][0]]);
    PlayerTextDrawSetString(playerid, ObmenTD[playerid][IDkv[slot][1]], fix ? FixText(text) : text);
    PlayerTextDrawShow(playerid, ObmenTD[playerid][IDkv[slot][1]]);
    PlayerTextDrawColor(playerid, ObmenTD[playerid][IDkv[slot][2]], item ? -1523963137 : 1010580735);
    PlayerTextDrawShow(playerid, ObmenTD[playerid][IDkv[slot][2]]);
    return 1;
}
stock CheckObmen(playerid, type)
{
    new id = PI[playerid][pIDObmen];
    for(new i; i < 10; i++)
    {
        if(ObInfo[id][obPlayer] == playerid && i < 5 && ObInfo[id][obType][i] == type) return 1;
        else if(ObInfo[id][obID] == playerid && i > 4 && ObInfo[id][obType][i] == type) return 1;
    }
    return 0;
}

stock SuccefulObmen(playerid, id, type, i)
{
    switch(ObInfo[type][obType][i])
    {
        case 1:
        {
            GiveMoney(playerid, -ObInfo[type][obItem][i]);
            GiveMoney(id, ObInfo[type][obItem][i]);
        }
        case 2:
        {
            HouseInfo[ObInfo[type][obItem][i]][hNalog] = 0;
            HouseInfo[ObInfo[type][obItem][i]][hNalog2] = 0;
            SetString(HouseInfo[ObInfo[type][obItem][i]][hOwner], PN(id));
            SQL("UPDATE `houses` SET `Owner` = '%s' WHERE `ID` = '%d'", HouseInfo[ObInfo[type][obItem][i]][hOwner], HouseInfo[ObInfo[type][obItem][i]][hID]);
            UpdateHouse(ObInfo[type][obItem][i]);
            ResetHouse(ObInfo[type][obItem][i]);
        }
        case 3:
        {
            BizData[ObInfo[type][obItem][i]][bLevel] = 0;
            SetString(BizData[ObInfo[type][obItem][i]][bOwner], PN(id));
            SQL("UPDATE `businesses` SET `Owner` = '%s' WHERE `ID` = '%d'", BizData[ObInfo[type][obItem][i]][bOwner], BizData[ObInfo[type][obItem][i]][bID]);
            UpdateBusinessText(ObInfo[type][obItem][i], 1);
        }
        case 5:
        {
            global_str[0] = EOS;
            PI[id][pTrailer] = ObInfo[type][obItem][i]; PI[playerid][pTrailerKey] = -1;
            UpdatePlayerDataInt(playerid, "Trailer", PI[playerid][pTrailerKey]);
            UpdatePlayerDataInt(id, "Trailer", PI[id][pTrailerKey]);
            SetString(TrailerInfo[ObInfo[type][obItem][i]][tOwner], PN(id));
            format(global_str, 300, "Priekaba {ffffff}¹%d\n{ff9966}Savininkas: {ffffff}%s\n{ff9966}Durys %s\n\n{ff9966}[ {ffffff}ALT {ff9966}]", ObInfo[type][obItem][i], TrailerInfo[ObInfo[type][obItem][i]][tOwner], TrailerInfo[ObInfo[type][obItem][i]][tLocks] ? ("{b3ff66}atrakintos") : ("{ff704d}uzrakintos"));
            Update3DTextLabelText(TrailerInfo[ObInfo[type][obItem][i]][tLabel], 0xFF9966FF, global_str), SaveTrailer(ObInfo[type][obItem][i]);
        }
    }
    return 1;
}

stock IsAPokrasItem(itemid)
{
	if(TextFind(ItemsInfo[itemid][ItemName], "Aksesuaras") && ItemsInfo[itemid][ItemColorAks] == -1) return 1;
	else if(itemid == 1130) return 1;
	else if(itemid == 2739) return 1;
	return 0;
}

stock UpdateColorSlot(playerid)
{
	if(ItemChangeColor[playerid][0] && ItemChangeColor[playerid][1] && ItemChangeColor[playerid][2] >= 7)
	{
		if(!InfoChanColor[playerid])
		{
			#include textdraws/cataloges/infochangecolor2
			PlayerTextDrawSetStringf(playerid, InfColorChange[playerid][2], "%d BTC", BizData[BizEntered[playerid]][bItem][2]);
			for(new k; k < 6; k++) PlayerTextDrawShow(playerid, InfColorChange[playerid][k]);
			InfoChanColor[playerid] = true;
		}
		PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][13],1);
		PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][13]);
	}
	return 1;
}

stock ResetPokras(playerid)
{
	Inventory[playerid][1][SlotChangeColor[playerid][2]] -= 7;
	Inventory[playerid][1][SlotChangeColor[playerid][1]] -= 1;

	for(new s; s < 3; s++)
	{
		InventSlotUse[playerid][SlotChangeColor[playerid][s]] = false,
		ItemChangeColor[playerid][s] = 0;
		InvSlotUpdate(playerid, SCC[playerid][s], SlotChangeColor[playerid][s]);
	}

	PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][25], "%d/7", ItemChangeColor[playerid][2]);
	PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][24], ItemChangeColor[playerid][2] >= 7 ? -1 : -1717986817);
	PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][24], 0);
	PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][24]);

	PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][28], "%d/1", ItemChangeColor[playerid][1]);
	PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][27], -1717986817);
	PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][27], ItemChangeColor[playerid][1] ? 1 : 0);
	PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][27]);

	PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][26], 0);
	PlayerTextDrawSetPreviewModel(playerid, ChangeColor_PTD[playerid][26], 1649);
	PlayerTextDrawSetPreviewRot(playerid, ChangeColor_PTD[playerid][26], 0.000,  0.000,  90.00,  2.0);
	PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][26]);

    if InfoChanColor[playerid] *then
    {
		for(new k; k < 6; k++) DestroyPlayerTD(playerid, InfColorChange[playerid][k]);
		InfoChanColor[playerid] = false;
	}

	SetPVarInt(playerid, "idcolorchange", 0);

	if(IsPlayerTextDrawVisible(playerid, ChangeColor_A[playerid])) DestroyPlayerTD(playerid, ChangeColor_A[playerid]);
}

stock IsKonflictItem(itemid)
{
	switch itemid do
	{
		case 1447,2411,2412,953..957,1438,1448..1456,1441,1442,1457,1458,1459,1460,1464..1472: return true;
	}
	return false;
}
