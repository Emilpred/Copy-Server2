			                f(global_str, sizeof(global_str), "{E06C1F}Autobusas\n{E06C1F}Reisas: {73B461}%s\n{E06C1F}Vaziavimo kaina: {73B461}%d$",Vehs[getcar][vName],Vehs[getcar][vCena]);
							UpdateDynamic3DTextLabelText(AutobCarText[getcar], 0xFFFFFFFF, global_str);
			                SetPlayerRaceCheckpoint(playerid,BusLvvv[0][BUSSTATION7],BusLvvv[0][BUS_COORD7][0],BusLvvv[0][BUS_COORD7][1],BusLvvv[0][BUS_COORD7][2],BusLvvv[1][BUS_COORD7][0],BusLvvv[1][BUS_COORD7][1],BusLvvv[1][BUS_COORD7][2],10.0);
		                }
		                case 7:
		                {
		                    Vehs[playerid][vReis] = 8;
			                strmid(Vehs[getcar][vName],"LS Stotis -> Jefferson -> SF Stotis -> Vairavimo mokykla",0,strlen("LS Stotis -> Jefferson -> SF Stotis -> Vairavimo mokykla"),50);
			                f(global_str, sizeof(global_str), "{E06C1F}Autobusas\n{E06C1F}Reisas: {73B461}%s\n{E06C1F}Vaziavimo kaina: {73B461}%d$",Vehs[getcar][vName],Vehs[getcar][vCena]);
							UpdateDynamic3DTextLabelText(AutobCarText[getcar], 0xFFFFFFFF, global_str);
			                SetPlayerRaceCheckpoint(playerid,bussf[0][BUSSTATION8],bussf[0][BUS_COORD8][0],bussf[0][BUS_COORD8][1],bussf[0][BUS_COORD8][2],bussf[1][BUS_COORD8][0],bussf[1][BUS_COORD8][1],bussf[1][BUS_COORD8][2],10.0);
		                }
		                case 8:
		                {
		                    Vehs[playerid][vReis] = 9;
			                strmid(Vehs[getcar][vName],"LV Stotis -> Casino -> Fort Carson -> SF Stotis",0,strlen("LV Stotis -> Casino -> Fort Carson -> SF Stotis"),50);
			                f(global_str, sizeof(global_str), "{E06C1F}Autobusas\n{E06C1F}Reisas: {73B461}%s\n{E06C1F}Vaziavimo kaina: {73B461}%d$",Vehs[getcar][vName],Vehs[getcar][vCena]);
							UpdateDynamic3DTextLabelText(AutobCarText[getcar], 0xFFFFFFFF, global_str);
			                SetPlayerRaceCheckpoint(playerid,buslvsf[0][BUSSTATION9],buslvsf[0][BUS_COORD9][0],buslvsf[0][BUS_COORD9][1],buslvsf[0][BUS_COORD9][2],buslvsf[1][BUS_COORD9][0],buslvsf[1][BUS_COORD9][1],buslvsf[1][BUS_COORD9][2],10.0);
		                }
		                case 9:
		                {
		                    Vehs[playerid][vReis] = 10;
			                strmid(Vehs[getcar][vName],"Miesto SF",0,strlen("Miesto SF"),50);
			                f(global_str, sizeof(global_str), "{E06C1F}Autobusas\n{E06C1F}Reisas: {73B461}%s\n{E06C1F}Vaziavimo kaina: {73B461}%d$",Vehs[getcar][vName],Vehs[getcar][vCena]);
							UpdateDynamic3DTextLabelText(AutobCarText[getcar], 0xFFFFFFFF, global_str);
			                SetPlayerRaceCheckpoint(playerid,bussfsf[0][BUSSTATION10],bussfsf[0][BUS_COORD10][0],bussfsf[0][BUS_COORD10][1],bussfsf[0][BUS_COORD10][2],bussfsf[1][BUS_COORD10][0],bussfsf[1][BUS_COORD10][1],bussfsf[1][BUS_COORD10][2],10.0);
		                }
		                case 10:
		                {
		                    Vehs[playerid][vReis] = 11;
			                strmid(Vehs[getcar][vName],"SF Stotis -> Ukis -> RCPD -> Gamykla",0,strlen("SF Stotis -> Ukis -> RCPD -> Gamykla"),50);
			                f(global_str, sizeof(global_str), "{E06C1F}Autobusas\n{E06C1F}Reisas: {73B461}%s\n{E06C1F}Vaziavimo kaina: {73B461}%d$",Vehs[getcar][vName],Vehs[getcar][vCena]);
							UpdateDynamic3DTextLabelText(AutobCarText[getcar], 0xFFFFFFFF, global_str);
			                SetPlayerRaceCheckpoint(playerid,bussffa[0][BUSSTATION11],bussffa[0][BUS_COORD11][0],bussffa[0][BUS_COORD11][1],bussffa[0][BUS_COORD11][2],bussffa[1][BUS_COORD11][0],bussffa[1][BUS_COORD11][1],bussffa[1][BUS_COORD11][2],10.0);
		                }
		            }
				}
				f(global_str,sizeof(global_str),"Autobuso vairuotojas %s pradejo marsruta %s. Vaziavimo kaina: %d$", PN(playerid), Vehs[getcar][vName],Vehs[getcar][vCena]);
				ProxDetector(25,playerid,global_str,COLOR_PURPLE);
			}
	    }
	    case RABOTABUS+4:
	    {
	        if(response)
	        {
         		if(GetPlayerVehicleID(playerid) == pTemp[playerid][pArendaCar]) return endrabavt(playerid);
	        }
	    }
	    case RABOTABUS+5:
	    {
	        if(response)
	        {
	            if(rabden[playerid] == 1) SPD(playerid,RABOTABUS+2,DIALOG_STYLE_INPUT,"Kaina","Vaziavimo kaina ( nuo 0$ iki 100$ )","Atlikta", !"Atsaukti");
				else endrabavt(playerid);
	        }
	    }
	}
	return 1;
}

stock IsAGameNick(name[])
{
	for(new i;i < strlen(name);i ++)
	{
		switch(name[i])
		{
		    case 'a'..'z', 'A'..'Z', '0'..'9', '.', '_', '[', ']', '(', ')', '$', '@', '-': continue;
		}
	}
	return 1;
}
stock UpdateDorm(dormid)
{
	new allzone = 0, narkoz=0;
	static urik[30]; urik = "";
	if(OrgInfo[dormid][oOb4ak] == 1) urik="{A92424}Uzrakintas{FFFFFF}";
	if(!OrgInfo[dormid][oOb4ak]) urik="{3FA924}Atrakintas{FFFFFF}";

	if((dormid>=11 && dormid<=15) || dormid == 25)
	{
        for(new d = 1; d < GANGZONES; d++)
		{
			if(GZInfo[d][gzFracID] == dormid)
			{
				allzone++;
				if (d == 33)narkoz++;
				if (d == 43)narkoz++;
				if (d == 10)narkoz++;
				if (d == 14)narkoz++;
				if (d == 24)narkoz++;
			}
		}
		f(global_str, 500,"Teritoriju\nKiekis: {FAAC58}%d{FFFFFF}\nNarkotiku landynes: {FAAC58}%d{FFFFFF}\n\nSandelis %s\n{FAAC58}%s{FFFFFF}\n\nNarkotiku: {FAAC58}%d g{FFFFFF}\nSoviniai: {FAAC58}%d vnt{FFFFFF}\nKanistros: {FAAC58}%d vnt{FFFFFF}\nInstrumentai: {FAAC58}%d vnt{FFFFFF}\nKaukes: {FAAC58}%d vnt{FFFFFF}\n",allzone,narkoz,urik,OrgInfo[dormid][oName],OrgInfo[dormid][oDrugs],OrgInfo[dormid][oMats],OrgInfo[dormid][oBenz],OrgInfo[dormid][oRemont],OrgInfo[dormid][oMask]);
	}
	else
	{
	    for(new bizid;bizid < MAX_BIZ;bizid++)
		{
		    if(BizData[bizid][bKrasher] != dormid || strcmp(BizData[bizid][bOwner],"The State",true) == 0 ) continue;
			allzone++;
		}
		f(global_str, 500,"Verslu\nKiekis {FAAC58}%d{FFFFFF}\n\nSandelis %s\n{FAAC58}%s{FFFFFF}\n\nNarkotiku: {FAAC58}%d g{FFFFFF}\nSoviniai: {FAAC58}%d vnt{FFFFFF}\nKanistros: {FAAC58}%d vnt{FFFFFF}\nInstrumentai: {FAAC58}%d vnt{FFFFFF}\nKaukes: {FAAC58}%d vnt{FFFFFF}",allzone,urik,OrgInfo[dormid][oName],OrgInfo[dormid][oDrugs],OrgInfo[dormid][oMats],OrgInfo[dormid][oBenz],OrgInfo[dormid][oRemont],OrgInfo[dormid][oMask]);
	}
	UpdateDynamic3DTextLabelText(DormText[dormid],COLOR_WHITE,global_str);
	return 1;
}

stock PlayerUnleader(playerid = INVALID_PLAYER_ID, Name[] = "None")
{
	if(playerid != INVALID_PLAYER_ID)
	{
	    if(IsACop(playerid))
		{
			if(UsingShield{playerid})RemovePlayerAttachedObject(playerid, 7);
			PI[playerid][pShield] = 0.0;
		}
  		PI[playerid][pLeader] = 0;
	    PI[playerid][pMember] = 0;
	    PI[playerid][pDCTime]=0;
	    SCM(playerid, COLOR_WHITE, !">> {FF6347} Spawno vieta automatiskai nustatyta Gelezinkelio stotyje. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");
	    PI[playerid][pRank] = 0;
	    SetBumSkin(playerid);
	    PlayerJob[playerid] = 0;
	    SetPlayerColor(playerid,TeamColors[0]);
	    ResetSpawnInfo(playerid, 0);
	    SaveAccount(playerid);
	    SCM(playerid,COLOR_LIGHTBLUE,"Jus buvote nusalintas nuo savo pareigu");
	}
	else
	{
		f(global_str, 144, "UPDATE `accounts` SET `Leader` = '0',`Member` = '0', `Job` = '0',`Rank` = '0' WHERE `NickName` = '%s'",Name);//,`Skin` = '0'
		mysql_tquery(mysql, global_str);
	}
	return 1;
}

new aml_str[512];

stock aml(string[], type, name[], name2[])
{
//	f(aml_str, 1024, "INSERT INTO `%s` (`Text`, `Type`, `NickName1`, `NickName2`) VALUE ('%s', '%d', '%s', '%s')", Mode_Logs, string, type, name, name2), CallRemoteFunction("AddLOG", "s", aml_str);
//	printf("%s", aml_str);
	return 1;
}
/*public: AddLOG(log_string[])
{
	if WRITE_ACTION_SERVER *then {
		mysql_tquery(mysql, log_string);
	}
}*/
public: @CONNECTION_LOG_BASE(unix_time) {

	if WRITE_ACTION_SERVER *then
	{
		new ms = GetTickCount();
		printf("Serverio zurnalai sekmingai prijungti per: %d milisekundziu! Unix_time: (%d)", GetTickCount() - ms, unix_time);
	}
	return LOG_BASE;
}

stock GetPlayerID(name[], type = PLAYER_SEARCH_NAME, data = -1)
{
	foreach (new i: Player)
	{
		switch type do
		{
			case PLAYER_SEARCH_NAME:
			{
				if !strcmp(PlayerName[i], name, false) *then
					return i;
			}

			case PLAYER_SEARCH_PID:
			{
				if PI[i][pID] == data *then
					return i;
			}
		}
	}

	return INVALID_PLAYER_ID;
}

stock GetHouseStyle(houseid)
{
	if(HouseInfo[houseid][hType] == 2) return 32;
	for(new i = 1;i < sizeof(GHSPos);i ++)
	{
	    if(floatcomp(GHSPos[i][0], 0.000000)) continue;
	    if(	floatcomp(HouseInfo[houseid][hExit_X], GHSPos[i][0]) &&
	    	floatcomp(HouseInfo[houseid][hExit_Y], GHSPos[i][1]) &&
	    	floatcomp(HouseInfo[houseid][hExit_Z], GHSPos[i][2])) return i;
	}
	return -1;
}

stock IsValidHouse(id)
{
	if(id < OWNABLEHOUSES && id >= 0) return 1;
	return 0;
}

stock HideFuelTD(playerid)
{
	for(new i; i < 34; i++) DestroyPlayerTD(playerid, FillUp[playerid][i]);
	return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	if _:clickedid == INVALID_TEXT_DRAW *then
	{
		if(KindFuel[playerid] != -1)
	 	{
 			KindFuel[playerid] = -1;
			CountFuel[playerid] = 0.0;
			HideFuelTD(playerid);
			CancelSelectTextDraw(playerid);
		}
        if(Ujahhs[playerid] == 1)
        {
            PI[playerid][pInputCode] = 0;
			CancelSelectTextDraw(playerid);
	        for(new osa = 0; osa < 10; osa++) PlayerTextDrawHide(playerid, security_code_TD[playerid][osa]);
	        return Kick(playerid);
        }
		if !(PhoneOpen[playerid] == -1) *then
			ClosePhoneTD(playerid);

		if AuctionData_player[playerid][p_status_open] *then
			return SelectTextDraw(playerid, 0xA55252FF);

		if Int_GetPlayerData(playerid, "NOclose") *then return
			DeletePVar(playerid, "NOclose"), SelectTextDraw(playerid, PI[playerid][pSelectTD]);

        if(Clother[playerid] != -1 || BuyInt[playerid] != -1 || BuyGuns[playerid] != -1 || Buyitem[playerid] != -1) SelectTextDraw(playerid, -16776961);
		if(Int_GetPlayerData(playerid,"contOPEN")) HideContMenu(playerid);
		if (Int_GetPlayerData(playerid,"StolCard") != -1) SelectTextDraw(playerid,  0xff8c8c00);

		if !(pTemp[playerid][kladID] == -1) && IsPlayerTextDrawVisible(playerid, KladTD[playerid][0]) *then
			SelectTextDraw(playerid, 0xA52A2AFF);

		if Int_GetPlayerData(playerid, "SecondHand_PlayerTime") > Global_Time && SecondHand_Open{playerid} *then
			return SelectTextDraw(playerid, 0xA52A2AFF);

		else if SecondHand_Open{playerid} *then
			return DestroySecondHandTD(playerid);

		else if Int_GetPlayerData(playerid, "AutoDrive") or Int_GetPlayerData(playerid, "RussianBonus") *then
			SelectTextDraw(playerid, 0xA52A2AFF);

		else if FamilyCaptureOpen{playerid} *then
		    return DestroyFamCapture(playerid);

		else if(PI[playerid][pIDObmen] >= 0)
		    ResetObmen(playerid);

		else if BodyguardOpen{playerid} *then
		    CloseBodyguardTextDraw(playerid);

		if InventoryUpdate[playerid] *then return true;
		//
		SystemTextDrawHide(playerid);

		if FamilyOpen{playerid} *then
		{
			if FamilyOpenID[playerid] *then
				ShowFamilyMenu(playerid, true);
			else
				ShowFamilyMenu(playerid, false);
		}

		//
		HideQuickPanel(playerid);
		HideBoomMenu(playerid);

		if IsTextDrawVisibleForPlayer(playerid, BoxEat[0]) *then
			EatBoxHide(playerid);

	  	for(new A; A < 7; A++)
		{
			TextDrawHideForPlayer(playerid, alcodraw1[A]);
			if( A < 5)
			{
				TextDrawHideForPlayer(playerid, alcodraw[A]);
				DestroyPlayerTD(playerid, alcodraw2[playerid][A]);
			}
		}
        if(Gambling[playerid]) SelectTextDraw(playerid, 0xFF9933FF);
        else if(ShowMap[playerid]) TogglePlayerMap(playerid, 0);
		ShowPlayerTD(playerid, debug2[playerid][0]);
	    for(new i; i < 9; i++) DestroyPlayerTD(playerid, pokazmenu[playerid][i]);
		//if(PI[playerid][pInventori] == 1 || PI[playerid][pInventori] == 2) return 1;

	    if(RouletteStarted[playerid] == 1) return SelectTextDraw(playerid, PI[playerid][pSelectTD]);

	    if RouletteOpen{playerid} *then
		{
		    for(new i; i < 43; i++) {
				DestroyPlayerTD(playerid, NewRoulette[playerid][i]);
				if(i < 16){
				DestroyPlayerTD(playerid, KletkiKolvo[playerid][i]);
				DestroyPlayerTD(playerid, NewRouletteKletki[playerid][i]); }
			}
		    RouletteOpen{playerid} = false;

	    }

	    if !GetPlayerLauncher(playerid) *then
		for new i; i < 3; i++ do TextDrawShowForPlayer(playerid, Logotype[i]);

	    ShowLogo(playerid);
	}

	if !IsTextDrawVisibleForPlayer(playerid, clickedid) *then
		return false;

	if Int_GetPlayerData(playerid, "openGetGun") *then
	{
		if clickedid == GetGunTD[2] *then
		{
			new id = selectgun[playerid];
			f(global_str, 150, "\
			{ffffff}Jus isrinkote {ffff00}%s {cccccc}(%s)\n\n\
			{ffffff}Kiekis(soviniai): {ffff00}%d\n\
			{ffffff}Reikalingos medziagos: {ffff00}%d",
			GetGunMas[id][getNameRu],
			GetGunMas[id][getName],
			GetGunMas[id][getAmmo],
			GetGunMas[id][getMaterials]);

			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija", global_str, !"Uzdaryti", !"");
		}
		else if clickedid == GetGunTD[3] *then
			return CloseGetGunOrg(playerid);

		else if clickedid == GetGunTD[5] *then
			return TakeGetGunOrg(playerid);

		else if clickedid == GetGunTD[8] || clickedid == GetGunTD[9] *then
		{
			if clickedid == GetGunTD[8] *then { if !selectgun[playerid] *then return PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0); }
			else if clickedid == GetGunTD[9] *then { if selectgun[playerid]+1 >= sizeof(GetGunMas) *then return PlayerPlaySound(playerid, 1085, 0.0, 0.0, 0.0); }

			selectgun[playerid] += clickedid == GetGunTD[9] ? 1:-1;
			UpdateGetGunOrg(playerid, selectgun[playerid]);
			return false;
		}
	}

	if(clickedid == Bandito[3])
	{
	    if(Gambling[playerid] == 1)
        {
            Bet[playerid] = GetNextValidBet(Bet[playerid]);
            UpdateBetText(playerid);
        }
        return 1;
	}
	if(clickedid == Bandito[2])
	{
	    if(Gambling[playerid] == 1)
        {
			Bet[playerid] = GetNextValidMBet(Bet[playerid]);
		 	UpdateBetText(playerid);
		}
		return 1;
	}
	if(clickedid == Bandito[8])
	{
	    if(Gambling[playerid] == 1) return ExitPlayerFromSlotMachine(playerid);
	}
	if(clickedid == Bandito[6])
	{
	    if(Gambling[playerid] == 1)
        {
            new money = PI[playerid][pMoney];
            if(Bet[playerid] > money + Balance[playerid]) return GameTextForPlayer(playerid, "~r~You don't have enough money!",5000,4);
            if(Balance[playerid] - Bet[playerid] < 0) return GameTextForPlayer(playerid, "~r~Your balance is too low!",5000,4);
            SeccureAnimation(playerid, "CASINO", "Slot_Plyr");
            SlotCounter[playerid] = 30+random(18);
        	SlotTimer[playerid] = CallTimeOutFunction("Gambler",100,1,"d",playerid);
        	Gambling[playerid] = 2;
            Balance[playerid]-=Bet[playerid];
            new prefix[4];
            if(Balance[playerid] == 0) strcat(prefix,"~y~");
            if(Balance[playerid]  > 0) strcat(prefix,"~g~");
            if(Balance[playerid]  < 0) strcat(prefix,"~r~");
			UpdateBetText(playerid);
        }
        return 1;
	}

  	new biz = BizEntered[playerid];
	if(biz == -1) biz = 51;
	new Float:Health;
	GetPlayerHealth(playerid,Health);
    if(clickedid == alcodraw[0])
	{
	    if(J_GetPlayerDrunkLevel(playerid) >= 3000) return SendBotMessage(playerid,"O, kaip tu prisigerei, as tau neparduosiu, ir nesiklausinek!");
	    if(HouseEntered[playerid] == -1)
	    {
        	if(PI[playerid][pMoney] < BizData[biz][bItem][0]) return SendBotMessage(playerid,"Atsiprasome, bet neturite pakankamai pinigu!");
        	if(biz != -1) GiveBizMoney(biz,BizData[biz][bItem][0]);
        	GiveMoney(playerid, -BizData[biz][bItem][0]);
		}
		else
		{
		    if(HouseInfo[HouseEntered[playerid]][hNoOwner] < 1)return SCM(playerid,COLOR_RED,!"[Klaida] {FFFFFF}Produktu truksta, juos galite nusipirkti bet kurioje uzkandineje!");
		    HouseInfo[HouseEntered[playerid]][hNoOwner]-=1;
		}
        SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DRINK_SPRUNK);
        if(Health <= 95.0) UpdatePlayerHealth(playerid,Health+5);
        else UpdatePlayerHealth(playerid,100);
        SendBarBot(playerid);
        return 1;
    }
	if(clickedid == alcodraw[1])
	{
	    if(J_GetPlayerDrunkLevel(playerid) >= 3000) return SendBotMessage(playerid,"O, kaip tu prisigerei, as tau neparduosiu, ir nesiklausinek!");
	    if(HouseEntered[playerid] == -1)
	    {
		    if(PI[playerid][pMoney] < BizData[biz][bItem][1]) return SendBotMessage(playerid,"Atsiprasome, bet neturite pakankamai pinigu!");
		    if(biz != -1)
			{
			    if(BizData[biz][bProducts]<5)return SendBotMessage(playerid,"Atsiprasome, bet mums baigesi produktai!");
				GiveBizMoney(biz,BizData[biz][bItem][1]);
				BizData[biz][bProducts]-=5;
			}
			GiveMoney(playerid, -BizData[biz][bItem][1]);
		}
		else
		{
		    if(HouseInfo[HouseEntered[playerid]][hNoOwner] < 5)return SCM(playerid,COLOR_RED,!"[Klaida] {FFFFFF}Produktu truksta, juos galite nusipirkti bet kurioje uzkandineje!");
		    HouseInfo[HouseEntered[playerid]][hNoOwner]-=5;
		}
        SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DRINK_WINE);
        J_SetPlayerDrunkLevel(playerid,J_GetPlayerDrunkLevel(playerid) + 300);
        if(Health <= 70.0) UpdatePlayerHealth(playerid,Health+30);
        else UpdatePlayerHealth(playerid,100);
        SendBarBot(playerid);
        return 1;
	}
	if(clickedid == alcodraw[2])
	{
	    if(J_GetPlayerDrunkLevel(playerid) >= 3000) return SendBotMessage(playerid,"O, kaip tu prisigerei, as tau neparduosiu, ir nesiklausinek!");
	    if(HouseEntered[playerid] == -1)
	    {
   	 		if(PI[playerid][pMoney] < BizData[biz][bItem][2])return SendBotMessage(playerid,"Atsiprasome, bet neturite pakankamai pinigu!");
   	 		if(biz != -1)
			{
			    if(BizData[biz][bProducts]<7)return SendBotMessage(playerid,"Atsiprasome, bet mums baigesi produktai!");
				GiveBizMoney(biz,BizData[biz][bItem][2]);
				BizData[biz][bProducts]-=7;
			}
			GiveMoney(playerid, -BizData[biz][bItem][2]);
		}
		else
		{
		    if(HouseInfo[HouseEntered[playerid]][hNoOwner] < 7)return SCM(playerid,COLOR_RED,!"[Klaida] {FFFFFF}Produktu truksta, juos galite nusipirkti bet kurioje uzkandineje!");
		    HouseInfo[HouseEntered[playerid]][hNoOwner]-=7;
		}
        SetPlayerSpecialAction(playerid,SPECIAL_ACTION_DRINK_WINE);
        J_SetPlayerDrunkLevel(playerid,J_GetPlayerDrunkLevel(playerid) + 350);
		SendBarBot(playerid);
        if(Health <= 50.0) UpdatePlayerHealth(playerid,Health+50);
        else UpdatePlayerHealth(playerid,100);
        return 1;
	}
	if(clickedid == alcodraw[3])
	{
	    if(PI[playerid][pMoney] < BizData[biz][bItem][3]) return SendBotMessage(playerid,"Atsiprasome, bet neturite pakankamai pinigu!");
		if(Fullness[playerid] >= 70) return SCM(playerid,COLOR_GREY, !"Jus nesate alkanas!");
        if(biz != -1)
		{
		    if(BizData[biz][bProducts]<3)return SendBotMessage(playerid,"Atsiprasome, bet mums baigesi produktai!");
			GiveBizMoney(biz,BizData[biz][bItem][3]);
			BizData[biz][bProducts]-=3;
		}
		GiveMoney(playerid, -BizData[biz][bItem][3]);
		GiveFullness(playerid, 25);
		SCM(playerid,COLOR_VALIK, !"Jus pasiemete pizza. Alkio busena galite pamatyti {FFFFFF}/satiety");
		ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
		Send2BarBot(playerid);
		return 1;
	}
	if(clickedid == alcodraw[4])
	{
	    if(PI[playerid][pMoney] < BizData[biz][bItem][4]) return SendBotMessage(playerid,"Atsiprasome, bet neturite pakankamai pinigu!");
        if(Fullness[playerid] >= 60) return SCM(playerid,COLOR_GREY, !"Jus nesate alkanas!");
        if(biz != -1)
		{
		    if(BizData[biz][bProducts]<4)return SendBotMessage(playerid,"Atsiprasome, bet mums baigesi produktai!");
			GiveBizMoney(biz,BizData[biz][bItem][4]);
			BizData[biz][bProducts]-=4;
		}
		GiveMoney(playerid, -BizData[biz][bItem][4]);
		GiveFullness(playerid, 40);
		SCM(playerid,COLOR_VALIK, !"Jus pasiemete pietus. Alkio busena galite pamatyti {FFFFFF}/satiety");
		ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
		Send2BarBot(playerid);
		return 1;
	}
	if(clickedid == alcodraw1[5])
	{
		for(new A; A < 5; A++) TextDrawHideForPlayer(playerid, alcodraw[A]); //disku kvadratai
		for(new A; A < 7; A++) TextDrawHideForPlayer(playerid, alcodraw1[A]); //disku kvadratai
		for(new A; A < 5; A++) DestroyPlayerTD(playerid, alcodraw2[playerid][A]); //disku kvadratai
		CancelSelectTextDraw(playerid);
		return 1;
	}

	if clickedid == BoxEat[3] *then
	{
		if !(InfoBiz[playerid] == -1) *then
		{
			new id = (GetPVarInt(playerid, "SelectBoxEat") == 2);

			if PI[playerid][pMoney] < BizData[InfoBiz[playerid]][bItem][id] *then
				return SendBotMessage(playerid, !"Atsiprasome, bet neturite pakankamai pinigu!");

			else if Fullness[playerid] > 99 *then
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus nesate alkanas!");

			GiveMoney(playerid, -BizData[InfoBiz[playerid]][bItem][id]);
			GiveBizMoney(InfoBiz[playerid], BizData[InfoBiz[playerid]][bItem][id]);
			GiveFullness(playerid, 25);
			ApplyAnimationEx(playerid, !"FOOD", !"EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
			SCM(playerid, COLOR_VALIK, !"Siek tiek uzkandote. Alkio busena galite pamatyti {FFFFFF}/satiety");
			SCM(playerid, -1, !"Rekomenduojame valgyti uzkandinese, ten yra daug pigiau!");
			SendEatBot(playerid);
		}

		return EatBoxHide(playerid), CancelSelectTextDraw(playerid);
	}

	else if clickedid == BoxEat[2] *then
		return EatBoxHide(playerid), CancelSelectTextDraw(playerid);

	else if(Clother[playerid] != -1 || BuyInt[playerid] != -1 || BuyGuns[playerid] != -1 || Buyitem[playerid]!=-1)
	{
	    if(_:clickedid == 65535) SelectTextDraw(playerid, 0xFFFFFFAA);
	    else if(clickedid == ButtonLeft) callcmd::back(playerid,"");
	    else if(clickedid == ButtonRight) callcmd::next(playerid,"");
	    else if(clickedid == boxaccept) callcmd::cancel(playerid,"");
	    else if(clickedid == boxcancel) callcmd::done(playerid,"");
	    return 1;
	}
	if(KindFuel[playerid] != -1)
 	{
 		if(_:clickedid == 65535)
 		{
	 		KindFuel[playerid] = -1;
			CountFuel[playerid] = 0.0;
			HideFuelTD(playerid);
			CancelSelectTextDraw(playerid);
		}
	}
    return 0;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if !IsPlayerTextDrawVisible(playerid, playertextid) *then
		return false;

	if Int_GetPlayerData(playerid, "pTimeInv3") && !(playertextid == InventMenuTD[playerid][11]) && InventoryPage[playerid] != E_INVENTORY_TYPE_TRADE *then
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Prasau, palaukite siek tiek...");

	CallTimeOutFunction("TrashTimer",200,0,"d",playerid);
	SetPVarInt(playerid, "pTimeInv3", 1);

	if(playertextid == PlayerText:INVALID_TEXT_DRAW)
    {
        if(Ujahhs[playerid] == 1)
        {
            PI[playerid][pInputCode] = 0;
			CancelSelectTextDraw(playerid);
	        for(new osa = 0; osa < 10; osa++) PlayerTextDrawHide(playerid, security_code_TD[playerid][osa]);
	        SendClientMessage(playerid, COLOR_LIGHTRED, "Jus buvote pasalintas del atsisakymo ivesti grafini slaptazodi.");
	        Kick(playerid);
        }
    }
    for(new i = 0; i < 9; i++)
	{
		if(playertextid == security_code_TD[playerid][i])
		{
		    PlayerPlaySound(playerid, 17803, 0.0, 0.0, 0.0);
		    if(GetPVarInt(playerid, "NumberDigits") == 0) return PI[playerid][pInputCode] += 1000 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
		    else if(GetPVarInt(playerid, "NumberDigits") == 1) return PI[playerid][pInputCode] += 100 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
		    else if(GetPVarInt(playerid, "NumberDigits") == 2) return PI[playerid][pInputCode] += 10 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", GetPVarInt(playerid, "NumberDigits") + 1);
		    else if(GetPVarInt(playerid, "NumberDigits") == 3)
			{
				PI[playerid][pInputCode] += 1 * (mass_pass[playerid][i]), SetPVarInt(playerid, "NumberDigits", 0);
				if(PI[playerid][pInputCode] == PI[playerid][pSecurityCode])
				{
				    new Int[8];
					MyasoTimer[playerid] = Int[0];
					RC_KillTimer[playerid] = Int[1];
					ChestTimer[playerid] = Int[2];
					ChestTime[playerid] = Int[3];
					VoenikTimer[playerid] = Int[4];
					IlonMaskTimer[playerid] = Int[5];
					TimeOpenPresents[playerid] = Int[6];
					HalloweenTimer[playerid] = Int[7];

					new idx;
					for new x; x < 13; x ++ do
						PI[playerid][pGuns][x] = strval(strtok(global_str, idx)), PI[playerid][pAmmos][x] = strval(strtok(global_str, idx));
				 	IsPlayerLogged{playerid} = true;
					GetPlayerIp(playerid, PlayerIp[playerid], 16);

					CreateSpawnTextDraws(playerid);
					SetFullness(playerid, Fullness[playerid]);
					PreloadAllAnimLibs(playerid);
					CreatePlayerMapDraws(playerid);
					OnLoadPass(playerid);
					LoadPlayerCar(playerid, -1);
					CreateOpisanie(playerid);

					SetPlayerScore(playerid, PI[playerid][pLevel]);
					GivePlayerMoney(playerid, PI[playerid][pMoney]);
					SetPlayerWantedLevel(playerid, PI[playerid][pWanted]);

					if TeamDuty{playerid} *then
						SetPlayerColor(playerid, TeamColors[GetTeamID(playerid)]);
					else
						SetPlayerColor(playerid, 0xFDFCFC15);

				    for new ii; ii < 11; ii++ do
						TextDrawHideForPlayer(playerid, IntroLogo[ii]);

					if PI[playerid][pHealth] > 5 *then
				 		UpdatePlayerHealth(playerid, PI[playerid][pHealth]);
					else
						UpdatePlayerHealth(playerid, 20);

					if(IsAtGang(playerid) || IsAtMafia(playerid))
						SetPlayerColor(playerid, TeamColors[GetTeamID(playerid)]);

					if !PI[playerid][pHungryShow] && !AlertOpen{playerid} *then
				 		Hunger(playerid, 0);

					f(global_str, 150, "UPDATE `accounts` SET `OldIP` = '%s', `Online_status` = '1001', `LastLogin` = CURDATE(), `PlayerID` = '%d' WHERE `ID` = '%i'", PlayerIp[playerid], playerid, PI[playerid][pID]);
				    mysql_tquery(mysql, global_str);

					f(global_str, 150, "SELECT * FROM `questsprogress` WHERE `player_id` = '%d' ORDER BY `idquest`;", PI[playerid][pID]);
					mysql_tquery(mysql, global_str, "LoadQuestMysql", "d", playerid);

					f(global_str, 150, "SELECT `QuestProgress`,`QuestDone` FROM `rewards` WHERE `Name`='%s'", PN(playerid));
					mysql_tquery(mysql, global_str, "LoadRewards", "d", playerid);

					f(global_str, 128, "SELECT * FROM notif WHERE ownerid = %d", PI[playerid][pID]);
					mysql_tquery(mysql, global_str, "ShowNotifPlayer", "d", playerid);

					f(global_str, 128, "~n~~n~~n~~n~~n~~n~~w~Welcome~n~~b~%s", PN(playerid));
					GameTextForPlayer(playerid, global_str, 5000, 6);

					amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> uzejo i serveri. IP: %s", 4, PN(playerid),"", PN(playerid), PN(playerid), PlayerIp[playerid]);

					if PI[playerid][pHouseKey] > OWNABLEHOUSES *then
						PI[playerid][pHouseKey] = -1;

					if strlen(PI[playerid][pOpisanie]) > 3 *then
					{
						SCM(playerid, COLOR_YELLOW, "Jusu personazo aprasymas:");
						SCM(playerid, COLOR_GREY, PI[playerid][pOpisanie]);
					}
					SPDF(playerid, 15330, DIALOG_STYLE_MSGBOX, !"\
				San Andreas Gyvenimo akcijos", "{ffffff}Mes dziaugiames matydami jus serveryje.\n\
				Dabar serveryje veikia akcija {FA5858}X1 saskaitos papildymas {ffffff}ir {FA5858}X1 PayDay\n\n\
				{42B02C}Prekes uz SAG-Eurus:{cccccc} /donate\n\
				{42B02C}Veikia premiju programa:{cccccc} /bonus\n\
				{42B02C}Uz kiekviena suzaista valanda gausite po 1 bilieta:{cccccc} /bilet\n\n\
				{FF69B4}Rask dovanas ir atidaryk dezutes. Pagrindinis prizas {ffffff}BMW X5!\n\
				{ffffff}Musu Site: {cccccc}%s\n\
				{ffffff}Forumas: {cccccc}%s\n\
				{ffffff}Discord Grupe: {cccccc}%s\n\
				{ffffff}Atsisiusti Launcher: {cccccc}"Mode_Site"\n\
				{ffffff}Donate Site: {cccccc}%s\n\n\
					{C2A2DA}Malonaus zaidimo San Andreas Gyvenime!", !"Uzdaryti", !"", XDonate, XPayDay, Mode_Site, Mode_Forum, Server_VKontakte, Mode_Site);
					SCM(playerid, COLOR_WHITE, !"{DFCFCF}[Uzuomina] {DC4747}Serveryje yra inventorius, naudokite klavisa Y, kad ji valdytumete.");
				 	SCM(playerid, COLOR_WHITE, !"{DFCFCF}[Uzuomina] {DC4747}Galite uzduoti klausima musu techninei pagalbai /report.");
				    if(PI[playerid][pSkin] != 0) SCMF(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Siuo metu turite {FFF000}%d{ffffff} Laimes rato sukimus", GetCount(playerid, 2511));

					if(GetPlayerLauncher(playerid))
					{
						ShowPlayerHud(playerid);
						UpdatePlayerLauncher(playerid);
						SavePlayerLauncher(playerid), ShowLogo(playerid);
					}

					if !PI[playerid][pSkin] *then
						Inventory[playerid][0][0] = 313, Inventory[playerid][1][0] = 1, SCM(playerid, COLOR_YELLOW, !"Jums buvo pridetas daiktas 'Ruletes skrynia'. Noredami atidaryti inventoriu, naudokite klavisa 'Y' arba /invent");
					if !PI[playerid][pSkin] *then AddItem(playerid, 2511), SCM(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Jus gavote nemokama Laimes rato sukima!"), SCM(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Galite sukti Laimes rata casino (/gps - Ivairus - Casino 4 Dragons)");
					SPDF(playerid, 15330, DIALOG_STYLE_MSGBOX, !"\
				San Andreas Gyvenimo akcijos", "{ffffff}Mes dziaugiames matydami jus serveryje.\n\
				Dabar serveryje veikia akcija {FA5858}X1 saskaitos papildymas {ffffff}ir {FA5858}X1 PayDay\n\n\
				{42B02C}Prekes uz SAG-Eurus:{cccccc} /donate\n\
				{42B02C}Veikia premiju programa:{cccccc} /bonus\n\
				{42B02C}Uz kiekviena suzaista valanda gausite po 1 bilieta:{cccccc} /bilet\n\n\
				{FF69B4}Rask dovanas ir atidaryk dezutes. Pagrindinis prizas {ffffff}BMW X5!\n\
				{ffffff}Musu Site: {cccccc}%s\n\
				{ffffff}Forumas: {cccccc}%s\n\
				{ffffff}Discord Grupe: {cccccc}%s\n\
				{ffffff}Atsisiusti Launcher: {cccccc}"Mode_Site"\n\
				{ffffff}Donate Site: {cccccc}%s\n\n\
					{C2A2DA}Malonaus zaidimo San Andreas Gyvenime!", !"Uzdaryti", !"", XDonate, XPayDay, Mode_Site, Mode_Forum, Server_VKontakte, Mode_Site);
				 	if GiveMeBackMyBTC[playerid] *then
				 	{
						AddItem(playerid, 1461, GiveMeBackMyBTC[playerid]);
						GiveMeBackMyBTC[playerid] = 0;
						SCM(playerid, COLOR_VALIK, "Jus sekmingai pardavete nama aukcione!");
				 	}
					if BitcoinUpdate *then
					{
						if BitcoinUpdate > 0 *then
							AddItem(playerid, 1461, BitcoinUpdate);
						else
							DeleteItem(playerid, 1461, abs(BitcoinUpdate));
						UpdatePlayerDataInt(playerid, "BitcoinUpdate", BitcoinUpdate = 0);
					}
					foreach(Admin, id)
					{
						if PI[id][pAdmin] && ADuty{id} *then
						{
							if !AdminInfo[id][admIP] *then f(global_str, 256, "Zaidejas/admin %s[%d] uzejo [reg ip:%s] -- [norm ip: %s]", PN(playerid), playerid, PlayerRegIP[playerid], PlayerIp[playerid]);
							else f(global_str, 128, "Zaidejas/admin %s[%d] uzejo.", PN(playerid), playerid);
							SCM(id, COLOR_OLDRED, global_str);
						}
					}
					if PI[playerid][pLeader] *then
					{
					    if !GetString(OrgInfo[PI[playerid][pLeader]][oLeader], PN(playerid)) *then
					    {
					        if IsACop(playerid) *then
							{
								if(UsingShield{playerid}) RemovePlayerAttachedObject(playerid, 7);
								PI[playerid][pShield] = 0.0;
							}
					    	SCM(playerid, COLOR_WHITE, ">> {FF6347}Gelezinkelio stotis automatiskai priskiriama kaip spawno vieta. Pakeisti spawno vieta {ffffff}>> {FF6347}/setspawn!");
					    	SCM(playerid, COLOR_GREY, !"Jus buvote pasalintas is lyderio pareigu");
					    	PI[playerid][pLeader] =
					    	PI[playerid][pMember] =
					    	PI[playerid][pDCTime] =
					    	PI[playerid][pRank] = 0;
					    	SetBumSkin(playerid);
					    }
					}
					if PI[playerid][pRank] > 0 && PI[playerid][pMember]==0 *then
						PI[playerid][pRank] = 0;
					if(PI[playerid][pCredit] > 200000)
					{
					    SCMF(playerid, COLOR_ACHAT, "Skola centriniam bankui yra: %d$. Sumokekite kredita, kad isvengtumete paskyros blokavimo.", PI[playerid][pCredit]);
					    SAMF(COLOR_ORANGE, "[A] %s[%d] uzejo i zadima. Siuo metu jo banke yra skola %d$", PN(playerid), playerid, PI[playerid][pCredit]);
					    OrgInfo[TEAM_BANK][oBank] += 100000;
					    if(OrgInfo[TEAM_BANK][oBank] > 2000000000) OrgInfo[TEAM_BANK][oBank] = 2000000000;
					    SaveOrg(TEAM_BANK);
					}
					if(GetTrailer(playerid) != -1)
					{
					    if(IsValidTrailer(GetTrailer(playerid)))
					    {
							if(!TrailerInfo[GetTrailer(playerid)][tParked] && PI[playerid][pDCTime] == 4) PI[playerid][pDCTime] = 0;
							PI[playerid][pTrailerKey] = GetTrailer(playerid);
						}
					}
					if(PI[playerid][pWarns] > 0)
					{
						PI[playerid][pMember] = 0;
						PI[playerid][pLeader] = 0;
						PI[playerid][pRank] = 0;
						if(PI[playerid][pDCTime] == 2) PI[playerid][pDCTime]=0;
					}
				    if(PI[playerid][pWarns] > 2)
					{
					    SCM(playerid, COLOR_RED, !"Jusu paskyra uzblokuota!");
					    PI[playerid][pWarns] = 0;
						BanPlayer(playerid);
					}
					switch(PI[playerid][pDCTime])
					{
					    case 1: if(PI[playerid][pHouseKey] == -1) PI[playerid][pDCTime] = 0;
					    case 2: if(!PI[playerid][pMember]) PI[playerid][pDCTime] = 0;
					}
					foreach(Vehicle, iv)
					{
					    if !IsValidVehicle(OwnableCar[iv]) *then
							continue;
					    if GetString(CarInfo[iv][cOwner], PN(playerid)) *then
							DestroyVehicleEx(OwnableCar[iv]);
					}
					NoEnterPickup[playerid] = 6;
					if PI[playerid][pVIP] < 5 *then
					{
						if !( floatround( (PI[playerid][pVipTime] - Global_Time)/3600/24, floatround_ceil )>= 1) *then
					    {
					        if(PI[playerid][pVIP] > 0)
					     	{
						        if(PI[playerid][pVIP] > 1)
						    	{
							     	SCM(playerid, COLOR_LIGHTBLUE, "[Svarbu] {FFFFFF}Jusu VIP paskyros galiojimo laikas baigesi, VIP lygis buvo sumazintas ir pratestas!");
							    	PI[playerid][pVipTime] = Global_Time + (30 * 24 * 60 * 60);
						    	}
				                else if(PI[playerid][pVIP] == 1) SCM(playerid, COLOR_LIGHTBLUE, "[Svarbu] {FFFFFF}Jusu VIP paskyros galiojimo laikas baigesi, VIP lygis buvo pasalintas.");
					       		PI[playerid][pVIP] --;
				     		}
				    	}
					}
					if IsValidHouse(PI[playerid][pHouseKey]) *then
					{
					    new bool: on = false;
						new s = GetHouseStyle(PI[playerid][pHouseKey]);
						if(s != -1)
						{
							for(new ij; ij < HouseRooms[s]; ij++)
							{
								if(GetString(HRoomOwner[PI[playerid][pHouseKey]][ij], PN(playerid)))
								{
					                on = true;
					                break;
								}
							}
							if(on == false && !GetString(HouseInfo[PI[playerid][pHouseKey]][hOwner], PN(playerid))) PI[playerid][pHouseKey] = -1;
						}
					}
					else
						PI[playerid][pHouseKey] = -1;
					if !(PI[playerid][pFarmOwner] == -1) && !GetString(FarmData[PI[playerid][pFarmOwner]][farmOwner], PlayerName[playerid]) *then
						UpdatePlayerDataInt(playerid, "FarmOwner", PI[playerid][pFarmOwner] = -1);
					if PI[playerid][pInvCell] == 144 *then
						UpdatePlayerDataInt(playerid, "InvCell", PI[playerid][pInvCell] = 144);
					if !(FP_Data[playerid][F_FAMILY_ID] == -1) *then
						LoadFamilyDataPlayer(playerid, FP_Data[playerid][F_FAMILY_ID]);
					if !GetString(PI[playerid][pLastIP], PlayerRegIP[playerid]) *then
						AcceptAdm{playerid} = false;
					GetPlayerIp(playerid, PI[playerid][pLastIP], 16);
					GangZoneShowForPlayer(playerid, ZoneFix, 0x000000FF);
					if GetPlayerADDVIP(playerid) *then
					    PlayerADDVIPSpawn(playerid), pTemp[playerid][tAddVipSpawn] = 1;
					else
						PlayerSpawn(playerid);
				}
				else Kick(playerid), SendClientMessage(playerid, COLOR_RED, "Neteisingas slaptazodis!");
				for(new fx = 0; fx < 10; fx++) PlayerTextDrawHide(playerid,security_code_TD[playerid][fx]);
				PI[playerid][pInputCode] = Ujahhs[playerid] = 0;
				CancelSelectTextDraw(playerid);
			}
		}
	}

	if(playertextid == recon_p[playerid][54]) return SCM(playerid, -1, "0");

	if(playertextid == recon_p[playerid][53]) return ShowButtonRecon(playerid, 1);
	if(playertextid == recon_p[playerid][52]) return ShowButtonRecon(playerid, 2);
	if(playertextid == recon_p[playerid][51]) return ShowButtonRecon(playerid, 3);
	if(playertextid == recon_p[playerid][50]) return SCM(playerid, -1, "4"), ShowButtonRecon(playerid, 4);
	if(playertextid == recon_p[playerid][49]) return SCM(playerid, -1, "5"), ShowButtonRecon(playerid, 5);
	if(playertextid == recon_p[playerid][48]) return ShowButtonRecon(playerid, 6);
	if(playertextid == recon_p[playerid][47]) return SCM(playerid, -1, "7"), ShowButtonRecon(playerid, 7);
	if(playertextid == recon_p[playerid][46]) return ShowButtonRecon(playerid, 8);

	if(playertextid == recon_p[playerid][1])//lolll
	{
	    if(Int_GetPlayerData(playerid,"selectrecon") == 2) return callcmd::weap(playerid, SERIU[playerid][sID]);
	    if(Int_GetPlayerData(playerid,"selectrecon") == 3) return SPD(playerid,124,1,"WARN","{73B461}Demesio!\n\n{FFFFFF}Iveskite priezasti i eilute.\n","Priimti","Atsaukti");
	    if(Int_GetPlayerData(playerid,"selectrecon") == 6) return ShowLicenses(playerid, SERIU[playerid][sID]);
		if(Int_GetPlayerData(playerid,"selectrecon") == 8) return callcmd::reoff(playerid,"");
	}
	if(playertextid == recon_p[playerid][2])
	{
	    if(Int_GetPlayerData(playerid,"selectrecon") == 2) return f(global_str, 20, "%d 0", SERIU[playerid][sID]), callcmd::sethp(playerid, global_str);
	    if(Int_GetPlayerData(playerid,"selectrecon") == 3) return SPD(playerid,129,1,"JAIL","{73B461}Demesio!\n\n{FFFFFF}Iveskite laika ir priezasti i eilute.\nIveskite per kableli be tarpu ( 10,DM )\n\nMaksimaliai 30 simboliu!","Pasodinti","Atsaukti");
	    if(Int_GetPlayerData(playerid,"selectrecon") == 6) return CheckItemInv(playerid, SERIU[playerid][sID]);
		if(Int_GetPlayerData(playerid,"selectrecon") == 8) return callcmd::reoff(playerid,""), callcmd::gethere(playerid,SERIU[playerid][sID]);
	}
	if(playertextid == recon_p[playerid][3])
	{
	    if(Int_GetPlayerData(playerid,"selectrecon") == 2) return f(global_str, 20, "%d 150", SERIU[playerid][sID]), callcmd::sethp(playerid, global_str);
	    if(Int_GetPlayerData(playerid,"selectrecon") == 3) return SPD(playerid,137,1,"MUTE","{73B461}Demesio!\n\n{FFFFFF}Iveskite laika ir priezasti i eilute.\nIveskite per kableli be tarpu ( 10,FLOOD )\n\nMaksimaliai 30 simboliu!","Priimti","Atsaukti");
	    if(Int_GetPlayerData(playerid,"selectrecon") == 6) return f(global_str, 256, "Zaidejas %s[%d] parode savo vairavimo igudziu ataskaita. Vairavimo igudis: {FFFFFF}[%d/100]", PN(SERIU[playerid][sID]), SERIU[playerid][sID], PI[SERIU[playerid][sID]][pCarSkill]), SCM(playerid, COLOR_LIGHTBLUE, global_str);
		if(Int_GetPlayerData(playerid,"selectrecon") == 8) return callcmd::reoff(playerid,""), callcmd::goto(playerid,SERIU[playerid][sID]);
	}
	if(playertextid == recon_p[playerid][4])
	{
        if(Int_GetPlayerData(playerid,"selectrecon") == 2) return f(global_str, 20, "%d 1", SERIU[playerid][sID]), callcmd::slap(playerid, global_str);
        if(Int_GetPlayerData(playerid,"selectrecon") == 3) return SPD(playerid,125,1,"BAN","{73B461}Demesio!\n\n{FFFFFF}Iveskite laika ir priezasti i eilute.\nIveskite per kableli be tarpu ( 10,Cheat )\n\nMaksimaliai 30 simboliu!","Priimti","Atsaukti");
        if(Int_GetPlayerData(playerid,"selectrecon") == 6) return ShowSkills(playerid, SERIU[playerid][sID]);
		if(Int_GetPlayerData(playerid,"selectrecon") == 8) return callcmd::az(playerid,SERIU[playerid][sID]);
	}
	if(BodyguardOpen{playerid})
	{
		for(new i; i < safebodyguardCount[playerid]; i++)
		{
			if(playertextid == BodyguardMenuButtons[playerid][i][0])
				return safeguardType[playerid] = i, SPDF(playerid, 25762, DIALOG_STYLE_LIST, (str_f("%s", safeguardNickName[playerid][i])), "{FFFFFF}[1] %s\n{%s}[2] Paleisti animacija\n{FFFFFF}[3] Pakeisti sargybinio varda {FFC300}[500 SAG-Coins]\n{FFFFFF}[4] Parduoti kitam zaidejui\n{FFFFFF}[5] Pakeisti replikas\n{FFFFFF}[6] Isnuomoti sargybini\n{FFFFFF}[7] Atsisveikinti (ismesti)", !"Isrinkti", !"Atsaukti", safeguardSpawned[playerid][i] ? "Paslepti":"Uzspawninti prie saves", safeguardSpawned[playerid][i] ? "ffffff":"bfbbba");

			else if(playertextid == BodyguardSkinsTextDraws[playerid][i][1])
			{
			    static const BodyguardTypeName[][] = {"{AAAAAA}Paprastas", "{68FE40}Nepaprastas", "{25CAFF}Retas", "{D239CC}Unikalus"};
//			    new npcid = Bodyguard[playerid][bodyguardNpcId];

				return 1;
/*				SPDF(playerid, 0, 0, !"Informacija apie palydova", \
				"{ffffff}\
				Palydovo vardas: {b83434}[%s]\n{ffffff}Tipas: {b83434}%s{ffffff}\n\n\
				Lygis: {b83434}[%d]\n{ffffff}EXP: {b83434}[%d/%d]{ffffff}\n\
				Sveikata: {b83434}[%.0f/1000]{ffffff}\nSarvai: {b83434}[%.0f/100]{ffffff}\n\
				Sotumas: {b83434}[100.0/100.0]{ffffff}\n\nApsauga: {b83434}[-%d% zalos]{ffffff}\n\
				Zala: {b83434}[+%d zalos]{ffffff}\nMaks. HP: {b83434}[+%d maks. HP]", !"Uzdaryti", !"", safeguardNickName[playerid][i],\
			 	BodyguardTypeName[safeguardTall[playerid][i][0]],\
			    safeguardData[playerid][i][0], safeguardData[playerid][i][1],\
				(safeguardData[playerid][i][0]+1)*4,\
				FCNPC_GetHealth(npcid),\
				FCNPC_GetArmour(npcid),\
				safeguardFeature[playerid][i][1],\
				safeguardFeature[playerid][i][2],\
				safeguardFeature[playerid][i][0]);*/
			}
			else if playertextid == BodyguardWeaponTextDraws[playerid][i][0] *then
			{
//			    new npcid = Bodyguard[playerid][bodyguardNpcId];
			    if safeguardGun[playerid][i] != 0 *then
			    {
					AddItem(playerid, safeguardGun[playerid][i], safeguardGunAmmo[playerid][i]);
					safeguardGun[playerid][i] = safeguardGunAmmo[playerid][i] = 0;
//					FCNPC_SetWeapon(npcid, 0);

					new item = safeguardGunAmmo[playerid][i];

					PlayerTextDrawSetPreviewModel(playerid, BodyguardWeaponTextDraws[playerid][i][0], ItemsInfo[item][ItemModel]),
					PlayerTextDrawSetPreviewRot(playerid, BodyguardWeaponTextDraws[playerid][i][0], ItemsInfo[item][POSTDx], ItemsInfo[item][POSTDy], ItemsInfo[item][POSTDz], ItemsInfo[item][POSTDc]);

					SQL("UPDATE Bodyguard SET safeguardGun = '%d', safeguardGunAmmo = '%d' WHERE safeguardSearch = '%s[%d]'", safeguardGun[playerid][i], safeguardGunAmmo[playerid][i], PN(playerid), i);

					for(new s; s < 3; s++)
						UpdateBodyguardTextDraw(playerid, s);
				}
				else if timeaks[playerid] *then
				{
                    new id = Inventory[playerid][0][PickInvent[playerid]];

					switch id do
					{
						case 531..536: SPD(playerid, 12219, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite naudoti", !"Priimti", !"Atsaukti");
					}
				}
			}
			else if playertextid == BodyguardInventoryButtons[playerid][i][0] *then
			{
				new Float:X = 462.401703 + InventoryPos[playerid][0], Float:Y = 101.5 + InventoryPos[playerid][1], Float:Pos[2];

				bodyguardInventoryOpen{playerid} = !bodyguardInventoryOpen{playerid};

				if bodyguardInventoryOpen{playerid} *then
				{
					for new id; id < 4; id++ do
					{
						if id == i *then
							continue;

						Pos[0] = X - 124.401703, Pos[1] = Y + 26.100006;

						CreateBodyguardBackGround(playerid, Pos, id);

						if i < 3 && id == i + 1 *then
						{
							PlayerTextDrawHide(playerid, BodyguardNameTextDraws[playerid][id]);
							PlayerTextDrawHide(playerid, BodyguardRarityTextDraws[playerid][id]);

							for new td; td < 4; td++ do
							{
								if td < 3 *then
								{
									for new s; s < 2; s++ do
										PlayerTextDrawHide(playerid, BodyguardFeatureTextDraws[playerid][id][td][s]);

									PlayerTextDrawHide(playerid, BodyguardDecorationTD[playerid][id][td]);
								}
								if td < 2 *then
									PlayerTextDrawHide(playerid, BodyguardMenuButtons[playerid][id][td]),
									PlayerTextDrawHide(playerid, BodyguardWeaponTextDraws[playerid][id][td]),
									PlayerTextDrawHide(playerid, BodyguardSkinsTextDraws[playerid][id][td]),
									PlayerTextDrawHide(playerid, BodyguardLevelTextDraws[playerid][id][td]);

								PlayerTextDrawHide(playerid, BodyguardInventorySlots[playerid][id][td]);
							}

							continue;
						}
					}

					Pos[0] = X - 121.401703, Pos[1] = Y + 84.600006;

					CreateBodyguardInventoryCells(playerid, Pos, i);
				}
				else
				{
					for new id; id < 12; id++ do
					{
						if id < 4 *then
							DestroyPlayerTD(playerid, BodyguardBackGround[playerid][id]);

						DestroyPlayerTD(playerid, BodyguardInventoryCells[playerid][i][id]);
					}

					for new td; td < 4; td++ do
					{
						if i >= 3 *then
							break;

						if !td *then
							PlayerTextDrawShow(playerid, BodyguardWeaponTextDraws[playerid][i + 1][0]),
							PlayerTextDrawShow(playerid, BodyguardSkinsTextDraws[playerid][i + 1][0]),
							UpdateBodyguardTextDraw(playerid, 0), UpdateBodyguardTextDraw(playerid, 3);

						if td < 3 *then
							PlayerTextDrawShow(playerid, BodyguardDecorationTD[playerid][i + 1][td]);

						PlayerTextDrawShow(playerid, BodyguardInventorySlots[playerid][i + 1][td]);
					}

					if i < 3 && i + 1 < safebodyguardCount[playerid] *then
					{
						PlayerTextDrawShow(playerid, BodyguardNameTextDraws[playerid][i + 1]);
						PlayerTextDrawShow(playerid, BodyguardRarityTextDraws[playerid][i + 1]);

						for new td; td < 3; td++ do
						{
							if td < 2 *then
								PlayerTextDrawShow(playerid, BodyguardMenuButtons[playerid][i + 1][td]),
								PlayerTextDrawShow(playerid, BodyguardLevelTextDraws[playerid][i + 1][td]);

							for new s; s < 2; s++ do
								PlayerTextDrawShow(playerid, BodyguardFeatureTextDraws[playerid][i + 1][td][s]);
						}
					}
				}

				return PlayerTextDrawSetString(playerid, BodyguardInventoryButtons[playerid][i][1], bodyguardInventoryOpen{playerid} ? ( PI[playerid][pLanguage] ? FixText("UZDARYTI") : !"CLOSE" ) : ( PI[playerid][pLanguage] ? FixText("INVENTORIUS") : !"INVENTORY" ) );
			}
			for new id; id < 12; id++ do
			{
				if playertextid == BodyguardInventoryCells[playerid][i][id] *then
				{
				    if safeguardInventory[playerid][id][i] *then
				    {
				    	AddItem(playerid, safeguardInventory[playerid][id][i]),
				    	safeguardInventory[playerid][id][i] = 0;
						PlayerTextDrawSetPreviewModel(playerid, BodyguardInventoryCells[playerid][i][id], ItemsInfo[safeguardInventory[playerid][id][i]][ItemModel]);
						PlayerTextDrawSetPreviewRot(playerid, BodyguardInventoryCells[playerid][i][id], ItemsInfo[safeguardInventory[playerid][id][i]][POSTDx], ItemsInfo[safeguardInventory[playerid][id][i]][POSTDy], ItemsInfo[safeguardInventory[playerid][id][i]][POSTDz], ItemsInfo[safeguardInventory[playerid][id][i]][POSTDc]);
						PlayerTextDrawHide(playerid, BodyguardInventoryCells[playerid][i][id]),
						PlayerTextDrawShow(playerid, BodyguardInventoryCells[playerid][i][id]);
						SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
						safeguardInventory[playerid][0][i],safeguardInventory[playerid][1][i],safeguardInventory[playerid][2][i],safeguardInventory[playerid][3][i], safeguardInventory[playerid][4][i],safeguardInventory[playerid][5][i],safeguardInventory[playerid][6][i],safeguardInventory[playerid][7][i],\
						safeguardInventory[playerid][8][i],safeguardInventory[playerid][9][i],safeguardInventory[playerid][10][i],safeguardInventory[playerid][11][i],\
						PN(playerid), i);
					}
				}
			}
  		}
	}
	//recon
    if(obmenOpen{playerid})
    {
        new check[] = { 8, 12, 16, 20, 24, 28, 32, 36, 40, 44};
        new id = PI[playerid][pIDObmen], type2[2] = -1, player2[2], color[2];
        if(ObInfo[id][obID] == playerid) player2[0] = ObInfo[id][obPlayer], player2[1] = ObInfo[id][obID];
        else player2[0] = ObInfo[id][obID], player2[1] = ObInfo[id][obPlayer];
        for(new i; i < sizeof(check); i++)
        {
            if(playertextid == ObmenTD[playerid][check[i]])
            {
                if(i > 4 && playertextid == ObmenTD[playerid][check[i]] && ObInfo[id][obPlayer] == playerid || i < 5 && playertextid == ObmenTD[playerid][check[i]] && ObInfo[id][obID] == playerid)
                {
                    switch(ObInfo[id][obType][i])
                    {
                        case 1: SPDF(playerid, 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija", "Uzdaryti", "", "{FFFFFF}Pinigai: {FFFF00}$%i", ObInfo[id][obItem][i]);
                        case 2: SPDF(playerid, 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija", "Uzdaryti", "", "{FFFFFF}Namas: {FFFF00}¹%i", ObInfo[id][obItem][i]);
                        case 3: SPDF(playerid, 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija", "Uzdaryti", "", "{FFFFFF}Verslas: {FFFF00}¹%i (%s)", ObInfo[id][obItem][i], BizData[ObInfo[id][obItem][i]][bName]);
                        case 5: SPDF(playerid, 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija", "Uzdaryti", "", "{FFFFFF}Transportas: {FFFF00}%s [Model: %i] [ID: %i]", GetVehicleName(ObInfo[id][obItem][i]), GetVehicleModelEx(ObInfo[id][obItem][i]), ObInfo[id][obItem][i]);
                        case 6: SPDF(playerid, 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija", "Uzdaryti", "", "{FFFFFF}Priekaba: {FFFF00}¹%i", ObInfo[id][obItem][i]);
                    }
                }
                else if(ObInfo[id][obType][i]) SPD(playerid, 4080,DIALOG_STYLE_MSGBOX, "{CCCCCC}Patvirtinimas", "{FFFFFF}Ar tikrai norite pasalinti turta is sio langelio?", "Pasalinti", "Atsaukti");
                else SPD(playerid, 4079, DIALOG_STYLE_LIST, "{BFBBBA}Pasirinkite turto tipa:", "Pinigai\nNamas\nVerslas\nUkis\nPriekaba", "Isrinkti", "Atsaukti");
                SetPVarInt(playerid, "idslotObmen", i);
            }
        }
        if(playertextid == ObmenTD[playerid][2] && (ObInfo[id][obPlayer] == playerid || ObInfo[id][obID] == playerid)) ResetObmen(id);
        else if(playertextid == ObmenTD[playerid][3] && ObInfo[id][obPlayer] == playerid || playertextid == ObmenTD[playerid][6] && ObInfo[id][obID] == playerid) SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{BFBBBA}Informacija", "{ffffff}Sis mygtukas rodo pasirengima apsikeisti turtu su zaideju,\nkuriuo keiciates.\n\nJei mygtukas dega {00ff00}zalia {ffffff}- tai reiskia, kad zaidejas pasiruoses ir laukia,\nkol patvirtinsite mainus.\n\nKai jusu mygtukai dega {FE9A2E}oranzine {ffffff}- tai reiskia,\nkad pirmasis patvirtinimas ivyko ir reikia antro patvirtinimo,\nsiekiant isitikinti, kad niekas nieko nepakeite\nir visi pasirenge apsikeisti tuo, kas nurodyta.", "Uzdaryti", "");
        else if(playertextid == ObmenTD[playerid][3] || playertextid == ObmenTD[playerid][6])
        {
            if(playertextid == ObmenTD[playerid][6] && ObInfo[id][obPlayer] == playerid) type2[0] = 0, type2[1] = 1;
            else if(playertextid == ObmenTD[playerid][3] && ObInfo[id][obID] == playerid) type2[0] = 1, type2[1] = 0;
            if(PI[playerid][pMoney] >= 50000)
            {
                if(ObInfo[id][obAccept][type2[1]] >= 1 && ObInfo[id][obAccept][type2[0]] == 1) ObInfo[id][obAccept][type2[0]] = 2;
                else if(ObInfo[id][obAccept][type2[0]] == 1) ObInfo[id][obAccept][type2[0]] = 0;
                else if(!ObInfo[id][obAccept][type2[0]]) ObInfo[id][obAccept][type2[0]] = 1;
            }
            else SCM(playerid, COLOR_LIGHTRED, "[Klaida] {FFFFFF}Neturite 50000 komisiniams sumoketi!");
            if(ObInfo[id][obAccept][0] >= 1 && ObInfo[id][obAccept][1] >= 1) color[0] = 0xFE9A2EFF,color[1] = 0xFE9A2EFF;
            else if(ObInfo[id][obAccept][0] == 1 && ObInfo[id][obAccept][1] == 0) color[0] = 0x00ff00FF, color[1] = 842150655;
            else if(ObInfo[id][obAccept][1] == 1 && ObInfo[id][obAccept][0] == 0) color[0] = 842150655, color[1] = 0x00ff00FF;
            else color[0] = 842150655, color[1] = 842150655;
            for(new i; i < 2; i++)
            {
                if(ObInfo[id][obAccept][0] == 1 && ObInfo[id][obAccept][1] == 1)
                {
                    for(new k; k < sizeof(check); k++)
                    {
                        PlayerTextDrawSetSelectable(player2[i], ObmenTD[player2[i]][check[k]], 0);
                        PlayerTextDrawShow(player2[i], ObmenTD[player2[i]][check[k]]);
                    }
                }
                PlayerTextDrawColor(player2[i], ObmenTD[player2[i]][6], color[0]);
                PlayerTextDrawShow(player2[i], ObmenTD[player2[i]][6]);
                PlayerTextDrawColor(player2[i], ObmenTD[player2[i]][3], color[1]);
                PlayerTextDrawShow(player2[i], ObmenTD[player2[i]][3]);
                if(PI[ObInfo[id][obPlayer]][pLanguage]) PlayerTextDrawSetString(ObInfo[id][obPlayer],ObmenTD[ObInfo[id][obPlayer]][5],ObInfo[id][obAccept][1] >= 1 && ObInfo[id][obAccept][0] == 0 || ObInfo[id][obAccept][1] == 2  ? FixText("PATVIRTINTA") : FixText("LAUKIA_PATVIRTINIMO"));
                else PlayerTextDrawSetString(ObInfo[id][obPlayer],ObmenTD[ObInfo[id][obPlayer]][5], ObInfo[id][obAccept][1] >= 1 && ObInfo[id][obAccept][0] == 0 || ObInfo[id][obAccept][1] == 2  ? "CONFIRMED" : "WAITING_CONFIRM");
                if(PI[ObInfo[id][obID]][pLanguage]) PlayerTextDrawSetString(ObInfo[id][obID],ObmenTD[ObInfo[id][obID]][7], ObInfo[id][obAccept][0] >= 1 && ObInfo[id][obAccept][1] == 0 || ObInfo[id][obAccept][0] == 2 ? FixText("PATVIRTINTA") : FixText("LAUKIA_PATVIRTINIMO"));
                else PlayerTextDrawSetString(ObInfo[id][obID],ObmenTD[ObInfo[id][obID]][7], ObInfo[id][obAccept][0] >= 1 && ObInfo[id][obAccept][1] == 0 || ObInfo[id][obAccept][0] == 2 ? "CONFIRMED" : "WAITING_CONFIRM");
            }
        }
        if(ObInfo[id][obAccept][0] == 2 && ObInfo[id][obAccept][1] == 2)
        {
            static text[100], text2[2][300];
            text2[0] = "", text2[1] = "";
            for(new i; i < 10; i++)
            {
                switch(ObInfo[id][obType][i])
                {
                    case 1: f(text, sizeof(text), "- pinigai (%i$)\n", ObInfo[id][obItem][i]);
                    case 2: f(text, sizeof(text), "- namas (¹%i)\n", ObInfo[id][obItem][i]);
                    case 3: f(text, sizeof(text), "- verslas (¹%i - %s)\n", ObInfo[id][obItem][i], BizData[ObInfo[id][obItem][i]][bName]);
                    case 5: f(text, sizeof(text), "- transportas (%s)\n", GetVehicleName(ObInfo[id][obItem][i]));
                    case 6: f(text, sizeof(text), "- priekaba (¹%i)\n", ObInfo[id][obItem][i]);
                }
                if(i < 5) SuccefulObmen(ObInfo[id][obPlayer], ObInfo[id][obID], id, i), strcat(text2[0], text);
                if(i > 4) SuccefulObmen(ObInfo[id][obID], ObInfo[id][obPlayer], id, i), strcat(text2[1], text);
                if(i < 2) GiveMoney(player2[i], -50000);
                text[0] = EOS;
            }
            SPDF(ObInfo[id][obPlayer], 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija",\
            "{FFFF00}Atidavete mainams:\n\
            {FFFFFF}%s\n\
            {FFFF00}Mainais gavote:\n\
            {FFFFFF}%s\n\
            {37DE3C}Mainai sekmingai baigti.\n\
            Is abieju zaideju buvo isskaiciuotas mainu mokestis: 50000$", "Uzdaryti", "", text2[0], text2[1]);
            SPDF(ObInfo[id][obID], 0,DIALOG_STYLE_MSGBOX, "{CCCCCC}Informacija",\
            "{FFFF00}Atidavete mainams:\n\
            {FFFFFF}%s\n\
            {FFFF00}Mainais gavote:\n\
            {FFFFFF}%s\n\
            {37DE3C}Mainai sekmingai baigti.\n\
            Is abieju zaideju buvo isskaiciuotas mainu mokestis: 50000$", "Uzdaryti", "", text2[1], text2[0]);
            ResetObmen(id);
            //amlf("Zaidejas <a href=../data/logsaccount.php?id=%d>%s</a> padare turto mainus <a href=../data/logsaccount.php?id=%d>%s</a>  Gavo: %s | Atidave: %s ", 5, "", "", PI[ObInfo[id][obPlayer]][pID], PN(ObInfo[id][obPlayer]), PI[ObInfo[id][obID]][pID], PN(ObInfo[id][obID]), text[0], text[1]);
        }
	}

    if(FamilyCaptureOpen{playerid})
    {
        for(new k; k < 156; k++)
        {
            global_str[0] = EOS;
            if(playertextid == FamilyZones[playerid][k])
            {
				new ftext[150];
                new id = FamilyZone[k][fZoneOwnerId];
                f(global_str, sizeof(global_str), "{BFBBBA}Teritorija ¹%i", k);
                SetPVarInt(playerid,"idKvadrat",k);
                new month, day;
                getdate(_, month, day);
                if(day == 31 || day == 30 || day == 29) return SCM(playerid, COLOR_LIGHTRED, !"[Klaida]{FFFFFF} Sezonas baigesi, prasideda 1 diena");
                f(ftext, sizeof(ftext), "{BFBBBA}Teritorija ¹%i", k);
                if(id == -1) return SPD(playerid, 15216, DIALOG_STYLE_LIST, global_str,"Nustatyti zyma GPS\nAtimti teritorija", "Isrinkti", "Uzdaryti");
                else return SPDF(playerid, 15210, DIALOG_STYLE_LIST, ftext, "Nustatyti zyma GPS\nAtimti teritorija\n \nPriklauso seimai: %s", "Isrinkti", "Uzdaryti", GetFamilyDataString(id, "name"));
            }
        }
        return 1;
    }

    if(ChangeColorOpen{playerid})
    {
        if(playertextid == ChangeColor_PTD[playerid][13])
        {
            if(ItemChangeColor[playerid][2] < 7 || !ItemChangeColor[playerid][1] || !ItemChangeColor[playerid][0]) return 1;
            if(!CancelChangeColor{playerid})
            {
                if(GetCount(playerid, 1461) < BizData[BizEntered[playerid]][bItem][2]) return SCM(playerid, COLOR_LIGHTRED, !"[Klaida]{FFFFFF} Jums nepakanka BTC!");
                if(!GetPVarInt(playerid, "idcolorchange")) return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Nepasirinkta pagrindine spalva aksesuaro dazymui.");
                ApplyAnimationEx(playerid, !"CASINO", !"DEALONE", 4.1, 1, 1, 1, 1, 0, 1);
                SCM(playerid, COLOR_VALIK, "[Uzuomina] {ffffff}Aksesuaro dazymo procesas sekmingai pradetas..");
                CancelChangeColor{playerid} = true;
                ChangeColorTime[playerid] = 5;
            }
        }
        if(playertextid == ChangeColor_PTD[playerid][12]) SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{BFBBBA}{73B461}Aksesuaru perdazymas", "{73B461}—{ffffff} Aksesuaru perdazymas:\n\n{73B461}—{ffffff} Norint nudazyti daiktus, jums reikia {73B461}galastuvu{FFFFFF}, kuriuos\ngalite rasti seimos renginyje - Nykusis rumas ({73B461}/GPS - Renginiai{FFFFFF})\narba isigykite Donate ar Centrineje Rinkoje. Taip pat surinkti ukiuose.\n\nTaip pat, norint nudazyti daiktus, jums reikia {73B461}dazu{FFFFFF}, kuriuos\ngalite rasti ukiuose ar Centrineje Rinkoje.\n\nPerdazydami galesite pakeisti savo aksesuaro isvaizda", "Uzdaryti", "");
        else if(playertextid == ChangeColor_PTD[playerid][14]) HidePokrasAcs(playerid);
        for(new k = 15; k < 24; k++)
		{
			if(playertextid == ChangeColor_PTD[playerid][k] && ItemChangeColor[playerid][0])
			{
				SetPVarInt(playerid, "idcolorchange", k-15);

	            if(IsPlayerTextDrawVisible(playerid, ChangeColor_A[playerid])) DestroyPlayerTD(playerid, ChangeColor_A[playerid]);
	            ChangeColor_A[playerid] = CreatePlayerTextDraw(playerid, 217.9998, 180.7183, "LD_SPAC:white");
	            PlayerTextDrawLetterSize(playerid, ChangeColor_A[playerid], 0.4799, 1.1200);
	            PlayerTextDrawTextSize(playerid, ChangeColor_A[playerid], 6.0000, 7.0000);
	            PlayerTextDrawAlignment(playerid, ChangeColor_A[playerid], 1);
	            PlayerTextDrawColor(playerid, ChangeColor_A[playerid], AksMassive[k-15][AksColorDefault]);
	            PlayerTextDrawBackgroundColor(playerid, ChangeColor_A[playerid], 255);
	            PlayerTextDrawFont(playerid, ChangeColor_A[playerid], 4);
	            PlayerTextDrawSetProportional(playerid, ChangeColor_A[playerid], 0);
	            PlayerTextDrawSetShadow(playerid, ChangeColor_A[playerid], 0);
	            PlayerTextDrawShow(playerid, ChangeColor_A[playerid]);
            }
		}
        if(playertextid == ChangeColor_PTD[playerid][24])
        {
	 		ItemChangeColor[playerid][2] = 0;
            InventSlotUse[playerid][SlotChangeColor[playerid][2]] = false;
			PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][25], "%d/7", ItemChangeColor[playerid][2]);
			PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][24], ItemChangeColor[playerid][2] >= 7 ? -1 : -1717986817);
			PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][24], 0);
			PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][24]);
   			InvSlotUpdate(playerid, SCC[playerid][2], SlotChangeColor[playerid][2]);
		    if InfoChanColor[playerid] *then
		    {
				for(new k; k < 6; k++) DestroyPlayerTD(playerid, InfColorChange[playerid][k]);
				InfoChanColor[playerid] = false;
			}
		}
        else if(playertextid == ChangeColor_PTD[playerid][27])
        {
 			ItemChangeColor[playerid][1] = 0;
            InventSlotUse[playerid][SlotChangeColor[playerid][1]] = false;
			PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][28], "%d/1", ItemChangeColor[playerid][1]);
			PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][27], -1717986817);
			PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][27], ItemChangeColor[playerid][1] ? 1 : 0);
			PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][27]);
			InvSlotUpdate(playerid, SCC[playerid][1], SlotChangeColor[playerid][1]);
		    if InfoChanColor[playerid] *then
		    {
				for(new k; k < 6; k++) DestroyPlayerTD(playerid, InfColorChange[playerid][k]);
				InfoChanColor[playerid] = false;
			}
		}
        else if(playertextid == ChangeColor_PTD[playerid][26])
        {
