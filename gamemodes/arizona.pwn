public OnIncomingPacket(playerid, packetid, BitStream:bs)
{
	if packetid == 220 *then
	{
		static custom;

		BS_IgnoreBits(bs, 8);
		BS_ReadUint8(bs, custom);

		switch custom do
		{
			case 18:
			{
				static query[300];
				BS_ReadString32(bs, query);
				ClickedBrowser(playerid, query, custom, "NoData");
			}
		    /*case 0:
			{
				static keys;
				BS_ReadUint8(bs, keys);
				for(new i; i < sizeof(playerkey); i++)
				{
					if playerkey[i][htkey] == keys *then
						SCMF(playerid, -1, "paspausta klavisa %s", playerkey[i][htkeyname]);
					else
					    SCM(playerid, -1, "--");
				}
			}*/
			case 17:
				return true;

			case 20:
				for new i; i < 2; i++ do
					BS_ReadUint32(bs, playerCefResolution[playerid][i]);

			case 24:
			{
				BS_IgnoreBits(bs, 32);
				static number;
				BS_ReadUint8(bs, number);
				if(!number && playerCefFocus[playerid] == true)
				{
					playerCefFocus[playerid] = false;
					HideFullCef(playerid, player_tuningOpen{playerid} ? 1 : 0);
				}
				else playerCefFocus[playerid] = true;
			}
			case 38:
			{
				OnPlayerInitializingBrowser(playerid);

				for new i; i < 2; i++ do
					playerCefInitiliaze[playerid][i] = true;
			}
		}
	}
	return 1;
}

stock HideFullCef(playerid, tuning = 0)
{
    ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"null\"]');");
    UpdateBrowser(playerid, 52, 2);
	UpdateBrowser(playerid, 86, 0);
	UpdateBrowser(playerid, 73, 0);

	if tuning *then
	{
	 	if(playerTun_IsGarage{playerid} != 255)
	 	{
			new carid = GetPlayerVehicleID(playerid);

			ExecuteEvent(playerid, 0, "window.executeEvent('event.tuning.updateCart', `[[]]`);");

			SetVehiclePos(carid, 2567.7468,968.1774,10.6322);
			SetVehicleZAngle(carid, 90.0000);
			SetPlayerVirtualWorld(playerid, 0);
			SetVehicleVirtualWorld(carid, 0);
			PutPlayerInVehicle(playerid, carid, 0);
			LinkVehicleToInterior(carid, 0);
			SetPlayerInterior(playerid, 0);
			SetCameraBehindPlayer(playerid);
			OnFocusBrowser(playerid, 1, false);
			UpdatePlayerLauncher(playerid);
			tuningclose = -1;
			UpdateDynamic3DTextLabelText(globalTun_Label3D, -1, "Ivaziavimui i garaza\n{70CFFA}Naudokite: {ffffff}ALT");
			PI[playerid][pTunGarage] = -1;
			UpdateEnterTuningCenter(playerTun_IsGarage{playerid}, -1);
			reset_CustomComponent(carid);
		    //playerTun_IsLoad{playerid} = false;

			TogglePlayerControllable(playerid, true);
			player_tuningOpen{playerid} = false;
            for new i; i < 8; i ++ do tuningCenter_playerData[playerid][cartCheck][i] = 0;
			playerTun_IsGarage{playerid} = 255;
			tuningCenter_playerData[playerid][cartCount] = 0;
			tuningCenter_playerData[playerid][cartString][0] = EOS;

			ResetVehicleTuning(carid);
			LoadNewTune(carid, GetVehicleID(carid), 1);
	 	}
 	}
 	else
		UseNewDonate(playerid, 1);

	return 1;
}

stock CreateBrowser(playerid, url[], key[] = "")
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, \
		PR_UINT8, 220, \
		PR_UINT8, 10, \
		PR_UINT32, playerCefResolution[playerid][0], \
		PR_UINT32, playerCefResolution[playerid][1], \
		PR_UINT32, 0, \
		PR_UINT32, 0, \
		PR_STRING32, url, \
		PR_STRING32, key, \
		PR_STRING32, 0);

	return PR_SendPacket(bs, playerid), BS_Delete(bs);
}

stock ShowPlayerSpeedometr(playerid)
