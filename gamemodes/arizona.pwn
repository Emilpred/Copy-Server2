	else if(pickupid == nalogoffise[1])
	{
	    SetPlayerVirtualWorld(playerid,0);
		SetPlayerInterior(playerid,0);
		UpdatePlayerPos(playerid,1530.8074,-1070.4329,25.0625);
		SetPlayerFacingAngle(playerid, 339.1004);
		return 1;
	}
	else if(pickupid == amybank)
 	{
		if(GetTeamID(playerid) != TEAM_BANK)
			return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus nesate banko darbuotojas!");

		_GiveGun(playerid, 3, 100);
		f(global_str, 50, "%s paima ginkla", PN(playerid));
		ProxDetector(25, playerid, global_str, COLOR_PURPLE);
		return 1;
	}
	else if(pickupid >= HealSG[0] && pickupid <= HealSG[86])
		return GameTextForPlayer(playerid, !"~g~Press~r~ ALT", 1000, 3);

 	else if(pickupid == Inc_CP[0]||pickupid == Inc_CP[1])
	{
		if PlayerJob[playerid] != JOB_COLLECTOR *then
	 		return SCM(playerid, COLOR_GREY, !"[Klaida] {FFFFFF}Jus nesate inkasatorius");

		if InJob[playerid] *then
			SPD(playerid, 149, 0, !"Darbas 'Inkasatorius'", !"{FFFFFF}Jus norite persirengti, kad baigtumete darba?", !"Taip", !"Ne");
		else
			SPD(playerid, 149, 0, "Darbas 'Inkasatorius'", "{FFFFFF}Jus norite persirengti, kad pradetumete darba?", !"Taip", !"Ne");

		return 1;
	}
	else if(pickupid == Yakydzapick)
	{
	    if(Getemer[playerid]>Global_Time)return 0;
	    Getemer[playerid]=Global_Time+5;
		SPD(playerid, 1666, 2, !"Restorano meniu", !"Vistiena Teriyaki padaze\t\t\t 600$\nMiso sriuba\t\t\t\t\t 500$\nSkaidrus makaronai su jautiena\t\t 700$\nUdon makaronai grietineles padaze su jautiena\t\t 800$\nKani spicy \t\t\t\t\t 600$", !"Priimti", !"Uzdaryti");
		return 1;
	}
	else if(pickupid >= portpick[0] && pickupid <= portpick[4])
	{
	    if(!IsPlayerInAnyVehicle(playerid))
	    {
		    if(!IsANotControllable(playerid))
		    {
				if(PlayerJob[playerid] == JOB_PORTER)
				{
					if(InJob[playerid] == 1)
					{
					    ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
			            InJob[playerid] = 3;
			            TogglePlayerDynamicCP(playerid, PorterDownCP, true);
			    		CarryAnim(playerid);
			    		if(!IsPlayerAttachedObjectSlotUsed(playerid, 7))SetPlayerAttachedObjectEx(playerid, 7, 2060, 5, 0.01, 0.1, 0.2, 100, 10, 85);
					}
				}
			}
		}
		return 1;
	}
	else if (pickupid ==demorgan[0])
	{
	    if(PI[playerid][pDemorgan]) return 1;
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerFacingAngle(playerid, 272.4357);
		UpdatePlayerPos(playerid, -2152.7336, 645.0001, 52.3672);
		return 1;
    }
	else if(pickupid >= FerumPickup[0] && pickupid <= FerumPickup[5])
	{
	    if(CreateMats[playerid] == 1)
		{
		    if(GetPlayerVirtualWorld(playerid)==11 && GLS[25]<100) return SPD(playerid, 0, 0, !"", !"{BCB7B7}Karineje sandelyje truksta medziagu, reikalingu saudmenu gamybai!\nGalite uzkrauti medziagas LS gamykloje naudodami sraigtasparni.", !"Uzdaryti", !"");
		    else if (GetPlayerVirtualWorld(playerid)==12 && GLS[26]<100)  return SPD(playerid, 0, 0, !""," {BCB7B7}Karineje sandelyje truksta medziagu, reikalingu saudmenu gamybai!\nGalite uzkrauti medziagas LS gamykloje naudodami sraigtasparni.", !"Uzdaryti", !"");
			else if (GetPlayerVirtualWorld(playerid)==13 && GLS[43]<100)  return SPD(playerid, 0, 0, !"", !"{BCB7B7}Karineje sandelyje truksta medziagu, reikalingu saudmenu gamybai!\nGalite uzkrauti medziagas LS gamykloje naudodami sraigtasparni.", !"Uzdaryti", !"");
			CreateMats[playerid] = 2;
			SetPlayerAttachedObjectEx(playerid, 7, 7891, 5, 0.3, 0.17, 0.1, 0.0, 150.0, 60.0, 0.08, 0.08, 0.08);
			if(GetPlayerVirtualWorld(playerid)==10)
			{
			    if(FactoryFerum<5)return SCM(playerid,COLOR_RED,!"[Klaida] {FFFFFF}Gamyklai nepakanka metalo jo perdirbimui!");
				FactoryFerum -= 5;
    			f(global_str, 170, "{FFFFFF}Metalo: {10F441}%dkg\n{FFFFFF}Medziagu: {10F441}%d\n\n{FFFFFF}Atsistokite ant Pickup, kad nusipirktumete medziagas", FactoryFerum, FactoryMats);
				UpdateDynamic3DTextLabelText(FactoryText[0], COLOR_WHITE, global_str);
			}
			for(new i; i < sizeof(FerumCP);i ++) TogglePlayerDynamicCP(playerid, FerumCP[i], true);
		}
		else if(CreateMats[playerid] == 2) SCM(playerid, COLOR_GREY, !"[Klaida] {FFFFFF}Jus jau paemete metala. Eikite i darbo vieta.");
		else if(CreateMats[playerid] == 4) SCM(playerid, COLOR_GREY, !"[Klaida] {FFFFFF}Nuneskite medziagas prie kitu medziagu.");
		else SCM(playerid, COLOR_GREY, !"[Klaida] {FFFFFF}Jus nedirbate!");
		return 0;
	}
    else if(pickupid == FactoryClothes)
    {
        if(Getemer[playerid]>Global_Time)return 0;
	    Getemer[playerid]=Global_Time+5;
        if InJob[playerid] *then
 			return SCM(playerid, COLOR_GREY, !"[Klaida] {FFFFFF}Siuo metu jus jau dirbate kazkur kitur!");

        if !CreateMats[playerid] *then
			SPD(playerid, 254, 0, !"Rubine", !"Jus norite pradeti darba?", !"Taip", !"Ne");
		else
			SPD(playerid, 254, 0, !"Rubine", !"Jus norite baigti darba?", !"Taip", !"Ne");
		return 1;
	}
	else if(pickupid >= ZavodClotherCP[0] && pickupid <= ZavodClotherCP[5])
    {
  	 	if !CreateMats[playerid] && !IsAZavodSkin(playerid) *then
		   	return SPD(playerid, 300, 0, !"Rubine", !"{FFFFFF}Jus norite persirengti ir {33AA33}pradeti {FFFFFF}darba?", !"Taip", !"Atsaukti");
    	else
			return SPD(playerid, 300, 0, !"Rubine", !"{FFFFFF}Jus norite persirengti ir {FF0000}baigti {FFFFFF}darba?", !"Taip", !"Atsaukti");
   	}
	return 1;
}
public OnVehicleMod(playerid, vehicleid, componentid)
{
    if(!IsAOwnableCar(vehicleid))
	{
	    SPD(playerid, 0, 0, !"", !"{CD1717}Klaida!{FFFFFF}\n\n\nTuninguoti galima tik asmenini transporta!\n\n\n", !"Priimti", !"");
	    RemoveVehicleComponent(vehicleid,componentid);
        return 0;
	}
	else
	{
	    RemoveVehicleComponent(vehicleid, componentid);
	    SCM(playerid, COLOR_WHITE, !"Sios transporto priemones negalima tuninguoti");
	}
	return 1;
}

stock SharpeningDamage(playerid, id, Float:amount)
{
	switch(id)
	{
		case 4..13:
		{
			new Float:health;
			GetPlayerHealth(playerid, health);
			SetPlayerHealth(playerid, health - id - 3);

    		SCMF(playerid, -1, "[amount = %0.2f]", amount);
			SCMF(playerid, -1, "[health = %0.2f]", health);
			SCMF(playerid, -1, "OnPlayerGiveDamage [%0.2f]", amount + id - 3);
		}
	}

	return false;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
	if !IsPlayerLogged{playerid} *then
		return false;
	global_str = "";
    if(GetPlayerWeapon(playerid)!=43 && GetPlayerSpecialAction(playerid)!= SPECIAL_ACTION_DRINK_SPRUNK &&  GetPlayerSpecialAction(playerid)!= SPECIAL_ACTION_DRINK_WINE && GetPlayerSpecialAction(playerid)!= SPECIAL_ACTION_SMOKE_CIGGY && GetPlayerSpecialAction(playerid)!=SPECIAL_ACTION_DRINK_BEER)
	{
		if !IsACop(playerid) *then
		{
			if GetPlayerGZ(playerid) && GetPlayerVirtualWorld(playerid) != 11 && GetPlayerVirtualWorld(playerid)!=12 && GetPlayerVirtualWorld(playerid) !=13 *then
			{
 				if !NoEnterPickup[playerid] *then
				 	SetPVarInt(playerid,"antidmnew",(Int_GetPlayerData(playerid,"antidmnew")+1));

				NoEnterPickup[playerid] = 7;
				ClearAnimationsEx(playerid);
				ApplyAnimationEx(playerid, !"MISC", "PLYR_SHKHEAD", 4.1, false, false, false, false, 0, false);
 				SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"{B8F64D}Uzuomina", !"\n{FFFFFF}Sioje vietoje draudziama {FC7979}mustis/saudyti{FFFFFF}.\nJei tesite, busite ismestas!\n\nTaip pat galite buti nubaustas ir pasodintas i demorgana\narba buti ispetas (WARN).", !"Priimti", !"");
 				return 0;
			}
		}
	}
	SharpeningDamage(damagedid, AksSlot[damagedid][1][2], amount);
 	switch(weaponid)
  	{
   		case 3:
     	{
      		if(IsACop(playerid) || IsAMeria(playerid) || PI[playerid][pMember] == TEAM_BANK || PI[playerid][pMember] == TEAM_TSR)
        	{
         		if(!CuffedTime[damagedid])
           		{
             		if(Controllable{damagedid})
               		{
                 		ClearAnimationsEx(damagedid);
                   		CheckMiner(damagedid);
                     	CheckPorter(damagedid);
                      	CheckBreakCuff(damagedid);
                       	CheckTheftCar(damagedid);
                        f(global_str, 144,"* %s apsvaigino %s lazda",PN(playerid),PN(damagedid));
                        ProxDetector(25,playerid,global_str,COLOR_PURPLE);
                        SCM(playerid, COLOR_WHITE, !"[Informacija] {FFFFFF}Paspauskite {FF0000}\"N\"{FFFFFF} salia zmogaus, kad ji surakintumete");
                        TazerPlayer[damagedid] = playerid;
                        TazerPlayer[playerid] = damagedid;
                        new Float:X, Float:Y, Float:Z;
                        GetPlayerPos(damagedid, X, Y, Z), Z += 1.5;
                        switch(GetPlayerAnimationIndex(playerid))
                        {
                        	case 17: CuffedPlayer(damagedid, 15);
                         	case 18: CuffedPlayer(damagedid, 20);
                          	case 19: CuffedPlayer(damagedid, 25);
                           	default: CuffedPlayer(damagedid, 30);
                        }
                   	}
               	}
                return 1;
           	}
		}
  		case 23:
    	{
     		if(IsACop(playerid) || PI[playerid][pMember] == TEAM_MERIALS)
       		{
         		if(!CuffedTime[damagedid])
           		{
					if(Controllable{damagedid})
     				{
         				ClearAnimationsEx(damagedid);
             			CheckMiner(damagedid);
                		CheckPorter(damagedid);
                  		CheckBreakCuff(damagedid);
                    	CheckTheftCar(damagedid);
                     	f(global_str,144,"* %s apsvaigino %s suviu is tazerio",PN(playerid),PN(damagedid));
                      	ProxDetector(25,playerid,global_str,COLOR_PURPLE);
                       	SCM(playerid, COLOR_WHITE, !"[Informacija] {FFFFFF}Paspauskite {FF0000}\"N\"{FFFFFF} salia zmogaus, kad ji surakintumete");
                        TazerPlayer[damagedid] = playerid;
                        TazerPlayer[playerid] = damagedid;
                        new Float:X, Float:Y, Float:Z;
                        GetPlayerPos(damagedid, X, Y, Z), Z += 1.5;
                        switch GetPlayerAnimationIndex(playerid) do
                        {
                        	case 17: CuffedPlayer(damagedid, 15);
                         	case 18: CuffedPlayer(damagedid, 20);
                          	case 19: CuffedPlayer(damagedid, 25);
                           	default: CuffedPlayer(damagedid, 30);
                        }
                    }
                }
         	}
     	}
    }
	ShowDamageTextDrawForPlayer(playerid, damagedid, weaponid, amount);
    f(global_str, 12, "- %.2f HP", Float:amount),
    SetPlayerChatBubble(damagedid, global_str, COLOR_OLDRED, 30.0, 5000);
    return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
    if !IsPlayerLogged{playerid} *then
		return false;
    if(GetPlayerWeapon(issuerid)!=43 && GetPlayerSpecialAction(issuerid)!= SPECIAL_ACTION_DRINK_SPRUNK &&  GetPlayerSpecialAction(issuerid)!= SPECIAL_ACTION_DRINK_WINE && GetPlayerSpecialAction(issuerid)!= SPECIAL_ACTION_SMOKE_CIGGY && GetPlayerSpecialAction(issuerid)!=SPECIAL_ACTION_DRINK_BEER)
	{
		if !IsACop(issuerid) *then
		{
			if GetPlayerGZ(issuerid) && GetPlayerVirtualWorld(issuerid) != 11 && GetPlayerVirtualWorld(issuerid)!=12 && GetPlayerVirtualWorld(issuerid) !=13 *then
			{
 				if !NoEnterPickup[issuerid] *then
				 	SetPVarInt(issuerid,"antidmnew",(Int_GetPlayerData(issuerid,"antidmnew")+1));

				NoEnterPickup[issuerid] = 7;
				ClearAnimationsEx(issuerid);
				ApplyAnimationEx(issuerid, !"MISC", "PLYR_SHKHEAD", 4.1, false, false, false, false, 0, false);
 				SPD(issuerid, 0, DIALOG_STYLE_MSGBOX, !"{B8F64D}Uzuomina", !"\n{FFFFFF}Sioje vietoje draudziama {FC7979}mustis/saudyti{FFFFFF}.\nJei tesite, busite ismestas!\n\nTaip pat galite buti nubaustas ir pasodintas i demorgana\narba buti ispetas (WARN).", !"Priimti", !"");
 				return 0;
			}
		}
	}
	new Float:Health, Float:AksPerfect;

	if !(issuerid == INVALID_PLAYER_ID) && GetAccessoryUpdate(AksSlot[issuerid][1][2]) *then
	{
		AksPerfect = GetAccessoryUpdate(AksSlot[issuerid][1][2]);

		amount += AksPerfect;
	}

	if !(issuerid == INVALID_PLAYER_ID) && GetAccessoryUpdate(AksSlot[playerid][1][1]) *then
	{
		AksPerfect = amount * GetAccessoryUpdate(AksSlot[playerid][1][1]) * 2 / 100;

		amount -= AksPerfect;

		if PI[playerid][pArmour] > 0 && weaponid <= 46 *then {

			GetPlayerArmour(playerid, Health);
			SetPlayerArmour(playerid, Health - amount);
		}
		else {

			GetPlayerHealth(playerid, Health);

			SetPlayerHealth(playerid, Health - amount);
		}
	}

	else
	{
		if PI[playerid][pArmour] > 0 && weaponid <= 46 *then {

			GetPlayerArmour(playerid, Health);
			SetPlayerArmour(playerid, Health - amount);
		}
		else {

			GetPlayerHealth(playerid, Health);
			SetPlayerHealth(playerid, Health - amount);
		}
	}

	if(PI[playerid][pArmour] > 0)
	{
	    if(weaponid > 46) PI[playerid][pHealth] -= amount;
	    else PI[playerid][pArmour] -= amount;
	}
	else PI[playerid][pHealth] -= amount;

	if(amount > 0)
 	{
		if(UsingShield{playerid})
		{
	        if(PI[playerid][pShield] >= 10.0)
	        {
	   			GetPlayerHealth(playerid,Health);
	            Health += 10;
				if(Health > 100) Health = 100;
			    UpdatePlayerHealth(playerid,Health);
				PI[playerid][pShield] -= 10.0;
			}
			else
			{
			    RemovePlayerAttachedObject(playerid, 7);
				UsingShield{playerid} = false;
				PI[playerid][pShield] = 0.0;
				ClearAnimationsEx(playerid);
			}
	    }
		SetPlayerSkills(issuerid);
	}
	return 1;
}
stock SetPlayerSkills(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;
    SetPlayerSkillLevel(playerid,WEAPONSKILL_PISTOL,			PI[playerid][pPistol_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_PISTOL_SILENCED,	PI[playerid][pSDPistol_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_DESERT_EAGLE,		PI[playerid][pEagle_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_SHOTGUN,			PI[playerid][pShotGun_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_MICRO_UZI,			PI[playerid][pUZI_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_MP5,				PI[playerid][pMP5_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_AK47,				PI[playerid][pAK47_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_M4,				PI[playerid][pM4_Skill]/10);
	SetPlayerSkillLevel(playerid,WEAPONSKILL_SNIPERRIFLE,		PI[playerid][pSniper_Skill]/10);
	return 1;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
	if Int_GetPlayerData(playerid, "EditObjectHouse") *then
	{
		new id = Int_GetPlayerData(playerid, "object_edit_id"); DeletePVar(playerid, "EditObjectHouse"), DeletePVar(playerid, "object_edit_id");
		SetDynamicObjectPos(BH_Object[id][objID], BH_Object[id][objPosX], BH_Object[id][objPosY], BH_Object[id][objPosZ]);
		SetDynamicObjectRot(BH_Object[id][objID], BH_Object[id][objRotX], BH_Object[id][objRotY], BH_Object[id][objRotZ]);
	 	CancelEdit(playerid);
	}

	if(newinteriorid > 0 && oldinteriorid == 0)
	{
		SetPlayerWeather(playerid, 2);
		DestroyPlayerMapDraws(playerid);
	}
	else if(newinteriorid == 0 && oldinteriorid > 0)
	{
		SetPlayerWeather(playerid, Weather);
		CreatePlayerMapDraws(playerid);
	}
	return 1;
}

public: EngineVehicle(playerid, vehicleid)
{
	if(IsPlayerInVehicle(playerid,vehicleid))
	{
	    if(!IsAOwnableCar(vehicleid) || CarInfo[GetVehicleID(vehicleid)][cKeyIN])
	    {
	        new Float:Health;
			GetVehicleHealth(vehicleid, Health);
			if(Health > 1000.0) Health = 1000.0;
			new hp = 11 - floatround(Health / 100.0);
		    new uEngine = random(hp);
		    if(uEngine < 4)
		    {
		        SetEngineStatus(vehicleid, true, playerid);
		        f(global_str, 100," Variklis sekmingai uzsivede | -  %s .",PN(playerid));
  				PlayerNotification(playerid, "success","Pranesimas","Variklis sekmingai uzvestas",1500);
		        ProxDetector(25.0,playerid, global_str, COLOR_DOCHAT);
		        ShowAttention(playerid, "", "Variklis sekmingai uzvestas", 2);
		        if(LightsObject[vehicleid][0]!=-1 || LightsObject[vehicleid][1]!=-1)
			  	{
     				DestroyDynamicObject(LightsObject[vehicleid][0]);
					DestroyDynamicObject(LightsObject[vehicleid][1]);
					LightsObject[vehicleid][0] = -1;
					LightsObject[vehicleid][1] = -1;
					SignalTick[vehicleid][0] = 0;
					SignalTick[vehicleid][1] = -1;
					Signal[vehicleid] = 0;
				}
		    }
		    else
		    {
		        f(global_str,100," Variklis neuzsivede | -  %s.",PN(playerid));
		        ProxDetector(25.0,playerid,global_str,COLOR_DOCHAT);
  				PlayerNotification(playerid, "error","Pranesimas","Variklis neuzsivede",1500);
		        ShowAttention(playerid, "Pranesimas", "Variklis neuzvestas", 1);
			}
		}
	}
	return 1;
}
stock MuchNumber(...)
{
	new count = numargs(), maxnum;
	for(new i; i < count; i ++)
	{
	    new temp = getarg(i);
	    if(temp > maxnum) maxnum = temp;
	}
	return maxnum;
}
forward DestroyTempStrip(strip, carid);
public DestroyTempStrip(strip, carid)
{
	DestroyDynamicObject(TempStripObject[carid]);
	TempStripObject[carid] = -1;
	if(StripCount > 1)
	{
		for(new i = strip; i < StripCount; i ++)
		{
		    TStripPos[i][0] = TStripPos[i+1][0];
			TStripPos[i][1] = TStripPos[i+1][1];
			TStripPos[i][2] = TStripPos[i+1][2];
		}
	}
	StripCount --;
	return 1;
}
forward PlayerUnStrip(playerid);
public PlayerUnStrip(playerid)
{
    NoStrip[playerid] = -1;
    return 1;
}
stock IsAStripCar(carid)
{
	new model = GetVehicleModelEx(carid);
	switch(model)
	{
	    case 528, 596..599: return 1;
	    default: return 0;
	}
	return 0;
}
stock bool:bollean(value)
{
	return value?true:false;
}
stock CuffedPlayer(playerid, cuffedtime)
{
	TogglePlayerControllable(playerid, true);
	CuffedTime[playerid] = cuffedtime;
	Cuffed[playerid] = true;
	Crack{playerid} = bollean(cuffedtime > 0);
	Cuffed[playerid] = bollean(cuffedtime == 0);
	if(PlayerJob[playerid] == 17 && InJob[playerid] == 2) for(new i; i < sizeof(MinPos); i ++) TogglePlayerDynamicCP(playerid, MinerCP[i], false);

	if(PlayerJob[playerid] == JOB_PORTER && InJob[playerid] == 2) TogglePlayerDynamicCP(playerid, PorterDownCP, false);
    if(TheftCarID[playerid] != 0)
	{
	    TheftCarID[playerid] = 0;
	    TheftKey[playerid] = 0;
	    TheftTime[playerid] = 0;
	    TheftCount[playerid] = 0;
	    HidePlayerActionText(playerid);
	    HidePlayerActionBand(playerid);
	}
	if(pTemp[playerid][BreakKey] != 0)
	{
		pTemp[playerid][BreakKey] =
		pTemp[playerid][BreakTime] =
		pTemp[playerid][BreakCount] = 0;
  		HidePlayerActionText(playerid);
	    HidePlayerActionBand(playerid);
		DeleteItem(playerid, 328, 1);
	}
	if(IsACop(playerid))
	{
	    new cuffid = PlayerOfCuff[playerid];
	    if(cuffid != INVALID_PLAYER_ID)
	    {
	        if(PlayerOfCuff[cuffid] == playerid) PlayerOfCuff[cuffid] = INVALID_PLAYER_ID;
	        PlayerOfCuff[playerid] = INVALID_PLAYER_ID;
	        TimeOfCuff[playerid] = 0;
	    }
	}
	if(cuffedtime <= 0)
	{
	    new tazer = TazerPlayer[playerid];
		if(tazer != INVALID_PLAYER_ID)
  		{
 			TazerPlayer[playerid] = INVALID_PLAYER_ID;
 			TazerPlayer[tazer] = INVALID_PLAYER_ID;
  		}
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
	}
	CancelCuff(playerid);
	return 1;
}
stock UnCuffPlayer(playerid)
{
	Cuffed[playerid] = false;
	CuffedTime[playerid] = 0;
	SetPlayerSpecialAction(playerid, 0);
    TogglePlayerControllable(playerid, true);
    pTemp[playerid][BreakKey] = 0;
	pTemp[playerid][BreakTime] = 0;
	pTemp[playerid][BreakCount] = 0;
 	HidePlayerActionText(playerid);
	HidePlayerActionBand(playerid);
	ClearAnimations(playerid);
	return 1;
}
stock Parking(playerid)
{
	new carid = GetPlayerVehicleID(playerid);
    if GetPlayerVirtualWorld(playerid) == 0 *then
    {
        for new i; i < sizeof parking; i++ do
        {
            if IsPlayerInRangeOfPoint(playerid, 2.0, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z]) *then
            	return ParkingEntered[playerid] = i, SPD(playerid, 1981, DIALOG_STYLE_LIST, !"Pasirinkite auksta!", !"{FFFFFF}1.\n2.", !"Priimti", !"Atsaukti");
        }
    }
    else
    {
        new i = ParkingEntered[playerid];
        if i == -1 *then return false;

        if IsPlayerInRangeOfPoint(playerid, 2.0, parking[i][pExit_x], parking[i][pExit_y], parking[i][pExit_z]) *then
        {
        	SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 0);
			if carid *then
			{
				SetVehiclePos(carid, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z] + 1.0);
				SetVehicleZAngle(carid, parking[i][pExit_a]);
				LinkVehicleToInterior(carid, 0);
				SetVehicleVirtualWorld(carid, 0);
			}
			else UpdatePlayerPos(playerid, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z] + 1.0, parking[i][pEnter_a]);
            return ParkingEntered[playerid] = -1;
        }
        else if IsPlayerInRangeOfPoint(playerid, 2.0, parking[i][pVExit_x], parking[i][pVExit_y], parking[i][pVExit_z]) *then
        {
			if carid *then
			{
				SetVehiclePos(carid, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z] + 1.0);
				SetVehicleZAngle(carid, parking[i][pExit_a]);
				LinkVehicleToInterior(carid, 0);
				SetVehicleVirtualWorld(carid, 0);
			}
			SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 0);
			UpdatePlayerPos(playerid, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z] + 1.0, parking[i][pEnter_a]);
			return ParkingEntered[playerid] = -1;
        }
    }
    return 0;
}
stock GarageMovement(playerid)
{
	new veh_id = GetPlayerVehicleID(playerid);
  	if GarageEntered[playerid] == -1 *then
	{
		for new i; i < OWNABLEHOUSES; i++ do
		{
			if HouseInfo[i][hGarage] *then
			{
				if IsPlayerInRangeOfPoint(playerid, 2.0, HouseInfo[i][hGarage_X], HouseInfo[i][hGarage_Y], HouseInfo[i][hGarage_Z]) *then
				{
					if !GetString(HouseInfo[i][hOwner], PN(playerid)) *then
						return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Tai nera jusu garazas!");

					if IsPlayerInAnyVehicle(playerid) *then
					{
						new count = 0;
						foreach(Vehicle, vehid)
						{
							if(GetVehicleVirtualWorld(vehid) != (i+50)) continue;
							count ++;
						}
						if(count == 1 && HouseInfo[i][hKlass] == 1) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Siame garaze jau yra 1 automobilis!");

						if(count == 2 && HouseInfo[i][hKlass] == 2) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Siame garaze jau yra 2 automobiliai!");

						if(count == 3 && (HouseInfo[i][hKlass] == 3 || HouseInfo[i][hKlass] == 4)) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Siame garaze jau yra 3 automobiliai!");

						if(count == 5 && HouseInfo[i][hKlass] == 5) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Siame garaze jau yra 5 automobiliai!");

						SetVehiclePos(veh_id,GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_X], GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_Y],
						GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_Z]+1.0);
						LinkVehicleToInterior(veh_id, GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_INT]);
						SetVehicleVirtualWorld(veh_id, i + 50);

						SetPlayerInterior(playerid, GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_INT]);
						SetPlayerVirtualWorld(playerid, i + 50);
					}
					SetPlayerVirtualWorld(playerid, i + 50), SetPlayerInterior(playerid, GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_INT]);

					UpdatePlayerPos(playerid,
					GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_X],
					GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_Y],
					GaragesInteriors[HouseInfo[i][hKlass] - 1][e_GARAGE_INTERIOR_Z] + 1.0,
					-1);
                    if(veh_id != 0)	PutPlayerInVehicle(playerid, veh_id, 0);
					return GarageEntered[playerid] = i;
				}
				else continue;
			}
		}
	}
	else
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.5, GaragesInteriors[HouseInfo[GarageEntered[playerid]][hKlass] - 1][e_GARAGE_INTERIOR_X], GaragesInteriors[HouseInfo[GarageEntered[playerid]][hKlass] - 1][e_GARAGE_INTERIOR_Y], GaragesInteriors[HouseInfo[GarageEntered[playerid]][hKlass] - 1][e_GARAGE_INTERIOR_Z]))
		{
			if(GetPlayerVirtualWorld(playerid) == (GarageEntered[playerid] + 50))
			{
				if IsPlayerInAnyVehicle(playerid) *then
				{
					SetVehiclePos(
						veh_id,
						HouseInfo[GarageEntered[playerid]][hGarage_X],
						HouseInfo[GarageEntered[playerid]][hGarage_Y],
						HouseInfo[GarageEntered[playerid]][hGarage_Z] + 0.6
					);
					LinkVehicleToInterior(veh_id, 0);
					SetVehicleVirtualWorld(veh_id, 0);
					Streamer_Update(playerid);
				}
				UpdatePlayerPos(playerid, HouseInfo[GarageEntered[playerid]][hGarage_X], HouseInfo[GarageEntered[playerid]][hGarage_Y], HouseInfo[GarageEntered[playerid]][hGarage_Z] + 0.6 );
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0);
				if(veh_id != 0)	PutPlayerInVehicle(playerid, veh_id, 0);
				GarageEntered[playerid] = -1;
				return 1;
			}
		}
	}
	return 0;
}

new timerwaxt[MAX_PLAYERS];
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if !IsPlayerLogged{playerid} *then
		return false;

	if(newkeys & 4)
	{
		for(new i; i < sizeof(tunDataEnter_Position); i++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2.5, tunDataEnter_Position[i][0], tunDataEnter_Position[i][1], tunDataEnter_Position[i][2]))
			{
			    if GetPlayerState(playerid) == PLAYER_STATE_DRIVER *then
			    {
			        new num;
					foreach(new id: Player)
					{
					    if(GetPlayerVehicleID(id) == GetPlayerVehicleID(playerid))
					    {
					        if(GetPlayerState(id) == PLAYER_STATE_PASSENGER) num++;
					    }
					}
					if(num != 0) return SCM(playerid, COLOR_GREY, "[Klaida] Noredami ivaziuoti i garaza, turite isleisti visus keleivius!");
			        if(tuningclose != -1) return SCM(playerid, COLOR_GREY, "[Klaida] Siuo metu garazas uzimtas!");
					if !IsPlayerCefInit(playerid, 1) *then
					    return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Prieinama tik is naujo SAG Launcher.");
                    tuningclose = playerid;
					UpdateEnterTuningCenter(i, playerid);
					playerTun_IsGarage{playerid} = i;
					PI[playerid][pTunGarage] = 1;
					ShowTuningMenu(playerid);
					break;
				}
			}
		}
	}

	if(newkeys == 1024)
	{
		foreach(Klad, i)
		{
			if KladInfo[i][kladStatus] && IsPlayerInRangeOfPoint(playerid, 2.0, KladInfo[i][kladX], KladInfo[i][kladY], KladInfo[i][kladZ]) *then
			{
			    if(GetPVarInt(playerid, #openk) != 0) return SCM(playerid, COLOR_GREY, "[Klaida] Jus jau pradejote iskasineti lobi!");
				if KladInfo[i][kladOpen] == true *then
				{
				    if IsAOwner(playerid) || CheckFD(playerid, 1) || CheckFD(playerid, 2) *then
						SCMF(playerid, COLOR_VALIK, "[Hitch-System] {ffffff}Atsakymas i klausima-misle: %s.", captcha_klad[KladInfo[i][kladCaptcha]][1]);
		            return pTemp[playerid][kladID] = i, SPDF(playerid, 3736, DIALOG_STYLE_INPUT, !"{ffffff}Isilauzimas | {ae433d}Lobis", "\n\n{42B02C}Sioje duobeje radote didele skrynia su pakabinta spyna\n\n{ffffff}Noredami atrakinti spyna,\nturite atsakyti i klausima-misle!\n\nKlausimas:\n%s\n\nIveskite atsakyma i tuscia kontekstini laukeli:\n", !"»", !"x", captcha_klad[KladInfo[i][kladCaptcha]][0]);
		        }
		        new num;
		        for(new j; j < 13; j ++)
				{
				    GetPlayerWeaponData(playerid, j, PI[playerid][pGuns][j], PI[playerid][pAmmos][j]);
				    if(PI[playerid][pGuns][j] != 6) continue;
				    num++;
				}

				if(num != 0) pTemp[playerid][kladID] = i, SPD(playerid, 3735, DIALOG_STYLE_MSGBOX, !"{FFFFFF}Iskasti | {ae433d}Lobis", !"\n\n{ffffff}Ar tikrai norite iskasti si lobi?\n\n", !"»", !"x");
				else SCM(playerid, COLOR_VALIK, "[Hitch-System]{ffffff} Neturite kastuvo rankose! Kastuva galima isigyti bet kurioje degalineje (/gps > Artimiausia degaline)");
				return true;
			}
		}
		if !GetPVarInt(playerid, "P_SEAT_STATUS") *then
		{
			help_id = GetPlayerData(playerid, P_AREA_ID);
			if !(help_id == -1) && IsPlayerInRangeOfPoint(playerid, 1.25, SEAT_SYSTEM_POS[help_id][Sx], SEAT_SYSTEM_POS[help_id][Sy], SEAT_SYSTEM_POS[help_id][Sz]) *then
			{
	            SetPlayerPos(playerid, SEAT_SYSTEM_POS[help_id][Sx], SEAT_SYSTEM_POS[help_id][Sy], SEAT_SYSTEM_POS[help_id][Sz]);
		        SetPlayerFacingAngle(playerid, SEAT_SYSTEM_POS[help_id][Aa]);
		        SetCameraBehindPlayer(playerid);
				ApplyAnimation(playerid, "PED", "SEAT_down", 4.1, false, false, false, true, 0, true);

				SetPVarInt(playerid, "P_SEAT_STATUS", true);

				SendPlayerData(playerid);
			}
		}
		if(IsPlayerInRangeOfPoint(playerid, 2.0, SinisterXYZ[0], SinisterXYZ[1], SinisterXYZ[2]))
		{
			if(SinisterXYZ[0] != 0.0)
			{
				EnableGPSForPlayer(playerid, -1370.5117, -2152.5623, 25.0233);

				SCM(playerid, COLOR_VALIK, !"[Informacija] {ffffff}Pasiemete deze su akmenimis, nuneskite ja i sandeli, pazymeta zemelapyje."),
				SetPlayerAttachedObject(playerid, 7, 19572, 5, -0.005000, 0.303000, 0.2, 100.0, 10.0, 85.0, 1.0, 1.0, 1.0),
				ApplyAnimationEx(playerid, !"CARRY", !"CRRY_PRTIAL", 4.1, 0, 1, 1, 1, 1, 1);

				PlayerSinisterObject[playerid] = true;

				for(new id; id < 3; id++)
					SinisterXYZ[id] = 0.0;

				SinisterOfTheDelete();
			}
		}
	}

	if(newkeys == 1024)
	{
		if(IsPlayerInRangeOfPoint(playerid, 2.0, -1370.5117, -2152.5623, 25.0233))
		{
			if(PlayerSinisterObject[playerid])
			{
			    new id = FP_Data[playerid][F_FAMILY_ID];

				AddItem(playerid, 2098, 1);
				f(global_str, 256, "{%s}[Seima (Naujienos)] {ffffff}Seimos narys: %s[%d] atnese deze su akmenimis i rengini. Seimai buvo suteikta gresminga reputacija.", FamilyColor[GetFamilyDataInt(id, "color")], PN(playerid), playerid);
				SendFamilyMessage(id, global_str);
				UpdateFamilyData(id, "zlovechayareputation = `zlovechayareputation` + %d", 10);

				ClearAnimations(playerid);

				RemovePlayerAttachedObject(playerid, 7);
				PlayerSinisterObject[playerid] = false;
			}
		}
	}
    if newkeys == PRESS_ALT *then
	{
		if IsPlayerInRangeOfPoint(playerid, 2.0, 1780.7780,-1888.3790,13.3899) or IsPlayerInRangeOfPoint(playerid, 2.0, 1150.9264,-1732.5895,13.7734) *then
		{
	 		SPD(playerid, 25761, DIALOG_STYLE_LIST, !"{FFFFFF}NPC [Andreas]", "Isigyti{8b00ff} [MonoCoin = 1.000.000.000]\n{ffffff}Isigyti{8b00ff} [Daiktai]", !"Isrinkti", !"Atsaukti");
		}
	}
    if newkeys == PRESS_ALT *then
	{
		if(IsPlayerInRangeOfPoint(playerid, 1, 2266.3584, -807.6035, 1407.6224))
		{
	 		ShowPlayerDialog(playerid, 25453, DIALOG_STYLE_MSGBOX, "{BFBBBA}{FFD700}Laimes ratas", "{ffffff}Ar tikrai norite pasukti laimes rata?\n\n{FFD700}-{ffffff} Prizai, kuriuos galite laimeti is laimes rato:\n\n{FFD700}1.{ffffff} Desert Eagle\n{FFD700}2.{ffffff} SAG-Coins\n{FFD700}3.{ffffff} EXP\n{FFD700}4.{ffffff} Bronzine rulete\n{FFD700}5.{ffffff} Sidabrine rulete\n{FFD700}6.{ffffff} Auksine rulete\n{FFD700}7.{ffffff} Seimos talonas\n{FFD700}9. Pagrindinis prizas: Ford Mustang Razor\n\n\n{cccccc}Norint pasukti laimes rata, jums reikes sukimo sertifikato \"Free Fortune Spins\".\nLaimes rata galima sukti neribota skaiciu kartu.\nKiekviena PayDay jums bus suteiktas atsitiktinis skaicius sukimo sertifikatu laimes ratui!", "Toliau", "Uzdaryti");
		}
		else if(IsPlayerInRangeOfPoint(playerid, 1, 2266.3496, -831.1735, 1406.2732))
		{
		    format(global_str, sizeof(global_str), "{FFD700}-{ffffff} Kiekviena savaite vyksta unikalio automobilio loterija.\n\nSiuo metu automobilis, kuri galite gauti is laimes rato - {FFD700}Lamborghini Countach{ffffff}.\n\nDaugiau informacijos apie laimes rata galite gauti ant Pickup prie pat rato.");
			ShowPlayerDialog(playerid, 1234, DIALOG_STYLE_MSGBOX, "{BFBBBA}{FFD700}Laimes rato automobilis", global_str, "Uzdaryti", "");
		}
	}

    if newkeys == PRESS_ALT *then
	{
		if(IsPlayerInRangeOfPoint(playerid, 1, 720.7039,-679.7466,3047.3120))
		{
			f(global_str, 1954, "\
			{ffffff}Sveiki, pradedantysis arba jau pazenges zaidejas.\n\
			Patekote i parduotuve 'Aksesuaru gaudymas'. Sios parduotuves esme yra labai paprasta.\n\
			Kiekviena valanda atsiranda {ae433d}1 {ffffff}atsitiktinis {ae433d}naujas {ffffff}aksesuaras.\n\
			Sio aksesuaro kaina priklauso nuo jo retumo.\n\
			Norint isigyti aksesuara, reikia ne tik prieiti prie kasos ir paspausti {ae433d}ALT{ffffff}\n\
			bet ir ivesti CAPTCHA greiciau nei kiti zaidejai, kurie bando sugauti.\n\n\
			Manau, trumpai paaiskinau sios parduotuves esme. Sekmes gaudant!");

			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, (str_f("{cccccc}Aksesuaru gaudymas | {ae433d}San Andreas Gyvenimas %s", Mode_City)), global_str, !"Supratau", !"Uzdaryti");
		}
		else if(IsPlayerInRangeOfPoint(playerid, 1, 722.0730,-671.2625,3047.3120)) SPD(playerid, 2008, 2, (str_f("Aksesuaru yra %d", AksLovlya[BizEntered[playerid]])), "Nusipirkti atsitiktini aksesuara", "Isrinkti", "Atsaukti");
	}

    if(newkeys == PRESS_ALT)
    {
        new type = 0;
        if(IsPlayerInRangeOfPoint(playerid, 1.0, 1517.4783, 1436.0298, 10.9406)) J_SetPlayerPos(playerid, 1288.0322, 315.8082, 19.5547);
        else if(IsPlayerInRangeOfPoint(playerid, 1.0, 1288.0322, 315.8082, 19.5547)) J_SetPlayerPos(playerid, 1517.4783, 1436.0298, 10.9406, 68, 1);
        else if(IsPlayerInRangeOfPoint(playerid, 3.0, 1522.6383, 1425.1490, 10.9406)) type = 1;
        else if(IsPlayerInRangeOfPoint(playerid, 3.0, 1532.1292, 1425.1183, 10.9406)) type = 2;
        else if(IsPlayerInRangeOfPoint(playerid, 3.0,1532.1077, 1447.2823, 10.9406)) type = 3;
        else if(IsPlayerInRangeOfPoint(playerid, 3.0,1522.6000, 1447.5934, 10.9406)) type = 4;
        if(type > 0)
        {
            SetPVarInt(playerid, "idOpenObmen", type-1);
            SPD(playerid, 4078, DIALOG_STYLE_INPUT, "Turto mainu pasiulymas", "{FFFFFF}Iveskite zaidejo ID, kuriam norite pasiulyti turto mainus:", !"Toliau", !"Uzdaryti");
        }
    }
    if newkeys == PRESS_ALT *then
        if IsPlayerInRangeOfPoint(playerid, 2, 1147.1647, -1423.3448, 16.0686) *then
	 		return SPD(playerid, 17123, DIALOG_STYLE_LIST, !"Daiktu pirkimas", !"[1] Nusipirkti naujus aksesuarus\n[2] Nusipirkti naujus automobilius\n[3] Nusipirkti naujus skinus\n[4] Keitimas BTC i SAG-Coins\n[5] Keitimas VC i SAG-Coins", !"Isrinkti", !"Atsaukti");
	/*Auto-invite*/
	if newkeys == PRESS_ALT *then
	{
		new position_ainvite = IsPlayerInRangeOfPoint(playerid, 1.5, -82.8856, 1209.2118, 19.7422) or
							   IsPlayerInRangeOfPoint(playerid, 1.5, -1995.5789,137.5688,27.6875) or
							   IsPlayerInRangeOfPoint(playerid, 1.5, 1773.8164,-1900.8397,13.5502) or
							   IsPlayerInRangeOfPoint(playerid, 1.5, 2823.8813,1295.2294,10.7633) or
							   IsPlayerInRangeOfPoint(playerid, 1.5, 1157.5122,-1748.6414,13.5703);

		if position_ainvite *then
		{
			if !status_autoinvite *then return SendBotMessage(playerid, "Atsiprasau, negaliu padeti!"), SCM(playerid, COLOR_RED, "[Klaida] {FFFFFF}Auto-invite uzdarytas serverio administracijos.");
			if PI[playerid][pMember] *then return SendBotMessage(playerid, "Jus jau priklausote organizacijai!");
		    return SPD(playerid, 8022, DIALOG_STYLE_MSGBOX, "Auto-invite (Klausimai)", "{FFFFFF}Sveiki. Pries priimant jus i organizacija, turite atsakyti i 5 klausimus.\nJei pasiruose, paspauskite \"Toliau\"", "Toliau", "Uzdaryti");
		}
	}
	if newkeys == PRESS_ALT *then
	{
		if IsPlayerInRangeOfPoint(playerid, 2.0, 1989.9951, -1991.4318, 13.5469) *then
			return callcmd::dm(playerid);

	}

	if newkeys == KEY_ACCELERATE && !IsPlayerInAnyVehicle(playerid) *then/*SKATE*/
	{
		if addskate[playerid] == 1 && !IsPlayerInWater(playerid) *then
		{
		    if CountVehicles() >= 1999 or AnimPlayed{playerid} or !(GetPlayerState(playerid) == 1) *then
				return SendErrorMessage(playerid);

		    if Int_GetPlayerData(playerid, !"skatewait") > Global_Time *then
				return SCMF(playerid, COLOR_OLDRED, "[Klaida] {FFFFFF}Negalite taip daznai naudoti riedlentes. Laukite %d sek.", Int_GetPlayerData(playerid, !"skatewait") - Global_Time);

		    else if !(GetPlayerInterior(playerid) == 0) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Negalima naudoti interjere!");

			new Float:X, Float:Y, Float:Z, Float:A;

			GetPlayerPos(playerid, X, Y, Z);
			GetPlayerFacingAngle(playerid, A);

			PI[playerid][plveh] = J_AddStaticVehicleEx(15882, X, Y, Z, A, random(127), random(127));
			PutPlayerInVehicle(playerid, PI[playerid][plveh], 0);

			addskate[playerid] = 2;
			PlayerPlaySound(playerid, 1131, 0, 0, 0);

			return RemovePlayerAttachedObject(playerid, 6);
		}
	}

	if newkeys == KEY_FIRE *then
	{
	    if !(RandomHouseID[playerid] == -1) && IsPlayerInRangeOfPoint(playerid, 2.0, HouseInfo[ RandomHouseID[playerid] ][hEnter_X], HouseInfo[ RandomHouseID[playerid] ][hEnter_Y], HouseInfo[ RandomHouseID[playerid] ][hEnter_Z]) *then
	    {
	        RandomHouseID[playerid] = -1;

	        return ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
 		}
	}

	if newkeys == PRESS_ALT *then
	{
     	if IsPlayerInRangeOfPoint(playerid, 1.0, -2682.6814, 797.2183, 1501.0259) *then
     	    callcmd::top(playerid);

        if IsPlayerInRangeOfPoint(playerid, 1.0, -2682.5259, 795.9078, 1501.0259) *then
		{
		    new day, num;
            getdate(_, _, day);

            if PI[playerid][pLarecOligarch] == day *then
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus jau siandien gavote \"Skrynia Oligarcho\", ateikite rytoj.");

		    for new i; i < OWNABLEHOUSES; i++ do
				if GetString(HouseInfo[i][hOwner], PN(playerid)) *then num++;

			if num < 4 *then
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite 4 namu.");

			PI[playerid][pLarecOligarch] = day;
			UpdatePlayerDataInt(playerid, "LarecOligarch", day);

		    SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija", !"{FFFFFF}Jus gavote 4 {FFFF00}\"Skrynia Oligarcho\".\n{C0C0C0}Ateikite rytoj ir pasiimkite dar keturias \"Skrynia Oligarcho\" visiskai nemokamai", !"Uzdaryti", !"");
		    AddItem(playerid, 2209, 4);
		}
	}

	if newkeys == PRESS_ALT *then
	{
/*		if IsPlayerInRangeOfPoint(playerid, 1.0, 1777.5724,-1889.3271,13.3875) or
			IsPlayerInRangeOfPoint(playerid, 1.0, 2838.9500,1292.5120,11.3906) or
			IsPlayerInRangeOfPoint(playerid, 1.0, -1996.2001,122.2308,27.6875) or
			IsPlayerInRangeOfPoint(playerid, 1.0, 2227.5225,-1142.9734,25.7969) or
			IsPlayerInRangeOfPoint(playerid, 1.0, 1150.7325,-1747.3101,13.5705) *then */
		{
			if !(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) or AnimPlayed{playerid} *then
				return false;
	/*
			for new i; i < 9; i++ do
				GivePlayerLic(playerid, i);
			SavePlayerLicense(playerid);
			SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Informacija", "\
			{ffffff}Jus gavote pilna licenciju komplekta!\n\
			Dabar jums reikia gauti pasa.\n\
			Pasu skyrius yra miesto savivaldybeje (/gps > Svarbios vietos > Savivaldybe)\n\n\
			{ffff00}Linkime jums malonaus zaidimo {ffffff}San Andreas Gyvenime!\n\
			{ffff00}Jei turite klausimu, kreipkites: {ffffff}/rep", "Aciu", "");
			*/
		}

		if IsPlayerInRangeOfPoint(playerid, 1.5, -1662.1952,-246.4758,14.1484) && !(HouseEntered[playerid] == -1) *then
		{
			SetPlayerInterior(playerid, HouseInfo[HouseEntered[playerid]][hInt]);
			return UpdatePlayerPos(playerid, HouseInfo[HouseEntered[playerid]][hExit_X], HouseInfo[HouseEntered[playerid]][hExit_Y], HouseInfo[HouseEntered[playerid]][hExit_Z], -1);
		}

		else if IsPlayerInRangeOfPoint(playerid, 2.0, AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZmap]) && AirDrop[air_Status] *then
		{
			if !AirDrop[air_Open] *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Kontrabandos konteineris dar nenusileido ant zemes!");

			global_str = "{FFFFFF}Prizas\t{FFFFFF}Kiekis\t{FFFFFF}Laikmatis";

			for new i; i < 5; i++ do
				strcat(global_str, (str_f("\n%s (x%d)\t%d\t%s", ItemsInfo[AirDrop[air_Inventory][i]][ItemName2],  AirDrop[air_InventoryReCount][i], AirDrop[air_InventoryCount][i], Global_Time < AirDrop[air_InventoryLastTake][i] ? (str_f("{ae433d}%s", Convert(AirDrop[air_InventoryLastTake][i]-Global_Time))):"{9ACD32}Dabar")));

			return SPD(playerid, 9904, DIALOG_STYLE_TABLIST_HEADERS, !"{FFFFFF}AirDrop |{8C65E9} Turinys", global_str, !"{9ACD32}O", !"{ae433d}X");
		}

		if IsPlayerInRangeOfPoint(playerid, 2.0, -802.6970,2828.7820,1501.9895) *then
		{
			if PI[playerid][pDemorgan] == 0 *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Jus nesate psichiatrijos ligonineje.");

	  		SPD(playerid, 2222, 0, !"", (str_f("\
				{ffffff}Galite isvengti savo laiko psichiatrijos ligonineje!\nIsankstinio paleidimo kaina: {FFCA2A}%d SAG-Eur\n\n\
				{ffffff}Paspauskite {FF2A2A}ENTER{FFFFFF}, jei sutinkate su paleidimu", (PI[playerid][pDemorgan]/100*10))), !"Iseiti", !"Atsaukti");
		}

		else if !(BizEntered[playerid] == -1) *then
		{
			if IsPlayerInRangeOfPoint(playerid, 1.0, 1525.2045, 1436.7594, 10.9674) or IsPlayerInRangeOfPoint(playerid, 1.0, 1525.1495, 1439.1144, 10.9674) *then
			{
				if !GetString(BizData[BizEntered[playerid]][bOwner], PlayerName[playerid]) && !GetString(BizData[BizEntered[playerid]][bZam], PlayerName[playerid]) *then
					return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Prieinama tik lombardo savininkui ir pavaduotojui.");

				new data = (IsPlayerInRangeOfPoint(playerid, 1.5, 1525.2045, 1436.7594, 10.9674));

				if data *then
					UpdatePlayerPos(playerid, 1525.1495, 1439.1144, 10.9674);
				else
					UpdatePlayerPos(playerid, 1525.2045, 1436.7594, 10.9674);
			}
			else if IsPlayerInRangeOfPoint(playerid, 1.0, 1531.2493,1445.7972,10.9674) *then
			{
				if !GetString(BizData[BizEntered[playerid]][bOwner], PlayerName[playerid]) && !GetString(BizData[BizEntered[playerid]][bZam], PlayerName[playerid]) *then
					return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Prieinama tik lombardo savininkui ir pavaduotojui.");

//				return ShowLombardMenu(playerid);
			}
		}

		if IsPlayerInRangeOfPoint(playerid, 1.0, 1118.0151, -1432.4603, 15.7969) *then
			return SPD(playerid, 15072, DIALOG_STYLE_LIST, !"Pasirinkite sarasa", !"Vidutines prekiu pardavimo kainos\nVidutines prekiu supirkimo kainos", !"Isrinkti", !"Uzdaryti");

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 334.1906, -1806.6876, 4.5385) *then
			return SPD(playerid, 25111, DIALOG_STYLE_LIST, !"Automobilinis aukcionas", !"{ffffff}{ae433d}[1] {ffffff}Informacija\n{ae433d}[2] {CCCCCC}Atsiimti isigyta transporto priemone", !"Isrinkti", !"Atsaukti");

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 333.5765, -1813.9194, 4.6678) *then
			return CreateShopTD(playerid, 8);

		else if IsPlayerInRangeOfPoint(playerid, 2.5, -413.8500, 684.7383, 1601.9966) *then
		    return CreateShopTD(playerid, 10);

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 2571.3157, 978.1287, 10.9932) *then
			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija apie salona", !"{95D1CC}Siame tuning salone galite isigyti prekiu, kurios zymiai pagerins jusu automobilio\ntechnines savybes, taip pat vizualines mofidikacijas prekiu: tamsinimo pleveles, vinilu, unikaliu disku ir daug\nkitu dalyku, kurie isskirs jusu automobili is minios!\n\n{B3541E}Apsilankyti salone galima tik vairuojant pritaikyta automobili, pasiekiama zaidziant su SAG Launcher\n\n{F0BB62}Du kartus per valanda, 25-a ir 55-a minute, tuning salonas uzdaromas penkioms minutems, kad butu papildytos tuning komponentai!\nPo papildymo tuning salone atsiras 3 atsitiktines techninio tuning dalys,\n3 atsitiktines vizualinio tuning dalys ir 3 atsitiktiniai vinilai!", !"Iseiti", !"");

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 1148.6715, -1308.8401, 1019.4266) *then
			return SPD(playerid, 15310, DIALOG_STYLE_MSGBOX, !"Greitas gydymas", !"{ffffff}Ar tikrai norite atlikti\ngreitosios reabilitacijos uz {ffff00}$50000{ffffff}?", !"Taip", !"Uzdaryti");

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 1487.6162, 1519.0647, 1601.0859) or IsPlayerInRangeOfPoint(playerid, 1.0, 1487.5302, 1519.0012, 1604.6797) or IsPlayerInRangeOfPoint(playerid, 1.0, 1487.4905, 1519.0012, 1608.2207) or IsPlayerInRangeOfPoint(playerid, 1.0, 1487.4507, 1519.0012, 1611.7803) *then
			return SPD(playerid, 7677, DIALOG_STYLE_LIST, !"", !"{6DCB33}1{FFFFFF} aukstas\n{6DCB33}2{FFFFFF} aukstas\n{6DCB33}3{FFFFFF} aukstas\n{6DCB33}4{FFFFFF} aukstas", !"Priimti", !"Atsaukti");

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 2266.3496, -831.1735, 1406.2732) *then
			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"{FFD700}Automobilis laimes ratas", !"{FFD700}-{ffffff} Karta per savaite vyksta unikalios masinos loterija.\n\nSiuo metu automobilis, kuri galite gauti is laimes rato - {FFD700}Ford Mustang Razor{ffffff}.\n\nDaugiau informacijos apie laimes rata galite gauti ant Pickup prie pat rato.", !"Uzdaryti", !"");

		if IsPlayerInRangeOfPoint(playerid, 1.0, 1535.0533, 1281.0515, 10.9075) *then
		{
		    if SkladEntered[playerid] *then
		    {
				new Float:x, Float:y, Float:z;
				x = Coords_SkladExit[SkladEntered[playerid]-1][0];
				y = Coords_SkladExit[SkladEntered[playerid]-1][1];
				z = Coords_SkladExit[SkladEntered[playerid]-1][2];
		        SetPlayerPos(playerid, x, y, z);
		        SetPlayerInterior(playerid, 0);
		        SetPlayerVirtualWorld(playerid, 0);
		    }
		    SkladEntered[playerid] = 0;
		    SkladEntered2[playerid] = -1;
		}
		if IsPlayerInRangeOfPoint(playerid, 1.0, 1534.5374, 1287.7101, 10.9075) *then
		{
		    SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Naudinga informacija", "\
            {54b9d0}Sandelio patalpos:\n\
            {FFFFFF}Mieste yra is viso 10 sandelio patalpu,\n\
            kiekvienoje patalpoje yra 50 sandeliu, kuriuos galima isigyti ir parduoti\n\
            bet kuriuo metu valstybei arba zaidejui bunant sandelyje.\n\n\
            {54b9d0}Privilegijos tureti savo sandeli:\n\
            {FFFFFF}- 120 langeliu skirtingiems daiktams laikyti;\n\
			- jokio sandelio mokescio, jis niekada nebus prarastas;\n\
			- galimybe nustatyti individualu prieigos koda\n\
			ir perduoti ji draugams, kad jie galetu naudotis\n\
			jusu sandeliu (ji galima nustatyti sandelio meniu)", "Uzdaryti", "");
		}

		for new i; i < OWNABLESKLADS; i ++ do
		{
			if SkladEntered[playerid] > 1 *then
				SetPVarInt(playerid, "idsklad", (i+(50*SkladEntered[playerid]))-50);
			else
				SetPVarInt(playerid, "idsklad", i);

			new idsklada = GetPVarInt(playerid, "idsklad");

			new o = idsklada;

			if IsPlayerInRangeOfPoint(playerid, 1.0, SkladData[o][skCoords][0], SkladData[o][skCoords][1], SkladData[o][skCoords][2]) *then
			{
   			 	if GetString(SkladData[o][skOwner], "The State") *then
			       	return SPDF(playerid, 25201, DIALOG_STYLE_MSGBOX, "Sandelio pirkimas", "{FFFFFF}Sandelio patalpa: {54b9d0}¹%d\n{FFFFFF}Sandelis: {54b9d0}¹%d\n{FFFFFF}Kaina: {54b9d0}%d$\n\n{FFFFFF}Ar tikrai norite isigyti si sandeli?", "Isigyti", "Uzdaryti", SkladEntered[playerid], SkladData[idsklada][skNumber], SkladData[idsklada][skCost]);

    			if !GetString(SkladData[o][skOwner], PN(playerid)) *then
			    {
			        if(SkladDoors[o][spdOpen])
					{
						if(!LoginInSklad[playerid][o]) return false;
						else
						{
							MoveDynamicObject(SkladDoorObject[idsklada], SkladDoors[o][spdX], SkladDoors[o][spdY], SkladDoors[o][spdZ], 4, SkladDoors[o][spdrX], SkladDoors[o][spdrY], SkladDoors[o][spdrZ]);
							SkladDoors[o][spdOpen] = false;
							Delete3DTextLabel(Sklad3DText[o]);
							DestroyPickup(SkladPickInt[o]);
							return LoginInSklad[playerid][o] = false;
						}
					}

					SkladEntered2[playerid] = o;

					if GetPVarInt(playerid, "time_sklad") > Global_Time *then
				    	return SCM(playerid, COLOR_OLDRED, "[Klaida] {FFFFFF}Prieigos koda galima ivesti viena karta per minute!"), SetPVarInt(playerid, "idsklad", -1);
					return SPD(playerid, 25199, DIALOG_STYLE_INPUT, "Prieiga draudziama!", "{FFFFFF}Noredami atidaryti si sandeli, iveskite specialu {54b9d0}prieigos koda{ffffff}:", "Atidaryti", "Uzdaryti");
			    }

			    else
				{
			        if(SkladDoors[idsklada][spdOpen] && LoginInSklad[playerid][o])
					{
						MoveDynamicObject(SkladDoorObject[o], SkladDoors[o][spdX], SkladDoors[o][spdY], SkladDoors[o][spdZ], 4, SkladDoors[o][spdrX], SkladDoors[o][spdrY], SkladDoors[o][spdrZ]);
						SkladDoors[o][spdOpen] = false;
						Delete3DTextLabel(Sklad3DText[o]);
						DestroyPickup(SkladPickInt[o]);
						return LoginInSklad[playerid][o] = false;
					}

					MoveDynamicObject(SkladDoorObject[o], SkladDoors[o][spdX], SkladDoors[o][spdY], SkladDoors[o][spdZ]+4, 4, SkladDoors[o][spdrX], SkladDoors[o][spdrY], SkladDoors[o][spdrZ]);
					SkladDoors[o][spdOpen] = true;
					Sklad3DText[o] = Create3DTextLabel("Paspauskite ALT, kad\natidarytumete sandelio meniu", COLOR_GREY, sklpos[o][SkladPositionX], sklpos[o][SkladPositionY], sklpos[o][SkladPositionZ], 5.0000, SkladData[o][skWorld]);
					SkladPickInt[o] = CreatePickup(1277, 23, sklpos[o][SkladPositionX], sklpos[o][SkladPositionY], sklpos[o][SkladPositionZ], SkladData[o][skWorld]);
					LeftSklad[playerid][o] = 10;
					SklNum[playerid][o] = idsklada;
					SkladEntered2[playerid] = idsklada;
					return LoginInSklad[playerid][o] = true;
				}
			}

            for(new newid; newid < sizeof(sklpos); newid++)
            {
				if GetPlayerVirtualWorld(playerid) == SkladData[o][skWorld] *then
				{
					if IsPlayerInRangeOfPoint(playerid, 1.0, sklpos[newid][SkladPositionX], sklpos[newid][SkladPositionY], sklpos[newid][SkladPositionZ]) *then
					{
   					 if SkladDoors[o][spdOpen] *then
					    {
					        if LoginInSklad[playerid][idsklada] or GetString(SkladData[o][skOwner], PN(playerid)) *then
								return SPD(playerid, 25200, DIALOG_STYLE_LIST, "Sandelio meniu", "Perziureti sandelio turini\nPakeisti prieigos koda\nParduoti sandeli valstybei\nParduoti sandeli zaidejui", "Isrinkti", "Uzdaryti");
						}
					}
				}
			}
		}

		for new i; i < sizeof Coords_SkladExit; i++ do
		{
		    if IsPlayerInRangeOfPoint(playerid, 6.0, Coords_SkladExit[i][0], Coords_SkladExit[i][1], Coords_SkladExit[i][2]) *then
		    {
		        UpdatePlayerPos(playerid, 1535.0533, 1281.0515, 10.9075);

			    SkladEntered[playerid] = 1 + i;

			    SetPlayerInterior(playerid, 104), SetPlayerVirtualWorld(playerid, 101 + i);
		    }
		}

		if IsPlayerInRangeOfPoint(playerid, 2.0, -1379.6326, -2161.7012, 22.2144) *then
	    {
	        if FP_Data[playerid][F_FAMILY_ID] == -1 *then
				return SendBotMessage(playerid, !"Tu nepriklausai ne vienai seimai!");

	        return SPD(playerid, 4710, DIALOG_STYLE_LIST, !"{FFFFFF}Isrinkite | {ae433d}Piktuju rumai", !"{FFFFFF}Pereiti prie prekiu pasirinkimo\n{FFFFFF}Perziureti TOP 10 seimu su piktaja reputacija ", !"Isrinkti", !"Atsaukti");
	 	}

		else if IsPlayerInRangeOfPoint(playerid, 1.0, 1137.5560, -1489.6359, 15.7969) *then
		{
		    if ConceptCount <= 0 *then
				return SPDF(playerid, 0, DIALOG_STYLE_MSGBOX, !"Concept Car Luxury", "{C87D6D}Siuo metu skryniu nera\n\n{ffffff}Kitas nauju skryniu pristatymas bus {cccccc}%d:00.\n\n{cccccc}Centrineje San Fierro rinkoje taip pat yra\nstendas su skryniomis, galbut ju ten dar liko.\nJuos galima rasti /gps > Ivairus > Stendai Concept Luxury Car", !"Uzdaryti", !"", ConceptTime);

