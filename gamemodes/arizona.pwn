}

stock LoadPlayerAttention()
{
	for(new i;i < sizeof(BarrierInfo);i ++)
		BarrierInfo[i][brZone] = CreateDynamicSphere(BarrierInfo[i][brPos_X], BarrierInfo[i][brPos_Y], BarrierInfo[i][brPos_Z], 3, -1, -1);

	for(new i; i < sizeof(parking); i++)
		parking[i][prZone] = CreateDynamicSphere(parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z], 2, -1, -1);

	for(new i; i < 48; i++)
		LavkaZone[i] = CreateDynamicSphere(LavkaPos[i][0],LavkaPos[i][1],LavkaPos[i][2], 1, -1, -1);

	for(new i; i < 48; i++)
		LavkaZone1[i] = CreateDynamicSphere(LavkaPos[i][3],LavkaPos[i][4],LavkaPos[i][5], 1.5, -1, -1);

	for(new i; i < sizeof(Bankomats); i++)
		BankZone[i] = CreateDynamicSphere(Bankomats[i][0], Bankomats[i][1], Bankomats[i][2], 1.5, -1, -1);

	for(new i; i < sizeof(AttentionOther); i++)
		AttentionZone[i] = CreateDynamicSphere(AttentionOther[i][AttentionPos][0], AttentionOther[i][AttentionPos][1], AttentionOther[i][AttentionPos][2], 1.5, -1, -1);

	for new i; i < MAX_LEVEL_GARAGES; i ++ do
		GarageZoneInt[i] = CreateDynamicSphere(GaragesInteriors[i][e_GARAGE_INTERIOR_X], GaragesInteriors[i][e_GARAGE_INTERIOR_Y], GaragesInteriors[i][e_GARAGE_INTERIOR_Z], 2, -1, -1);

	for new i; i < MAX_AUTO_BAZAR; i ++ do
	    AutoBazaMobileArea[i] = CreateDynamicSphere(autoBazarInfo[i][autoBazarPosX], autoBazarInfo[i][autoBazarPosY], autoBazarInfo[i][autoBazarPosZ], 1.5, -1, -1);

	for new i; i < sizeof FuelInfo; i ++ do
	    FuelZone[i] = CreateDynamicSphere(FuelInfo[i][fPos_X], FuelInfo[i][fPos_Y], FuelInfo[i][fPos_Z], 5.0, -1, -1);

	for new i; i < sizeof BuildInfo; i ++ do
	    BuildZone[i] = CreateDynamicSphere(BuildInfo[i][Posb_X],BuildInfo[i][Posb_Y],BuildInfo[i][Posb_Z], 2, -1, -1);

    for(new i; i < sizeof(HealInfo); i ++)
        HealZone[i] = CreateDynamicSphere(HealInfo[i][hCP][0],HealInfo[i][hCP][1],HealInfo[i][hCP][2], 1, -1, -1);

	for new i; i < sizeof DoorInfo; i ++ do
	    DZone[i] = CreateDynamicSphere(DoorInfo[i][dPos][0],DoorInfo[i][dPos][1],DoorInfo[i][dPos][2], 1.2, DoorInfo[i][dWorld], DoorInfo[i][dInterior]);
}

stock UpdateHouseGarage(house)
{
	if IsValidDynamicPickup(HouseGaragePickup[house]) *then
		DestroyDynamicPickup(HouseGaragePickup[house]);

	if IsValidDynamic3DTextLabel(HouseGarage3DText[house]) *then
		DestroyDynamic3DTextLabel(HouseGarage3DText[house]);

	if IsValidDynamicArea(GarageZone[house]) *then
		DestroyDynamicArea(GarageZone[house]);

	if HouseInfo[house][hGarage] *then
	{
		HouseGaragePickup[house] = CreateDynamicPickup(
			19133,
			0,
			HouseInfo[house][hGarage_X],
			HouseInfo[house][hGarage_Y],
			HouseInfo[house][hGarage_Z],
			0, 0, -1, 25.0
		);

		f(global_str, 84,
			"{FFFFFF}Garazas ( %i )\n\
			Ieiti: {f4e451}ALT{FFFFFF}\n\
			Ivaziuoti: {f4e451}ALT",
			house
		);

		HouseGarage3DText[house] = CreateDynamic3DTextLabel(global_str,-1,
				HouseInfo[house][hGarage_X],
				HouseInfo[house][hGarage_Y],
				HouseInfo[house][hGarage_Z],
				10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0
		);

		GarageZone[house] = CreateDynamicSphere(HouseInfo[house][hGarage_X], HouseInfo[house][hGarage_Y], HouseInfo[house][hGarage_Z], 2, -1, 0);
	}
	return true;
}

stock GiveRub(playerid, money)
{
	if !IsPlayerLogged{playerid} *then return 0;
	PI[playerid][pRoubles] += money;
	f(global_str, 100, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~%d SAG-Eur", money);
	GameTextForPlayer(playerid, global_str, 3000, 3);
	UpdatePlayerDataInt(playerid, "Eurs", PI[playerid][pRoubles]);
	return 1;
}
