stock TextFind(text[],findtext[]) return strfind(text, findtext) != -1;

stock ResetSpawnInfo(playerid, team)
{
	new skin = GetSkinOfPlayer(playerid);
	SetSpawnInfo( playerid, 255, skin, SpawnInfo[team][0], SpawnInfo[team][1], SpawnInfo[team][2], SpawnInfo[team][3], 0, 0, 0, 0, 0, 0);
	return 1;
}
stock ValidChar(mailchar)
{
	if(
	(mailchar >= 'A' && mailchar <= 'Z') 	||
	(mailchar >= 'a' && mailchar <= 'z') 	||
	(mailchar >= '0' && mailchar <= '9') 	||
	(mailchar == '-') || (mailchar == '_') 	||
	(mailchar == '@') || (mailchar == '.'))return 1;
	return 0;
}
stock IsValidEMail(email[])
{
	new bool:Succes = true;
	new bool:Good;
	for(new i;i < strlen(email);i ++)
	{
	    if(email[i] == '@')
		{
		    if(!Good) Good = true;
		    else
			{
				Good = false;
		    	break;
			}
		}
	    if(!ValidChar(email[i])) Succes = false;
	}
	if(!Good) Succes = false;
	if(!TextFind(email,".ru") && !TextFind(email,".com") && !TextFind(email,".ua") && !TextFind(email,".su")) Succes = false;
	if(!TextFind(email,"@")) Succes = false;
  	return Succes;
}

stock ShowRegisterDialog(playerid, rstate)
{
	switch rstate do  {
	    case 1: ShowGrandRegiserDialog(playerid);
	    case 2: SPD(playerid, 1, DIALOG_STYLE_LIST, !"{E88813}[2/5] Pasirinkite savo lyti","Vyras\nMoteris", !"Priimti", !"Iseiti");
		case 3: SPD(playerid, 1, DIALOG_STYLE_LIST, !"{E88813}[3/5] Pasirinkite odos spalva","{FFCC99}Sviesus\n{FFCC99}Tamsus", !"Priimti", !"Iseiti");
		case 4: SPD(playerid, 1, DIALOG_STYLE_LIST, !"{E88813}[4/5] Is kur jus apie mus suzinojote?","Skirtukas 'Hosted'\nIs draugu\nPortaluose/forumuose\nPaieskos sistemoje\nKita", !"Priimti", !"Iseiti");
	    case 5: SPD(playerid, 1, DIALOG_STYLE_INPUT, !"{E88813}[5/5] Iveskite pakviesto asmens Nick?","{FFFFFF}Iveskite zaidejo Nick, kuris pakviete jus.\nPavyzdys: {E88813}Developer\n\n{42B02C}Pasiekus 30 lygi, pakvietes zaidejas gaus 30.000$.\nJei pakvietes zaidejas nustate grazinima referalui, lesos bus pervestos i jusu saskaita", !"Priimti", !"Iseiti");
        default: return 0;
	}
	return 1;
}

stock CheckPassword(pass[])
{
	for(new i; i < strlen(pass); i ++)
	{
	    if( (pass[i] >= 'a' && pass[i] <= 'z') ||
		(pass[i] >= 'A' && pass[i] <= 'Z') ||
		(pass[i] >= 'à' && pass[i] <= 'ÿ') ||
		(pass[i] >= 'À' && pass[i] <= 'ß') ||
		(pass[i] >= '0' && pass[i] <= '9')  ) continue;
		else return 0;
	}
	return 1;
}
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	// --- poker (filterscripts/poker.amx) ---------------------------------------------
	// This callback returns 1 for every dialog, so SA-MP never passes dialog answers on to
	// filterscripts. The two poker input dialogs are handed to the poker filterscript here.
	if(dialogid == POKER_DIALOG_BUYIN || dialogid == POKER_DIALOG_RAISE)
	{
		new poker_text[129];
		strcat(poker_text, inputtext, sizeof poker_text);
		if(poker_text[0] == EOS) poker_text = " "; // CallRemoteFunction crashes the server on an empty string
		CallRemoteFunction("PokerDialogResponse", "iiiis", playerid, dialogid, response, listitem, poker_text);
		return 1;
	}
	// ----------------------------------------------------------------------------------
	static inputtextsave[256];
	inputtextsave[0] = EOS; global_str = "";

	mysql_escape_string(inputtext, inputtextsave);

	for new i; i < strlen(inputtextsave); i++ do
	{
		switch inputtextsave[i] do
		{
			case 'A'..'Z', 'a'..'z', 'À'..'ß', 'à'..'ÿ', '0'..'9', ' ', '>', '<', '(', ')', '/', '+', '-','_', '?', '!', '.', ',', '@': continue;
			default: inputtextsave[i] = ' ';
		}
	}

	for new i; i < strlen(inputtextsave); i ++ do
	{
		if inputtextsave[i] == '%' *then inputtextsave[i] = '#';
		else if inputtextsave[i] == '{' && inputtextsave[i+7] == '}' *then strdel(inputtextsave, i, i+8);
	}

	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	DeletePVar(playerid, "DialogOpen");
	switch dialogid do
	{
	    case 6885:
	    {
	        if(!response) return 1;
	        if(PI[playerid][pMoney] < 70000) return SCM(playerid, COLOR_GREY, !"[Klaida] Paslaugos kaina 70.000$!");
			if !IsPlayerInAnyVehicle(playerid) *then
				return SCM(playerid, COLOR_GREY, !"[Klaida] Reikia buti transporte!");
			if(!GetString(CarInfo[GetVehicleID(GetPlayerVehicleID(playerid))][cOwner], PN(playerid)))
				return SCM(playerid, COLOR_GREY, !"Jus turite sedeti asmenineje transporto priemoneje");
			ResetNewTune(playerid, GetPlayerVehicleID(playerid));
			GiveMoney(playerid, -70000);
	        return 1;
	    }
	    case 1242:
	    {
	        if !response *then
	            return false;

			switch listitem do
			{
				case 0:
				{
		            if(PI[playerid][pWanted] > 0)
					{
						PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
						PI[playerid][pJailTime] = PI[playerid][pWanted] * 540;
						PI[playerid][pBailPrice] = PI[playerid][pWanted] * 200;
						if(GetCount(playerid, 525) >0 || GetCount(playerid, 553) >0) SCM(playerid,COLOR_RED,!"[Informacija] {FFFFFF}Jums ateme narkotikus ir sovinius!");
		                if(!IsPlayerInRangeOfPoint(playerid, 10.0, -456.2372,2173.8435,1601.0908))
		                {
							new jrand = random( 2 );
							SetSpawnInfoEx(playerid, GetPlayerSkin(playerid), JailPos[jrand][0],JailPos[jrand][1],JailPos[jrand][2], 0.0);
						}
						else SetSpawnInfoEx(playerid, GetPlayerSkin(playerid), JailPos[2][0],JailPos[2][1],JailPos[2][2], 0.0);
						_ResetGun(playerid);
						SetOldWanted(playerid, 540);
						PI[playerid][pWanted] = 0;
						SetPlayerWantedLevel(playerid,0);
						PlayerSpawn(playerid);
						DeleteItem(playerid, 525, GetCount(playerid, 525));
						DeleteItem(playerid, 553, GetCount(playerid, 553));
						f(global_str, 150, ">> Jus savanoriskai sedote i kalejima %d minuciu.", (PI[playerid][pJailTime]/60));
						SCM(playerid, COLOR_RED, global_str);
						SCM(playerid, COLOR_LIGHTBLUE, ">> Naudokite /advokats, kad surastumete advokata, kuris jums pades isvykti is cia!");
						if(IsPlayerToKvadrat(playerid,-891.3302,-2950.0190,2915.9917,560.3257)) PI[playerid][pPrison]=1,SetPlayerVirtualWorld(playerid, 11);
						else if(IsPlayerToKvadrat(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) PI[playerid][pPrison]=3,SetPlayerVirtualWorld(playerid, 13);
						else PI[playerid][pPrison]=2,SetPlayerVirtualWorld(playerid, 12);
						SetPlayerInterior(playerid, 6);
						TogglePlayerControllable(playerid, true);
					}
					else SendBotMessage(playerid,"Idomu, koki nusikaltima ketinate prisipazinti, jei jusu nera ieskomu sarase?");
				}
				case 1: interface_Number(playerid);
				case 2:
				{
				    new id;
				    global_str = "Numeriu zenklas\tValstybe\tRegionas\n";

				    static const countryName[][] = {"None", "Kazachstanas", "Rusija", "Ukraina", "Baltarusija", "Jungtines Amerikos Valstijos"};

					for new i; i < PI[playerid][pInvCell]; i ++ do
					{
					    if(Inventory[playerid][0][i] == 2911)
					    {
					        id ++;
					        spdList(playerid, id, i);
