CMD:removetune(playerid, params[])
{
	if !CheckAdm(playerid, 3) *then return false;
	extract params -> new vehicle; else
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Naudokite: /removetune [transporto ID]");
	if !IsAOwnableCar(vehicle) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Istrinti tuninga galima tik asmeninio transporto zaidejo.");
	new car = GetVehicleID(vehicle);
	for new i; i < 10; i++ do
		InstallTun(vehicle, i, 1), CarInfo[car][TuningComp][i] = CarInfo[car][InvCar][i] = 0;
	SCMF(playerid, COLOR_GREEN, "Jus sekmingai istrynete visa tuninga transportui ID: %d (savininkas %s)!", vehicle, CarInfo[car][cOwner]);
	f(global_str, 145, "[%s] istryne visa tuninga transportui ID: %d (savininkas %s)", PN(playerid), vehicle, CarInfo[car][cOwner]);
	SendAdminsMessage(COLOR_GREY, global_str);
	SaveInvCar(vehicle);
	f(global_str, 256, "Administratorius <a href=../pages/user?name=%s>%s</a> istryne transporto tuninga <a href=../pages/carlog.php?id=%d>¹%d</a>",
	PN(playerid), PN(playerid), CarInfo[car][cID], CarInfo[car][cID]);
	aml(global_str, 5, PN(playerid),"");
	return false;
}
