	return true;
}
CMD:restartreport(playerid)
{
	if(TotalReport <= 0) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Reportas svarus!");
	TotalReport = 0;
	foreach(new i: Player)
	{
		if(ReportON{i})
		{
			ReportON{i} = ReportSlot{i} = false;
			if(ReportID[i] != -1)
			{
				ReportID[ReportID[i]] =
				ReportID[i] = -1;
			}
		}
	}
	f(global_str, 145, "[A] %s[%d] paleido is naujo reporta!", PN(playerid), playerid);
	SendAdminsMessage(COLOR_GREY, global_str);
	return 1;
}
