	return -1;
}
stock UpdateDataInt(id, basename[], fieldss[], data)
{
	f(global_str, 200, "UPDATE `%s` SET `%s` = '%d' WHERE `ID` = '%d'", basename, fieldss, data, id);
	mysql_tquery(mysql, global_str);
