CMD:checktime(playerid, params[])
{
	if(PI[playerid][pAdmin] < 5) return SCM(playerid, COLOR_RED, "");
	extract params -> new id; else return SCM(playerid, COLOR_RED, !"Naudokite: /checktime [id]");
