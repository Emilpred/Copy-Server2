	for(new i; i < sizeof(AttentionOther); i++)
	{
	    if AttentionOther[i][AttentionVWNotINT] *then
	    {
			if areaid == AttentionZone[i] *then
			{
			    if GetPlayerMobileLauncher(playerid) *then
			        ShowButton(playerid, AttentionOther[i][AttentionType]);

				else if IsPlayerCefInit(playerid, 1) *then PlayerNotification(playerid, "info", "Paspauskite noredami saveikauti", (str_f("Noredami saveikauti - %s", !AttentionOther[i][AttentionType] ? "ALT" : AttentionOther[i][AttentionType] == 1 ? "N" : "ALT")), 2000);
				else ShowAttention(playerid, "Paspauskite noredami saveikauti", (str_f("Noredami saveikauti - %s", !AttentionOther[i][AttentionType] ? "ALT" : AttentionOther[i][AttentionType] == 1 ? "N" : "ALT")));
			}
	    }
	    else if GetPlayerInterior(playerid) == AttentionOther[i][AttentionINT] && GetPlayerVirtualWorld(playerid) == AttentionOther[i][AttentionVW] *then
	    {
			if areaid == AttentionZone[i] *then
			{
			    if GetPlayerMobileLauncher(playerid) *then
			        ShowButton(playerid, AttentionOther[i][AttentionType]);

				else if IsPlayerCefInit(playerid, 1) *then PlayerNotification(playerid, "info", "Paspauskite noredami saveikauti", (str_f("Noredami saveikauti - %s", !AttentionOther[i][AttentionType] ? "ALT" : AttentionOther[i][AttentionType] == 1 ? "N" : "ALT")), 2000);
				else ShowAttention(playerid, "Paspauskite noredami saveikauti", (str_f("Noredami saveikauti - %s", !AttentionOther[i][AttentionType] ? "ALT" : AttentionOther[i][AttentionType] == 1 ? "N" : "ALT")));
