			ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
			return DeleteItem(playerid, itemid, 1);
		}
        //case 590: return SPD(playerid, 0, 0, !"", !"{FFFFFF}Ar tikrai norite naudoti patobulinima?\n\n{96472f}Panaudojus, visos jusu saskaitos papildymai bus\npadidinti {3bd1b0}4 kartus, {96472f}efekto galiojimo trukme: {3bd1b0}5 dienos\n\n{e94949}Demesio! Efektas negalios per serverio\nadministracijos vykdomas akcijas!", !"Isrinkti", !"Atsaukti");
		case 722,723:
		{
		    if BodyguardOpen{playerid} *then
		        AddBodyguardItem(playerid, itemid, Bodyguard[playerid][bodyguardNpcId], Bodyguard[playerid][bodyguardslotUse], 10);
		}

        case 382..389, 422, 329, 551, 1473..1501:
        {
			HideInvent(playerid);

			if !(PhoneOpen[playerid] == -1) *then
       			return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Jus jau turite atidaryta mobiluji telefona!");

			PhoneColor[playerid] = GetPhoneColorIdByModel(ItemsInfo[Inventory[playerid][0][PickInvent[playerid]]][ItemModel]);
			ShowPhoneTD(playerid, GetPhoneID(Inventory[playerid][0][PickInvent[playerid]]));

			f(global_str, 150, "%s istrauke %s %s is kisenes", PN(playerid), GetPhoneColorNameByModel(ItemsInfo[Inventory[playerid][0][PickInvent[playerid]]][ItemModel]), ItemsInfo[Inventory[playerid][0][PickInvent[playerid]]][ItemNameLavka]);
			ProxDetector(25.0, playerid, global_str, COLOR_ME);

			return SelectTextDraw(playerid, 0x852a18aa);
		}

        case 368,370..381,554..577,703,1592..1596,1259..1330,1351..1358,1628..1800,1969..2013,2095..2097,2222..2233,2513..2526,2549..2581,2766..2778,3034: // sertifikatai
        {
            if !IsPlayerInRangeOfPoint(playerid, 250, -2123.6548,-854.3079,32.0939) *then
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Sertifikata galima aktyvuoti tik autoturguje!");

			else if !IsValidPassport(playerid) *then
				return SCM(playerid,COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite paso, ji galima gauti savivaldybeje");

			else if !IsValidNumberCars(playerid) *then
				return SCM(playerid,COLOR_GREY, !"[Klaida] {FFFFFF}Jusu VIP lygis per zemas, kad turetumete tiek automobiliu!");

			else if CountVehicles() > 1998 *then
				return SCM(playerid, -1, !"Siuo metu to padaryti neimanoma, serveryje per daug masinu!");

			else
			{
			    new ID = PickInvent[playerid],
				IDS = Inventory[playerid][0][ID];

				new car = AddOwnableCar(playerid, ItemsInfo[IDS][ItemModel], PN(playerid));

				if !(car == -1) *then
				{
					Inventory[playerid][0][ID] = Inventory[playerid][1][ID] = 0;

     				SPDF(playerid, 0, 0, !"", GetString(ItemsInfo[IDS][ItemPhoneColor], "Launch") ? "\n{FFFFFF}Sveikiname su gavimu:{73B461} automobilio %s komplektacijoj Launch.{FFFFFF}\n{FFFFFF}Gero zaidimo "Mode_Site"":"\n{FFFFFF}Sveikiname su gavimu: {98FF98}automobilio %s.\n{FFFFFF}Gero zaidimo "Mode_Site"", !"Aciu", !"", ItemsInfo[IDS][ItemName2]);

					if GetString(ItemsInfo[IDS][ItemPhoneColor], "Launch") *then
						CarInfo[car][InvCar][0] = 951,
						OtherInstallTun(OwnableCar[car], 951),
						Streamer_Update(playerid),
						SaveOwnableCar(OwnableCar[car]);

					amlf("<a href=../pages/user?name=%s>%s</a> aktivavo sertifikata automobiliui <a href=../pages/carlog.php?id=%d>%s(%d)</a>", 3, PN(playerid),"", PN(playerid), PN(playerid), ItemsInfo[IDS][ItemModel], ItemsInfo[IDS][ItemName2], ItemsInfo[IDS][ItemModel]);

				}
			}
		}
        case 366:
        {
            if(Int_GetPlayerData(playerid, !"itemtime") > Global_Time)
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Tarp daiktu naudojimo turi praeiti 3 sekundes!");

			SetPVarInt(playerid, !"itemtime", Global_Time+3);
			new Float:Health, Float:X, Float:Y, Float:Z;
			GetPlayerPos(playerid, X, Y, Z);
			Adrenaline[playerid] = CreateDynamicPickup(1241,5, X,Y,Z,GetPlayerVirtualWorld(playerid),GetPlayerInterior(playerid),playerid);

			f(global_str, 80, "%s isgere adrenalino tablete", PN(playerid));
			ProxDetector(25.0, playerid, global_str, COLOR_PURPLE);
			DeleteItem(playerid, 366, 1);

			GetPlayerHealth(playerid,Health);
			UpdatePlayerHealth(playerid, Health <= 50.0 ? Health+50:100.0);

			CallTimeOutFunction("DeletePickup", 2000, 0, "d", playerid);
			ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
			Streamer_Update(playerid);
		}
		case 314: SetPVarInt(playerid, "use_player_Med", 1), ShowActionCef(playerid, "Daikto naudojimas", 5);
        case 319: SetPVarInt(playerid, "use_player_Mask", 1), ShowActionCef(playerid, "Daikto naudojimas", 5);
        case 330: SetPVarInt(playerid, "use_player_Armour", 1), ShowActionCef(playerid, "Daikto naudojimas", 5);
        case 525: SetPVarInt(playerid, "use_player_Drugs", 1), ShowActionCef(playerid, "Daikto naudojimas", 5);

		case 315: eatcheeps(playerid);

        case 317: callcmd::killme(playerid, "");

		case 318: callcmd::repcar(playerid);


		case 320: callcmd::smoke(playerid, "");

		case 321: callcmd::smoke(playerid, "");

		case 322..324:
		{
			NoCloseTD(playerid), ShowRoulette(playerid);

			if itemid == 324 *then
   				OnPlayerClickPlayerTextDraw(playerid, NewRoulette[playerid][25]);

			else if itemid == 323 *then
				OnPlayerClickPlayerTextDraw(playerid, NewRoulette[playerid][20]);

			else
				OnPlayerClickPlayerTextDraw(playerid, NewRoulette[playerid][15]);

			DeletePVar(playerid, "pTimeInv3");
		}

		case 325: callcmd::beer(playerid);

		case 327: SPD(playerid, 2392, 1, !"", !"{FFFFFF}Iveskite{FBAD2F}zaidejo{FFFFFF}ID, kurio numeri norite suzinoti.", !"Priimti", !"Atsaukti");

		case 328: callcmd::break(playerid, "");

		case 331: SPD(playerid, 2393, 1, !"Iveskite spalva", !"{FFFFFF}Iveskite spalva 1 ir spalva 2 per kableli\n{9ACD32}- Pavyzdziui: {0AD6FF}132,132", !"Toliau", !"Atsaukti");

		case 332: callcmd::fillcar(playerid);

		case 521: callcmd::radio(playerid);

		case 522: callcmd::go_fished(playerid, "");

		case 524: callcmd::usebad(playerid, "");

		case 333, 548, 578:
		{
			if IsPlayerInHisVehicle(playerid) *then ChangeModificationCar(playerid);

			return false;
		}

  		case 549: callcmd::jfish(playerid);

        case 552: callcmd::firewood(playerid);

		case 1..311, 1172..1242, 1253..1258, 1331..1340, 2014..2094, 2100..2206, 2234..2271, 2468..2510, 2613..2660, 2779..2795, 2888..2906:
		{
	    	if !(TeamDuty{playerid} or InJob[playerid] or PI[playerid][pDemorgan]) *then
				ChangeInventorySkin(playerid);

			return false;
		}
	}

	PI[playerid][OpenGunMenu] = 0;
	closeuse(playerid);

	return false;
}

stock getItemInfo(playerid, slot)
{
	new item = Inventory[playerid][0][slot];

	if !IsAAks(item) *then
		return GetItemInfo(playerid, item, slot);

	ColorSlotReset(playerid);

	static item_bonus[107], UpdateStr[36], nashivkastr[120];
	static const Nashivka[][] = {"apsaugos", "regeniracijos", "zalos", "sekmes", "maks. HP"};

    f(global_str, sizeof global_str, "{FFFFFF}- Tobulinimas: {FDCF28}%d/13", Inventory[playerid][2][slot]);
	f(item_bonus, sizeof item_bonus, "{FFFFFF}- Bonusas nuo pagerinimo: {B08A87}");

    if Inventory[playerid][5][slot] *then
		f(nashivkastr, 400, "\n\n{ffa500}Imontuotas pledukas {ffffff}%d-o{ffa500} lygio{ffffff} (+%d prie %s){ffa500}.{ffffff}", Inventory[playerid][5][slot], Inventory[playerid][5][slot], Nashivka[Inventory[playerid][4][slot]-1]);

	switch GetAccessoryItemPos(item) do
	{
		case 0:
			f(item_bonus, sizeof item_bonus, "%s\n%s[+%d HP i min.]", global_str, item_bonus, GetAccessoryUpdate(Inventory[playerid][2][slot])),
			UpdateStr = "atstato sveikata";

		case 1, 4:
			f(item_bonus, sizeof item_bonus, "%s\n%s[-%d%% nuo zalos]", global_str, item_bonus, GetAccessoryUpdate(Inventory[playerid][2][slot])),
			UpdateStr = "padidina apsauga";

		case 2, 3:
			f(item_bonus, sizeof item_bonus, "%s\n%s[+%d%% zalos]", global_str, item_bonus, GetAccessoryUpdate(Inventory[playerid][2][slot])),
			UpdateStr = "padidina zala";

		case 5:
			f(item_bonus, sizeof item_bonus, "%s\n%s[kritinio smugio tikimybe %d%%]", global_str, item_bonus, GetAccessoryUpdate(Inventory[playerid][2][slot])),
			UpdateStr = "padidina kritinio smugio tikimybe";
	}

	f(global_str, sizeof global_str, "{FFFFFF}%s\n\
	%s %s\n\n\
	{FFFFFF}Charakteristikos:\n\
	{FFFFFF} - Spalva: %s\n\
	%s\n\
	{FFFFFF} - Tvirtumas: {%s}%d/100\n\n\
	{FFFFFF}* Pagerinimo metu ", ItemsInfo[item][ItemName], GetItemStory(playerid, item), nashivkastr, GetItemColorName(item), (Inventory[playerid][2][slot] >= 4) ? item_bonus:global_str, GetColorItemProc(Inventory[playerid][3][slot]), Inventory[playerid][3][slot]);

	strcat(global_str, UpdateStr);

	PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);

	return SPD(playerid, 0, 0, !"Informacija apie daikta", global_str, !"Isejimas", !"");
}

stock GetItemInfo(playerid, item, slot = -1)
{
	if item == 2910 *then
	{
	    static const countryName[][] = {"None", "Kazachstanas", "Rusija", "Ukraina", "Belarusija", "JAV"};
	    //playerInventory_NumbersText[MAX_PLAYERS][2][144][8],
		return SPDF(playerid, 0, DIALOG_STYLE_MSGBOX, "{BFBBBA}Informacija apie daikta",\
		"{FFFFFF}Daiktas: {FDCF28}Registracijos numerio zenklas asmeniniam T/P{FFFFFF}\n\nNumerio zenklas: {FFFF00}%s{ffffff}\n\
		Salis: {FFFF00}%s{ffffff}\n\
		Regionas: {FFFF00}%s{ffffff}\n\n\
		Naudojama registracijos numerio zenklui imontuoti i asmenini transporta.\n\
		Galima gauti {ff6666}Los Santos Policijoje{ffffff}.\n\n\
		Issaumiau apie numerius: {FF6666}/help Apribojimas uz vaziavima be numeriu{ffffff}.\n\n\
		Galima naudoti, pardavineti ir perdavineti.\n\n{ffffff}Galima laikyti viename langelyje: {cccccc}1 vnt. daikto.", "Isejimas", "", playerInventory_NumbersText[playerid][0][slot], countryName[Inventory[playerid][6][slot]], playerInventory_NumbersText[playerid][1][slot]);
	}

	f(global_str, sizeof global_str, "{FFFFFF}%s\n{FFFFFF}%s", ItemsInfo[item][ItemName], GetItemStory(playerid, item));

	strcat(global_str, (str_f("\n\n{FFFFFF}Galima laikyti viename langelyje: {cccccc}%d vnt. daikto.", ItemsInfo[item][ItemQuantity])));

	switch item do
	{
		case 1503:
			strcat(global_str, (str_f("\n\n{FFFF00}Veiklos lygis: %d is 10\nPer viena darbo valanda minenina: %f BTC.", Inventory[playerid][2][slot], GetMiningBTC(Inventory[playerid][2][slot]))));

		case 1506..1510:
		    strcat(global_str, (str_f("\n\n{FFA500}Issiuvimo lygis: {FFFFFF}%d.\n(patobulinti galima drabuziu taisykloje)", Inventory[playerid][2][slot])));
	}

	return SPD(playerid, 0, 0, !"Informacija apie daikta", global_str, !"Isejimas", !""), ColorSlotReset(playerid), PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
}

stock GetColorItemProc(level)
{
	new str[8];

	switch level do
	{
		case 60..100:
			str = "73B461";

		case 26..59:
			str = "BBB791";

		case 0..25:
			str = "B08A87";
	}

	return str;
}
stock GetItemColorName(itemid)
{
	static c_name[30];
	switch ItemsInfo[itemid][ItemColorAks] do
	{
	    case 0xFFCC2426: c_name = "{CC2426}Raudonas";
	    case 0xFFCC7824: c_name = "{CC7824}Tamsiai-oranzinis";
	    case 0xFFE6BC1E: c_name = "{E6BC1E}Oranzinis";
	    case 0xFFD5D73C: c_name = "{D5D73C}Geltonas";
	    case 0xFF3CD740: c_name = "{3CD740}Zalias";
	    case 0xFF3CD7D7: c_name = "{3CD7D7}Zydras";
	    case 0xFF3C3ED7: c_name = "{3C3ED7}Melynas";
	    case 0xFFD73CD4: c_name = "{D73CD4}Violetinis";
	    case 0xFFD73C7E: c_name = "{D73C7E}Avietinis";
		default: c_name = "Nera";
	}
	return c_name;
}

stock SetPlayerAccessoryWeapon(playerid, item, count = 1)
{
	switch item do
	{
		case 526: _GiveGun(playerid, 1, count);
		case 527: _GiveGun(playerid, 5, count);
		case 528: _GiveGun(playerid, 8, count);
		case 529: _GiveGun(playerid, 46, count);
		case 530: _GiveGun(playerid, 17, count);
		case 531: _GiveGun(playerid, 24, count);
		case 532: _GiveGun(playerid, 25, count);
		case 533: _GiveGun(playerid, 29, count);
		case 534: _GiveGun(playerid, 30, count);
		case 535: _GiveGun(playerid, 31, count);
		case 536: _GiveGun(playerid, 33, count);
		case 356: _GiveGun(playerid, 6, count);
		case 510: _GiveGun(playerid, 46, count);
	}

	ApplyAnimationEx(playerid, "RIFLE", "RIFLE_load", 4.0, 0, 0, 0, 0, 0, 1);
	f(global_str, 125, "%s[%d] issitrauke ginkla is kisenes.", PN(playerid), playerid);
    ProxDetector(25.0, playerid,global_str, COLOR_PURPLE);
	SCMF(playerid, COLOR_VALIK, "[Informacija] {FFFFFF}Jus istraukete is kisenes '%s' su saudmenimis %d", ItemsInfo[item][ItemNameLavka], count);
	DeleteItem(playerid, item, count);

	return closeuse(playerid);
}

//
stock AddItem(playerid, itemid, amount = 1, level = 0, proc = 100, nashivka = 0, nashivkalevel = 0, time = 0, uid1 = 0, color = 0, number_type = 0, number_region[] = 0, number[] = "")
{
	if GetInvSet(playerid) >= PI[playerid][pInvCell] *then
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums truksta vietos inventoriuje!");

	if !(InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen")) *then
	{
		if(amount >= 2)
		{
	    	f(global_str, 180, "Jums buvo pridetas daiktas '%s' (%d vnt). Noredami atidaryti inventoriu, naudokite klavisa 'Y' arba /invent", ItemsInfo[itemid][ItemName2], amount);
			SCM(playerid, COLOR_YELLOW, global_str);
			f(global_str, 60, "%s (%d vnt.)", ItemsInfo[itemid][ItemName2], amount);
			ShowAttention(playerid, "Jums buvo pridetas daiktas", global_str);
		}
		else
		{
		    f(global_str, 180, "Jums buvo pridetas daiktas '%s'. Noredami atidaryti inventoriu, naudokite klavisa 'Y' arba /invent", ItemsInfo[itemid][ItemName2]);
			SCM(playerid, COLOR_YELLOW, global_str);
			f(global_str, 60, "%s", ItemsInfo[itemid][ItemName2], amount);
			ShowAttention(playerid, "Jums buvo pridetas daiktas", global_str);
		}
	}

	for new i; i < PI[playerid][pInvCell]; i++ do
    {
		if(GetInvSet(playerid) >= PI[playerid][pInvCell]) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums truksta vietos inventoriuje!");
        if(Inventory[playerid][0][i] != itemid) continue;

		if(ItemsInfo[itemid][ItemQuantity] > Inventory[playerid][1][i])
		{
			if(amount < ItemsInfo[itemid][ItemQuantity])
			{
				if(amount+Inventory[playerid][1][i] < ItemsInfo[itemid][ItemQuantity])
				{
					Inventory[playerid][1][i] += amount;
					amount = 0;
				}
				else
				{
					amount = Inventory[playerid][1][i]+amount-ItemsInfo[itemid][ItemQuantity];
					Inventory[playerid][1][i] = ItemsInfo[itemid][ItemQuantity];
				}
			}
			else
			{
				amount -= ItemsInfo[itemid][ItemQuantity]-Inventory[playerid][1][i];
				Inventory[playerid][1][i] = ItemsInfo[itemid][ItemQuantity];
			}
			if shopopen{playerid} || InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") *then InvSlotUpdate(playerid, GetInvID(playerid, i, 1), i);
		}

        if amount <= 0 *then
			return SaveInventory(playerid);
    }

    for new i; i < PI[playerid][pInvCell]; i++ do
    {
        if Inventory[playerid][0][i] *then continue;
		Inventory[playerid][0][i] = itemid;
		Inventory[playerid][2][i] = level;
		Inventory[playerid][3][i] = proc;
		Inventory[playerid][4][i] = nashivka;
		Inventory[playerid][5][i] = nashivkalevel;

		ArendaInfo_INT[playerid][0][i] = time;
		ArendaInfo_INT[playerid][1][i] = uid1;

		PI[playerid][pColor][i] = color;

		if itemid == 2910 *then
		{
			//AddItem(playerid, 2977, 1, 0, 100, 0, 0, 0, 0, 0, 2, 1, "X344XF");
			Inventory[playerid][6][i] = number_type;
			SetString(playerInventory_NumbersText[playerid][1][i], (str_f("%s", number_region)));
			SetString(playerInventory_NumbersText[playerid][0][i], (str_f("%s", number)));
		}

		if(ItemsInfo[itemid][ItemQuantity] > amount)
		{
			Inventory[playerid][1][i] = amount;
			amount = 0;
			if shopopen{playerid} || InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") *then InvSlotUpdate(playerid, GetInvID(playerid, i, 1), i);

			return SaveInventory(playerid);
		}
		else
		{
			Inventory[playerid][1][i] = ItemsInfo[itemid][ItemQuantity];
			amount -= ItemsInfo[itemid][ItemQuantity];
			if shopopen{playerid} || InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") *then InvSlotUpdate(playerid, GetInvID(playerid, i, 1), i);
		}

        if amount <= 0 *then
			return SaveInventory(playerid);
    }

    return SaveInventory(playerid);
}

stock DeleteItem(playerid, itemid, amount = 1)
{
	for new i,j; i < PI[playerid][pInvCell]; i++ do
	{
		if Inventory[playerid][0][i] != itemid || InventSlotUse[playerid][i] *then continue;
		j = Inventory[playerid][1][i];
		Inventory[playerid][1][i] -= amount;
		amount -= j;
		if(Inventory[playerid][1][i] < 1) Inventory[playerid][1][i] = Inventory[playerid][0][i] = 0;
		if shopopen{playerid} || InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") *then InvSlotUpdate(playerid, GetInvID(playerid, i, 1), i);
		if amount <= 0 *then
			return SaveInventory(playerid);
	}

	return false;
}

stock ClearItem(playerid, slot, count)
{
	if count < Inventory[playerid][1][slot] *then
		Inventory[playerid][1][slot] -= count;

	else {
		ArendaInfo_INT[playerid][0][slot] =
		ArendaInfo_INT[playerid][1][slot] =
		Inventory[playerid][0][slot] =
		Inventory[playerid][1][slot] =
		Inventory[playerid][2][slot] =
		Inventory[playerid][3][slot] =
		Inventory[playerid][6][slot] =
		PI[playerid][pColor][slot] =
		InventSlotUse[playerid][slot] = false;

		SetString(playerInventory_NumbersText[playerid][0][slot], "0");
		SetString(playerInventory_NumbersText[playerid][1][slot], "0");
	}

	if shopopen{playerid} || EnchantWork{playerid} || InventoryOpen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") *then InvSlotUpdate(playerid, GetInvID(playerid, slot, 1), slot);
	return false;
}
stock SletMenu(playerid, dId = 0)
{
	global_str = "{FFFF00}ID\t{FFFF00}Tipas\t{FFFF00}Laikas\t{ae433d}Pastate ant iskritimo";

	for new i; i < sizeof AutoSlet; i++ do {

		if AutoSlet[i][as_Status] == false *then
			strcat(global_str, "\n{ae433d}-\t{ae433d}-\t{ae433d}-\t{ae433d}-");
		else
			strcat(global_str, (str_f("\n¹%d\t%s\t%d:%d\t%s\t%s", AutoSlet[i][as_ID], AutoSlet[i][as_Type] ? "Verslas":"Namas", AutoSlet[i][as_Hour], AutoSlet[i][as_Min], AutoSlet[i][as_Owner])));
	}

	return SPD(playerid, dId, DIALOG_STYLE_TABLIST_HEADERS, !"{FFFFFF}Automatinis iskritimas | {ae433d}Gyvenimas "Mode_City"", global_str, dId ? !"Parametrai":!"Iseiti", dId ? !"Iseiti":!"");
}

stock onboard(playerid)
{
	if !addboard[playerid] *then
	{
	    RemovePlayerAttachedObject(playerid, 5);
		SetPlayerAttachedObjectEx(playerid,6,2406,6,0.0000,0.037000,0.000000,1.299999,8.300021,-0.899996,0.583000,1.000000,0.685999);
		SCM(playerid, COLOR_GREEN, !"Paemete lenta i ranka, kad ja panaudotumete, laikykite nuspaude 'BEGIMO KLAVISA'");
		return addboard[playerid] = 1;
	}

	return RemovePlayerAttachedObject(playerid, 6), SetPlayerAccessory(playerid, AksSlot[playerid][0][5], 5), addboard[playerid] = 0;
}

stock HideInventMenuTD(playerid)
{
	for new i; i < 14; i++ do
		DestroyPlayerTD(playerid, InventMenuTD[playerid][i]);

	return true;
}

stock ShowInventMenuTD(playerid, PlayerText:td, item, ItemCount, type, slot, redact = 0, kletochka = -1)
{
 //new Float:X, Float:Y;
	for new i = 0; i < 14; i++ do
		DestroyPlayerTD(playerid, InventMenuTD[playerid][i]);

	//GetPosTD(playerid, InvItemSlot[playerid][slot], X, Y);

