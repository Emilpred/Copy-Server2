{
	new rows, fields;
	cache_get_data(rows, fields);
	if rows *then
	{
 		new code[24], level, money, ludi, btc, owner[24];
 		cache_get_row(0, 5, owner, mysql);
   		cache_get_row(0, 0, code, mysql);
