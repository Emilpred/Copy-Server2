    {
		case 26: return 30000;
		case B_BAR: return 10000;
		case B_BUY: return 30000;
		case 13: return 30000;
		case B_RENTCAR: return 50000;
		case B_GAS: return 30000;
		case B_CL_BELL: return 15000;
		case 0: return 30000;
		case 24: return 999999;
    }
    return 0;
}
