	return CheckItemInv(playerid, giveplayerid);


stock CheckStatsOff(playerid, name[])
{
	f(mysql_string, 150, "SELECT * FROM `accounts` WHERE `NickName` = '%s' LIMIT 1", name);
	new Cache:result = mysql_query(mysql, mysql_string);
	if !cache_get_row_count(mysql) *then {
		SCM(playerid, COLOR_OLDRED, "[Klaida]{FFFFFF} Si paskyra neegzistuoja duomenu bazeje.");
		cache_delete(result, mysql);
		return false;
	}
	// accounts
	static vipname[30];
	switch cache_get_row_int(0, 16, mysql) do
	{
		case STATUS_NONE: vipname = "Nera";
		case STATUS_VIP: vipname = "Bronze";
		case STATUS_GOLD: vipname = "GOLD";
		case STATUS_PLATIN: vipname = "Platina";
		case 4: vipname = "Diamond";
		case 5: vipname = "Titan";
		case 6: vipname = "PREMIUM";
		case 7: vipname = "SAG";
		case 8: vipname = "HOLY";
		case 9: vipname = "DELUXE";
		case 10: vipname = "SuperSAG";
	}
	static RegIP[16], LastIP[16];

	cache_get_field_content(0, "RegIP", RegIP, mysql);
	cache_get_field_content(0, "OldIP", LastIP, mysql);

	f(global_str, 300, "\
	ID duomenu bazeje: %d\n\
	Nick: %s\n\
	RegIP: %s\n\
	LastIP: %s\n\
	Lygis: %d\n\
	Administravimo lygis: %d\n\
	Donate saskaita: %d\n\
	Donate saskaita SAG-Eurais: %d\n\
	Pinigai: %d\n\
	Telefono numeris: %d\n\
	Pinigai banke: %d\n\
	Asmenines saskaitos bukle: %d\n\
	Pinigai indelyje: %d BTC",
	cache_get_row_int(0, 0, mysql),
	name,
	RegIP,
    LastIP,
	cache_get_row_int(0, 7, mysql),
	cache_get_row_int(0, 11, mysql),
	cache_get_row_int(0, 81, mysql),
	cache_get_row_int(0, 200, mysql),
	cache_get_row_int(0, 13, mysql),
	cache_get_row_int(0, 32, mysql),
	cache_get_row_int(0, 14, mysql),
	cache_get_row_int(0, 210, mysql),
	cache_get_row_int(0, 149, mysql)
	);

	if cache_get_row_int(0, 18, mysql) *then
		f(global_str, 424, "%s\nOrganizacija: %s\nPareigos: %s",
		global_str,
		OrgInfo[cache_get_row_int(0, 18, mysql)][oName],
		GetRankName(cache_get_row_int(0, 18, mysql), cache_get_row_int(0, 19, mysql)));
	else
		strcat(global_str, "\nOrganizacija: Nera\nPareigos: Nera");

	if !(cache_get_row_int(0, 126, mysql) == -1) *then
	    f(global_str, 2048, "%s\nSeima: %s [FamID: %d]", global_str, GetFamilyDataString(cache_get_row_int(0, 126, mysql), "name"), cache_get_row_int(0, 126, mysql));
	else
		strcat(global_str, "\nSeima: Nera");

	f(global_str, 500, "\
	%s\n\
	Ispejimu: %d\n\
    VIP statusas: %s\n\n\
	Sandelio ¹%d\n\n\
	MuteTime: %s\n\
	Demorgan: %s\n\n\
	Namo:",
	global_str,
	cache_get_row_int(0, 27, mysql),
	vipname,
	cache_get_row_int(0, 247, mysql),
	Convert( cache_get_row_int(0, 40, mysql) ),
	Convert( cache_get_row_int(0, 86, mysql) ));
	cache_delete(result, mysql);

	//house
	f(mysql_string, 150, "SELECT `ID` FROM `houses` WHERE `Owner` = '%s'", name);
	result = mysql_query(mysql, mysql_string);

	if !cache_get_row_count(mysql) *then strcat(global_str, "\nNera");
	else
	{
		for new i; i < cache_get_row_count(mysql); i++ do
			f(global_str, 1024, "%s\nIDH %d", global_str, cache_get_row_int(i, 0, mysql));
	}
	cache_delete(result, mysql);
	//

	//businesses
	strcat(global_str, "\n\nVerslai:");
	f(mysql_string, 150, "SELECT `ID` FROM `businesses` WHERE `Owner` = '%s'", name);
	result = mysql_query(mysql, mysql_string);

	if !cache_get_row_count(mysql) *then strcat(global_str, "\nNera");
	else
	{
		for new i; i < cache_get_row_count(mysql); i++ do
			f(global_str, 1024, "%s\nIDB %d", global_str, cache_get_row_int(i, 0, mysql));
	}
	cache_delete(result, mysql);
	//

	//cars
	strcat(global_str, "\n\nAutomobiliai:");
	f(mysql_string, 150, "SELECT `Model` FROM `ownable` WHERE `Owner` = '%s'", name);
	result = mysql_query(mysql, mysql_string);

	if !cache_get_row_count(mysql) *then strcat(global_str, "\nNera");
	else
	{
		for new i; i < cache_get_row_count(mysql); i++ do
			f(global_str, 1200, "%s\nIDC [%d] %s", global_str, cache_get_row_int(i, 0, mysql), GetVehicleName(cache_get_row_int(i, 0, mysql), true));
	}
	cache_delete(result, mysql);
	//

 	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Zaidejo offline statistika", global_str, "Uzdaryti", "");

	f(mysql_string, 150, "SELECT * FROM `accounts` WHERE `NickName` = '%s' LIMIT 1", name);
	result = mysql_query(mysql, mysql_string);

	// vk
    if !(cache_get_row_int(0, 204, mysql) == 0) *then
        SCMF(playerid, -1, "{32CD32}[CheckOff] %s | Discord: DC ID: %d", name, cache_get_row_int(0, 204, mysql));

	else
		SCMF(playerid, COLOR_OLDRED, "[CheckOff] %s | Discord: nepriristas prie sios paskyros.", name);
	//

	// euro
    SCMF(playerid, -1, "{32CD32}[CheckOff] %s | Euro: %d", name, cache_get_row_int(0, 230, mysql));
	//

    // btc
    SCMF(playerid, -1, "{32CD32}[CheckOff] %s | BTC: %d", name, cache_get_row_int(0, 131, mysql));
    //

	cache_delete(result, mysql);

	f(mysql_string, 150, "SELECT * FROM `bannames` WHERE BINARY `Name` = '%s' LIMIT 1", name);
	result = mysql_query(mysql, mysql_string);

	// ban
    if cache_get_row_count(mysql) > 0 *then
    {
		sql_get_row(0, {1,2,3,5});

		if Global_Time < cache_get_row_int(0, 4, mysql) *then
		{
		    SCMF(playerid, -1, "{008000}[CheckOff] %s | Paskyra uzbluokota %s administratorium %s iki atblokavimo %s dienu", SQL_GET_ROW_STR[0], SQL_GET_ROW_STR[1], SQL_GET_ROW_STR[3], UNIX_TO_DATE(cache_get_row_int(0, 4, mysql)));
       		SCMF(playerid, -1, "{008000}[CheckOff] %s | Blokavimo priezastis: %s", SQL_GET_ROW_STR[0], SQL_GET_ROW_STR[2]);
		}
    }
    //

    cache_delete(result, mysql);

	SAMF(COLOR_GREY, "[A] A: %s[%d] perziurejo offline statistika zaidejo %s", PN(playerid), playerid, name);
	amlf("Administratorius <a href=../pages/user?name=%s>%s</a> perziurejo offline statistika %s", 5, PN(playerid), name, PN(playerid), PN(playerid), name);

	return false;
}


stock ShowStats(playerid, giveplayerid)
{
	if !IsPlayerOnline(giveplayerid) *then return false;

	static str[50];

	if PI[giveplayerid][pTelNum] <= 1 *then str = "Nera";
		else str = IntToStr(PI[giveplayerid][pTelNum]);

	f(global_str, 800, "\
	Dabartinis saskaitos likutis:\t\t%d SAG-Coins\n\
	Dabartine SAG-Euru saskaitos bukle:\t\t%d SAG-Eur\n\
	\n{FFFFFF}Vardas: {633169}[%s] \n\
	{FFFFFF}Lytis: {633169}[%s] \n\
	{FFFFFF}Lygis: {633169}[%d] \n\
	{FFFFFF}EXP: {633169}[%d/%d] \n\
	{FFFFFF}Pinigai: {633169}[$%d]\n\
	{FFFFFF}MC: {633169}[%d]\n\
	{FFFFFF}EURO: {633169}[%d]\n\
	{FFFFFF}BTC: {633169}[%d]\n\
	{FFFFFF}Telefono numeris: {633169}[%s] \n\
	{FFFFFF}Pinigai banke: {633169}[%d BTC]\n\
	{FFFFFF}Asmenines saskaitos bukle: {633169}[$%d]\n\
	{FFFFFF}Pinigai indelyje: {633169}[%d BTC]\n\
	{FFFFFF}Darbas: {633169}[%s]\n", PI[giveplayerid][pVirMoney], PI[giveplayerid][pRoubles], PN(giveplayerid),
	(PI[giveplayerid][pSex] > 0) ? ((PI[giveplayerid][pSex] > 1) ? ("Moteris"):("Vyras")):("None"),
	PI[giveplayerid][pLevel], PI[giveplayerid][pExp], (PI[giveplayerid][pLevel]+1)*4, PI[giveplayerid][pMoney], PI[giveplayerid][pMonoCoin],
	GetCount(giveplayerid, 615), GetCount(giveplayerid, 1461), str,
	PI[giveplayerid][pBank], PI[giveplayerid][pMyBank], PI[giveplayerid][pDeposit],
	GetJobPN(PlayerJob[giveplayerid]));



	if(PI[giveplayerid][pMember]>0) f(global_str,1024,"\
	%s{FFFFFF}Organizacija: {633169}[%s]\n\
	{FFFFFF}Pareigos: {633169}%s(%d)\n",global_str, OrgInfo[GetTeamID(giveplayerid)][oName],GetRankName(GetTeamID(giveplayerid),PI[giveplayerid][pRank]),PI[giveplayerid][pRank]);
	else f(global_str, 1024 ,"%s{FFFFFF}Organizacija: {633169}[Nera] \n",global_str);

	switch(PI[giveplayerid][pAllRepl])
	{
		case 0..100: str = "\t{529020}[Nera priklausomybes]";
		case 101..200: str = "\t{274B09}[Galima priklausomybe]";
		case 201..300: str = "\t{D79B23}[1 lvl]";
		case 301..400: str = "\t{D76223}[2 lvl]";
		default: str = "\t{961C00}[3 lvl]";
	}

	f(global_str, 2048,"\
	%s{FFFFFF}Ieskomumo lygis: {633169}[%d]\n\
	{FFFFFF}Teisetvarka: {633169}%d/100\n\n\
	{FFFFFF}Apsauga: {B83434}[-%d%% zalos]\n\
	{FFFFFF}Regeneracija: {B83434}[%d HP i min.]\n\
	{FFFFFF}Zala: {B83434}[+%d zalos]\n\
	{FFFFFF}Sekme: {B83434}[%d%% kritinio smugio tikimybe]\n\n\
	{FFFFFF}Ispejimu: {633169}[%d] \n\
	{FFFFFF}Narkomanija: {633169}%d %s\n\
	{FFFFFF}Banko kortele: {633169}[%s]\n",
	global_str,
	PI[giveplayerid][pWanted],
	PI[giveplayerid][pZKP],

	GetAccessoryUpdate(AksSlot[giveplayerid][1][1]),
	GetAccessoryUpdate(AksSlot[giveplayerid][1][0]),
	GetAccessoryUpdate(AksSlot[giveplayerid][1][2]),
	GetAccessoryUpdate(AksSlot[giveplayerid][1][5]),

	PI[giveplayerid][pWarns],
	PI[giveplayerid][pAllRepl], str, (!PI[giveplayerid][pBankPass]) ? ("Nera"):(" Yra "));

	switch PI[giveplayerid][pVIP] do
	{
		case STATUS_NONE: str = "[Nera]";
		case STATUS_VIP: str = "[Bronze]";
		case STATUS_GOLD: str = "[GOLD]";
		case STATUS_PLATIN: str = "[Platina]";
		case 4: str = "[Diamond]";
		case 5: str = "[Titan]";
		case 6: str = "[PREMIUM]";
		case 7: str = "[SAG]";
		case 8: str = "[HOLY]";
		case 9: str = "[DELUXE]";
		case 10: str = "[SuperSAG]";
	}

	f(global_str, 2048, "\
	%s{FFFFFF}Statusas: {633169}%s\n",
	global_str,str);

	if !(FP_Data[giveplayerid][F_FAMILY_ID] == -1) *then
		f(global_str, 2048, "%s{FFFFFF}Seima: {633169}%s [ID %d]\n", global_str, GetFamilyDataString(FP_Data[giveplayerid][F_FAMILY_ID], "name"), FP_Data[giveplayerid][F_FAMILY_ID]);
	else
		strcat(global_str, "{FFFFFF}Seima: {633169}Nera\n");

	f(global_str, 2048, "\
	%s{FFFFFF}Galimybe tureti 5 verslus: %s\n\
	{FFFFFF}Galimybe tureti 3 namus: %s\n",
	global_str,
	!ImprovementsData[playerid][idBusinessman] ? "{633169}[NERA]" : "{529020}[YRA]",
	!ImprovementsData[playerid][idMoreHouses] ? "{633169}[NERA]" : "{529020}[YRA]");

	foreach(Vehicle, c)
	{
		if(OwnableCar[c] == INVALID_VEHICLE_ID) continue;

		new number = OwnableCar[c];
		if(IsPlayerHaveCar(giveplayerid,number))
		{
			f(global_str, 3072 ,"%s\n{AFAFAF}%s(%d)\nBlokavimo statusas: [%s] \nSignalizacija: [%s] %s\n", global_str, GetVehicleName(number), number,
			CarInfo[c][cLock] >= 1 ? ("Uzrakinta"):("Atrakinta"),CarInfo[c][cAlarmON] >= 1 ? ("Ijungta"):("Isjungta"),CarInfo[c][cShtraf] > 0 ? ("{9EF2FF}[X]"):(""));
		}
	}
	if PI[giveplayerid][pWarns]>0 *then
		f(global_str, 3072,"%s\n{E83C3C}Iki WARN praejimo liko: \t\t%d valandu.\n",global_str, floatround((PI[giveplayerid][pTimeToLastWarn]+(3600*24*1)-Global_Time)/3600,floatround_ceil) );
	setcheck[playerid] = giveplayerid;
	if(!SPD(playerid, 235, 0, !"{bfbbba}Pagrindine statistika",global_str, !"Daiktai", !"Uzdaryti")) SCM(playerid, COLOR_GREY, !"Siuo metu nepasiekiama.");
	return 1;
}

stock IsANotControllable(playerid)
{
	return !(!PlayerLie{playerid} && !Crack{playerid} && !Cuffed[playerid] && !CuffedTime[playerid] && Controllable{playerid});
}
stock ShowStyles(playerid, giveplayerid, dialogid = 0)
{
    static Boxing[25], Kungfu[25], Kneehead[25], Elbow[25], Style[20];
	if(PI[giveplayerid][pBoxing]) Boxing = "{10F441}Ismoktas";
	else Boxing = "{FF6347}Neismokytas";
	if(PI[giveplayerid][pKungfu]) Kungfu = "{10F441}Ismoktas";
	else Kungfu = "{FF6347}Neismokytas";
	if(PI[giveplayerid][pKneehead]) Kneehead = "{10F441}Ismoktas";
	else Kneehead = "{FF6347}Neismokytas";
	if(PI[giveplayerid][pElbow]) Elbow = "{10F441}Ismoktas";
	else Elbow = "{FF6347}Neismokytas";
	switch(GetPlayerFightingStyle(giveplayerid))
	{
		case 5: Style = "Boxing";
		case 6: Style = "Kungfu";
		case 7: Style = "Kneehead";
		case 16: Style = "Elbow";
		default: Style = "Standart";
	}
    f(global_str, 300,"{FFFFFF}Boxing: \t\t%s\n\
	{FFFFFF}Kungfu: \t\t%s\n\
	{FFFFFF}Kneehead: \t\t%s\n\
	{FFFFFF}Elbow: \t\t\t%s\n\n\
	{FFFFFF}Dabartinis kovos stilius: \t{FFFF00}%s\n\n\
	{FFFFFF}Kovos menu igudziai: \t{FFFF00}%d",Boxing,Kungfu,Kneehead,Elbow,Style,PI[playerid][pSkillLevel]);
	SPD(playerid,dialogid,0,"Kovos stiliai",global_str,"OK","");
	return 1;
}
