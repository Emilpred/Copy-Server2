forward TimerGoToTruck(playerid);
public TimerGoToTruck(playerid)
{
    switch(GetPVarInt(playerid, "TruckType"))
    {
        case 1: GiveTruck(playerid, 1), GiveMoney(playerid, -25000);
        case 2: GiveTruck(playerid, 2), GiveMoney(playerid, -35000);
        case 3: GiveTruck(playerid, 3), GiveMoney(playerid, -50000);
    }
}
