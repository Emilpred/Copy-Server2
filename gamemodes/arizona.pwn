						case 0: SPD(playerid, 25476, DIALOG_STYLE_LIST, !"{BFBBBA}", !"{73B461}1. {FFFFFF}Paziureti pasa\n{73B461}2. {FFFFFF}Paziureti medicinine kortele", !"Toliau", !"Uzdaryti");
