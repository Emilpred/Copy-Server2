public OnPlayerEnterDynamicArea(playerid, areaid)
{
	if areaid >= SEAT_SYSTEM_AREAS[0] && areaid <= SEAT_SYSTEM_AREAS[1] *then
	{
		SetPlayerData(playerid, P_AREA_ID, areaid - SEAT_SYSTEM_AREAS[0]);
		if GetPlayerMobileLauncher(playerid) *then
			ShowButton(playerid, 0);
		else if IsPlayerCefInit(playerid, 1) *then PlayerNotification(playerid, "info", "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT", 2000);
		else ShowAttention(playerid, "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT");
	}
    if areaid == ZZGG_areaid *then
    {
		SCM(playerid, COLOR_VALIK, "[Uzuomina] {ffffff}Jus iejote i {FF6666}\"Centra Getto\"{ffffff}. Tai yra visu banditu neutrali teritorija.");
		SCM(playerid, COLOR_VALIK, "[Uzuomina] {ffffff}Rekomenduojame laikytis vietiniu taisykliu, kad isvengtumete bausmiu! {cccccc}( /help - Centras Getto )");
        GameTextForPlayer(playerid, FixText("JUS IEJOTE I GETTO CENTRA"), 2000, 4);
	}
	foreach(Player, i)
	{
		if(areaid == area_boombox[i] && RadioID[i] && !Int_GetPlayerData(playerid, "Bumboxing"))
		{
			if(IsPlayerInRangeOfPoint(playerid, 30.0, BumBoxPos[i][0], BumBoxPos[i][1], BumBoxPos[i][2]))
			{
				StopAudioStreamForPlayerFix(playerid);
				PlayAudioStreamForPlayerFix(playerid, BumboxInfo[RadioID[i]][bumLink], BumBoxPos[i][0], BumBoxPos[i][1], BumBoxPos[i][2], 30.0, 1);
				SetPVarInt(playerid, "Bumboxing", 1);
			}
			return 1;
		}
	}
	for(new i; i < 5; i++)
	{
		{
			PlayerNotification(playerid, "info", notificationData[i][nName], notificationData[i][nText],3500);
			break;
		}
	}
	for(new i; i < MAX_QUESTS_ZONES; i++)
	{
	    if areaid == questzone[i][qArea] *then return ShowQuestZone(playerid, i);
	}
	for new i; i < sizeof DoorInfo; i ++ do
	{
	    if areaid == DZone[i] *then
	    {
			if GetPlayerMobileLauncher(playerid) *then
				ShowButton(playerid, 2);

		    else if IsPlayerCefInit(playerid, 1) *then PlayerNotification(playerid, "info", "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT", 2000);
		    else ShowAttention(playerid, "Paspauskite noredami saveikauti", "Noredami saveikauti - ALT");
	    }
	}

    for(new i; i < sizeof(HealInfo); i ++)
    {
