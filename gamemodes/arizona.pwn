					return SPD(playerid, 119, DIALOG_STYLE_INPUT, !"Papildyti saskaita", !"\n\n{FFFFFF}Iveskite suma, kad papildytumete savo telefono saskaita\n\n", !"Apmoketi", !"Atsaukti");
			}
