stock MoneyStr(value, string[], length = sizeof string) {
    format(string, length, "%i", value < 0 ? -value : value);
    for (new i = strlen(string); (i -= 3) > 0;) {
        if(string[i] != '\0' && '0' <= string[i] <= '9') {
            strins(string, ".", i, length);
        } else {
            return;
        }
    }


    if (value < 0) {
        strins(string, "-", 0, length);
    }


    return;
}
stock IsValidBiz(id)
{
    new changenum = -1;
    if(1 <= id <= OWNABLEBIZES-1) changenum = 1;
	return changenum;
}
stock ShowAdminListt(playerid, list)
{
	FirstBL[playerid] = list;
	global_str = "{FFFFFF}Administratorius\t{FFFFFF}Lygis\t{ffffff}Reputacija/Ispejimai\t{FFFFFF}Prefix\n";
	new value;
//	foreach(Admin, i)
	foreach(new i: Player)
	{
        if !PI[i][pAdmin] *then continue;
		if(PlayerAFKTime[i] < 10)
	 	{
	 		if(IsAOwner(playerid)) f(global_str, 2048, "%s{ff0000}%s [ID: %d]\t{ff0000}[%d lvl]\t{ff0000}%d - Ispejimu [%d/3]\t{%s}%s{ffffff}\n", global_str, PN(i), i, PI[i][pAdmin], PI[i][pAdmRep], PI[i][pAWarns], PI[i][pAdmTagColor], PI[i][pAdmTag]);
	 		else f(global_str, 2048, "%s%s [ID: %d]\t[%d lvl]\t%d - Ispejimu [%d/3]\t{%s}%s{ffffff}\n", global_str, PN(i), i, PI[i][pAdmin], PI[i][pAdmRep], PI[i][pAWarns], PI[i][pAdmTagColor], PI[i][pAdmTag]);
		}
		else
		{
			if(IsAOwner(playerid)) f(global_str, 2048, "%s{ff0000}%s [ID: %d] [AFK: %d]\t{ff0000}[%d lvl]\t{ff0000}%d - Ispejimu [%d/3]\t{%s}%s{ffffff}\n", global_str, PN(i), i, PlayerAFKTime[i], PI[i][pAdmin], PI[i][pAdmRep], PI[i][pAWarns], PI[i][pAdmTagColor], PI[i][pAdmTag]);
			else f(global_str, 2048, "%s%s [ID: %d] [AFK: %d]\t[%d lvl]\t%d - Ispejimu [%d/3]\t{%s}%s{ffffff}\n", global_str, PN(i), i, PlayerAFKTime[i], PI[i][pAdmin], PI[i][pAdmRep], PI[i][pAWarns], PI[i][pAdmTagColor], PI[i][pAdmTag]);
		}
		value++;
	}
	new countS = value;
	if countS == 15 && list *then strcat(global_str, ">>> Sekantis puslapis\n<<< Praeitas puslapis");
	else if countS == 15 *then strcat(global_str, ">>> Sekantis puslapis");
	else if !countS *then return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Serverio administracija Online", !"{FFFFFF}Administracijos sarasas tuscias", !"Uzdaryti", !"");
	return SPD(playerid, 2264, DIALOG_STYLE_TABLIST_HEADERS, !"Serverio administracija Online", global_str, !"Isrinkti", !"Uzdaryti");
}
stock GiveCoins(playerid, money)
{
	if !IsPlayerLogged{playerid} *then
		return false;

	PI[playerid][pVirMoney] += money;

	f(global_str, 100, "%s %d$", money > 0 ? "I balansa iskaityta" : "Is balanso nurasyta", money),
	ShowAttention(playerid, "Informacija", global_str);

	f(mysql_string, 300, "UPDATE  `accounts` SET  `VirMoney` = '%d' WHERE  `NickName`='%s';", PI[playerid][pVirMoney], PN(playerid));
	mysql_tquery(mysql, mysql_string);

	return 1;
}
stock SetVehicleTuningNeon(vehicleid, color1, color2, color3)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, 142);
	BS_WriteValue(bs, PR_UINT16, vehicleid);
	BS_WriteValue(bs, PR_UINT8, color1);//1 spalva
	BS_WriteValue(bs, PR_UINT8, color2);//2 spalva
	BS_WriteValue(bs, PR_UINT8, color3);//3 spalva
	BS_WriteValue(bs, PR_UINT8, 255);//255 defolt
	PR_SendPacketToVehicleStream(bs, vehicleid), BS_Delete(bs);
}

stock SetVehicleTuningLight(vehicleid, color1, color2, color3, color4)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, 132);
	BS_WriteValue(bs, PR_UINT16, vehicleid);
	BS_WriteValue(bs, PR_UINT8, color1);
	BS_WriteValue(bs, PR_UINT8, color2);
	BS_WriteValue(bs, PR_UINT8, color3);
	BS_WriteValue(bs, PR_UINT8, color4);
	PR_SendPacketToVehicleStream(bs, vehicleid), BS_Delete(bs);
}

stock SetVehicleTuningSmoke(vehicleid, color1, color2, color3)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, 139);
	BS_WriteValue(bs, PR_UINT16, vehicleid);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 4);
	BS_WriteValue(bs, PR_UINT8, 150);
	BS_WriteValue(bs, PR_UINT8, 190);
	BS_WriteValue(bs, PR_UINT8, color1);
	BS_WriteValue(bs, PR_UINT8, color2);
	BS_WriteValue(bs, PR_UINT8, color3);
	PR_SendPacketToVehicleStream(bs, vehicleid), BS_Delete(bs);
}
public: CheckPromo(playerid, promo[])
{
	if(cache_get_row_count(mysql) > 0)
	{
		new level, money, btc;
		level = cache_get_row_int(0,1,mysql);
		money = cache_get_row_int(0,2,mysql);
		btc = cache_get_row_int(0,6,mysql);
		if(PI[playerid][pLevel] < level) return SCM(playerid, COLOR_GREY, "[Klaida] Jusu lygis per mazas aktyvavimui promocode!");
		SQL("UPDATE promo SET `ludi` = `ludi`+1 WHERE `code` = '%s' LIMIT 1", promo);
		strmid(PI[playerid][pUsePromo], promo, 0, 24);
		SQL("UPDATE accounts SET `pUsePromo` = '%s' WHERE `ID` = '%d' LIMIT 1", promo, PI[playerid][pID]);
		f(global_str, 145, "Jus sekmingai aktyvavote promocode: {ffffff}%s", promo);
		SCM(playerid, COLOR_GREEN, global_str);
		GiveMoney(playerid, money);
		AddItem(playerid, 1461, btc);
		return 1;
	}
	else SCM(playerid, COLOR_GREY, "[Klaida] Nurodytas promocode duomenu bazeje nerastas!");
	return 1;
}
public: CheckPromoName(playerid, name[])
{
	if(cache_get_row_count(mysql) > 0)
	{
		SPD(playerid, 1996, DIALOG_STYLE_INPUT, "Promocode kurimas", "{ffffff}Nurodykite lygi, grynuju pinigu suma ir Bitcoin suma per kableli,\nkurie bus suteikiami aktyvavus promocode \n\nPavyzdziui: 1,1,1", "Atlikta", "Atsaukti");
		SetPVarString(playerid, #cprname, name);
		return 1;
	}
	else SCM(playerid, COLOR_GREY, "[Klaida] Paskyra su tokio Nick duomenu bazeje nerasta!"), SPD(playerid, 1996, DIALOG_STYLE_INPUT, "Promocode kurimas", "{ffffff}Iveskite promocode savininko Nick\n{ffff00}Pavyzdziui:{ffffff} Developer", "Atlikta", "Atsaukti");
	return 1;
}
public: MyPromo(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if rows *then
	{
	    f(global_str, sizeof(global_str), "Promocode\tAktyvavimu\tLygis\tApdovanojimas");
		for(new i = 0; i < rows; i++)
		{
		    new code[24], level, money, ludi, btc;
		    cache_get_row(i, 0, code, mysql);
			level = cache_get_row_int(i,1,mysql);
            money = cache_get_row_int(i,2,mysql);
            ludi = cache_get_row_int(i,3,mysql);
            btc = cache_get_row_int(i,6,mysql);
			f(global_str, sizeof(global_str), "%s\n{FFFF00}%s\t{FFFFFF}%d\t%d\t%d$, %d BTC",global_str, code, ludi, level, money, btc);
		}
		SPD(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, "Asmeniniai promocodes", global_str, "Uzdaryti", "");
	}
	else SCM(playerid, COLOR_GREY, "[Klaida] Jus neturite asmeninio promocode!");
	return 1;
}
