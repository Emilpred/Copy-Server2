						return SPDF(playerid, 25035, DIALOG_STYLE_MSGBOX, !"Isimti vaizdo plokste", "{cccccc}Pasirinktoje vaizdo ploksteje siuo metu uzdirbta {FFFF00}%f BTC.\n{FFFFFF}Jei dabar isimsite vaizdo plokste, pelnas is jos bus prarastas.\n\nAr tikrai norite isimti vaizdo plokste ir prarasti %f BTC{ffffff}?", !"Isimti", !"Atgal", MiningBTC[hId][cardPos][card_balance], MiningBTC[hId][cardPos][card_balance]);
					else
						GetMiningCard(playerid, hId, cardPos);
				}
			}

			return SaveMiningBTC(hId);
		}

		case 25033:
