cmd:vanish(playerid)
{
	if !CheckAdm(playerid, 1) *then
	    return false;

    if(PI[playerid][pVanish] == 0)
    {
        SetPlayerColor(playerid,0x665E5E01);
		SCM(playerid, COLOR_VALIK, "[Sekmingai] {ffffff}Jus tapote nematomi zemelapyje.");
		SCM(playerid, COLOR_VALIK, "[Informacija] {ffffff}Iveskite isnaujo /vanish noredami tapti matomas zemelapyje");
		PI[playerid][pVanish] = 1;
		return SAMF(COLOR_YELLOW, "A: %s[%d] Paslepe savo Nicka zemelapyje!", PN(playerid), playerid);
    }
	else if(PI[playerid][pVanish] == 1)
	{
        SetPlayerColor(playerid, 0xFDFCFC15);
		SCM(playerid, COLOR_VALIK, "[Sekmingai] {ffffff}Jus grazinote sau clist zemelapyje");
		PI[playerid][pVanish] = 0;
		return SAMF(COLOR_YELLOW, "A: %s[%d] vel matomas zemelapyje!", PN(playerid), playerid);
    }
    return 1;
}

stock ShowPlayerCustomInterface(playerid, id, listitem = -1)
{
	listitem = (id == speedInterface) ? 0: (id == hudInterface ? 1 : 2);

	static const customInterface[][] = {"Greicio matuoklis", "Hod", "Radaras"};

	global_str = "{FFFFFF}Tipas\t{FFFFFF}Statusas";

	for new i, count; i < sizeof InterfaceData; i++ do
	{
		if id == InterfaceData[i][interfaceType] *then
			strcat(global_str, (str_f("\n%s\t%s", InterfaceData[i][interfaceName], PI[playerid][LauncherData][listitem] == count ? "{9ACD32}Ijungta" : "{FF6347}Isjungta"))), count ++;
	}

	return spdList(playerid, 0, id), spdList(playerid, 1, listitem), SPD(playerid, 3775, DIALOG_STYLE_TABLIST_HEADERS, (str_f("{FFFFFF}Isrinkti | {ae433d}%s", customInterface[listitem])), global_str, !"»", !"«");
}

