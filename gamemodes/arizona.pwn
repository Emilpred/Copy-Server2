stock GetSkinInfo(item, type = 0)
{
	if item > 311 && type <= 5 *then
	{
		switch type do
		{
			case 0: return skins_data[ GetSkinInfo (item , 5) ][skinModelSAMP];
			case 1: return skins_data[ GetSkinInfo (item , 5) ][skinID];
			case 2: return skins_data[item-312][skinModel];
