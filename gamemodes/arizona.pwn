stock LoadSklads()
{
	new ID, Cache:result = mysql_query(mysql, "SELECT * FROM `sklads`");

	OWNABLESKLADS = cache_get_row_count(mysql);

	for new i; i < OWNABLESKLADS; i++ do
	{
		ID = cache_get_row_int(i, 0, mysql);
		SkladData[ID][skID] = ID;
		cache_get_row(i, 1, SkladData[ID][skOwner], mysql, 30);
		SkladData[ID][skCost] = cache_get_row_int(i, 2, mysql);
		cache_get_row(i, 9, SkladData[ID][skPassword], mysql, 13);
		cache_get_row(i, 10, global_str, mysql),
			sscanf(global_str, "p<,>a<f>[3]",  SkladData[ID][skCoords]);
		SkladData[ID][skNumber] = cache_get_row_int(i, 11, mysql);
		SkladData[ID][skWorld] = cache_get_row_int(i, 12, mysql);
		SkladData[ID][skMoney] = cache_get_row_int(i, 13, mysql);
		cache_get_row(i, 14, global_str, mysql),
			sscanf(global_str, "p<,>a<f>[3]",  SkladData[ID][skpCoords]);

	    cache_get_field_content(i, "Item", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItem]);
	    cache_get_field_content(i, "ItemCount", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemCount]);
	    cache_get_field_content(i, "ItemLevel", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemLevel]);
	    cache_get_field_content(i, "ItemProc", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemProc]);
	    cache_get_field_content(i, "ItemTypeNashiv", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemTypeNashiv]);
	    cache_get_field_content(i, "ItemLvlNashiv", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemLvlNashiv]);
	    cache_get_field_content(i, "ItemColor", global_str), Int_UnPackMassive(global_str, SkladData[ID][skItemColor]);

	    if GetString(SkladData[ID][skOwner], "The State") *then
	        SkladPickup[SkladData[ID][skID]] = CreateDynamicPickup(1274, 1, SkladData[ID][skCoords][0], SkladData[ID][skCoords][1], SkladData[ID][skCoords][2], SkladData[ID][skWorld], 104),
	        f(global_str, 400, "{54b9d0}Sandelis ¹%d (id %d)\n\n{FFFFFF}Kaina: $%d\nPaspauskite ALT, noredami nusipirkti", SkladData[ID][skNumber], SkladData[ID][skID], SkladData[ID][skCost]),
        	Sklad3D[SkladData[ID][skID]] = CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, SkladData[ID][skCoords][0], SkladData[ID][skCoords][1], SkladData[ID][skCoords][2], 5.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, SkladData[ID][skWorld], 104, -1);
		else
		    SkladPickup[SkladData[ID][skID]] = CreateDynamicPickup(19135, 1, SkladData[ID][skCoords][0], SkladData[ID][skCoords][1], SkladData[ID][skCoords][2], SkladData[ID][skWorld], 104),
	        f(global_str, 400, "{54b9d0}Sandelis ¹%d (id %d)\n\n{FFFFFF}Savininkas: %s\nPaspauskite ALT, noredami atrakinti durys", SkladData[ID][skNumber], SkladData[ID][skID], SkladData[ID][skOwner]),
        	Sklad3D[SkladData[ID][skID]] = CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, SkladData[ID][skCoords][0], SkladData[ID][skCoords][1], SkladData[ID][skCoords][2], 5.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, SkladData[ID][skWorld], 104, -1);
	}

	cache_delete(result, mysql);

	return true;
}

stock AddItemSklad(playerid, sklid, itemid, amount, level, procent, typenashiv, lvlnashiv, color)
{
	amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> padejo i sandeli ¹%d daikta is inventoriaus %s (id:%d) kiekyje %d (galandimas: +%d) (zenkliuko lygis: %d)", 4, PN(playerid), "", PN(playerid), PN(playerid), sklid, ItemsInfo[itemid][ItemName2], itemid, amount, level, lvlnashiv);

	for new i; i < 150; i++ do
    {
    	if SkladData[sklid][skItem][i] != itemid *then continue;

		if(ItemsInfo[itemid][ItemQuantity] > SkladData[sklid][skItemCount][i])
		{
			if(amount < ItemsInfo[itemid][ItemQuantity])
			{
				if(amount+SkladData[sklid][skItemCount][i] < ItemsInfo[itemid][ItemQuantity])
				{
					SkladData[sklid][skItemCount][i] += amount;
					amount = 0;
				}
				else
				{
					amount = SkladData[sklid][skItemCount][i]+amount-ItemsInfo[itemid][ItemQuantity];
					SkladData[sklid][skItemCount][i] = ItemsInfo[itemid][ItemQuantity];
				}
			}
			else
			{
				amount -= ItemsInfo[itemid][ItemQuantity]-SkladData[sklid][skItemCount][i];
				SkladData[sklid][skItemCount][i] = ItemsInfo[itemid][ItemQuantity];
			}
			OtherInventSlotUpdateAll(sklid, 1, itemid, GetInvOtherID(i), SkladData[sklid][skItemCount][i], i);
		}
        if(amount <= 0) return 1;
    }
    for new i; i < 150; i++ do
    {
        if SkladData[sklid][skItem][i] *then continue;
		SkladData[sklid][skItem][i] = itemid;
		SkladData[sklid][skItemLevel][i] = level;
		SkladData[sklid][skItemProc][i] = procent;
		SkladData[sklid][skItemTypeNashiv][i] = typenashiv;
		SkladData[sklid][skItemLvlNashiv][i] = lvlnashiv;
		SkladData[sklid][skItemColor][i] = color;
		if(ItemsInfo[itemid][ItemQuantity] > amount)
		{
			SkladData[sklid][skItemCount][i] = amount;
			amount = 0;
			OtherInventSlotUpdateAll(sklid, 4, itemid, GetInvOtherID(i), SkladData[sklid][skItemCount][i], i, level);
			return 1;
		}
		else
		{
			SkladData[sklid][skItemCount][i] = ItemsInfo[itemid][ItemQuantity];
			amount -= ItemsInfo[itemid][ItemQuantity];
			OtherInventSlotUpdateAll(sklid, 4, itemid, GetInvOtherID(i), SkladData[sklid][skItemCount][i], i, level);
		}
        if(amount <= 0) return 1;
    }

    return true;
}

stock SaveItemSklad(sklid)
	return SQL("UPDATE `sklads` SET `Item` = '%s', `ItemCount` = '%s', `ItemLevel` = '%s', `ItemProc` = '%s', `ItemTypeNashiv` = '%s', `ItemLvlNashiv` = '%s', `ItemsColor` = '%s' WHERE `ID` = %d;", Int_PackMassive(0, SkladData[sklid][skItem]), Int_PackMassive(1, SkladData[sklid][skItemCount]), Int_PackMassive(2, SkladData[sklid][skItemLevel]), Int_PackMassive(3, SkladData[sklid][skItemProc]), Int_PackMassive(4, SkladData[sklid][skItemTypeNashiv]), Int_PackMassive(5, SkladData[sklid][skItemLvlNashiv]), Int_PackMassive(6, SkladData[sklid][skItemColor]), SkladData[sklid][skID]);

stock UpdateSklad(sklid)
{
	if IsValidDynamicPickup(SkladPickup[sklid]) *then
		DestroyDynamicPickup(SkladPickup[sklid]);

	if IsValidDynamic3DTextLabel(Sklad3D[sklid]) *then
		DestroyDynamic3DTextLabel(Sklad3D[sklid]);

	if GetString(SkladData[sklid][skOwner], "The State") *then
 		SkladPickup[sklid] = CreateDynamicPickup(1274, 1, SkladData[sklid][skCoords][0], SkladData[sklid][skCoords][1], SkladData[sklid][skCoords][2], SkladData[sklid][skWorld], 104),
   		f(global_str, 400, "{54b9d0}Sandelis ¹%d (id %d)\n\n{FFFFFF}Kaina: $%d\nPaspauskite ALT, noredami nupirkti", SkladData[sklid][skNumber], SkladData[sklid][skID], SkladData[sklid][skCost]),
   		Sklad3D[sklid] = CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, SkladData[sklid][skCoords][0], SkladData[sklid][skCoords][1], SkladData[sklid][skCoords][2], 5.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, SkladData[sklid][skWorld], 104, -1);
	else
 		SkladPickup[sklid] = CreateDynamicPickup(19135, 1, SkladData[sklid][skCoords][0], SkladData[sklid][skCoords][1], SkladData[sklid][skCoords][2], SkladData[sklid][skWorld], 104),
   		f(global_str, 400, "{54b9d0}Sandelis ¹%d (id %d)\n\n{FFFFFF}Savininkas: %s\nPaspauskite ALT, noredami atrakinti durys", SkladData[sklid][skNumber], SkladData[sklid][skID], SkladData[sklid][skOwner]),
    	Sklad3D[sklid] = CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, SkladData[sklid][skCoords][0], SkladData[sklid][skCoords][1], SkladData[sklid][skCoords][2], 5.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, SkladData[sklid][skWorld], 104, -1);
   	return 1;
}

stock CheckPasswordSklad(pass[])
{
	for(new i; i < strlen(pass); i ++)
	{
	    if( (pass[i] >= '0' && pass[i] <= '9')  ) continue;
		else return 0;
	}
	return 1;
}
stock Open_Server(type)
{
	global_str = "";
	switch type do
	{
	    case 0: global_str = "password 0";
	    case 1: f(global_str, sizeof(global_str), "password open%i", random(999999));
	    default: global_str = "";
	}
	SendRconCommand(global_str);
}
new AUCTION_HOUSE = 0;
