	[ Operacijos su kriptovaliuta ]\n\
	{FFFFFF}Dabar banke: %d BTC\n\
	Bankas perka 1 BTC uz $%d\n\
	Bankas parduoda 1 BTC uz $%d\n\n\
	{FFFF00}SAG Stable Coin (ASC):\n\
	{FFFFFF}Dabar banke: %d ASC\n\
	Bankas perka 1 SSC uz $%d\n\
	Bankas parduoda 1 SSC uz $%d\n\n\
	{cccccc}Paspauskite N", bankbitcoin, bankbuybitcoin, banksellbitcoin,bankasc,bankbuyasc,banksellasc)));

stock PayDay(counts)
{
    SaveServerData();
	new count_fh = 0, count_zh = 0;
	for(new house; house < OWNABLEHOUSES; house++)
	{
		if(!strcmp(HouseInfo[house][hOwner], "The State")) count_fh ++;
		else count_zh ++;
	}

	if(TruckGruzAmmoLS > 10) TruckGruzAmmoLS = 10;
	else if(TruckGruzAmmoLS < 10) TruckGruzAmmoLS = 10;
	if(TruckGruzAmmoLV > 10) TruckGruzAmmoLV = 10;
	else if(TruckGruzAmmoLV < 10) TruckGruzAmmoLV = 10;
	if(TruckGruzAmmoSF > 10) TruckGruzAmmoSF = 10;
	else if(TruckGruzAmmoSF < 10) TruckGruzAmmoSF = 10;
	if(TruckGruzFuelLS > 10) TruckGruzFuelLS = 10;
	else if(TruckGruzFuelLS < 10) TruckGruzFuelLS = 10;
	if(TruckGruzFuelLV > 10) TruckGruzFuelLV = 10;
	else if(TruckGruzAmmoLV < 10) TruckGruzFuelLV = 10;
	if(TruckGruzFuelSF > 10) TruckGruzFuelSF = 10;
	else if(TruckGruzAmmoSF < 10) TruckGruzAmmoSF = 10;
	if(TruckCarSF > 10) TruckCarSF = 10;
	else if(TruckCarSF < 10) TruckCarSF = 10;
	if(TruckCarLS > 10) TruckCarLS = 10;
	else if(TruckCarSF < 10) TruckCarSF = 10;
	if(TruckCarLV > 10) TruckCarLV = 10;
	else if(TruckCarLV < 10) TruckCarLV = 10;

	f(global_str, sizeof(global_str), "Paimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarLS);
	Update3DTextLabelText(TruckCarText[0],0xFFFF00FF, global_str);
	f(global_str, sizeof(global_str), "Paimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarLV);
	Update3DTextLabelText(TruckCarText[1],0xFFFF00FF, global_str);
	f(global_str, sizeof(global_str), "Paimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarSF);
	Update3DTextLabelText(TruckCarText[2],0xFFFF00FF, global_str);

	global_str = "";
	f(global_str, 250, "Informacija apie serverio namus:\n\nLaisvu: %i\nNupirktu: %i", count_fh, count_zh);
	UpdateDynamic3DTextLabelText(info_house, -1, global_str);

	for(new i; i < sizeof(ReklamaGPS); i++)
	{
		if(ReklamaGPS[ReklamaOsnTimer]) {
            ReklamaGPS[ReklamaOsnTimer]--;
			if(!ReklamaGPS[ReklamaOsnTimer]) ResetReklama();
			else SaveReklama();
		}
	}

	CryptoUpdate_BitCoin();

	if counts >= 1 *then
	{
		counts --;
		if !counts *then
		{
			PayDayHouses();
			PayDayBizes();
			PayDayCars();
			PayDayTrailers();
			PayDayOther();
			PayDayAccs();
			return false;
		}
		else PayDay(counts);
	}
	else
		PayDayHouses(),
		PayDayBizes(),
		PayDayCars(),
		PayDayTrailers(),
		PayDayOther(),
		PayDayAccs();

	SaveServer = 10;
	return 1;
}

stock CheckNextLevel(playerid)
{
	if PI[playerid][pExp] >= (PI[playerid][pLevel] + 1)*4  *then
	{
        while PI[playerid][pExp] >= (PI[playerid][pLevel] + 1)*4 do
		{
			PI[playerid][pLevel] ++;
			PI[playerid][pExp] -= (PI[playerid][pLevel]+1)*4;
			if PI[playerid][pLevel] == 30 *then
			{
				f(global_str, 100, "SELECT `Referal` FROM `accounts` WHERE `NickName`='%s'", PN(playerid));
				mysql_tquery(mysql, global_str, "MysqlReferalCheck", "d", playerid);
			}
		}
		SetPlayerScore(playerid,PI[playerid][pLevel]);
		f(global_str, 100, "Sveikiname! Jus pasiekete %d lygi!",PI[playerid][pLevel]);
		SCM(playerid,COLOR_VALIK,global_str);

		new famid = FP_Data[playerid][F_FAMILY_ID];

		if !(famid == -1) *then
        {
            UpdateFamilyData(famid, "exp = '%d'", GetFamilyDataInt(famid, "exp") + 2);

            if GetFamilyDataInt(famid, "exp") == GetFamilyDataInt(famid, "level") * 10 *then
            {
                UpdateFamilyData(famid, "exp = '0', level = '%d'", GetFamilyDataInt(famid, "level") + 1);

                SendFamilyMessage(famid, (str_f("{%s}[Seimos naujienos]{FFFFFF} Sveikiname! Musu seimos lygis padidintas iki {66FF99}%d.", FamilyColor[GetFamilyDataInt(famid, "color")], GetFamilyDataInt(famid, "level"))));
            }
            SendFamilyMessage(famid, (str_f("{%s}[Seimos naujienos]{FFFFFF} Seimos narys: %s[%d] pasieke %d lygi. Seimai priskirta patirtis.", FamilyColor[GetFamilyDataInt(famid, "color")], PN(playerid), playerid, PI[playerid][pLevel])));
        }

        return 1;
	}
	return 0;
}


stock SendMessage(color, const text[], Float:Pos[], vw = 0, Float: radius = 25.0)
{
	foreach(Player, i)
	{
		if IsPlayerInRangeOfPoint(i, radius, Pos[0], Pos[1], Pos[2]) && GetPlayerVirtualWorld(i) == vw *then
			SCM(i, color, text);
	}
}

stock SendAdminsMessage(color, const text[])
{
	foreach(new i: Admin)
	{
		if PI[i][pAdmin] && ADuty{i} *then
		{
			SCM(i, color, text);
		}
	}
	return 1;
}

stock PlayerIP(playerid)
{
	return PlayerIp[playerid];
}
stock CheckPlayerBanIP(playerid)
{
	static IP[16];
	GetPlayerIp(playerid, IP, 16);
	f(global_str, 100,"SELECT * FROM `banip` WHERE `IP` = '%s' LIMIT 1", IP);
	new Cache:result = mysql_query(mysql, global_str);
	if(cache_get_row_count(mysql) > 0)
	{
        SCM(playerid, COLOR_RED, !"Sis IP adresas yra uzblokuotas musu serveryje!");
		cache_delete(result, mysql);
		Kick(playerid);
		return 1;
	}
	cache_delete(result, mysql);
	return 0;
}

stock BanPlayer(playerid)
{
	BanName(PN(playerid), "kuris isdave WARN Offline",5,"Uzblokuotas del 3 WARN gavimu");
	J_Kick(playerid);
	return 1;

}
stock IsBannedName(name[])
{
	f(global_str, 200, "SELECT `Name` FROM `bannames` WHERE BINARY `Name` = '%s' LIMIT 1",name);
	new Cache:result = mysql_query(mysql, global_str);
	new i = cache_get_row_count(mysql);
    cache_delete(result, mysql);
	return i;
}

stock BanName(const name[], const namez[], days, reason[])
{
	mysql_tquery(mysql, (str_f("SELECT * FROM bannames WHERE BINARY `Name` = '%s' LIMIT 1;", name)), "@BanName", "ssds", name, namez, days, reason);

	return true;
}

public: @BanName(player_name[], ban_admin[], days, reason[])
{
	mysql_tquery(mysql, !cache_get_row_count() ? (str_f("INSERT INTO `bannames` (`Name`, `BanAdmin`, `BanSeconds`, `BanReason`) VALUE ('%s', '%s', '%d', '%s')", player_name, ban_admin, Global_Time+days*60*60*24, reason)):(str_f("UPDATE `bannames` SET `BanAdmin` = '%s', `BanSeconds` = %d, `BanReason` = '%s' WHERE `Name` = BINARY('%s') LIMIT 1;", ban_admin, Global_Time+days*60*60*24, reason, player_name)));

    return true;
}

stock BanIP(IP[])
{
    f(global_str, 100, "INSERT INTO `banip` (`IP`) VALUE ('%s')",IP);
	mysql_tquery(mysql, global_str);
	return 1;
}
stock Convert(number)
{
	new hours = 0, mins = 0, secs = 0, string[30];
	hours = floatround(number / 3600);
	mins = floatround((number / 60) - (hours * 60));
	secs = floatround(number - ((hours * 3600) + (mins * 60)));
	if(hours > 0) f(string, 30, "%d:%02d:%02d", hours, mins, secs);
	else f(string, 30, "%d:%02d", mins, secs);
	return string;
}
stock UnBanName(name[])
{
	if(IsBannedName(name))
	{
        f(global_str, 150, "DELETE FROM `bannames` WHERE BINARY `Name` = '%s'",name);
        mysql_tquery(mysql, global_str);
	}
	return 1;
}
