	}
    strcat(global_str,mysql_string);

    strcat(global_str,"\n{228B22}Pateikti pareiskima");

    return SPD(playerid, 8035, DIALOG_STYLE_TABLIST_HEADERS, "Prasymo pildymas", global_str, "Isrinkti", "Atsaukti");
}

