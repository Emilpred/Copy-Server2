	    if(IsPlayerInRangeOfPoint(playerid, 1, 2315.9089,72.5739,1501.9962) || IsPlayerInRangeOfPoint(playerid, 1, 2310.7771,72.5220,1501.9962) && PI[playerid][pJailTime] > 0) SPD(playerid, 0, 0, !"Informacija", !"{FFFFFF}Dabar esate arestineje\nPer laika, kuri jums skyre valstybe, reikia rasti\nadvokata ({34eb40}/advokats - ju telefonu numeriai{FFFFFF}). Jei per visa laika\nnerasite zmogaus, kuris\njums pades, jus issius i tikra kalejima su aukstesniais reikalavimais\nuz jusu nusikaltima.", !"Supratau", !"");
	    if(IsPlayerInRangeOfPoint(playerid, 2, -103.9012,2351.7346,1500.9497) && JailTSR[playerid] != -1) SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus negalite dabar palikti kalejimo!");
