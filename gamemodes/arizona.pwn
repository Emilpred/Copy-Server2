public: @AddItemOFF(playerid, itemid, count, name[]) {

	if !cache_get_row_count() *then
		return SCM(playerid, COLOR_GREY, !"Tokio zaidejo neegzistuoja.");

	new inventoff[4][110], invcell;

	cache_get_row(0, 0, global_str), Int_UnPackMassive(global_str, inventoff[0]); // Daiktu ID
    cache_get_row(0, 1, global_str), Int_UnPackMassive(global_str, inventoff[1]); // daiktu kiekis
    cache_get_row(0, 2, global_str), Int_UnPackMassive(global_str, inventoff[2]); // galandimas
    cache_get_row(0, 3, global_str), Int_UnPackMassive(global_str, inventoff[3]); // Stiprybe
    invcell = cache_get_row_int(0, 4, mysql);

    for new i; i < invcell; i++ do
    {
        if inventoff[0][i] *then continue;
		inventoff[0][i] = itemid;
		inventoff[1][i] = count;
		inventoff[2][i] = 0;
		inventoff[3][i] = 100;
		invcell = 0;
		break;
    }

	if invcell *then
		return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Sis zaidejas neturi pakankamai vietos inventoryje!");

	f(global_str, 147, "[A] Administratorius %s[ID: %d] isdave %s (%i vnt) zaidejui %s[OFF].",PN(playerid),playerid,ItemsInfo[itemid][ItemName2],count,name);
	SendAdminsMessage(COLOR_GREY, global_str);

	SCMF(playerid,COLOR_VALIK,"[Informacija] {ffffff}Jus sekmingai isdavete %s (%i vnt) zaidejui %s.",ItemsInfo[itemid][ItemName2],count,name);

	return SQL("UPDATE `accounts` SET `Item` = '%s', `ItemKolvo` = '%s', `ItemLevel` = '%s', `ItemProc` = '%s' WHERE `NickName` = BINARY('%s')", Int_PackMassive(0, inventoff[0]), Int_PackMassive(1, inventoff[1]), Int_PackMassive(2, inventoff[2]), Int_PackMassive(3, inventoff[3]), name);
}
stock GetMoney(playerid) return PI[playerid][pMoney];
new bool:MusicAll;
stock ShowActionCef(playerid, action[], delay)
{
    ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"ActionProgressBar\"]');");
    ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.actionProgressBar.initializeActionName', '[\"%s\"]');", action)));
	ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.actionProgressBar.initializeCountDown', '[%i]');", delay * 1000)));
	return SetTimerEx("HideActionCef", delay * 1000, false, "i", playerid);
}
public: HideActionCef(playerid)
{
    if GetPVarInt(playerid, "autoselection_run") *then AutoSeleciton_win(playerid);
	else if GetPVarInt(playerid, "use_player_Med") *then return callcmd::usemed(playerid, ""), DeletePVar(playerid, "use_player_Med"), ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[false]');");
	else if GetPVarInt(playerid, "use_player_Mask") *then return callcmd::mask(playerid, ""), DeletePVar(playerid, "use_player_Mask"), ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[false]');");
	else if GetPVarInt(playerid, "use_player_Armour") *then return callcmd::armour(playerid, ""), DeletePVar(playerid, "use_player_Armour"), ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[false]');");
	else if GetPVarInt(playerid, "use_player_Drugs") *then return callcmd::usedrugs(playerid, ""), DeletePVar(playerid, "use_player_Drugs"), ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[false]');");
	return ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[false]');");
}
stock AutoSeleciton_win(playerid) return SCM(playerid, COLOR_VALIK, !""); /* Autopadbor */

stock SideBarBarrier(playerid)
{
    ExecuteEvent(playerid, "window.executeEvent('cef.modals.showModal', '[\"interactionSidebar\",{\"title\": \"Atrakinti\",\"description\":\"\",\"timer\":7,\"buttons\":[{\"title\": \"Veiksmas\",\"keyTitle\": \"H\",\"buttonColor\": \"#ffffff\",\"backgroundColor\": \"rgba(171, 171, 171, 0.15)\"}]}]');");
    return SetTimer("HideBarAction", 1000*7, true);
}
forward HideBarAction(playerid);
public: HideBarAction(playerid) return ExecuteEvent(playerid, 0, "window.executeEvent('cef.modals.closeModal', '[\"interactionSidebar\"]');");

stock AirDropStart()
{
	AirDrop[air_Status] = true;
	AirDrop[air_Open] = false;

	AirDrop[air_PosX] = floatrandom(-3000.0, 3000.0);
	AirDrop[air_PosY] = floatrandom(-3000.0, 3000.0);
	AirDrop[air_PosZ] = floatrandom(100.0, 150.0);

	MapAndreas_FindZ_For2DCoord(AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZmap]);

	AirDrop[air_Object] = CreateDynamicObject(18849, AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZ], 0.0, 0.0, 0.0);

	MoveDynamicObject(AirDrop[air_Object], AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZmap] + 7.5, 2.50, 0.0, 0.0, 0.0);

	SetTimer("@AirDropOpen", floatround((AirDrop[air_PosZ]-AirDrop[air_PosZmap])/2.5)*1000, false);
	AirDrop[airArea] = CreateDynamicSphere(AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZ], 2.5);

	AirDrop[air_Text] = CreateDynamic3DTextLabel("Kontrabandos krovinys\nNaudokite {9ACD32}ALT{FFFFFF} norint\nperziureti turini!", -1, AirDrop[air_PosX], AirDrop[air_PosY], AirDrop[air_PosZmap] + 0.5, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);

	SCMALL(-1, !"{633169}[Demesio]{FFFFFF} Jusu draugai is {E65075}Liberty City{FFFFFF} numete kontrabandos konteineri!");
	SCMALL(-1, !"{633169}[Demesio]{FFFFFF} Greiciau isvykite i iskrovima, kad konkurentai nesugriebtu jusu konteinerio!");
	return SCMALL(-1, !"{633169}[Demesio]{FFFFFF} Issamesne informacija: {633169}/smug");
}
public: @RemoveInvOFF(playerid, name[]) {

	if !cache_get_row_count() *then
		return SCM(playerid, COLOR_GREY, !"Tokio zaidejo neegzistuoja.");

	f(global_str, 147, "[A] Administratorius %s[ID: %d] isvale inventoriu zaidejui %s[OFF].",PN(playerid),playerid,name);
	SendAdminsMessage(COLOR_GREY, global_str);

	SCMF(playerid,COLOR_VALIK,"[Informacija] {ffffff}Jus sekmingai isvalete inventoriu zaidejui %s.",name);
	return SQL("UPDATE `accounts` SET `Item` = '0', `ItemKolvo` = '0', `ItemLevel` = '0', `ItemProc` = '0', `ItemNashivka` = '0', `NashivkaLevel` = '0', `Bitcoin` = '0', `Euro` = '0', `Item_Time` = '0', `Item_UID` = '0', `Color` = '0' WHERE `NickName` = BINARY('%s')", name);
}
stock SetOrg(playerid, level) { PI[playerid][pMember] = level; return UpdatePlayerDataInt(playerid, "Member", PI[playerid][pMember]); }
stock SetLevelOrg(playerid, level) { PI[playerid][pRank] = level; return UpdatePlayerDataInt(playerid, "Rank", PI[playerid][pRank]); }
cmd:stuff(playerid, params[])
{
    if(!IsPlayerLogged{playerid}) return 0;
	if(PI[playerid][pRank] < 9)
	    return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Pasidaryti tatuiruote gali tik lyderis ir pavaduotojas!");
    if(!IsAtMafia(playerid))
        return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus nepriklausote mafijai!");
    new
        target,
        bodypart;
    if(sscanf(params, "ii", target, bodypart))
    {
        SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Naudokite: /stuff [ID] [Kuno dalis [1-4]]");
        SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Pasirinkite vieta, kur norite pasidaryti tatuiruote!");
        SCM(playerid, -1, !" ");
        SCM(playerid, -1, !" ");
        SCM(playerid, -1, !"<<Ant kaklo: 'Emblema seima'");
        SCM(playerid, -1, !"<<Ant kuno: 'Paveikslas - Kriksto tecio'");
        SCM(playerid, -1, !"<<Ant rankos: 'Vaizdas - Roze, apsivyniojanti aplink durkla'");
        SCM(playerid, -1, !"<<Ant nugaros: 'Paveikslas - Gangsteris suvarzytas grandinemis'");
        return 1;
    }
    if(!(1 <= bodypart <= 4))
        return SCM(playerid, -1, !"Klaida: Kuno dalis gali buti nuo 1 iki 4!");
	if(PI[playerid][pMember] != PI[target][pMember])
	    return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jis nepriklauso jusu mafijai!");
    if(!ProxDetectorS(5.0, playerid, target))
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jus turite buti salia zaidejo");
    player_tattoos[target]{bodypart - 1} = bodypart;
    global_str = "";
    strcat(global_str, "\n\n{FFFFFF}Sekmingai pasidarete tatuiruote organizacijos nariui: {FF6347}");
    strcat(global_str, PN(target));
    strcat(global_str, "\n\n");
    SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"", global_str, !"Priimti", !"");
	f(global_str, 400, "{FFFFFF}\n\n%s[%i] padare jums tatuiruote: {FF6347}%s\n\n{42AAFF}Dabar jus ilgai esate susije su savo organizacija,\nir jums nebuss lengva pradeti nauja gyvenimas!\n\n", PN(playerid), playerid, TATTOO_NAME[bodypart]);
    SPD(target, 0, DIALOG_STYLE_MSGBOX, !"", global_str, !"Priimti", !"");
	SetPlayerChatBubble(playerid, !"Pasidare tatuioruote", COLOR_PURPLE, 10.0, 5000);
	SetPlayerChatBubble(target, !"Sukreivo", COLOR_PURPLE, 10.0, 5000);
	ApplyAnimationEx(playerid, !"PED", !"SHOVE_PARTIAL", 4.0, 0, 0, 0, 0, 0, 1);
	ApplyAnimationEx(target, !"PED", !"IDLE_CHAT", 4.0, 0, 0, 0, 0, 0, 1);
    GameTextForPlayer(playerid, !"Successful", 5000, 1);
    GameTextForPlayer(target, !"Successful", 5000, 1);
    return 1;
}
CMD:showtatu(playerid)
{
	if(Int_GetPlayerData(playerid, !"antifloodtatu") > Global_Time)
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Ne FLOODink!");
	f(global_str, 128, "%s[%i] Nusiima virsutine apranga.", PN(playerid), playerid);
	ProxDetector(25.0, playerid, global_str, COLOR_ME);
	ApplyAnimationEx(playerid, !"PED", !"SHOVE_PARTIAL", 4.0, 0, 0, 0, 0, 0, 1);
	SetPVarInt(playerid, !"antifloodtatu", Global_Time + 9);
	f(global_str, 128, "{8C6F6F}<< {AFAFAF}Ant kaklo: {FFFFFF}%s{AFAFAF}, Ant kuno: {FFFFFF}%s{AFAFAF}.", TATTOO_NAME[player_tattoos[playerid]{0}], TATTOO_NAME[player_tattoos[playerid]{1}]);
	ProxDetector(25.0, playerid, global_str, COLOR_GREY);
	f(global_str, 128, "{8C6F6F}<< {AFAFAF}Rankose: {FFFFFF}%s{AFAFAF}, Ant nugaros: {FFFFFF}%s{AFAFAF}.", TATTOO_NAME[player_tattoos[playerid]{2}], TATTOO_NAME[player_tattoos[playerid]{3}]);
	ProxDetector(25.0, playerid, global_str, COLOR_GREY);
	return 1;
}
cmd:vad(playerid, data[])
{
	if PI[playerid][pVIP] < 5 *then
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} VIP Chatas prieinamas zaidejams, turintiems Titan VIP statusa ir aukstesni!");
	if PhoneImprovementsData[playerid][pdVIPChat] *then
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jus isjungete VIP Chata!");
	if PI[playerid][pMuteTime] *then
		return SendMuteMessage(playerid);
	if sscanf(data, "s[100]", mysql_string) *then
		return SCM(playerid, COLOR_OLDRED, !"Naudokite: /vad [text]");
    if IsAIP(mysql_string) *then
		return f(global_str, 145, "[Itarimas del reklamos] %s[%d]: [%s]", PN(playerid), playerid, mysql_string), SendAdminsMessage(COLOR_RED, global_str);
	if Int_GetPlayerData(playerid, !"vr") > Global_Time && !CheckFD(playerid, 1) && !GetPlayerADDVIP(playerid) *then
		return SCMF(playerid, COLOR_RED, "[Klaida]{FFFFFF} Iki galimybes vel siusti pranesima i si chata liko 00:%d", Int_GetPlayerData(playerid, !"vr")-Global_Time);
	else if(!CheckFD(playerid, 1) && !GetPlayerADDVIP(playerid)) if(PI[playerid][pVIP] == 6) SetPVarInt(playerid, !"vr", Global_Time + 15); else SetPVarInt(playerid, !"vr", Global_Time + 15);
	SetPVarString(playerid,"viptext",mysql_string);
	if !GetString(PN(playerid), "SupremeDCBot") *then
	{
		f(global_str,330,"\n\
		{FFFFFF}Ar jusu pranesimas yra reklama?\n\
		Reklaminio pranesimo kaina: {008000}$5,000\n\
		{cccccc}Pastaba: Atsiminkite, kad administracija gali nubausti uz neteisinga reklamu naudojima.\n\n\
		Nuo 23:00 iki 9:00 serverio laiku - reklama kainuoja {008000}$1,000!\n\
		Savininkams %s VIP - reklama visada nemokama",Mode_City);
		return SPD(playerid,9948,DIALOG_STYLE_MSGBOX,"",global_str,"Taip","Ne");
	}
	else
	{
		switch PI[playerid][pVIP] do
		{
			case 5: global_str = "{6495ED}[VIP]";
			case 6: global_str = "{F345FC}[PREMIUM]";
			case 7: global_str = "{DF3A01}[SAG]";
			case 8: global_str = "{9758fc}[HOLY]";
			case 9: global_str = "{488cff}[DELUXE]";
			case 10: global_str = "{9f003d}[SuperSAG]";
			default: f(global_str, 50, "%s", PI[playerid][pVipName]);
		}
		if !PI[playerid][pAdmin] *then
		{
			if(strlen(PI[playerid][pVipName]) > 0)
				f(global_str, 145, "%s{FFFFFF} %s[%d]{FFFFFF}: %s", PI[playerid][pVipName], PN(playerid), playerid, mysql_string);
			else
				f(global_str, 145, "%s{FFFFFF} %s[%d]{FFFFFF}: %s", global_str, PN(playerid), playerid, mysql_string);
		}
		else if(PI[playerid][pAdmin])
		{
		    if GetString(PI[playerid][pAdmTag], "None") *then
	        	f(global_str, 145, "{FCC645}[ADMIN | %s{FCC645}]{FFFFFF} %s[%d]{FFFFFF}: %s", Admin_Names[PI[playerid][pAdmin]], PN(playerid), playerid, mysql_string);
	    	else
				f(global_str, 145, "{FCC645}[ADMIN | {%s}%s{FCC645}]{ffffff} %s[%d]{FFFFFF}: %s", PI[playerid][pAdmTagColor], PI[playerid][pAdmTag], PN(playerid), playerid, mysql_string);
		}
		return SendVIPMessage(-1, global_str);
	}
}
public: OpenKlad(playerid)
{
	DeletePVar(playerid, #openk);
	GameTextForPlayer(playerid, "~g~SUCCESSFULLY", 1500, 3);
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija", !"{42B02C}Jus sekmingai iskasete duobe su lobiu!{ffffff}\n\nNoredami pamatyti, kas yra viduje, paspauskite: {42B02C}ALT", "Gerai", "");
	new kId = pTemp[playerid][kladID];
	KladInfo[kId][kladOpen] = true;
	ClearAnimationsEx(playerid);
	return 1;
}
stock PR_SendPacketToVehicleStream(BitStream:bs, vehicleid)
{
	foreach (new i : Player)
	{
		if (!IsVehicleStreamedIn(vehicleid, i) or !IsPlayerCefInit(i))
			continue;

        PR_SendPacket(bs, i);
    }
}

stock PR_SendRPCToVehicleStream(BitStream:bs, vehicleid, rpcid, excludedplayerid = INVALID_PLAYER_ID, PR_PacketPriority:priority = PR_HIGH_PRIORITY, PR_PacketReliability:reliability = PR_RELIABLE_ORDERED, orderingchannel = 0)
{
	foreach (new i : Player)
	{
    	if (i == excludedplayerid or !IsVehicleStreamedIn(vehicleid, i) or !IsPlayerCefInit(i))
        	continue;

        PR_SendRPC(bs, i, rpcid, priority, reliability, orderingchannel);
	}
}

stock PR_SendPacketToPlayerStream(BitStream:bs, playerid, PR_PacketPriority:priority = PR_HIGH_PRIORITY, PR_PacketReliability:reliability = PR_RELIABLE_ORDERED, orderingchannel = 0)
{
	foreach (new i : Player)
	{
    	if (!IsPlayerStreamedIn(i, playerid) or !IsPlayerCefInit(i))
        	continue;

    	PR_SendPacket(bs, i, priority, reliability, orderingchannel);
	}
}
stock ResetNewTune(playerid, carid)
{
    ResetVehicleTuning(carid);
    reset_CustomComponent(carid);
    UpdateVehicleTuning(carid);

    new number = GetVehicleID(carid);
	global_str[0] = EOS;
 	for(new i; i < 4; i++)
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Vinyl[carid][i]);
   	SQL("UPDATE `ownable` SET `tVinyl` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	global_str[0] = EOS, SQL_STRING[0] = EOS;
 	for(new i; i < 3; i++)
  	{
  		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_LightBackColor[carid][i]);
  		f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_LightFrontColor[carid][i]);
   	}
    SQL("UPDATE `ownable` SET `tLightBackColor` = '%s', `tLightFrontColor` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, CarInfo[number][cID]);

	global_str[0] = EOS;
	vTuning_Other[carid][3][0] = tuningCenter_playerData[playerid][cartCheck][1];
	for(new i; i < 4; i++)
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][3][i]);
   	SQL("UPDATE `ownable` SET `tOther_3` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	global_str[0] = EOS;
	vTuning_Other[carid][2][0] = tuningCenter_playerData[playerid][cartCheck][4];
	for(new i; i < 4; i++)
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][2][i]);
   	SQL("UPDATE `ownable` SET `tOther_2` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	global_str[0] = EOS;
	vTuning_Other[carid][0][0] = tuningCenter_playerData[playerid][cartCheck][3];
	for(new i; i < 4; i++)
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][0][i]);
   	SQL("UPDATE `ownable` SET `tOther_0` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	global_str[0] = EOS;
	vTuning_Other[carid][1][0] = tuningCenter_playerData[playerid][cartCheck][5];
	for(new i; i < 4; i++)
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][1][i]);
   	SQL("UPDATE `ownable` SET `tOther_1` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	global_str[0] = EOS;
	for(new i; i < 3; i++)
		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_SmokeColor[carid][i]);
  	SQL("UPDATE `ownable` SET `tSmokeColor` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	SQL("UPDATE `ownable` SET `tVipadVehicle_1` = '%.3f', `tVipadVehicle_2` = '%.3f', `tVipadVehicle_3` = '%.3f', `tVipadVehicle_4` = '%.3f',\
	`tRazvalVehicle_1` = '%.3f', `tRazvalVehicle_2` = '%.3f', `tRazvalVehicle_3` = '%.3f', `tRazvalVehicle_4` = '%.3f', `tWheelSize` = '%f' WHERE `ID` = '%i' LIMIT 1",\
	vTuning_WheelSettings[carid][0][0][0], vTuning_WheelSettings[carid][0][1][1], vTuning_WheelSettings[carid][0][1][0], vTuning_WheelSettings[carid][0][0][1],\
	vTuning_WheelSettings[carid][1][0][0], vTuning_WheelSettings[carid][1][1][1], vTuning_WheelSettings[carid][1][1][0], vTuning_WheelSettings[carid][1][0][1], vTuning_WheelSettings[carid][2][2][2], CarInfo[number][cID]);

	global_str[0] = EOS, SQL_STRING[0] = EOS, mysql_string[0] = EOS;
 	for(new i; i < 4; i++)
 	{
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Blackout[carid][0][i]);
   		f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_Blackout[carid][1][i]);
    	f(mysql_string, sizeof(mysql_string), "%s%i,", mysql_string, vTuning_Blackout[carid][2][i]);
  	}
  	SQL("UPDATE `ownable` SET `tBlackout_0` = '%s', `tBlackout_1` = '%s', `tBlackout_2` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, mysql_string, CarInfo[number][cID]);

   	global_str[0] = EOS, SQL_STRING[0] = EOS;
	new str[256];
 	for(new i; i < 4; i++)
 	{
 		f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Blackout[carid][3][i]);
  		f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_Blackout[carid][4][i]);
  		f(str, sizeof(str), "%s%i,", SQL_STRING, vTuning_Blackout[carid][5][i]); //vovka
 	}
  	SQL("UPDATE `ownable` SET `tBlackout_3` = '%s', `tBlackout_4` = '%s', `tBlackout_5` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, str, CarInfo[number][cID]);
	return 1;
}

stock SetVehicleNumbers(vehicleid, uId, text[], numbers[], forplayerid = INVALID_PLAYER_ID)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, \
		PR_UINT8, 220, \
		PR_UINT8, 153, \
		PR_UINT16, vehicleid, \
		PR_UINT8, uId, \
		PR_STRING32, text, \
		PR_STRING32, numbers);

	if forplayerid == INVALID_PLAYER_ID *then
		PR_SendPacketToVehicleStream(bs, vehicleid);
	else
		PR_SendPacket(bs, forplayerid);

	return BS_Delete(bs);
}
cmd:setcolor(playerid, params[])
{
	if !CheckFD(playerid, 2) *then return false;
    extract params -> new target, slot, color; else
		return SCM(playerid, COLOR_OLDRED, !"/setcolor [playerid] [slot] [color]");
	new item = Inventory[target][0][slot];
	if !item or !IsAAks(item) *then
	    return false;
	if color > 8 or color < 0 *then
		return false;
	SAMF(COLOR_VALIK, "[Informacija]{FFFFFF} A: %s[%i] perdaze aksesuara zaidejui %s[%i] i daikta %s [Spalva: %s]", PN(playerid), playerid, PN(target), target, ItemsInfo[item][ItemName2], AksMassive[color][AksColorName]);
	if color == 0 *then
	    PI[target][pColor][slot] = 0;
	else
		PI[target][pColor][slot] = AksMassive[color][AksColorDefault];
    SaveInventory(target);
	return 1;
}
CMD:changeservername(playerid)
{
	if !IsAOwner(playerid) *then
	    return SCM(playerid, COLOR_OLDRED, !"[Klaida] {cccccc}Jums neprieinama si komanda.");
	global_str = "";
	for new i; i < (PI[playerid][pAdmin] >= 7 ? sizeof (CommandServerName) : sizeof (CommandServerName) - 1); i++ do
		f(mysql_string, 1024, "%s\n%d. %s", global_str, i + 1, CommandServerName[i]), f(global_str, 1024, mysql_string, Mode_City);
	return SPD(playerid, 1111, 2, !"Serverio pavadinimas", global_str, !"Priimti", !"Atsaukti");
}
cmd:setadmtag(playerid, params[])
{
	new tagname[64];
	if sscanf(params, "us[32]s[64]", params[0], params[1], tagname) *then
		return SCM(playerid, COLOR_OLDRED, !"Naudokite: /setadmtag [id] [color] [tag]"), SCM(playerid, -1, !"Noredami isduoti standartini prefixa/prefixo spalva irasykite 1 i [tag] arba i [color].");
	if PI[params[0]][pAdmin] < 0 *then
		return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Sis zaidejas nera administorius!");
	if !IsPlayerConnected(params[0]) *then
		return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Zaidejas yra Offline!");
    if strlen(tagname) < 1 *then
		return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Prefixo ilgis turi buti ilgesnis nei 1 simbolis.");
    if !GetString(tagname, "1") *then SetString(PI[params[0]][pAdmTag], tagname);
    else SetString(PI[params[0]][pAdmTag], Admin_NoColor[PI[params[0]][pAdmin]]);
    if !GetString(params[1], "1") *then SetString(PI[params[0]][pAdmTagColor], params[1]);
    else SetString(PI[params[0]][pAdmTagColor], Admin_Colors[PI[params[0]][pAdmin]]);
    SCMF(playerid, COLOR_LIGHTBLUE, "[A] Jus nustatete prefixa administratoriui %s[%d]: {%s}%s", PN(params[0]), params[0], PI[params[0]][pAdmTagColor], PI[params[0]][pAdmTag]);
	SAMF(COLOR_LIGHTBLUE, "[A] A: %s[%d] nustate prefixa administratoriui %s[%d]: {%s}%s", PN(playerid), playerid, PN(params[0]), params[0], PI[params[0]][pAdmTagColor], PI[params[0]][pAdmTag]);
	return UpdatePlayerDataStr(params[0], "AdminTag", PI[params[0]][pAdmTag]), UpdatePlayerDataStr(params[0], "AdminTagColor", PI[params[0]][pAdmTagColor]);
}
stock ShowQuestZone(playerid, zone)
{

 /*   ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "{BFBBBA}", "\
		{FFFFFF}Noredami atidaryti deze su {FFF473}Ruletemis{FFFFFF}, turite pereiti visa\n\
