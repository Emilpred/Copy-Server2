	new
 		vehicle[] = {15960, 15861, 15627, 15722, 15723, 15498, 15496, 15497, 15495, 15331, 15099, 15085, 14909, 14767, 14124, 12727, 12724, 6613, 12718, 15963, 15909, 6624, 6620, 6619, 6618, 6617},
		id = vehicle[random(sizeof vehicle)];

	AddOwnableCar(playerid, id, PN(playerid));

	f(global_str, sizeof(global_str), "%s isbande savo sekme naudojant \'Uzantspauduota transporto sertifikata\' ir laimejo transporta: %s", PN(playerid), GetVehicleName(id, true));
