stock SetVehicleColor(vehicleid, playerid = INVALID_PLAYER_ID)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(bs,
            PR_UINT32, vehicleid,
            PR_UINT8, 4,
            PR_UINT8, 1,
            PR_UINT16, strlen("urus_wad"),
            PR_STRING, "urus_wad",
			PR_UINT8, 255,
            PR_UINT8, vTuning_Vinyl[vehicleid][1],
            PR_UINT8, vTuning_Vinyl[vehicleid][2],
            PR_UINT8, vTuning_Vinyl[vehicleid][3]);

	if(playerid == INVALID_PLAYER_ID)
    	PR_SendRPCToVehicleStream(bs, vehicleid, 161);

    else if(IsPlayerCefInit(playerid)) PR_SendRPC(bs, playerid, 161);
    BS_Delete(bs);

    return 1;
}

stock UpdateEventTuningData(playerid, slot)
{
	ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.tuning.setDashboardProperties', `[[\
		{\"type\":0,\"name\":\"Galia\",\"value\":%d,\"valueOffset\":0.0,\"valueMax\":245.0},\
		{\"type\":1,\"name\":\"Atsparumas\",\"value\":%d,\"valueOffset\":0.0,\"valueMax\":350.0},\
		{\"type\":2,\"name\":\"Pagreitis\",\"value\":%d,\"valueOffset\":0.0,\"valueMax\":75.0},\
		{\"type\":3,\"name\":\"Maks. Greitis\",\"value\":%d,\"valueOffset\":0.0,\"valueMax\":800.0}]]`);", Float:InfoConfigVehicle[slot][Power], Float:InfoConfigVehicle[slot][Stability], Float:InfoConfigVehicle[slot][Velocity], Float:InfoConfigVehicle[slot][MaxSpeed])));
}
stock GetCartCost(id)
{
	for new i; i < sizeof tuningData; i ++ do
	{
		if(tuningData[i][tuningId] == id) return tuningData[i][tuningCost];
	}
	return 1;
}
