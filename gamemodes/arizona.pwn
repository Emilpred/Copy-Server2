			InterpolateCameraLookAt(playerid, 1833.155517, -1836.299804, 32.592384, 1693.922973, -1849.756713, 15.648486, 10000);
	        f(global_str, 550, "%s\t{9ACD32}Sveiki atvyke i San Andreas Gyvenimas: %s!{FFFFFF}\n\n",global_str, Mode_City);
	        strcat(global_str,"Musu serveryje rasite daug idomaus sau.\n");
