		else SPD(playerid, 185, 2, !"Pasirinkite maista", !"{42B02C}-{FFFFFF} Bulvytes Free \t\t220$\n{42B02C}-{FFFFFF} Sumustinis \t\t\t260$\n{42B02C}-{FFFFFF} Basket \t\t\t300$\n{42B02C}-{FFFFFF} Sparneliai \t\t\t340$\n{42B02C}-{FFFFFF} Salotos \t\t\t380$\n{42B02C}-{FFFFFF} Vistiena \t\t\t420$\n{42B02C}-{FFFFFF} Kompleksinis pietus \t\t700$", !"Isrinkti", !"Atsaukti");
