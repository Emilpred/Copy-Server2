stock IsValidObjectVehicle(id)
{
    for(new i; i < sizeof(global_TuningData); i++) if(global_TuningData[i][tunUID] == id) return i;
    return -1;
}
stock SetVehicleEventEx(vehicleid, id, playerid = INVALID_PLAYER_ID)
{
    if(!Iter_Contains(Vehicle, vehicleid)) return 0;

    if(IsValidObjectVehicle(id) == -1) return 0;
    new BitStream:bsCustom = BS_New();
    BS_WriteValue(bsCustom,
            PR_UINT8, 255,
            PR_UINT8, 255,
            PR_UINT32, 2,
            PR_UINT32, vehicleid,
            PR_UINT32, id,
            PR_UINT32, 0,
            PR_UINT8, 0);

	if(playerid == INVALID_PLAYER_ID)
        PR_SendRPCToVehicleStream(bsCustom, vehicleid, 96);

    else if(IsPlayerCefInit(playerid)) PR_SendRPC(bsCustom, playerid, 96);
    BS_Delete(bsCustom);

    return 1;
}

stock SetVehicleKoleso(vehicleid, playerid = INVALID_PLAYER_ID) //playerid temp
{
    new id = vTuning_Other[vehicleid][3][0];
    if(!Iter_Contains(Vehicle, vehicleid) || id < 1) return 0;

    SetVehicleEventEx(vehicleid, wheelData[id-1][wUID]);

    new BitStream:bs = BS_New();
    BS_WriteValue(bs,
            PR_UINT32, vehicleid,
            PR_UINT8, 4,
            PR_UINT8, 1,
            PR_UINT16, strlen(wheelData[id-1][wName]),
            PR_STRING, wheelData[id-1][wName],
            PR_UINT8, 255,
            PR_UINT8, vTuning_Other[vehicleid][3][1],
            PR_UINT8, vTuning_Other[vehicleid][3][2],
            PR_UINT8, vTuning_Other[vehicleid][3][3],
            PR_UINT16, strlen("default"),
            PR_STRING, "default");

	if(playerid == INVALID_PLAYER_ID)
    	PR_SendRPCToVehicleStream(bs, vehicleid, 161);

    else if(IsPlayerCefInit(playerid)) PR_SendRPC(bs, playerid, 161);

    BS_Delete(bs);
    return 1;
}

stock SetVehicleRazval(vehicleid, Float:vipad, Float:razval, wheel, type)
{
	for new i; i < sizeof SixCars; i ++ do
	if(GetVehicleModelEx(vehicleid) == SixCars[i]) return false;

	global_str = "";

	static const
	typeWheel[][] = {"r", "l"},
	WheelPosition[][] = {"b", "f"};

	global_str = "";

	f(global_str, sizeof global_str, "wheel_%s%s_dummy", typeWheel[wheel], WheelPosition[type]);

	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT16, vehicleid, PR_UINT16, 256, PR_UINT16, 258, PR_UINT16, strlen(global_str), PR_STRING, global_str);

	BS_WriteValue(bs, PR_FLOAT, vipad, PR_UINT32, 0, PR_UINT32, 0, PR_FLOAT, razval);

	PR_SendRPCToVehicleStream(bs, vehicleid, 161), BS_Delete(bs);
	return 1;
}

stock SetVehicleWheelSize(vehicleid, Float:wheelSize)
{
	for new i; i < sizeof SixCars; i ++ do
	if(GetVehicleModelEx(vehicleid) == SixCars[i]) return false;

	new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 135, PR_UINT16, vehicleid, PR_FLOAT, wheelSize, PR_UINT32, 0);

	PR_SendPacketToVehicleStream(bs, vehicleid), BS_Delete(bs);
	return 1;
}

stock SetVehicleBlackout(vehicleid, type, playerid = INVALID_PLAYER_ID)
{
    if(!Iter_Contains(Vehicle, vehicleid) or ( type > 5 || type < 0 ) ) return 0;

    new
		level = vTuning_Blackout[vehicleid][type][0],
        color_0 = vTuning_Blackout[vehicleid][type][1],
        color_1 = vTuning_Blackout[vehicleid][type][2],
        color_2 = vTuning_Blackout[vehicleid][type][3];

    new BitStream:bs = BS_New();

    static const place_blackout[][] = {
        {"wnd"}, //priekine
        {"wnd_rr"}, //galine
        {"wdor_f"}, //sonine priekiniai
        {"wdor_r"}, //sonine galine
		{"wnd_rr"}, //galine
		{"wndrrl"} //galiniai zibintai
    };

    BS_WriteValue(bs,
            PR_UINT16, vehicleid,
            PR_UINT16, 256,
            PR_UINT16, 260,
            PR_UINT16, strlen(place_blackout[type]),
            PR_STRING, place_blackout[type],
            PR_UINT8, level,
            PR_UINT8, color_0,
            PR_UINT8, color_1,
            PR_UINT8, color_2,
            PR_UINT16, strlen("white"),
            PR_STRING, "white");

	if(playerid == INVALID_PLAYER_ID)
    	PR_SendRPCToVehicleStream(bs, vehicleid, 161);

    else if(IsPlayerCefInit(playerid)) PR_SendRPC(bs, playerid, 161);

	BS_Delete(bs);

	return 1;
}
stock SetVehicleVinyl(vehicleid, playerid = INVALID_PLAYER_ID) //playerid temp
{
    if(!Iter_Contains(Vehicle, vehicleid)) return 0;
    new BitStream:bs = BS_New();
    global_str[0] = EOS, f(global_str, sizeof(global_str), "%s_wad", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name]);
    new bool:off;
    if(vTuning_Vinyl[vehicleid][0] > 19 || vTuning_Vinyl[vehicleid][0] < 1) off = true;
    BS_WriteValue(bs,
            PR_UINT16, vehicleid,
            PR_UINT16, 256,
            PR_UINT16, off != false ? 259 : 260,
            PR_UINT16, strlen(global_str),
            PR_STRING, global_str);
    if(!off)
    {
        SQL_STRING[0] = EOS, f(SQL_STRING, sizeof(SQL_STRING), "wad%i", vTuning_Vinyl[vehicleid][0]);
        BS_WriteValue(bs, PR_UINT8, 255,
            PR_UINT8, vTuning_Vinyl[vehicleid][1],
            PR_UINT8, vTuning_Vinyl[vehicleid][2],
            PR_UINT8, vTuning_Vinyl[vehicleid][3],
            PR_UINT16, strlen(SQL_STRING),
            PR_STRING, SQL_STRING);
    }
	if(playerid == INVALID_PLAYER_ID)
    	PR_SendRPCToVehicleStream(bs, vehicleid, 161);

    else if(IsPlayerCefInit(playerid)) PR_SendRPC(bs, playerid, 161);
    BS_Delete(bs);
    return 1;
}

stock SearchVehicleName(model)
{
	for(new i; i < sizeof InfoConfigVehicle; i++)
	{//Model_Name
		if(model >= 612 && InfoConfigVehicle[i][Model_NEW] == model) return i;
		if(model < 612 && InfoConfigVehicle[i][Model_OLD] == model) return i;
	}
    return 0;
}

stock GetVehicleTuningEx(vehicleid, type, set) //set == abcde
{
    if(!Iter_Contains(Vehicle, vehicleid)) return 0;
    static const set_ABC[][] = {"a", "b", "c", "d", "e"};
    SQL_STRING[0] = EOS;
    switch(type)
    {
        case 0: //kapotas
        {
            SQL_STRING[0] = EOS, f(SQL_STRING, sizeof(SQL_STRING), "bnt_b_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name], set_ABC[set]);
        }
        case 1: //duslintuvas
        {
            SQL_STRING[0] = EOS, f(SQL_STRING, sizeof(SQL_STRING), "rbmp_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name], set_ABC[set]);
        }
        case 2: //spoileris
        {
            SQL_STRING[0] = EOS, f(SQL_STRING, sizeof(SQL_STRING), "spl_b_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name], set_ABC[set]);
        }
        default: //diskai
        {

        }
    }
    for(new i; i < sizeof(global_TuningData); i++)
        if(GetString(global_TuningData[i][tunName], SQL_STRING))
            return global_TuningData[i][tunUID];

    return 0;
}
stock SetVehicleTuningEx(vehicleid, type, set)
{
    if(!Iter_Contains(Vehicle, vehicleid) || GetVehicleModelEx(vehicleid) < 612) return 0;
    new data = GetVehicleTuningEx(vehicleid, type, set);
    if(data > 0)
    {
        vTuning_Other[vehicleid][type][0] = data;
        return 1;
    }
    return 0;
}
stock GetVehicleTuning(vehicleid, type)
{
    if(!Iter_Contains(Vehicle, vehicleid) || GetVehicleModelEx(vehicleid) < 612) return 0;
    return vTuning_Other[vehicleid][type][0];
}
stock ResetVehicleTuning(vehicleid)
{
    for(new i; i < 6; i++)
    {
        if(i < 3)
        {
            vTuning_LightBackColor[vehicleid][i] = TuningDataDefault[tBackColor][i];
            vTuning_LightFrontColor[vehicleid][i] = TuningDataDefault[tFrontColor][i];
            vTuning_SmokeColor[vehicleid][i] = TuningDataDefault[tSmokeColor][i];
            vTuning_NeonColor[vehicleid][i] = TuningDataDefault[tNeonColor][i];
			SetString(vTuning_NumberSettings[vehicleid][i], "0");
        }
        for(new j; j < 4; j++)
        {
            if(i < 4)
				vTuning_Other[vehicleid][i][j] = TuningDataDefault[tOther][i],
				vTuning_Vinyl[vehicleid][i] = TuningDataDefault[tVinyl][i];

            vTuning_Blackout[vehicleid][i][j] = TuningDataDefault[tBlackout][i];
        }
		vTuning_WheelSettings[vehicleid][0][0][0] = vTuning_WheelSettings[vehicleid][0][1][1] = vTuning_WheelSettings[vehicleid][0][1][0] = vTuning_WheelSettings[vehicleid][0][0][1] =
		vTuning_WheelSettings[vehicleid][1][0][0] = vTuning_WheelSettings[vehicleid][1][1][1] = vTuning_WheelSettings[vehicleid][1][1][0] = vTuning_WheelSettings[vehicleid][1][0][1] =
		vTuning_WheelSettings[vehicleid][2][2][2] = vTuning_Hydraulic[vehicleid] = 0;
    }
    return 1;
}

public: SetLoadTune(playerid) HideFullCef(playerid, 1);

stock RemoveVehicleVisualTuning(vehicleid, componentId, uId)//loll
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT16, vehicleid, PR_UINT16, componentId);

    PR_SendRPCToVehicleStream(bs, vehicleid, 57);

	BS_Delete(bs);

	vTuning_Other[vehicleid][uId][0] = vTuning_Other[vehicleid][uId][1] = vTuning_Other[vehicleid][uId][2] = vTuning_Other[vehicleid][uId][3] = 0;

    return 1;
}

stock UpdateEnterTuningCenter(i, set = -2)
{
	if(i == 255) return 1;

//	if(set != -2) globalTun_OwnerID[i] = set;
	if(globalTun_Label3D == Text3D:-1) globalTun_Label3D = CreateDynamic3DTextLabel(!"", 0xFFFFFFFF, tunDataEnter_Position[i][0], tunDataEnter_Position[i][1], tunDataEnter_Position[i][2], 20.0);
//	if(globalTun_Label3D[i] == Text3D:-1) globalTun_Label3D[i] = CreateDynamic3DTextLabel(!"", 0xFFFFFFFF, tunDataEnter_Position[i][0], tunDataEnter_Position[i][1], tunDataEnter_Position[i][2], 20.0);
	//update
	global_str[0] = EOS;
	if(tuningclose != -1) global_str = "{EFBE51}Garazas uzimtas!\nLaikykites eiles arba busite nubausti administracijos!";
	else global_str = "Ivaziavimui i garaza\n{70CFFA}Naudokit: {ffffff}ALT";
//	return UpdateDynamic3DTextLabelText(globalTun_Label3D[i], -1, global_str);
    return UpdateDynamic3DTextLabelText(globalTun_Label3D, -1, global_str);
}

stock ShowTuningMenu(playerid)
{
	if(playerTun_IsGarage{playerid} == 255) return SCM(playerid, -1, !"error dsa932");
    new carid = GetPlayerVehicleID(playerid);
    if(carid > 0)
    {
		LinkVehicleToInterior(carid, 3);
		SetVehicleVirtualWorld(carid, playerTun_IsGarage{playerid}+1);
		SetVehiclePos(carid, 1534.1133,956.9988,10.7498);
        SetVehicleZAngle(carid, 0.0);

        TogglePlayerControllable(playerid, false);

        SetPlayerInterior(playerid, 3);
		SetPlayerCameraPos(playerid, 1536.8762, 962.1998, 11.4604);
		SetPlayerCameraLookAt(playerid, 1530.8762, 951.8074, 9.4604);
		SetPlayerVirtualWorld(playerid, playerTun_IsGarage{playerid}+1);

