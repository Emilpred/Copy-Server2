					AuctionData[i][auction_item][0] = AuctionData_player[playerid][p_auction_item][0];
					AuctionData[i][auction_item][1] = AuctionData_player[playerid][p_auction_item][1];
				}

				SetString(AuctionData[i][auction_owner], PlayerName[playerid]);

				break;
			}

			if AuctionData_player[playerid][p_auction_id] == -1 *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Siuo metu aukciono vietos uzimtos, pabandykite veliau.");

			return SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Jusu preke %s => sekmingai prideta uz %d BTC", GetAuctionName(AuctionData_player[playerid][p_auction_id]), cost);
