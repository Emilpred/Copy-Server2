public: UpdateDonatePlayer(playerid)
{
	Int_SetPlayerData(playerid, "DonateWait", Global_Time + 5);

	new newdonate = cache_get_row_int(0, 0, mysql), xdonate = (!XDonate ? 1 : XDonate);

	if !newdonate *then
		return false;

	UpdatePlayerDataInt(playerid, "GetEurs", 0);

	GiveRoubles(playerid, newdonate * xdonate, "x2 Donate is site");

	return SPDF(playerid, 0, DIALOG_STYLE_MSGBOX, !"Balanso papildymas", "{FFFF00}Jusu balansas sekmingai papildytas %d SAG-Euru.", !"x", !"", newdonate * xdonate);
}

stock UpdateDonate(playerid)
{
    if Int_GetPlayerData(playerid, "DonateWait") < Global_Time *then {
		Int_SetPlayerData(playerid, "DonateWait", Global_Time + 5);

		f(global_str, 128, "SELECT `GetRoubles` FROM accounts WHERE NickName = BINARY('%s') LIMIT 1;", PN(playerid));
		mysql_tquery(mysql, global_str, "UpdateDonatePlayer", "i", playerid);
	}
	return true;
}

