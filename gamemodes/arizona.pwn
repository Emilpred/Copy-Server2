	{633169}[4] {FFFFFF}Isrinkti garazo tipa\t\t{cccccc}[%s]\n\
	{633169}[5] {FFFFFF}Nustatyti isvaziavimo taska is garazo\t{cccccc}[%.2f, %.2f, %.2f]\n\
	{cccccc}>> Istrinti uzpildytus duomenis\n\
	{73B460}>> Sukurti nama",
	AhPosX, AhPosY,
	AhPosZ, AhCost,
	AhKlass, AhGarageName,
	AhGaragePositionX, AhGaragePositionY, AhGaragePositionZ);
	return SPD(playerid, 22836, DIALOG_STYLE_TABLIST, "{AFAFAF}Namo kurimas", global_str, "Isrinkti", "Atsaukti");
