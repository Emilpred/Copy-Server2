	    case 7238:
		{
			if response *then
			{
				if listitem > 31 *then return false;
				new house = ShowHouse[playerid][listitem];
				switch Int_GetPlayerData(playerid, "typeHouseDialog") do
				{
					case 0:
					{
						PI[playerid][pDCTime]=1;
						f(global_str, 400,"» {633169}[Informacija] {FFFFFF}Jus nustatete nama [{FFD700}%d{ffffff}] kaip spawno vieta!", house);
						SCM(playerid,-1,global_str);
						PI[playerid][pHouseKey] = house;
						UpdatePlayerDataInt(playerid, "HouseKey", PI[playerid][pHouseKey]);
						callcmd::setspawn(playerid);
					}

				    case 1:
				    {
						if(!HouseInfo[house][hNalog]) return SendBotMessage(playerid,"Siam namui nebuvo nustatytas joks mokestis.");
						if(PI[playerid][pMoney] < HouseInfo[house][hNalog])return SendBotMessage(playerid,"Atsiprasome, bet jums truksta reikiamos pinigu sumos!");
						f(global_str, 150, "komunaliniu paslaugu apmokejimas namui idh:%d", house);
						GiveMoney(playerid, ImprovementsData[playerid][imFreeloader] ? -HouseInfo[house][hNalog]/2:-HouseInfo[house][hNalog], global_str);
						OrgInfo[GLS[13]][oBank] += HouseInfo[house][hNalog];
						if(OrgInfo[GLS[13]][oBank] > 2000000000) OrgInfo[GLS[13]][oBank] = 2000000000;
						SaveOrg(GLS[13]);
						HouseInfo[house][hNalog] = 0;
						SaveHouse(house);
						SCM(playerid,COLOR_GREEN, !"Sekmingai sumokejote neapmoketas saskaitas uz komunalines paslaugas");
						if(!ImprovementsData[playerid][imFreeloader]) SCM(playerid,COLOR_GREEN, !"Atkreipkite demesi, kad turint patobulinima 'Chaliavscikas', jus mokesite perpus maziau!");
   						SendBankBot(playerid);
				    }

				    case 2:
				    {
	                    if PI[playerid][pMoney] < 500 *then
							return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums nepakanka pinigu!");

	                  	GiveMoney(playerid, -500);
	                  	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"", !"\n\n{FFFFFF}Jusu namas pazymetas zemelapyje!\n\n", !"Priimti", !"");
	                    EnableGPSForPlayer(playerid, HouseInfo[house][hEnter_X], HouseInfo[house][hEnter_Y], HouseInfo[house][hEnter_Z]);
				    }

					case 3:
					{
						if !GetString(HouseInfo[house][hOwner], PN(playerid)) *then
							return false;

						foreach(Player, i)
						{
							if !(FP_Data[playerid][F_FAMILY_ID] == FP_Data[i][F_FAMILY_ID]) *then continue;
							FP_Data[i][F_FAMILY_SPAWN_DATA] = house;
							FP_Data[i][F_FAMILY_SPAWN_TYPE] = 1;
						}

						UpdateFamilyData(FP_Data[playerid][F_FAMILY_ID], "`spawn_type` = 1, `spawn_data` = %d", house);

						return SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Jus nustatete nama ¹%d kaip savo seimos spawno vieta.", house);
					}
				}
				DeletePVar(playerid, "typeHouseDialog");
			}
		}
	    case 2108:
	    {
	        if(response)
	        {
				if(!strlen(inputtextsave)) return 0;
				foreach(Player,i)
				{
					if(IsPlayerInRangeOfPoint(i,30.0, BumBoxPos[playerid][0], BumBoxPos[playerid][1], BumBoxPos[playerid][2]))
				    {
					    StopAudioStreamForPlayerFix(i);
						PlayAudioStreamForPlayerFix(i, inputtextsave, BumBoxPos[playerid][0], BumBoxPos[playerid][1], BumBoxPos[playerid][2], 30.0, 1);
					}
				}
			}
		}
		case 23045:
        {
 			if !response || !Int_GetPlayerData(playerid, "captchaOpen") *then
			 	return DestroyCaptcha_BOT(playerid);

			new
				captcha[5],
				type,
				ms = GetTickCount() - Int_GetPlayerData(playerid, "lsd"),
				house = InfoHouse[playerid],
				biz = InfoBiz[playerid];

			GetPVarString(playerid, "CaptchaAPIstr", global_str, sizeof global_str);
			sscanf(global_str, "p<,>ds[6]", type, captcha);

			if !strlen(inputtextsave) || !GetString(inputtextsave, captcha) *then {
				SCM(playerid, COLOR_RED, !"[Klaida] {ffffff}Atsakymas neteisingas!");
				return DestroyCaptcha_BOT(playerid);
			}

			if float(ms)/1000 <= 0.55 *then
			{
				SCM(playerid, COLOR_OLDRED, !"Deja, tai per greitai! Informacija issiusta administracijai!");

				f(global_str, 187, "Zaidejas %s[%d] bande isigyti turta uz valstybine kaina %.2f ms! CAPTCHA: (%s | %s)", PN(playerid), playerid, float(ms)/1000, captcha, inputtextsave);
				SendAdminsMessage(COLOR_OLDRED, global_str);

				return DestroyCaptcha_BOT(playerid);
			}

			switch type do
			{
			    case 1:
				{
					if house != Int_GetPlayerData(playerid, "CaptchAntiDeBug") *then
						return DestroyCaptcha_BOT(playerid);

			        if !strcmp(HouseInfo[house][hOwner], "The State") *then
			        {
				        HouseEntered[playerid] = house;
	                    HouseInfo[house][hNoOwner] = 0;
				     	InfoHouse[playerid] = -1;
				     	PI[playerid][pDCTime] = 1;

				     	SCM(playerid, -1, !">> {FF6347} Spawno vieta automatiskai nustatyta jusu name. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");

				     	if HouseInfo[house][hType] == 0 or HouseInfo[house][hType] == 2 *then
			     		{
						 	if GetCount(playerid, 952) *then
							 	GiveMoney(playerid, -HouseInfo[house][hCost]/2, (str_f("pirkimas namo ID: %d uz %.2f ms (%s | %s)", house, float(ms)/1000, captcha, inputtextsave))), DeleteItem(playerid, 952, 1);
   							else
							   	GiveMoney(playerid, -HouseInfo[house][hCost], (str_f("pirkimas namo ID: %d uz %.2f ms (%s | %s)", house, float(ms)/1000, captcha, inputtextsave)));
					   	}

						else if HouseInfo[house][hType] == 1 *then
							GiveDonate(playerid, -HouseInfo[house][hCost]);

						else if HouseInfo[house][hType] == 3 *then
						    DeleteItem(playerid, 2308, HouseInfo[house][hCost]), SaveInventory(playerid);

				     	PI[playerid][pHouseKey] = house;

						foreach(new i: Player)
						{
							if HouseNalog[i] == house *then
							{
							    callcmd::stopjob(i, "");
								SCM(i, COLOR_RED, !"[Informacija] {FFFFFF}Nama, su kuriuo dirbate, buvo ispirktas. Pradekite darba is naujo.");
							}
						}

				     	SetPlayerInterior(playerid, HouseInfo[house][hInt]);
					    SetPlayerVirtualWorld(playerid, house + 50);

					    UpdatePlayerPos(playerid, HouseInfo[house][hExit_X], HouseInfo[house][hExit_Y], HouseInfo[house][hExit_Z]);

					    SetString(HouseInfo[house][hOwner], PN(playerid));
					    UpdateHouse(house);

						SCM(playerid, COLOR_VALIK, !"[Informacija] {FFFFFF}Sveikiname! Dabar sis namas yra jusu!");

						PlayerPlaySound(playerid, 30800, 0.0, 0.0, 0.0);
						ResetHouse(house);

						f(global_str, 300, "%s [%d] nusipirko nama ID: %d uz valstybes kaina %.2f ms! CAPTCHA: (%s | %s)", PN(playerid), playerid, house, float(ms)/1000, captcha, inputtextsave);
						SendAdminsMessage(COLOR_OLDRED, global_str);

						HideInfoMenu(playerid);
			        }
			        else
						SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Sis namas jau yra nupirktas!");
  				}

			    case 2:
				{
					if biz != Int_GetPlayerData(playerid, "CaptchAntiDeBug") *then
						return DestroyCaptcha_BOT(playerid);

		        	else if(GetPlayerBizes(playerid))
		        	{
	                    if !strcmp(BizData[biz][bOwner], "The State") *then
	                    {
				     	    switch BizData[biz][bCostType] do
				     	    {
				     	    	case 1: GiveDonate(playerid, -BizData[biz][bCost]);
				     	    	case 2: GiveRoubles(playerid, -BizData[biz][bCost], (str_f("pirkimas verslo ID: %d uz %.2f ms (%s | %s)", biz, float(ms)/1000,captcha,inputtextsave)));
				     	    	case 3: DeleteItem(playerid, 2308, -BizData[biz][bCost]), SaveInventory(playerid);
				     	    	default: GiveMoney(playerid, -BizData[biz][bCost], (str_f("pirkimas verslo ID: %d uz %.2f ms (%s | %s)", biz, float(ms)/1000,captcha,inputtextsave)));
				     	    }

			     	        BizData[biz][bLevel] = 0;

					        SetString(BizData[biz][bOwner], PN(playerid));
					        UpdateBusinessText(biz, 1);

				     	    SCM(playerid, COLOR_VALIK, !"[Informacija] {FFFFFF}Sveikiname! Dabar sis verslas yra jusu!");

				     	    PlayerPlaySound(playerid, 30800, 0.0, 0.0, 0.0);

							f(global_str, 300,"%s [%d] nusipirko versla ID: %d uz valstybees kaina %.2f ms! CAPTCHA: (%s | %s)", PN(playerid),playerid, biz, float(ms)/1000,captcha,inputtextsave);
							SendAdminsMessage(COLOR_OLDRED, global_str);
			     	    }
			     	    else SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Sis verslas jau yra kazkieno nupirktas");
					}
