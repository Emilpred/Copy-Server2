stock ShowButton(playerid, type, text[] = "Paspauskite, kad saveikauti")
{
	new
		BitStream:packet_playerData = BS_New();

	switch type do
	{
	    case 0: // alt
	    {
			BS_WriteValue(packet_playerData, PR_UINT8, 220, PR_UINT8, 68, PR_UINT8, 0, PR_UINT8, 4, PR_UINT8, 0, PR_UINT8, 0, PR_UINT8, strlen(text), PR_UINT8, 0,\
			 PR_UINT8, 0, PR_UINT8, 0, PR_STRING, text);
		}
		case 1: //n
		{
			BS_WriteValue(packet_playerData, PR_UINT8, 220, PR_UINT8, 68, PR_UINT8, 0, PR_UINT8, 0, PR_UINT8, 2, PR_UINT8, 0,\
			 PR_UINT8, strlen(text), PR_UINT8, 0, PR_UINT8, 0, PR_UINT8, 0, PR_STRING, text);
		}
		case 2: //H
		{
			BS_WriteValue(packet_playerData, PR_UINT8, 220, PR_UINT8, 68, PR_UINT8, 2, PR_UINT8, 0, PR_UINT8, 0, PR_UINT8, 0,\
			 PR_UINT8, strlen(text), PR_UINT8, 0, PR_UINT8, 0, PR_UINT8, 0, PR_STRING, text);
		}
	}

	PR_SendPacket(packet_playerData, playerid);

	return BS_Delete(packet_playerData);
}

