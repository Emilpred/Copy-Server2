    BizData[bizid][bBuyCost] = 0;
    BizData[bizid][bNeedItem] = 0;
    BizData[bizid][bVisit] = 0;
    BizData[bizid][bWin] = 0;

    UpdateBusinessText(bizid, 1);
	return true;
}

stock ShowLogo(playerid)
{
    if(GetLauncherStatus(playerid) && PI[playerid][LauncherData][1]) return HideLogo(playerid);

    if(LogoStatus{playerid}) return false;

	if(GetPlayerLauncher(playerid))
	{
		new BitStream:bs = BS_New();
		BS_WriteValue(bs, PR_UINT8, 220, \
			PR_UINT8, 36, PR_UINT8, 2, PR_UINT8, \
			118, PR_UINT8, 114, PR_UINT8, 255, PR_UINT8, 0, \
			PR_UINT8, 223, PR_UINT8, 255, PR_UINT8, 41, PR_UINT8, 194, \
			PR_UINT8, 224, PR_UINT8, 248, PR_UINT8, 229, PR_UINT8, 32,\
			PR_UINT8, 241, PR_UINT8, 238, PR_UINT8, 238, PR_UINT8, 225, \
			PR_UINT8, 249, PR_UINT8, 229, PR_UINT8, 237, PR_UINT8, 232, \
			PR_UINT8, 229, PR_UINT8, 32, PR_UINT8, 225, PR_UINT8, 243, \
			PR_UINT8, 228, PR_UINT8, 229, PR_UINT8, 242, PR_UINT8, 32, \
			PR_UINT8, 238, PR_UINT8, 242, PR_UINT8, 239, PR_UINT8, 240, \
			PR_UINT8, 224, PR_UINT8, 226, PR_UINT8, 235, PR_UINT8, 229, \
			PR_UINT8, 237, PR_UINT8, 238, PR_UINT8, 32, PR_UINT8, 226, \
			PR_UINT8, 32, PR_UINT8, 226, PR_UINT8, 232, PR_UINT8, 239, \
			PR_UINT8, 45, PR_UINT8, 247, PR_UINT8, 224, PR_UINT8, 242, \
			PR_UINT8, 7, PR_UINT8, 194, PR_UINT8, 232, PR_UINT8, 239, \
			PR_UINT8, 45, PR_UINT8, 247, PR_UINT8, 224, PR_UINT8, 242);
		PR_SendPacket(bs, playerid);
	}
	ShowPlayerHud(playerid);

	for(new i; i < 3; i++) TextDrawShowForPlayer(playerid, Logotype[i]);

    LogoStatus{playerid} = true;

    return true;
}

stock HideLogo(playerid)
{
    if(!LogoStatus{playerid}) return false;

    for(new i; i < 3; i++) TextDrawHideForPlayer(playerid, Logotype[i]);

    LogoStatus{playerid} = false;

    return true;
}

stock ShowSpeed(playerid)
{
	if GetPlayerState(playerid) == 2 *then
	{
	    if CheckSpeed(playerid) *then
	    {
			for new i; i < 42; i++ do DestroyPlayerTD(playerid, speedometr[playerid][i]);
	    	SpeedometrSetting(playerid, 1);
	    }
	    else for new i; i < 42; i++ do DestroyPlayerTD(playerid, speedometr[playerid][i]);
	}
	return true;
}

stock SaveReklama()
{
	global_str = "";
	f(global_str, 1550 , "UPDATE `reklama` SET \
	`Owner` = '%s', `Hour` = '%d', `Text` = '%s'",
	ReklamaGPS[ReklamaOsnOwner], ReklamaGPS[ReklamaOsnTimer],\
	ReklamaGPS[ReklamaOsn]);

	mysql_tquery(mysql, global_str);
	return 1;
}
stock ZakazReklama(playerid)
{
	if ReklamaGPS[ReklamaOsnTimer] > 0 *then return SPDF(playerid, 0, DIALOG_STYLE_MSGBOX, !"Reklamos informacija", "\n\n{FFFFFF}Reklama jau issinuomota {F5B143}%dvalandu!{FFFFFF}\n{FFFFFF}Nuomininkas: {F5B143}%s.\n\n", !"Uzdaryti", !"", ReklamaGPS[ReklamaOsnTimer], ReklamaGPS[ReklamaOsnOwner]);
	f(global_str, 300, "{FFFFFF}Siame skyriuje galite isigyti reklama savo verslui/promocode\n{FFFFFF}1 valanda - 10.000$\nIveskite valandu skaiciu, kiek norite pirkti reklama.\n\n");
	SPD(playerid, 13134, DIALOG_STYLE_INPUT, !"{FFFFFF}Reklamos uzsakymas /GPS", global_str, !"Uzsakyti", !"Atgal");
	return 1;
}
stock ResetReklama()
{
   	f(ReklamaGPS[ReklamaOsn], 85, "Cia gali buti jusu reklama!");

	ReklamaGPS[ReklamaOsnTimer] = 0;
	ReklamaGPS[ReklamaOsnOwner] = -1;
	SaveReklama();
	return 1;
}
stock LoadReklama()
{
	new Cache:result = mysql_query(mysql, "SELECT * FROM reklama ORDER BY id");

	for new i; i < cache_get_row_count(); i++ do
	{
		cache_get_row(i, 0, ReklamaGPS[ReklamaOsnOwner], mysql, 24);
		ReklamaGPS[ReklamaOsnTimer] = cache_get_row_int(i, 1, mysql);
		cache_get_row(i, 2, ReklamaGPS[ReklamaOsn], mysql, 150);
	}
	cache_delete(result, mysql);
	return true;
}

stock GiveMHours(playerid, hours, reason[] = "")
{
	if !IsPlayerLogged{playerid} *then
		return false;

 	PI[playerid][pMemberPlayHours] += hours;
 	f(mysql_string, 400, "UPDATE `accounts` SET `MemberPlayHours` = '%s' WHERE `NickName` = '%s'", PI[playerid][pMemberPlayHours], PN(playerid));
	mysql_tquery(mysql, mysql_string);

	if !(hours == 0) *then
		f(global_str, 100, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~%d MHOURS", hours),
		GameTextForPlayer(playerid, global_str, 3000, 3);

	amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> %s organizacijos valandu %.0f priezastis %s (Eurs: %d).", 4, PN(playerid), "", PN(playerid), PN(playerid), hours > 0 ? "gavo" : "pamete", floatabs(hours), reason, PI[playerid][pMemberPlayHours]);

	return 1;
}

stock GiveHours(playerid, hours, reason[] = "")
{
	if !IsPlayerLogged{playerid} *then
		return false;

 	//PI[playerid][pPlayHours] += hours;
 	UpdatePlayerDataInt(playerid, "PlayHour", PI[playerid][pPlayHours] += hours);

	if !(hours == 0) *then
		f(global_str, 100, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~%d HOURS", hours),
		GameTextForPlayer(playerid, global_str, 3000, 3);

	amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> %s valandu %.0f priezastis %s (Eurs: %d).", 4, PN(playerid), "", PN(playerid), PN(playerid), hours > 0 ? "gavo" : "pamete", floatabs(hours), reason, PI[playerid][pMemberPlayHours]);

	return 1;
}
stock ShowBonusMenu(playerid)
{
	global_str = "{8400c2}Apdovanojimas\t{8400c2}Reikia atzaisti\t{ae433d}Statusas\n";

	for new i; i < sizeof BonusData; i++ do
	{
		if PI[playerid][pPlayHours] >= BonusData[i][bonusCost] && !BonusTake[playerid][i] *then
	    	f(mysql_string, sizeof(mysql_string),"{00FF00}Galima gauti");
		else if PI[playerid][pPlayHours] < BonusData[i][bonusCost] *then
	    	f(mysql_string, sizeof(mysql_string),"{fe4e4e}Neprieinama");
		else if BonusTake[playerid][i] *then
	    	f(mysql_string, sizeof(mysql_string),"{cccccc}Jau gauta");

		strcat(global_str, (str_f("{8400c2}[%d]{8400c2} %s\t%dval.\t%s\n", i + 1, BonusData[i][bonusName],  BonusData[i][bonusCost], mysql_string)));
	}

	return SPD(playerid, 25113, DIALOG_STYLE_TABLIST_HEADERS, (str_f("{8400c2}Viesai prieinama {FFFFFF}bonuso sistema | Jus atzaidete: {8400c2}%dval.", PI[playerid][pPlayHours])), global_str, !"»", !"x");
}

