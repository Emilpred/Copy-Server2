stock Float:PointToPoint(Float:x,Float:y,Float:z,Float:x2,Float:y2,Float:z2)
	return floatsqroot(floatpower(floatabs(floatsub(x2,x)),2)+floatpower(floatabs(floatsub(y2,y)),2)+floatpower(floatabs(floatsub(z2,z)),2));

stock NextStapQI(playerid,id)
{
	switch(id)
	{
	    case 0:
		{
	        if IsValidPassport(playerid) *then
	        {
				SPD(playerid, 0, 0, !"", !"{FFFFFF}Jus jau turite pasa! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");

	            QuestProgress[playerid][id] = 2;

	            if PI[playerid][pRace]==0 *then
					EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);
	        }
	        else if QuestProgress[playerid][id] == 0 *then
	        {
	            SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta,");
				SCM(playerid,-1, !"kur yra savivaldybe, vykite ten, kad gautumete pasa.");

	            EnableGPSForPlayer(playerid,1495.1967,-1283.5261,14.5414);
	        }
	        if QuestProgress[playerid][id] == 2 *then
	        {
	           	if PI[playerid][pRace]==0 *then
				   	EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);

				SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid, -1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
	        }
	    }
	    case 1:
	    {
	        if QuestProgress[playerid][id] >= 0 && QuestProgress[playerid][id] < 30 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra ukis, vykite ten");
				SCM(playerid, -1, !"ir perneskite 30 sieno rysuliu. Butina isidarbinti pradiniu ukininku, tada persirengti!");

	            EnableGPSForPlayer(playerid,-69.1276,92.9946,3.1172);
	        }
	        else if QuestProgress[playerid][id] == 30 *then
			{
			    if PI[playerid][pRace]==0 *then
					EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
	    }
	    case 2:
	    {
            if QuestProgress[playerid][id] >= 0 && QuestProgress[playerid][id] < 20 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra iskrovimo stotis, vykite ten");
				SCM(playerid, -1, !"ir perkelkite 20 daiktu is vagonu i sandeli. Butina isidarbinti krautuvu");

	            EnableGPSForPlayer(playerid,1980.2667,-1971.0826,13.5825);
	        }
	        else if QuestProgress[playerid][id] == 20 *then
			{
			    if PI[playerid][pRace]==0 *then
					EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
	    }
	    case 3:
	    {
	        if GetPlayerLicense(playerid, 0) *then
	        {
	            QuestProgress[playerid][id] = 2;

	            SPD(playerid, 0, 0,!"", !"{FFFFFF}Jus jau turite vairuotojo pazymejima! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");

	            if PI[playerid][pRace]==0 *then
					EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);
	        }
            if QuestProgress[playerid][id] == 0 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra vairavimo mokykla,");
				SCM(playerid, -1, !"vykite ten, islaikykite teorini ir praktini egzaminus bei gaukite vairuotojo pazymejima.");

	            EnableGPSForPlayer(playerid,-2034.7258,-116.8749,35.2599);
	        }
	        else if QuestProgress[playerid][id] ==2 *then
			{
			    if PI[playerid][pRace]==0 *then
					EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
	    }
	    case 4:
	    {
            if QuestProgress[playerid][id] >= 0 && QuestProgress[playerid][id] < 15 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra picos pristatymo imone,");
				SCM(playerid, -1, !"vykite ten ir pristatykite 15 uzsakymu. Butina isidarbinti picos pristatytoju.");

	            EnableGPSForPlayer(playerid,677.5144,-1560.4213,16.0349);
	        }
	        else if(QuestProgress[playerid][id]==15)
			{
			    if PI[playerid][pRace]==0 *then
		 			EnableGPSForPlayer(playerid,1773.6903,-1891.7493,13.5504);
				else
					EnableGPSForPlayer(playerid,1163.6832, -1754.9606, 13.6180);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
	    }
	    case 5:
	    {
	        if QuestProgress[playerid][id] == 0 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra Michael,");
				SCM(playerid, -1, !"vykite ten pagal draugo prasyma, susipazinkite su juo, kad uzbaigtumete uzduoti!");

	            EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);
	        }
	    }
	    case 6:
	    {
            if QuestProgress[playerid][id] >= 0 && QuestProgress[playerid][id] < 25 *then
	        {
	            SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra gamykla, vykite ten");
				SCM(playerid,-1, !"ir pagaminkite 25 medziagas. Butina isidarbinti.");

	            EnableGPSForPlayer(playerid,-86.2750,-301.2829,2.7646);
	        }
	        else if QuestProgress[playerid][id]==25 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
	    }
	    case 7:
		{
		    if PI[playerid][pTelNum] != 0 *then
	        {
				SPD(playerid, 0, 0, !"", !"{FFFFFF}Jus jau turite mobiluji telefona! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");
                EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

	            QuestProgress[playerid][id] = 1;
	        }
		    if QuestProgress[playerid][id] == 0 *then
	        {
				new
					b = random(28),
					a = 0;

				for new i = 1; i < OWNABLEBIZES; i++ do
				{
				    if BizData[i][bState] == 2 && BizData[i][bLock]==0 *then
				    {
				        if b == a *then
						{
							EnableGPSForPlayer(playerid,BizData[i][bEnter_X],BizData[i][bEnter_Y],BizData[i][bEnter_Z]);

							SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur galite nusipirkti mobiluji telefona,");
							SCM(playerid, -1, !"vykite ten ir padarykite tai, ko paprase Michael.");

						}
				        a++;
				    }
				}
	        }
	        else if QuestProgress[playerid][id]==1 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid, -1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
		}
		case 8:
		{
		    if PI[playerid][pLevel]>3 *then
			{
			    SPD(playerid, 0, 0, !"", !"{FFFFFF}Si uzduotis galioja zaidejams iki 3 lygio!\nVyresnio lygio zaidejams uzduotis atliekama automatiskai!\n{6DA5EF}Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");
			    EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

	            QuestProgress[playerid][id] = 1;
			}
		    if QuestProgress[playerid][id] == 0 *then
	        {
				new
			 		b = random(8),
					a = 0;
				for new i = 1; i < OWNABLEBIZES; i++ do
				{
				    if BizData[i][bState]==3 && BizData[i][bLock]==0 *then
				    {
				        if b == a *then
						{
							EnableGPSForPlayer(playerid,BizData[i][bEnter_X],BizData[i][bEnter_Y],BizData[i][bEnter_Z]);

							SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur galite nusipirkti nauju drabuziu,");
							SCM(playerid, -1, !"vykite ten ir padarykite tai, ko paprase Michael.");
						}
				        a++;
				    }
				}
	        }
	        else if QuestProgress[playerid][id]==1 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
		}
		case 9:
		{
		    if PI[playerid][pBankPass] !=0 *then
	        {
				SPD(playerid, 0, 0, !"", !"{FFFFFF}Jus jau turite banko kortele! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");
				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

	            QuestProgress[playerid][id] = 1;
	        }
		    if QuestProgress[playerid][id] == 0 *then
	        {
	            SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra Las Venturas banko skyrius");
				SCM(playerid,-1, !"vykite ten ir susikurkite banko kortele, kad ivykdytumete uzduoti.");

	            EnableGPSForPlayer(playerid,2375.5586,2308.5142,8.1406);
	        }
		    else if QuestProgress[playerid][id]==1 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid, -1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
		}
		case 10:
		{
			if PI[playerid][pSkillLevel] >= 30000 *then
			{
			    SPD(playerid, 0, 0, !"", !"{FFFFFF}Jus jau visiskai ismokote kovos stiliu! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");
	            QuestProgress[playerid][id]=100;
	            EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);
			}
		    if QuestProgress[playerid][id] ==0 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur yra LS sporto sale.");
				SCM(playerid, -1, !"Vykite ten ir treniruokites, kad atliktumete uzduoti.");

	            EnableGPSForPlayer(playerid,2228.4187,-1722.7664,13.5544);
	        }
		    else if QuestProgress[playerid][id] == 99 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid,COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje nustatyta vieta, kur reikia atlikti uzduoti.");
				SCM(playerid,-1, !"Vykite ten, kad gautumete atlygi uz ivykdyta uzduoti.");
			}
		}
		case 11:
		{
			if PI[playerid][pPistol_Skill] >= 9000 && PI[playerid][pSDPistol_Skill] >= 9000 && PI[playerid][pEagle_Skill] >= 9000 &&
			PI[playerid][pShotGun_Skill] >= 9000 && PI[playerid][pUZI_Skill] >= 9000 && PI[playerid][pMP5_Skill] >= 9000 &&
			PI[playerid][pAK47_Skill] >= 9000 && PI[playerid][pM4_Skill] >= 9000 && PI[playerid][pSniper_Skill] >= 9000 *then
			{
			    SPD(playerid, 0, 0, !"", !"{FFFFFF}Jus jau puikiai valdote ginkla! Uzduotis ivykdyta, gaukite atlygi.", !"Priimti", !"");
	            EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

	            QuestProgress[playerid][id] = 30;
			}

		    if QuestProgress[playerid][id] ==0 *then
	        {
	            SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje pazymeta LS saudyklos vieta,");
				SCM(playerid, -1, !"nuvykite ten, kad tobulintumete saudymo igudzius ir ivykdytumete uzduoti.");

	            EnableGPSForPlayer(playerid,876.4536,-1566.7714,13.5391);
	        }
		    else if QuestProgress[playerid][id] == 30 *then
			{
   				EnableGPSForPlayer(playerid,1324.0098,287.2829,20.0452);

				SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Mini zemelapyje yra pazymeta vieta, kur reikia ivykdyti uzduoti.");
				SCM(playerid, -1, !"Nuvykite ten, kad gautumete atlygi uz atlikta uzduoti.");
			}
		}
		case 12:
		{
		    if QuestProgress[playerid][id] < 2 *then
		    {
		        EnableGPSForPlayer(playerid, 1813.0168, 373.9233, 18.9664);

		        SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Noredami ivykdyti sia uzduoti, turite pasiimti viena is seimos sunkvezimiu");
		        SCM(playerid, -1, !"ir vadovautis nurodymais gabenant krovini is SF sandelio i seimos sandeli.");

		    }
		    else
		    {
		        EnableGPSForPlayer(playerid, 1800.4841, 409.9243, 20.2294);

		        SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Nuvykite pas Nathon, kad uzbaigtumete uzduoti ir gautumete atlygi.");
		    }
		}
		case 13:
		{
			if QuestProgress[playerid][id] < 10 *then
		    {
   		     	SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Noredami ivykdyti sia uzduoti, turite pernesti 10 deziu su akmenimis.");
		    }
		    else if QuestProgress[playerid][id] == 10 *then
		    {
		        EnableGPSForPlayer(playerid, -1379.6326, -2161.7012, 22.2144);

		        SCM(playerid, COLOR_GREEN, !"[Uzuomina] {FFFFFF}Nuvykite pas jaunaji Hagrida, kad uzbaigtumete uzduoti ir gautumete atlygi.");
		    }
		}
	    case 14:
	    {
	        if(QuestProgress[playerid][id] >= 30) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
			else
			{
			    f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko atsakyti i reporta - %d kartu.", 30 - QuestProgress[playerid][id]);
				SCM(playerid, COLOR_GREEN, global_str);
			}
		}
		case 15:
		{
		    if(QuestProgress[playerid][id] >= 5) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
		    else
		    {
		        f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko suzaisti - %d valanda(u).", 5 - QuestProgress[playerid][id]);
		    	SCM(playerid, COLOR_GREEN, global_str);
		    }
		}
		case 16:
		{
  			if(QuestProgress[playerid][id] >= 25) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
			else
			{
			    f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko isduoti %d MUTE zaidejams, kurie pazeidzia zaidimo taisykles.", 25 - QuestProgress[playerid][id]);
				SCM(playerid, COLOR_GREEN, global_str);
			}

		}
		case 17:
		{
			if(QuestProgress[playerid][id] >= 25) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
			else
			{
			    f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko pasodinti i Demorgana %d zaideju, kurie pazeidzia zaidimo taisykles.", 25 - QuestProgress[playerid][id]);
				SCM(playerid, COLOR_GREEN, global_str);
			}
		}
		case 18:
		{
			if(QuestProgress[playerid][id] >= 25) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
			else
			{
			    f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko isduoti %d WARN zaidejams, kurie pazeidzia zaidimo taisykles.", 25 - QuestProgress[playerid][id]);
				SCM(playerid, COLOR_GREEN, global_str);
			}
		}
		case 19:
		{
			if(QuestProgress[playerid][id] >= 25) SCM(playerid, COLOR_GREEN, !"[Admin-Quest]{ffffff} Pasiimkite savo apdovanojima! (/apanel - Kasdienes admin uzduotys).");
			else
			{
			    f(global_str, sizeof(global_str), "[Uzuomina]{ffffff} Jums liko uzblokuoti %d zaideju, kurie pazeidzia zaidimo taisykles.", 25 - QuestProgress[playerid][id]);
				SCM(playerid, COLOR_GREEN, global_str);
			}
		}
	}

	return SQL("UPDATE questsprogress SET `progress` = %d WHERE `idquest` = '%d' AND `player_id` = '%d'; ", QuestProgress[playerid][id], id, PI[playerid][pID] );
}

