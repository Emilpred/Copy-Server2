stock ShowFamilyDialog(playerid, dialog, id, listitem = 0)
{
	f(mysql_string, 128, "SELECT * FROM family WHERE ID = '%d'", id);
	new Cache:result = mysql_query(mysql, mysql_string);

	static FamLeader[24], FamName[32], slogan[40], FamDiscord[64], FamZam[3][24], FamColor, FamType, FamRep, FamZlovechayaReputation,
	FamSpawnType, FamSpawnData, FamLevel, FamExp, FamJackDaw, FamBrend, FamPercentDeposit, FamKV;

    cache_get_field_content(0, "name", FamName, mysql);
    cache_get_field_content(0, "slogan", slogan, mysql);
	cache_get_field_content(0, "ownername", FamLeader, mysql);
	cache_get_field_content(0, "discord", FamDiscord, mysql);
	cache_get_field_content(0, "zam_1", FamZam[0], mysql);
	cache_get_field_content(0, "zam_2", FamZam[1], mysql);
	cache_get_field_content(0, "zam_3", FamZam[2], mysql);

	cache_get_field_content(0, "rank", SQL_STRING, mysql), sscanf(SQL_STRING, "p<,>a<s[128]>[10]", SQL_GET_ROW_STR);

    FamColor = cache_get_field_content_int(0, "color");
    FamType = cache_get_field_content_int(0, "type");
	FamRep = cache_get_field_content_int(0, "reputation");
	FamZlovechayaReputation = cache_get_field_content_int(0, "zlovechayareputation");
	FamLevel = cache_get_field_content_int(0, "level");
	FamExp = cache_get_field_content_int(0, "exp");
	FamJackDaw = cache_get_field_content_int(0, "jackdaw");
	FamBrend = cache_get_field_content_int(0, "brend");
	FamPercentDeposit = cache_get_field_content_int(0, "percent_deposit");
	FamKV = cache_get_field_content_int(0, "kv_id");
	FamSpawnData = cache_get_field_content_int(0, "spawn_data");
	FamSpawnType = cache_get_field_content_int(0, "spawn_type");

	new Access = GetFamilyAcces(PN(playerid), id);

	if dialog *then ShowFamilyMenu(playerid, false);

	switch dialog do
	{
		case 0: // fammenu
		{
		    if (isnull(FamName))
				SPD(playerid, 493, DIALOG_STYLE_LIST, !"Seimos nustatymai", !"Seimos pavadinimas: {c0eb6b}[Pavadinimo nera]\nSeimos sukis: {eb6b6b}[Sukio nera]", !"Priimti", !"Atsaukti");
			else if (isnull(slogan))
			    SPDF(playerid, 493, DIALOG_STYLE_LIST, !"Seimos nustatymai", "Seimos pavadinimas: {c0eb6b}%s\nSeimos sukis: {eb6b6b}[Sukio nera]", !"Priimti", !"Atsaukti", FamName);
            else
				ShowFamilyMenu(playerid, true);
		}
		case 1:
		{
			switch listitem do
	        {
				case 0: SPD(playerid, 494, DIALOG_STYLE_INPUT, !"", !"\n\n{FFFFFF}Iveskite busima savo seimos pavadinima.\n\n{f2a425}Kriterijai:\n\n{FFFFFF}1. {dda64d}Sukio ilgi nuo 15 iki 40 simboliu.\n{FFFFFF}2. {dda64d}Seimos pavadinimas turi buti vardininko linksnyje.\n{FFFFFF}3. {dda64d}Seimos pavadinimas neturi buti su necenzurine leksika\n\n{FFFFFF}Jei sios taisykles bus pazeistos, jusu seima bus pasalinta!\n\n", !"Priimti", !"Atsaukti");
				case 1:
				{
					if (isnull(FamName)) SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Pirmiausia nurodykite seimos pavadinima!"), SPD(playerid, 494, DIALOG_STYLE_INPUT, !"", !"\n\n{FFFFFF}Iveskite busima savo seimos pavadinima.\n\n{f2a425}Kriterijai:\n\n{FFFFFF}1. {dda64d}Pavadinimo ilgis nuo 5 iki 15 simboliu.\n{FFFFFF}2. {dda64d}Seimos pavadinimas turi buti vardininko linksnyje.\n{FFFFFF}3. {dda64d}Seimos pavadinimas neturi buti su necenzurine leksika\n\n{FFFFFF}Jei sios taisykles bus pazeistos, jusu seima bus pasalinta!\n\n", !"Priimti", !"Atsaukti");
					else SPD(playerid, 495, DIALOG_STYLE_INPUT, !"", !"\n\n{FFFFFF}Iveskite jusu seimos suki.\n\n{f2a425}Kriterijai:\n\n{FFFFFF}1. {dda64d}Sukio ilgi nuo 15 iki 40 simboliu.\n{FFFFFF}2. {dda64d}Suki negalima pazeisti.\n{FFFFFF}3. {dda64d}Neturi buti keiksmazodziu\n\n{FFFFFF}Pavyzdziai: \n\n1. {dda64d}Seima, pareiga, garbe\n{FFFFFF}2. {dda64d}Nelankstus, nepalauziami, nepasiduodantys\n{FFFFFF}3. {dda64d}Ismintis ir jega\n\n", !"Priimti", !"Atsaukti");
				}
			}
		}
		case 2:
		{
		    switch listitem do
		    {
		        case 0:
				{
				    if !Access *then SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Pasiekiama tik vadovui ar pavaduotojams!");
					else
					{
					    f(global_str, 1024, "\
						{FFFFFF}1.{D4D4D4} Pakviesti i seima.\n\
						{FFFFFF}2.{D4D4D4} Ismesti is seimos.\n\
						{FFFFFF}3.{D4D4D4} Pavaduotojas: %s\n\
						{FFFFFF}4.{D4D4D4} Pavaduotojas 2: %s\n\
						{FFFFFF}5.{D4D4D4} Pakeisti seimos/racijos spalva.\n\
						{FFFFFF}6.{D4D4D4} Pakeisti seimos aprasyma/pranesima.\n\
						{FFFFFF}7.{D4D4D4} Pakeisti seimos tipa.\n\
						{FFFFFF}8.{D4D4D4} Seimos Discord [%s{D4D4D4}]\n\
						{FFFFFF}9.{D4D4D4} Perduoti sseimos vadovo teises\n\
						{FFFFFF}10.{D4D4D4} Pakeisti seimos pavadinima\n\
						{FFFFFF}11.{D4D4D4} Pakeisti seimos suki\n\
						{FFFFFF}12.{D4D4D4} Nustatyti seimos spawno vieta savo namuose\n\
						{FFFFFF}13.{D4D4D4} Procentas, nurasytas i biudzeta nuo nariu indeliu: 0%\n\
						{FFFFFF}14.{D4D4D4} Rangu nustatymai\n\
						{D4D4D4}[{FD4C4C}X{D4D4D4}] Isformuoti seima(istrinti)",
						isnull(FamZam[0]) ? "{B3DC52}[Isrinkti pavaduotoja]":(strins(FamZam[0], "{ED993F}", 0, 24), FamZam[0]),
						isnull(FamZam[1]) ? "{B3DC52}[Isrinkti pavaduotoja]":(strins(FamZam[1], "{ED993F}", 0, 24), FamZam[1]),
						isnull(FamDiscord) ? "{FD4D4D}Nera":(strins(FamDiscord, "{D1FD4D}", 0, 64), FamDiscord));

						SPD(playerid, 2921, DIALOG_STYLE_LIST, !"Valdymo panele", global_str, !"Priimti", !"Atgal");
					}
				}
				case 2:
				{
					f(global_str, 1750, "\
					{FFFFFF}\n\n\
					Seimos pavadinimas: {%s}%s{FFFFFF}\n\
					Seimos TOP: {%s}%s{FFFFFF}\n\
					Seimos reputacija: {%s}%d tasku{FFFFFF}\n\
					Seimos gresminga reputacija: {%s}%d tasku{FFFFFF}\n\
     				Seimos lygis: {%s}%d [%d/%d]{FFFFFF}\n\
					I seimos izda patenka nariu indeliai: {%s}%d%%{FFFFFF}\n\
					Spawno vieta: {%s}%s{FFFFFF}\n\
					Pinigai seimos biudzete: {%s}0${FFFFFF}\n\
					Discord: {%s}[ %s ]{FFFFFF}\n\n\
					Seimos lyderis: {%s}%s{FFFFFF}\n\
					Pavaduotojas: {%s}%s{FFFFFF}\n\
					Pavaduotojas 2: {%s}%s{FFFFFF}\n\
					Pavaduotojas 3: {%s}%s{FFFFFF}\n\n\
					Sukis: {%s}%s{FFFFFF}\n\
					Islaikymas: {%s}0 reputacijos kiekviena PayDay{FFFFFF}\n\
					Butas: {%s}0 reputacijos kiekviena PayDay\n\n\
					{FFFFFF}Seimos aljansas: {%s}Nera\n\
					Skelbimas: {FFFFFF}[{FF8859}Nera{FFFFFF}]{FFFFFF}\n\n\n\n\n\
					Informacija apie apribojimus per einamaja valanda (skirta pavaduotojams){FFFFFF}\n\
					\t- Zaidejai buvo atleisti (0/5){FFFFFF}\n\
					\t- Isleista seimos reputacijos tasku {cccccc}(pirkimas pirmosios pagalbos rinkiniu/sarvu): {FFFFFF}0/5000",
					FamilyColor[FamColor], FamName,
					FamilyColor[FamColor], FamilyType_EN[FamType],
					FamilyColor[FamColor], FamRep,
					FamilyColor[FamColor], FamZlovechayaReputation,
					FamilyColor[FamColor], FamLevel, FamExp, FamLevel*10,
					FamilyColor[FamColor], FamPercentDeposit,
					FamilyColor[FamColor], !(FamSpawnData == -1) ? ( !FamSpawnType ? "Seimos butas":(str_f("Namas ¹%d", FamSpawnData)) ):"Nera",
					FamilyColor[FamColor],
					FamilyColor[FamColor], isnull(FamDiscord) ? "Ne":FamDiscord,
					FamilyColor[FamColor], FamLeader,
					FamilyColor[FamColor], strlen(FamZam[0]) > 2 ? FamZam[0]:"{FFFFFF}[{FF8859}Nera{FFFFFF}]",
					FamilyColor[FamColor], strlen(FamZam[1]) > 2 ? FamZam[1]:"{FFFFFF}[{FF8859}Nera{FFFFFF}]",
					FamilyColor[FamColor], strlen(FamZam[2]) > 2 ? FamZam[2]:"{FFFFFF}[{FF8859}Nera{FFFFFF}]",
					FamilyColor[FamColor], slogan,
					FamilyColor[FamColor],
					FamilyColor[FamColor],
					FamilyColor[FamColor]);

					SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija apie seima", global_str, !"Priimti", !"");
				}
				case 3: callcmd::familymembers(playerid);
				case 4: f(global_str, 150, "SELECT * FROM `accounts` WHERE `Family` = '%d'", FP_Data[playerid][F_FAMILY_ID]), mysql_tquery(mysql, global_str, "@OfflineFamilyMembers", "d", playerid);

				case 6: SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}\n\n1.{DDA64D} Seimos chatas(racija) - /fam [text]\n{FFFFFF}2.{DDA64D} /phone - menu - nustatymai (Isjun./Ijung. racija)\n{FFFFFF}3.{DDA64D} Ismesti is seimos(offline) - /famoffkick\n{FFFFFF}4.{DDA64D} Suteikti seimos racijos MUTE - /fammute\n{FFFFFF}5.{DDA64D} Nuimti seimos racijos MUTE - /famunmute\n{FFFFFF}6.{DDA64D} Greitas invite i seima - /faminvite\n{FFFFFF}7.{DDA64D} Greitas atleidimas - /famuninvite\n{FFFFFF}8.{DDA64D} Seimos nariai Online - /fmembers\n{FFFFFF}9.{DDA64D} Pakeisti seimos nario ranga - /setfrank\n{FFFFFF}10.{DDA64D} Aljanso chatas - (/al)liance\n{FFFFFF}11.{DDA64D} Nustatyti Prefixa - /setfamprefix\n\n{D1FD4D}Atkreipkite demesi! Seimai reikia moketi uz jos islaikyma!\nReputacijos kaina priklauso nuo daugelio veiksniu, pagrindinis yra\nzmoniu, esanciu seimoje, skaicius.\n\nSeimos, uzimancios pirmaja vieta pagal vystymasi,\nzmoniu skaiciu arba itaka, gauna 10 reputacijos tasku\nkiekviena PayDay. Reitinga galima pamatyti bet kurio gyvenamuju namu komplekso iejime.", !"Priimti", !"");

				case 7:
				{
					if FamKV == -1 *then
						SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Jusu seima neturi seimos buto!");
					else
					{
						format(global_str, 1024, "\
							{FFFFFF}1. {AFAFAF}Informacija apie buta.\n\
							{FFFFFF}2. {AFAFAF}Atidaryti/uzdaryti buta.\n\
							{FFFFFF}3. {AFAFAF}Nupirkti 50 pirmosios pagalbos rinkiniu {FFFFFF}[ 50 reputacijos ]\n\
							4. {AFAFAF}Nupirkti 20 sarvu {FFFFFF} [ 100 reputacijos ]\n\
							5. {AFAFAF}Padeti pinigus i seimos sandeli\n\
							{FFFFFF}6. {AFAFAF}Paimti pinigus is seimos sandelio\n\
							{FFFFFF}7. {AFAFAF}Padeti seimos monetas i seimos sandeli\n\
							{FFFFFF}8. {AFAFAF}Paimti seimos monetas is seimos sandelio\n\
							{FFFFFF}9. {AFAFAF}Patobulinimai seimai\n\
							{FFFFFF}10. {AFAFAF}Sumoketi uz buto mokesti [$%d / $1200000]\n\
							{FFFFFF}11. {AFAFAF}Teritorijos pinigu rinkimo rangas: 1 rangas\n\
							{FFFFFF}12. {AFAFAF}Padaryti asmenini automobili seimos automobiliu\n\
							{FFFFFF}13. {AFAFAF}Padaryti seimos automobili asmeniniu\n\
							{FFFFFF}[{D36782}X{FFFFFF}] {AFAFAF}Parduoti seimos buta\n\
							{FFFFFF}[{D36782}X{FFFFFF}] {AFAFAF}Parduoti sseimos buta kitai seimai",

							FKV_Data[FamKV][kvNalog]
						);

						SPD(playerid, 2763, DIALOG_STYLE_LIST, !"", global_str, !"Priimti", !"Atgal");
					}
				}

				case 8:
				{
					if !FamJackDaw *then
						SPD(playerid, 8890, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}- Varneles pirkimas seimai\n\nOficialiai patvirtinta seima turi:\n\n{82cb43}- Specialus zenklas, patvirtinantis seimos patentavima.\n- Galimybe isformuoti seima, kuri kopijavo jusu pavadinima.\n- Galimybe prarasti dvigubai maziau reputacijos, kai baudziami seimos nariai.\n- Galimybe naudotis indeliu bet kuriuo paros metu.\n{FFFFFF}Varneles kaina: {f7d83f}5 000 000$\nPaspauskite Enter {FFFFFF}noredami patvirtinti pirkima!", !"Priimti", !"Atsaukti");

					else SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jus jau turite varnele!");
				}
				case 9:
				{
					if !FamBrend *then
						SPD(playerid, 8889, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}Brendo pirkimas seimai\n\nSeima, kuri turi brenda, turi:\n\n{82cb43}- Specialus zenklas, isskiriantis jus is kitu seimu.\n- Padidinti sansai gauti ruletes apdovanojimus rinkimo ir derbio metu.\n- Seimos advokatas gales jus atleisti nuo GRK su 50% tikimybe.\n- Prieiga prie informacinio centro telefonu.\n- Galimybe tureti viena papildoma nama!\n{FFFFFF}Brendo kaina: {f7d83f}8 000 000$\nPaspauskite Enter {FFFFFF}noredami patvirtinti pirkima!", !"Priimti", !"Atsaukti");

					else SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jus jau turite brenda!");
				}
				case 10:
				{
	   				if Access == 2 *then
	 					SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Lyderis negali palikti seimos!");
					else
						SPD(playerid, 8888, DIALOG_STYLE_MSGBOX, !"", !"\n\n{FFFFFF}Ar tikrai norite palikti savo seima?\n\n{633169}Jei ja paliksite, prarasite visas sistemos teikiamas siemos galimybes!\n\n", !"Priimti", !"Atsaukti");
				}
				case 11:
				{
					format(global_str, 128, "SELECT DCapture FROM family WHERE id = '%d'", FP_Data[playerid][F_FAMILY_ID]);
					new Cache:dick = mysql_query(mysql, global_str), rank;
					rank = cache_get_field_content_int(0, "DCapture");
					cache_delete(dick, mysql);
					if !Access *then
						SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Pasiekiama tik seimos lyderiui arba pavaduotojams!");
					else
						SPDF(playerid, 15208, DIALOG_STYLE_LIST, "Karas del teritoriju", "{FFFFFF}Teritoriju zemelapis\n{E65075}Artejantys susitikimai\n{FFFFFF}Visu susitikimu sarasas\nMusu teritorijos\n{cccccc}Naudinga informacija\nI susitikimus galima eiti nuo %i-o rango", "Isrinkti", "Atgal", rank);
				}
		    }
		}
		case 3:
		{
		    switch listitem do
		    {
				case 0: SPD(playerid, 2928, DIALOG_STYLE_INPUT, !"Pakviesti i seima", !"{FFFFFF}Iveskite langelyje norimo pakviesti i seima zaidejo {3667EC}ID{FFFFFF}!\n{3667EC}- Zaidejas turi buti salia jusu.", !"Priimti", !"Atsaukti");
				case 1: SPD(playerid, 2930, DIALOG_STYLE_INPUT, !"Ismesti is seimos", !"{FFFFFF}Iveskite langelyje norimo pasalinti zaidejo {ECBF36}ID{FFFFFF}!\n{ECBF36}- Zaidejas turi buti jusu seimos narys.", !"Priimti", !"Atsaukti");
  				case 2: SPDF(playerid, 2924, DIALOG_STYLE_INPUT, !"Pakeiskite pavaduotoja", "{FFFFFF}\n\nDabartinis pavaduotojas: %s{FFFFFF}\n\nIveskite savo seimos nario zaidejo ID,\nkad paskirtumete ji pavaduotoju ir suteiktumete jam valdymo panele.\nNoredami pasalinti pavaduotoja, iveskite savo ID.\n\n\n", !"Priimti", !"Atgal", isnull(FamZam[0]) ? "{B3DC52}[Nera]":(strins(FamZam[0], "{ED993F}", 0, 24), FamZam[0]));
				case 3: SPDF(playerid, 2124, DIALOG_STYLE_INPUT, !"Pakeisti pavaduotoja", "{FFFFFF}\n\nDabartinis pavaduotojas 2: %s{FFFFFF}\n\nIveskite savo seimos nario zaidejo ID,\nkad paskirtumete ji pavaduotoju ir suteiktumete jam valdymo panele.\nNoredami pasalinti pavaduotoja, iveskite savo ID.\n\n\n", !"Priimti", !"Atgal", isnull(FamZam[1]) ? "{B3DC52}[Nera]":(strins(FamZam[1], "{ED993F}", 0, 24), FamZam[1]));
		        case 4: SPD(playerid, 2922, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}\n\n- Seimos spalva - funkcija, kuri suteikia galimybe jusu seimai issiskirti is kitu!\nSeimos spalva naudojama:\n\n{F58558}- Seimos racijoje.\n- Seimos statistikoje.\n- Seimos pavadinime virs personazo galvos.\n- Sistema bus papildoma atnaujinimu metu.{FFFFFF}\n\nIveskite langelyje skaiciu, kurio spalva jums labiausiai patinka:\n{FF5E5E}0, {FFFFFF}1, {E65075}2, {EFA4B7}3, {905B69}4, {D052CE}5, {FF00FC}6, {5D395D}7, {8E38EA}8, {6B21BB}9,{2F00FF}10, {7456F8}11, {5287F1}12, {1DBAF2}13, {308EB0}14, {30B061}15, {20F271}16, {107135}17, {47EB2A}18, {9EE991}19, {C2D95E}20, {D1FF00}21, {7B9022}22, {FFC900}23, {E8CA60}24, {6B5B1F}25, {FF8400}26, {C04312}27, {5C4C45}28, {373534}29, {351204}30.\n\n\n", !"Priimti", !"Atgal");
				case 5:
				{
					global_str = "";

					for new i; i < sizeof FamilyType_EN; i++ do
					{
						f(mysql_string, 64, "{D4D4D4}[%s{D4D4D4}] %s%s\n", FamType == i ? "{8DFD4C}+":"{FD4C4C}-", FamilyType_EN[i], GetString(FamilyType_EN[i],FamilyType_RU[i]) ? "":(str_f(" (%s)", FamilyType_RU[i])) );

						strcat(global_str, mysql_string);
					}

					SPD(playerid, 7521, DIALOG_STYLE_LIST, !"", global_str, !"Priimti", !"Atsaukti");
				}
				case 6:
				{
					if FamKV == -1 or !FKV_Data[FamKV][kvLevel][9] *then
						SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Jusu seima neturi patobulinimo: \'Treciasis pavaduotojas\'");
					else
						SPDF(playerid, 2925, DIALOG_STYLE_INPUT, !"Pakeisti pavaduotoja", "{FFFFFF}\n\nDabartinis pavaduotojas 3: %s{FFFFFF}\n\nIveskite seimos nario zaidejo ID,\nkad paskirtumete ji pavaduotoju ir suteiktumete jam valdymo panele.\nNoredami pasalinti pavaduotoja, iveskite savo ID.\n\n\n", !"Priimti", !"Atgal", isnull(FamZam[2]) ? "{B3DC52}[Nera]":(strins(FamZam[2], "{ED993F}", 0, 24), FamZam[2]));
				}
				case 7: SPD(playerid, 2994, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}\n\nIveskite i langeli {ECBF36}numeri{FFFFFF} jusu Discord, kuri norite naudoti bendraujant su seima!\n\n\n{ECBF36}- Numeris, bus rodomas seimos aprasyme!\nJei nezinote, kas yra Discord, rekomenduojame\nnenyrodyti jo numerio!\n\n", !"Priimti", !"Atsaukti");
				case 10: SPD(playerid, 9425, DIALOG_STYLE_INPUT, !"", !"\n\n{FFFFFF}Iveskite savo seimos suki.\n\n{F2A425}Kriterijai:\n\n{FFFFFF}1.{DDA64D} Sukio ilgis turi buti nuo 15 iki 40 simboliu.\n{FFFFFF}2.{DDA64D} Sukis(Devizas) negalima pazeisti.\n{FFFFFF}3.{DDA64D} Neturetu buti keiksmazodziu\n\n{FFFFFF}Pavyzdziai:\n\n1.{DDA64D} Seima, pareiga, garbe\n{FFFFFF}2.{DDA64D} Nepalauzami, nesulenkami, nepasiduodantys\n{FFFFFF}3.{DDA64D} Ismintis ir jega\n\n{FFFFFF}Kaina: {FF6D33}500 SAG-Coins ", !"Priimti", !"Atsaukti");
				case 12: SPDF(playerid, 15018, DIALOG_STYLE_INPUT, !"Nustatymas indelio procentui", "{ffffff}Dabartinis procentas: {d4d4d4}%d%%\n{ffffff}Nurodykite procenta, kuris eis i seimos biudzeta: (iki 25%)\n\n{cccccc}Nuo kiekvieno zaidejo indelio delis sio procento eis i seimos biudzeta.", !"Pakeisti", !"Atgal", FamPercentDeposit);
				case 11: SPD(playerid, 20346, DIALOG_STYLE_LIST, !"Seimos spawno vietos nustatymas", !"{FFFFFF}[1] Nustatyti nama spawno vieta\n[2] Nustatyti spawno vieta seimos bute", !"Isrinkti", !"Atsaukti");
				case 13:
				{
					global_str = "";

					for new i; i < 10; i++ do
						f(global_str, 1024, "%s[%d] %s\n", global_str, i + 1, SQL_GET_ROW_STR[i]),
						String_SetPlayerData(playerid, "listitem", i, SQL_GET_ROW_STR[i]);

					SPD(playerid, 15022, DIALOG_STYLE_LIST, !"Seimos rangai", global_str, !"Isrinkti", !"Atgal");
				}
				case 15:
				{
					if !GetString(PN(playerid), FamLeader) *then
						return SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Seimos vadovavima perduoti gali tik jos savininkas.");

					SPD(playerid, 1924, DIALOG_STYLE_INPUT, !"Perduoti lyderyste", !"{FFFFFF}Iveskite zaidejo ID, kuris yra jusu seimoje,\nnoredami paskirti ji lyderiu ir perduoti jam visa valdymo panele.\nKaina: {FFB828}2000 SAG-Coins", !"Priimti", !"Atgal");
				}
			}
		}
	}

	cache_delete(result, mysql);
	return false;
}

stock ShowFamilyMenu(playerid, bool:status = true, id = 0)
{
	if !status *then
	{
		if FamilyOpen{playerid} *then
		{
			for new i = 0; i < 96; i++ do
			DestroyPlayerTD(playerid, FamMenu[playerid][i]);
		}

		CancelSelectTextDraw(playerid);
	}
	else
	{
		new count = 0;

		switch id do
		{
			case 0: count = 96;
			case 1: count = 83;
			case 2: count = 57;
		}

		if FamilyOpen{playerid} *then
		{
			for new i = 0; i < 96; i++ do
			DestroyPlayerTD(playerid, FamMenu[playerid][i]);
		}

		//if GetFamilyAcces(PN(playerid), FP_Data[playerid][F_FAMILY_ID]) *then PlayerTextDrawColor(playerid, FamMenu[playerid][88], 0x282828FF);
		//else PlayerTextDrawColor(playerid, FamMenu[playerid][88], 0xFFFFFFFF915C4AFF);

		#include "../library/fammenu"

		for new i = 0; i < count; i++ do
			ShowPlayerTD(playerid, FamMenu[playerid][i]);

		SelectTextDraw(playerid, 0xA52A2AFF);
	}

	FamilyOpenID[playerid] = id;
	return FamilyOpen{playerid} = status;
}

stock ApplyFamilyFunction(playerid, functionid)
{
	switch FamilyOpenID[playerid] do
	{
		case 0:
		{
			switch functionid do
			{
				case 75: ShowFamilyMenu(playerid, false);
				case 88:
				{
					if !GetFamilyAcces(PN(playerid), FP_Data[playerid][F_FAMILY_ID]) *then
				    	return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Prieinama tik seimos vadovui ar pavaduotojams!");

					ShowFamilyMenu(playerid, true, 1);
				}
				case 86: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 2);
				case 85: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 3);
				case 84: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 4);
				case 82: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 6);
				case 81: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 7);
				case 80: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 8);
				case 79: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 9);
				case 78: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 10);
				case 77: ShowFamilyDialog(playerid, 2, FP_Data[playerid][F_FAMILY_ID], 11);
				case 76: ShowFamilyMenu(playerid, true, 2);
				case 93: ShowFamilyMenu(playerid,false),ShowPrivateFraction(playerid);
			}
		}

		case 1:
		{
			switch functionid do
			{
				case 77: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 0);
				case 76: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 1);
				case 75: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 2);
				case 74: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 3);
				case 73: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 4);
				case 71: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 5);
				case 70: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 6);
				case 69: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 7);
				case 67: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 10);
				case 66: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 11);
				case 65: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 12);
				case 64: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 13);
				case 62: ShowFamilyDialog(playerid, 3, FP_Data[playerid][F_FAMILY_ID], 15);
			}
		}

		case 2:
		{
			switch functionid do
			{
				case 49:
					ShowFamilyMenu(playerid, false, 2), SPDF(playerid, 15232, DIALOG_STYLE_INPUT, !"Seimos monetu keitimas i pinigus", "{ffffff}Nurodykite kieki seimos monetu, kurias norite iskeisti i pinigus:\n\nKeitimo kursas: {ffff00}1 seimos moneta = $2000\n{ffffff}Jus turite: {ffff00}%d seimos monetu", !"Keitimas", !"Atgal", GetCount(playerid, 1443));

				case 3..47:
				{
					new id = (47 - functionid)/2, ItemId = FamilyShop[id][F_S_ItemId];

					if ItemId *then
					{
						spdList(playerid, 0, id);

						f(global_str, sizeof global_str, "\
							{FFFFFF}%s\n\
							%s\n\n\n\
							{ffffff}Kaina: {ffff00}%d seimos monetu\n\
							{ffffff}Ar tikrai norite tai nusipirkti?",
							ItemsInfo[ItemId][ItemName],
							GetItemStory(playerid, ItemId),
							FamilyShop[id][F_S_Cost]
						);

						SPD(playerid, 15234, DIALOG_STYLE_MSGBOX, !"Pirkimo patvirtinimas", global_str, !"Nusipirkti", !"Atgal");

						ShowFamilyMenu(playerid, false, 2);
					}
					else
						SCMF(playerid, COLOR_VALIK, "Greitai bus parduodama uz %d seimos monetu", FamilyShop[id][F_S_Cost]);
				}
			}
		}
	}

	return true;
}

stock SendFamilyMessage(id, msg[])
{
	foreach(Player, i)
	{
	    if FP_Data[i][F_FAMILY_ID] == id *then
	        SCM(i, 0xB9C1B8FF, msg);
	}
	return false;
}
stock EnterFamilyKV(playerid, kv_id)
{
	FP_Data[playerid][F_FAMILY_PICK_KV] = kv_id;

	if !FKV_Data[kv_id][kvFamilyId] *then
	{
		SCM(playerid, COLOR_VALIK, !"[Informacija]{FFFFFF} Seimos butas parduodamas, jei esate vienos seimos lyderis ar pavaduotojas");
		SCM(playerid, -1, !"galite isigyti si buta uz reputacijos taskus.");
		return SCM(playerid, -1, !"Pirkimui naudokite komanda: {D36782}/buyfam");
	}
	else if FKV_Data[kv_id][kvStatus] *then
		return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Durys uzdarytos, ieiti neimanoma.");

	new int_id = FKV_Data[kv_id][kvDataId];

	SetPlayerInterior(playerid, FKV_Data_Int[int_id][kvInterior]);
	SetPlayerVirtualWorld(playerid, FKV_Data[kv_id][kvSqlId] + 1);

	return UpdatePlayerPos(playerid, FKV_Data_Int[int_id][kvInt_X], FKV_Data_Int[int_id][kvInt_Y], FKV_Data_Int[int_id][kvInt_Z], FKV_Data_Int[int_id][kvInt_A]);
}

public: UpdateFamilyKV(kvId)
{
	f(global_str, 128, "\
	Seimos butas\n\
	%s{FFFFFF}\n\
	Statusas: %s{FFFFFF}",

	FKV_Data[kvId][kvFamilyId] ? (str_f("Savininkas: {57A552}%s", GetFamilyDataString(FKV_Data[kvId][kvFamilyId], "name"))):"Kaina: {87EB7F}10000 reputacijos",
	FKV_Data[kvId][kvStatus] ? "{D36782}[Uzrakintos]":"{87EB7F}[Atrakintos]"

	);

	return UpdateDynamic3DTextLabelText(FKV_Data[kvId][kvTextLabel], 0xFFFFFFFF, global_str);
}

stock LoadFamilyKV()
{
	new
		Cache:result = mysql_query(mysql, "SELECT * FROM family_kv ORDER BY data_id, ID;"),
		COUNT = cache_get_row_count();

	for new i; i < COUNT; i++ do
	{
		FKV_Data[i][kvSqlId] = cache_get_row_int(i, 0, mysql);

		FKV_Data[i][kvPickup] = CreateDynamicPickup(
			19132,
			23,
			cache_get_row_float(i, 1, mysql),
			cache_get_row_float(i, 2, mysql),
			cache_get_row_float(i, 3, mysql),
			cache_get_row_int(i, 5, mysql),
			cache_get_row_int(i, 6, mysql)
		);

		FKV_Data[i][kvTextLabel] = CreateDynamic3DTextLabel(
			IntToStr(i),
			-1,
			cache_get_row_float(i, 1, mysql),
			cache_get_row_float(i, 2, mysql),
			cache_get_row_float(i, 3, mysql),
			5.0,
			INVALID_PLAYER_ID,
			INVALID_VEHICLE_ID,
			0,
			cache_get_row_int(i, 5, mysql),
			cache_get_row_int(i, 6, mysql)
		);

		FKV_Data[i][kvStatus] = cache_get_row_int(i, 4, mysql);
		FKV_Data[i][kvDataId] = cache_get_row_int(i, 7, mysql);
		FKV_Data[i][kvFamilyId] = cache_get_row_int(i, 8, mysql);
		FKV_Data[i][kvHealths] = cache_get_row_int(i, 10, mysql);
		FKV_Data[i][kvArmours] = cache_get_row_int(i, 11, mysql);
		FKV_Data[i][kvNalog] = cache_get_row_int(i, 12, mysql);
		FKV_Data[i][kvMoney] = cache_get_row_int(i, 13, mysql);
		FKV_Data[i][kvMonets] = cache_get_row_int(i, 14, mysql);

		cache_get_field_content(i, "family_level", global_str), sscanf(global_str, "p<,>a<i>[12]", FKV_Data[i][kvLevel]);

		CallTimeOutFunction("UpdateFamilyKV", 1000, false, "d", i);
	}

	cache_delete(result, mysql);

	FKV_Data_Int_Exit[0] = CreateDynamicPickup(19132, 23, -1515.8022,2722.2063,1500.9674, -1, 205);
	FKV_Data_Int_Exit[1] = CreateDynamicPickup(19132, 23, -1205.1815,2382.4709,1500.9667, -1, 209);
	FKV_Data_Int_Exit[2] = CreateDynamicPickup(19132, 23, 1443.1824,-1067.3873,1601.9919, -1, 210);

	return true;
}

stock ShowAdminList(playerid, list = 0)
{
	f(mysql_string, 256, "SELECT `NickName`, `Admin`, `Online_status` FROM `accounts` WHERE `Admin` > 0 ORDER BY `Online_status` DESC LIMIT %d, %d", 15*list, 15*(list + 1));
	mysql_tquery(mysql, mysql_string, "@ShowAdminList", "dd", playerid, list);

	return true;
}

public: @ShowAdminList(playerid, list)
{
	FirstBL[playerid] = list;

	new countS = cache_get_row_count(mysql);

	global_str = "{FFFFFF}Administratorius\t{FFFFFF}Lygis\t{FFFFFF}Statusas\n";

	for new i; i < countS; i++ do
		cache_get_row(i, 0, mysql_string, mysql, 24),
		f(global_str, 2048, "%s%s\t[%d lvl]\t%s\n", global_str, mysql_string, cache_get_row_int(i, 1, mysql), cache_get_row_int(i, 2, mysql) == 1001 ? "{7ADC66}online":"{FF6347}offline");

	if countS == 15 && list *then strcat(global_str, ">>> Sekantis puslapis\n<<< Praeitas puslapis");
	else if countS == 15 *then strcat(global_str, ">>> Sekantis puslapis");
	else if !countS *then return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Serveriaus Administracija", !"{FFFFFF}Administracijos sarasas tuscias", !"", !"Atgal");

	return SPD(playerid, 2263, DIALOG_STYLE_TABLIST_HEADERS, !"Serveriaus Administracija", global_str, !"Isrinkti", !"Atgal");
}

