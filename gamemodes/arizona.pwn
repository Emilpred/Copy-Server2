public: OrelTimer(playerid)
{
	if !(!IsPlayerOnline(OrelName[playerid])) && GetCount(OrelName[playerid], 615) >= OrelMoney[OrelName[playerid]] && GetCount(playerid, 615) >= OrelMoney[OrelName[playerid]] *then
	{
		new bool:shans;
		if(PI[playerid][pVIP] == 10) shans = true;
		new comission = 10;
		if(!shans)
   		{
			switch random(100) do
			{
				case 0..49:
					{
						f(global_str, 100,"%s sugavo moneta ir iskrito: Herbas.",PN(playerid));
						ProxDetector(25,playerid,global_str,COLOR_ME);
						if(!strcmp("Herbas", StatusMoneta[playerid], true))
						{
							f(global_str, 100,"Laimejo %s - %s.",PN(playerid),StatusMoneta[playerid]);
							ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

							AddItem(playerid, 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
							DeleteItem(OrelName[playerid], 615, OrelMoney[playerid]);

							GameTextForPlayer(playerid, "~g~YOU WIN!", 4200, 1);
						}
						else
						{
							f(global_str, 100,"Laimejo %s - %s.",PN(OrelName[playerid]),StatusMoneta[OrelName[playerid]]);
							ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

							AddItem(OrelName[playerid], 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
							DeleteItem(playerid, 615, OrelMoney[playerid]);

							GameTextForPlayer(OrelName[playerid], "~g~YOU WIN!", 4200, 1);
						}
					}
				case 50..99:
					{
						f(global_str, 125,"%s sugavo moneta ir iskrito: Skaicius.",PN(playerid));
						ProxDetector(25,playerid,global_str,COLOR_ME);
						if(!strcmp("Skaicius", StatusMoneta[playerid], true))
						{
							f(global_str, 100,"Laimejo %s - %s.",PN(playerid),StatusMoneta[playerid]);
							ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

							AddItem(playerid, 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
							DeleteItem(OrelName[playerid], 615, OrelMoney[playerid]);

							GameTextForPlayer(playerid, "~g~YOU WIN!", 4200, 1);
						}
						else
						{
							f(global_str, 100,"Laimejo %s - %s.",PN(OrelName[playerid]),StatusMoneta[OrelName[playerid]]);
							ProxDetector(25,playerid,global_str,COLOR_DOCHAT);


							AddItem(OrelName[playerid], 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
							DeleteItem(playerid, 615, OrelMoney[playerid]*1);

							GameTextForPlayer(OrelName[playerid], "~g~YOU WIN!", 4200, 1);
						}
					}
			}

			GiveBizMoney(BizEntered[playerid], OrelMoney[playerid]/100*5);
		}
		else
		{
			switch random(100) do
			{
				case 0..59:
				{
					f(global_str, 100,"%s sugavo moneta ir iskrito: Herbas.",PN(playerid));
					ProxDetector(25,playerid,global_str,COLOR_ME);
					if(!strcmp("Herbas", StatusMoneta[playerid], true))
					{
						f(global_str, 100,"Laimejo %s - %s.",PN(playerid),StatusMoneta[playerid]);
						ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

						AddItem(playerid, 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
						DeleteItem(OrelName[playerid], 615, OrelMoney[playerid]);

						GameTextForPlayer(playerid, "~g~YOU WIN!", 4200, 1);
					}
					else
					{
						f(global_str, 100,"Laimejo %s - %s.",PN(OrelName[playerid]),StatusMoneta[OrelName[playerid]]);
						ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

						AddItem(OrelName[playerid], 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
						DeleteItem(playerid, 615, OrelMoney[playerid]);

						GameTextForPlayer(OrelName[playerid], "~g~YOU WIN!", 4200, 1);
					}
				}
				case 60..99:
				{
					f(global_str, 125,"%s sugavo moneta ir iskrito: Skaicius.",PN(playerid));
					ProxDetector(25,playerid,global_str,COLOR_ME);
					if(!strcmp("Skaicius", StatusMoneta[playerid], true))
					{
						f(global_str, 100,"Laimejo %s - %s.",PN(playerid),StatusMoneta[playerid]);
						ProxDetector(25,playerid,global_str,COLOR_DOCHAT);

						AddItem(playerid, 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
						DeleteItem(OrelName[playerid], 615, OrelMoney[playerid]);

						GameTextForPlayer(playerid, "~g~YOU WIN!", 4200, 1);
					}
					else
					{
						f(global_str, 100,"Laimejo %s - %s.",PN(OrelName[playerid]),StatusMoneta[OrelName[playerid]]);
						ProxDetector(25,playerid,global_str,COLOR_DOCHAT);


						AddItem(OrelName[playerid], 615, OrelMoney[OrelName[playerid]]-OrelMoney[OrelName[playerid]]/comission);
						DeleteItem(playerid, 615, OrelMoney[playerid]);

						GameTextForPlayer(OrelName[playerid], "~g~YOU WIN!", 4200, 1);
					}
				}
			}

			GiveBizMoney(BizEntered[playerid], OrelMoney[playerid]/100*5);
		}
	}
	OrelMoney[playerid] =
	ZapretOrel[playerid] = 0;
	ZapretOrel[OrelName[playerid]] = 0;
	StatusMoneta[playerid] = "0";
	StatusMoneta[OrelName[playerid]] = "0";
	OrelName[OrelName[playerid]]= INVALID_PLAYER_ID;
	return OrelName[playerid] = INVALID_PLAYER_ID;

}
stock UpdateDonateMenu(playerid, free, one, two)
{
	for new show; show < 4; show++ do
		DestroyPlayerTD(playerid, DonatePreview[playerid][show]);

	if !PI[playerid][pLanguage] *then
		PlayerTextDrawSetString(playerid, DonatePreview[playerid][0], ItemsInfo[one][ItemNameLavka]);
	else
		PlayerTextDrawSetString(playerid, DonatePreview[playerid][0], FixText(ItemsInfo[one][ItemName2]));

	for new show; show < 4; show++ do
		ShowPlayerTD(playerid, DonatePreview[playerid][show]);
}

stock GetMaxDonate(id)
{
	new s;
	for new i; i < MAX_DONATE; i++ do
	{
		if DonateInfo[i][donType] == id *then
	 		s++;
	}
	return s-1;
}

stock GetDonateID(id, score)
{
	new s;
	for new i; i < MAX_DONATE; i++ do
	{
		if DonateInfo[i][donType] == id *then
		{
			if s == score *then
				return i;
			s++;
		}
	}
	return s;
}

stock GetDonateInfo(playerid)
{
	new id = GetDonateID(selectdonate[playerid], donatelist[playerid]);

	f(global_str, sizeof global_str, "\
	{ffffff}%s\n\
	{ffffff}%s\n\n\
	{ffffff}Kaina: {6bc02e}%d {ffffff}SAG-Coins",
	ItemsInfo[DonateInfo[id][donID]][ItemName],
	GetItemStory(playerid, DonateInfo[id][donID]),
	DonateInfo[id][donPrice]);
	SPD(playerid, 0, 0, !"", global_str, !"Uzdaryti", !"");
	return 1;
}
