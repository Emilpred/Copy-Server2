					SCMF(playerid, COLOR_VALIK, "Jus pripylete 50%% ausinimo skyscio i vaizdo plokste, ausinimo sistemos bukle atkurta iki %.1f %%", MiningBTC[hId][cardPos][card_percent]);

					if !MiningBTC[hId][cardPos][card_status] *then
						SCM(playerid, COLOR_GREY, !"[Uzuomina] Nepamirskite paleisti vaizdo plokste");
