stock PLVEH_destroy(playerid)
{
	if !(PI[playerid][plveh] == -1) *then
		DestroyVehicleEx(PI[playerid][plveh]);

	if AksSlot[playerid][0][5] == 1462 || AksSlot[playerid][0][5] == 1463 *then
		SetPlayerAccessory(playerid, AksSlot[playerid][0][5], 5);

	return (true, PI[playerid][plveh] = INVALID_DATA_ID);
}

stock ShowLombardMenu(playerid)
{
	new data = GetDataPawnShopId(BizEntered[playerid]);

	if data == INVALID_DATA_ID *then
		return SendErrorMessage(playerid);

	return SPDF(playerid, 25340, DIALOG_STYLE_LIST, !"Lombardo valdymas", "Pakeisti prekes, skirtas ispirkimui\nPaliktu daiktu sandelis\nKomisinis mokestis uz 4 valandu saugojima:\t%d%%\nBTC saskaita uz ispirkima:\t\t%d BTC", !"Isrinkti", !"Uzdaryti", LombardData[data][ld_commission], LombardData[data][ld_balance]);
}

stock ApplyLombardAction(playerid, listitem, dId, text[], biz, data)
{
    new
		count = strval(text);

	switch dId do
	{
		case 25340:
		{
			switch listitem do
			{
				case 2:
					return SPDF(playerid, 25341, DIALOG_STYLE_INPUT, !"Saugojimo komisinio mokescio pakeitimas", "{ffffff}Dabartinis komisiniu procentai: {ffff00}%d%%\n{ffffff}Nurodykite nauja komisiniu procenta (nuo 1 iki 4%%)\n\n{AFAFAF}Procentas bus priskaiciuojamas prie ispirkimo sumos\nuz kiekvienas 4 valandas prekes laikymo lombarde.\n\nAtkreipkite demesi, kad komisiniai uz\ndaiktus, kurie jau yra laikomi lombarde, nesikeicia.", !"Pakeisti", !"Atgal", LombardData[data][ld_commission]);

				case 3:
					return SPD(playerid, 25342, DIALOG_STYLE_LIST, (str_f("Saskaita: %d BTC", LombardData[data][ld_balance])), !"Papildyti BTC saskaita\nIsimti is saskaitos BTC", !"Isrinkti", !"Atgal");
			}
		}

		case 25341:
		{
			if !(1 <= count <= 4) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Komisiniai negali buti mazesni nei 1%% ir didesnis nei 4%%.");

			SQL("update pawnshopdata SET commission = %d WHERE bizId = %d LIMIT 1;", LombardData[data][ld_commission] = count, biz);

			return SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Nustatete %d%% komisiniu mokescio lombarde ¹%d.", count, biz);
		}

		case 25342:
		{
			if !listitem *then
				f(global_str, 150, "{FFFFFF}Dabar saskaitoje: {FFFF00}%d BTC\nJusu asmenineje saskaitoje: %d BTC\n{FFFFFF}Nurodykite, kiek BTC norite papildyti?", LombardData[data][ld_balance], GetCount(playerid, 1461));
			else
				f(global_str, 150, "{FFFFFF}Dabar saskaitoje: {FFFF00}%d BTC\n{FFFFFF}Nurodykite, kiek BTC norite atsiimti?", LombardData[data][ld_balance]);

			strcat(global_str, "\n\n{AFAFAF}Jusu klientai negales uzstatyti savo daiktu,\njei jusu BTC saskaitoje nepakaks lesu.\nTodel nepamirskite sekti savo BTC saskaitos.");
			return (!listitem ? SPD(playerid, 25343, DIALOG_STYLE_INPUT, !"BTC saskaitos papildymas", global_str, !"Papildyti", !"Atgal"):SPD(playerid, 25344, DIALOG_STYLE_INPUT, !"BTC saskaitos isemimas", global_str, !"Isimti", !"Atgal"));
		}

		case 25343:
		{
			if !(1 <= count <= GetCount(playerid, 1461)) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Jusu saskaitoje nera tiek BTC.");

 			SQL("update pawnshopdata SET balance = +%d WHERE bizId = %d LIMIT 1;", LombardData[data][ld_balance] = count + LombardData[data][ld_balance], biz);
			SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Papildete lombardo saskaita %d BTC lombarde ¹%d.", count, biz);
			DeleteItem(playerid, 1461, count);

			UpdateDynamic3DTextLabelText(Lombard3DText, -1, (str_f("Lombardo saskaita: {67DAFF}\n%d BTC\n\n\n{cccccc}Noredami uzstatyti/ispirkti daikta\nPaspauskite ALT", LombardData[data][ld_balance])) );
		}

		case 25344:
		{
			if !(1 <= count <= LombardData[data][ld_balance]) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Lombardo saskaitoje nera tiek BTC.");

            SQL("update pawnshopdata SET balance = +%d WHERE bizId = %d LIMIT 1;", LombardData[data][ld_balance] = count - LombardData[data][ld_balance], biz);
			SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Is lombardo saskaitos isemete %d BTC.", count);
			AddItem(playerid, 1461, count);

			UpdateDynamic3DTextLabelText(Lombard3DText, -1, (str_f("Lombardo saskaita: {67DAFF}\n%d BTC\n\n\n{cccccc}Noredami uzstatyti/ispirkti daikta\nPaspauskite ALT", LombardData[data][ld_balance])) );
		}

	}

	return true;
}

stock CheckRepairSystem(playerid)
{
	for new i; i < sizeof AutoService; i++ do {

		if IsPlayerInRangeOfPoint(playerid, 1.5, AutoService[i][asPosX], AutoService[i][asPosY], AutoService[i][asPosZ]) *then {

			if !(AutoService[i][asStatus] == true) *then
				return SCM(playerid, COLOR_GREY, !"Siuo metu kazkas jau remontuojasi siame bokse.");

			int_TRANSIT_PLAYER_DATA = i;

			return SPD(playerid, 15424, DIALOG_STYLE_MSGBOX, !"Autoservisas", !"{ffffff}Ar tikrai norite atlikti remonto darbus savo automobiliu\n{ffff00}Remonto kaina: $100000", !"Sutinku", !"Atsaukti");
		}

	}

	return true;
}

stock CreateMechanicActorByVehicle(playerid, vehicleid, skinId, actor_nums, serviceId)
{
    new Float:y_dist, Float:X, Float:Y, Float:Z, Float:angle;

    GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, X, y_dist, Z);
    GetVehiclePos(vehicleid, X, Y, Z);

	GetVehicleZAngle(vehicleid, angle);

	switch actor_nums do {

		case 0: { // Bagazine

			y_dist = y_dist / 2 + 0.15;

			X += y_dist * floatsin(-angle + 180, degrees);
			Y += y_dist * floatcos(-angle + 180, degrees);
		}

		case 1: { // Kapotas

			y_dist = y_dist / 2 + 0.15;

			X -= y_dist * floatsin(-angle + 180, degrees);
			Y -= y_dist * floatcos(-angle + 180, degrees);
			angle -= 180.0;

		}

		case 2: { // Desininis galinis ratas

			y_dist = y_dist / 2 - 0.90;

			X += y_dist * floatsin(-angle + 35.0, degrees);
			Y += y_dist * floatcos(-angle + 35.0, degrees);

			angle += 90;
		}

		case 3: { // Kairinis galinis ratas

			y_dist = y_dist / 2 - 0.90;

			X -= y_dist * floatsin(-angle + 35.0, degrees);
			Y -= y_dist * floatcos(-angle + 35.0, degrees);

			angle -= 90;
		}

	}

	AutoService[serviceId][asActorIds][actor_nums] = CreateDynamicActor(skinId, X, Y, Z, angle, 1, 100.0, -1, -1, playerid);

	ApplyDynamicActorAnimation(AutoService[serviceId][asActorIds][actor_nums], "casino", "roulette_bet", 4.1, true, true, true, true, true);

	return ApplyDynamicActorAnimation(AutoService[serviceId][asActorIds][actor_nums], "casino", "slot_bet_01", 4.1, true, true, true, true, true);
}

public: @RepairCallBackCar(serviceId, vehicleId, playerid, getMoney)
{
	for new i; i < 4; i++ do DestroyDynamicActor(AutoService[serviceId][asActorIds][i]);

	AutoService[serviceId][asStatus] = true;

	if !IsPlayerOnline(playerid) *then
		return false;

	else if getMoney > PI[playerid][pMoney] *then
		return SCM(playerid, COLOR_GREY, !"Mechaniku darbas buvo nutrauktas, panasu, kad jie pastebejo, jog nesugebate sumoketi uz remonta!");

	else if !(GetPlayerVehicleID(playerid) == vehicleId) *then
		return SendErrorMessage(playerid);

	GiveMoney(playerid, -getMoney, (str_f("Autoremonto apmokejimas ¹%d", AutoService[serviceId][asBizId])));
	GiveBizMoney(AutoService[serviceId][asBizId], getMoney*1);

	J_RepairVehicle(vehicleId);

	TogglePlayerControllable(playerid, true);

	return SCMF(playerid, COLOR_GREEN, "Remontas sekmingai atliktas! Mechanikai paeme uz darba: {FFFFFF}$%d", getMoney);
}

public: @show_main_shop_price(playerid, type)
{
	if !cache_get_row_count() *then
	    return SCMF(playerid, COLOR_OLDRED, "[Klaida] {FFFFFF}Vidutines kainu prekiu per %s nera!", !type ? "pardavima":"supirkima");

	global_str = "{FFFF00}Daiktas\t{FFFF00}Per pastarasias 30 dienu\n{FF0000}Praeitas puslapis\n{FF0000}Sekantis puslapis";

	spdList(playerid, 0, 0);
	spdList(playerid, 1, type);

	for new i; i < cache_get_row_count(); i++ do
	{
		spdList(playerid, i + 2, cache_get_row_int(i, 0, mysql));
		strcat(global_str, (str_f("\n%s\t$%d", ItemsInfo[gpdList(playerid, i + 2)][ItemName2], floatround(cache_get_row_float(i, 1, mysql)/cache_get_row_float(i, 2, mysql) * 10000, floatround_ceil))));
	}

	return SPD(playerid, 25020, DIALOG_STYLE_TABLIST_HEADERS, (str_f("Vidutine kaina per %s", !type ? "pardavima":"supirkima")), global_str, !"Isrinkti", !"Atgal");
}

public: @show_main_shop_price_stats(playerid, type, itemId)
{
	global_str = "{FFFF00}Data\t{FFFF00}Pardavimu skaicius\t{FFFF00}Vidutine kaina per diena";

	for new i; i < cache_get_row_count(); i++ do
	{
		cache_get_row(i, 0, SQL_GET_ROW_STR[0], mysql);
		strcat(global_str, (str_f("\n%s\t%d\t$%d", SQL_GET_ROW_STR[0], cache_get_row_int(i, 1, mysql), floatround(cache_get_row_float(i, 2, mysql) * 10000, floatround_ceil))));
	}

	return SPD(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, (str_f("%s prekiu \'%s\' per pastarasias 30 dienu", !type ? "Pardavimas":"Supirkimas", ItemsInfo[itemId][ItemName2])), global_str, !"Atgal", !"Uzdaryti");
}

public: @update_main_shop_base(itemId, count, money, type)
{
	if !cache_get_row_count() *then
		SQL("INSERT INTO main_shop (`itemId`, `type`, `sumAll`, `sumAllCount`, `sumCenter`) VALUES ('%d', '%d', '%f', '%d', '%f')", itemId, type, float(money) / 10000, count, (float(money) / 10000) / count );

	else
	{
		new Int_Data, Float:Float_Data;

		Int_Data = cache_get_row_int(0, 4, mysql) + count;
		Float_Data = cache_get_row_float(0, 3, mysql) + float(money) / 10000;

		SQL("UPDATE main_shop SET sumAll = '%f', sumAllCount = '%d', sumCenter = '%f', sendCount = `sendCount` + 1 WHERE itemId = %d AND type = %d AND %s;", Float_Data, Int_Data, Float_Data / Int_Data, itemId, type, "`dateCreate` LIKE CONCAT('%', DATE_FORMAT(CURRENT_TIMESTAMP, '%Y-%m-%d'), '%')");
	}
}

