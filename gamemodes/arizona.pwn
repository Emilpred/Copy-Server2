							if(PI[id][pLeader] > 0 ) return SCM(playerid,COLOR_RED,!"Jus ne galite isduoti ispejima Lyderiui");
							f(global_str,sizeof(global_str),"Jus davete ispejima %s del %s",PN(id),reason);
							SCM(playerid,COLOR_LIGHTBLUE,global_str);
							f(global_str,sizeof(global_str),"%s jums buvo duotas ispejimas del %s",PN(playerid),reason);
							SCM(id,COLOR_RED,global_str);
							PI[id][pFWarns] ++;
							if(PI[id][pFWarns] >= 3)
							{
								PI[id][pFWarns] = 0;
								SCM(id,COLOR_GREY, !"Jus automatiskai pasalinti is organizacijos, nes turite daugiau nei 2 ispejimus");
								f(global_str,sizeof(global_str),"%s palieka musu organizacija, nes turi daugiau nei 2 ispejimus",PN(id));
								SendTeamMessage(PI[id][pMember],COLOR_GREY,global_str);
								PI[id][pMember] = 0;
								PI[id][pDCTime]=0;
								SCM(id, COLOR_WHITE, !">> {FF6347} Spawno vieta automatiskai nustatyta Gelezinkelio stotyje. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");
								PI[id][pRank] = 0;
								SetBumSkin(id);
								PlayerSpawn(id);
							}
						}
					}
				}
			}
		}
     	case RABOTABUS+1:
