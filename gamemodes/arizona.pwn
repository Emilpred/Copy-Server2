		case 15160:
		{
			if !response *then
				return false;

			new max_farm = sizeof FarmData,
				Float:X, Float:Y, Float:Z;

			static
				GPSname[32];

			if listitem == max_farm *then
				return false;

			else if listitem < max_farm *then
				f(GPSname, 15, "ukio ¹%d", listitem + 1), X = FarmData[listitem][farmPos][0], Y = FarmData[listitem][farmPos][1], Z = FarmData[listitem][farmPos][2];

			else if listitem == max_farm + 1 *then
				GPSname = "zemes ukio tech. nuomos verslo", X = 170.2670, Y = -21.3600, Z = 2.5850;

			else if listitem == max_farm + 2 *then
				GPSname = "artim. vandens siurblio stoties", X = 861.7285, Y = 678.9048, Z = 11.8915;

			else if listitem == max_farm + 3 *then
				GPSname = "Semo", X = -142.1979, Y = -222.0515, Z = 1.4219;

			EnableGPSForPlayer(playerid, X,Y,Z);
			return SCMF(playerid, COLOR_VALIK, "[Informacija]{FFFFFF} Vietove %s sekmingai pazymeta jusu GPS.", GPSname);
		}

		case 15188:
		{
			if !response *then
				return false;

			switch listitem do
			{
				case 0:
					global_str = !"{00ff00}[ Bendra informacija ]\n\n{ffffff}Ukiuose galima auginti darzoves ir parduoti jas miesto prekeiviui (ateityje atsiras ir kitu derliaus realizavimo vietu)\n\nPirkti ar parduoti uki valstybei arba kitam zaidejui galima tik LS Savivaldybeje pas konsultanta, atsakinga uz ukius.\nUkiu kainos skiriasi, nes visi jie yra skirtingo dydzio\n(ukio dydis reiskia laisvu skaiciu, t.y. kiek augalu galima auginti vienu metu)\n\n{ffff00}Kiekviename ukyje yra patalpa, sandelis ir statine su vandens atsargomis.\n{ffffff}Ukio patalpoje savininkas gali:\n{cccccc}- ziureti visa informacija apie uki;\n{cccccc}- imti/deti pinigus i ukio seifa (jie eina tik darbo uzmokesciui);\n\t{ff0000}(savininkas gali stebeti grynuosius seife, jei ten nepakaks pinigu darbo uzmokesciui, tada darbuotojai negales dirbti)\n{cccccc}- kurti ir keisti uzduotis darbuotojams;\n{ffffff}O potencialus darbuotojas gali pradeti arba baigti darba ukyje.\n{ffffff}Taip pat perziureti, kokios uzduotys siuo metu yra skirtos darbuotojams, kad zinotu, ka reikia atlikti.\n\n{ffff00}Sandelyje saugomi daigai, darbo irankiai ir jau nuimtas derlius.\n{ffffff}Daigus ir irankius i sandeli gali deti bet kas (pries tai juos reikia nusipirkti zemes ukio parduotuveje)\nVisus siuos daiktus is sandelio gali paimti tik ukio savininkas, o darbuotojai gali pasiimti tik po 1 daikta darbui siame ukyje.\n\n{ffff00}Statine su vandeniu skirta 750 litru talpai. \n{ffffff}Norint papildyti vandens atsargas, reikia paimti asmenini automobili ir nuvykti i zemes ukio technikos nuomos versla.\nTen stoves statines, reikes issinuomoti viena is ju ir vykti i vandens siurbli (/gps > ukiai > vandens siurblys).\nImame vandeni ir vaziuojame i savo uki (arba bet kuri kita, siuo uzsiemimu gali uzsiimti bet kas, vanduo nemokamas) ir pilame i statine, kuri stovi ukyje.\nVanduo ukyje reikalingas augalu laistymui, kiekvienam laistymui sunaudojama 5 litrai, issinuomotos statines talpa yra 300 litru.\n\n{ffff00}Ukio veikimo principas:\n{ffffff}Ukio savininkas perka daigus, taip pat reikalingus irankius darbui savo ukyje ir nuveza juos i sandeli.\nTada jis kuria uzduotis darbuotojams (maksimaliai galima sukurti 20 uzduociu, vienodos uzduotys kurti negalima, galima tiesiog pakeisti esama).\nI uki atvyksta zmogus ir isidarbina, tada perziuri dabartini uzduociu sarasa ir eina i sandeli paimti jam reikalingo daikto (daigo arba irankio)\nTada jis eina i lauka atlikti bet kuria is esamu uzduociu, o atlyginimas ismokamas is karto po kiekvienos uzduoties atlikimo.\n\n{ffff00}Augalu augimo etapai:\n{cccccc}1) Paimti kastuva ir eiti iskasti duobe konkreciam augalui (daigui) pasodinti\n2) paimti reikiama daiga ir pasodinti ji i iskasta duobe\n3) paimti kibira, nueiti prie statines, pripilti vandens ir palaistyti ta vieta, kur pasodinote (bet kuri augala, kuriam reikalingas laistymas)\n4) paimti greblius ir israveti lysve\n.. praejus tam tikram laikui (nuo 5 iki 15 minuciu, priklausomai nuo augalo tipo), reikes paimti\n5) kastuva ir nuimti derliu, taip pat butinai pernesti ji i sandeli\n\n{ffffff}Ukio savininkas veza surinkta derliu miesto prekeiviui Semui, kuris atvaziuoja vakarais is miesto ir stovi priesais tilta Los Santos mieste.\nMieste yra didziule paklausa musu derliui, todel visas surinktas derlius gali buti parduodamas Semui.";

				case 1:
					global_str = !"{00ff00}[ Kaip dirbti ukyje? ]\n\n{ffffff}Atidarykite /gps ir isrinkite punkta \"Ukiai\", tai visu ukiu sarasas su svarbia informacija jums.\nTen pateikta informacija apie uzimtu ir laisvu darbo vietu skaiciu, uzduociu kieki ir vidutini atlyginima, kuri siulo ukio savininkas.\nPasirinkite uki, kuris jums labiausiai patinka, ir vykite i ji pagal zyme zemelapyje.\n\nAtvyke i uki, turite ieiti i ukio patalpas ir pradeti darba (viduje yra Pickup).\nTada su tuo paciu Pickup patikrinkite esamas uzduotis, pasirinkite ta, kuri jums labiausiai patinka, ir pradekite dirbti!\n\n{ffff00}[ Duobes kasimo etapas ]\n{cccccc}Jei uzduotyje nurodyta, kad reikia iskasti duobe tam tikram augalui, turite nueiti i sandeli, paimti ten kastuva, \ntada rasti lauke laisva vieta ir paspausti ALT. Tuomet prasides duobes kasimo animacija.\nPraejus kelioms sekundems, duobe bus iskasta, ir dabar i sia vieta galesite pasodinti daiga, kuriam buvo iskasta duobe.\nKastuva galima grazinti atgal i sandeli.\n\n{ffff00}[ Daigo sodinimo etapas ]\n{cccccc}Jei uzduotyje nurodyta, kad reikia pasodinti tam tikra daiga, turite nueiti i sandeli, paimti reikiama daiga,\ntada rasti lauke vieta, kur jau yra iskasta duobe (kuriai pasodinti paemete daiga), ir paspausti ALT. Tuomet prasides daigo sodinimo animacija.\nPraejus kelioms sekundems, daigas bus pasodintas (ant vietos atsiras augalo objektas), dabar sia vieta reikes laistyti.\n\n{ffff00}[ Laistymo etapas ]\n{cccccc}Jei uzduotyje nurodyta, kad reikia laistyti tam tikra daiga, turite nueiti i sandeli, paimti ten kibira, tada prieiti prie vandens bako\nir paspausti ALT. Tuomet prasides vandens pripildymas i kibira. Po keliu sekundziu sistema pranes apie tai, kad kibiras pilnai pripildytas.\nPo to, kai kibiras bus pripildytas vandens, turite rasti lauke vieta, kuriai reikia laistymo, ir paspausti ALT. Tuomet prasides laistymo animacija.\nPraejus kelioms sekundems, daigas bus palaistytas (ant vietos pasikeis tekstas), dabar sia vieta reikes raveti.\n\n{ffff00}[ Piktzoliu ravejimo etapas ]\n{cccccc}Jei uzduotyje nurodyta, kad reikia raveti tam tikra daiga, tuomet turite nueiti i sandeli, ten pasiimti grebli,\ntada surasti lauka, kuriame reikia raveti, ir paspausti ALT. Tuomet prasides ravejimo animacija.\nPo keliu sekundziu ravejimas bus baigtas (lasteleje pasikeis tekstas ir bus nurodytas likes augimo laikas).\nSio etapo uzbaigimas pradeda daigo augima, kuris trunka nuo 5 iki 15 minuciu, priklausomai nuo augalo tipo.\nTuo tarpu galite palaukti arba vykdyti kitas uzduotis, o jei ju nera, galite pereiti dirbti i kita uki, kuriame yra uzduociu.\n\n{ffff00}[ Derliaus rinkimo etapas ]\n{cccccc}Jei uzduotyje nurodyta, kad reikia surinkti tam tikro augalo derliu, tuomet turite nueiti i sandeli, ten pasiimti kastuva,\ntada surasti lauke subrendusi augala (nurodyta uzduotyje) ir paspausti ALT. Tuomet prasides derliaus nuemimo animacija.\nPo keliu sekundziu derliaus nuemimas bus baigtas (lastele vel taps laisva). Jus butinai turite nunesti surinkta derliu ir kastuva i sandeli.\n\n\n{ff0000}SVARBU: {ffffff}Jus negalite atlikti darbo, kuris nera nurodytas ukio uzduotyse! Galite daryti tik tai, kas yra uzduociu sarase.\n{ff0000}SVARBU: {ffffff}Patariame nesipykti su ukiu savininkais, ne jie gali itraukti jus i juodaji sarasa, ir jus nebegalesite dirbti ju ukyje.\n{ff0000}SVARBU: {ffffff}Atlyginimas jums ismokamas is karto po kiekvienos uzduoties atlikimo (ji nereikia niekur atsiimti)\n\n{00ff00}Sekmes jums!";

				case 2:
					global_str = !"{00ff00}[ Kaip valdyti uki? ]\n\n{ffff00}[ Ukio valdymas ] {ffffff}(pasiekiama is ukio patalpu jusu ukyje ant Pickup)\n{cccccc}- Informacija apie uki, apie darbuotojus, kurie siuo metu dirba pas jus.\n- Ideti ir paimti pinigus is ukio seifo (pinigai is seifo skiriami darbuotoju atlyginimams, jei ju nepakaks - ukio darbai sustos)\n- Kurti uzduotis darbuotojams, keisti jau sukurtas uzduotis (pakeisti atlyginima arba atlikimu skaiciu), taip pat pasalinti uzduotis.\n\n{ffff00}[ Pasiekiamos komandos ]\n{ffffff}/farmlock {cccccc}- uzrakinti arba atrakinti uki (reikia buti salia duru ukio patalpoje).\n{ffffff}/farmuninvite [zaidejo ID] {cccccc}- priverstinai nutraukti zaidejo darba jusu ukyje.\n{ffffff}/farmbl [zaidejo ID] {cccccc}- ideti zaideja i juodaji sarasa jusu ukyje (jis negales dirbti pas jus).\n{ffffff}/farmunbl [zaidejo ID] {cccccc}- isimti zaideja is jusu ukio juodojo saraso.\n{ffffff}/farmtext [tekstas] {cccccc}- pakeisti teksta skelbimu lentoje (jei yra isigytas patobulinimas).\n\n{ffff00}[ Uzduoties kurimas ] {ffffff}(po uzduoties sukurimo darbuotojai iskart gali pradeti ja vykdyti)\n{cccccc}1) Pasirinkti veiksma: duobes kasimas, daigo sodinimas, laistymas, piktzoliu ravejimas, derliaus nuemimas.\n2) Pasirinkti augalo tipa, kuriam bus taikoma si veikla.\n3) Nurodyti uzduoties atlikimo kieki. (jei reikia uzauginti 3 morkas, reiketu nurodyti kieki: 3)\n4) Nurodyti atlyginima uz kiekviena sios uzduoties atlikima. (jei nurodote 50$ ir atlikimo kiekis  bus 3, tai atlyginimui bus isleista 150$)\n\n{ffff00}[ Pavyzdys, kaip kurti uzduotis ] \n{ffffff}Tarkime, kad norite uzauginti {D8F781}3 lino krumus{ffffff}, tada turite sukurti tokias uzduotis su siais parametrais:\n{cccccc}1) (Iskasti duobe) {D8F781}Linui {cccccc}(atlikimo kiekis: 3)\n2) (Pasodinti) {D8F781}Lina {cccccc}(atlikimu kiekis: 3)\n3) (Laistyti) {D8F781}Lina {cccccc}(atlikimu kiekis: 3)\n4) (Raveti) {D8F781}Lina {cccccc}(atlikimu kiekis: 3)\n5) (Surinkti) {D8F781}Lina {cccccc}(atlikimu kiekis: 3)\n\n{ffff00}[ Surinkto derliaus pardavimas ]\n{cccccc}Kol kas surinkto derliaus pardavimas imanomas tik Dedei Semui (miesto prekeivis), Jis atvyksta is miesto apie 17:00 ir stovi ant tilto Los Santos mieste iki 21:00.\nJums reikia paimti surinkta is grudu sandelio (nes i kisenes daug netilps, pasinaudokite automobilio bagazine).\nVykykite pas Dede Sema ir parduokite jam visa surinkta derliu, nes ju mieste yra beprotiska paklausa jusu uzaugintoms darzovems!\n\n\n{ff0000}SVARBU: {ffffff}Uzduociu tvarka nera svarbi, svarbiausia, kad butu atsizvelgiama i visus augimo etapus.\n{ff0000}SVARBU: {ffffff}Jei vieno is etapu truks, negalesite gauti subrendusio sio augalo derliaus.\n\n{ff0000}SVARBU: {ffffff}Jus negalesite sukurti keliu tu paciu uzduociu (kam kurti tas pacias, jei galima pakeisti atlikimo kieki ar atlyginima)\n{ff0000}SVARBU: {ffffff}Maksimaliai galima sukurti tik 20 uzduociu, o kiekvienai uzduociai - ne daugiau kaip 10 atlikimu. (tai padaryta tam, kad ukio savininkas aktyviai dalyvautu savo ukio veikloje)\n\n{ff0000}SVARBU: {ffffff}Sekite pinigu suma ukio seife, kad visada pakaktu atlyginimams darbuotojams, kitaip jie tiesiog negales dirbti.\n\n{ff0000}SVARBU: {ffffff}Sekite sandeli, kad jame visada butu tie daigai, kuriems kuriate uzduotis, kitaip siu uzduociu nebus galima atlikti.\n{ff0000}SVARBU: {ffffff}Nepamirskite apie irankius, geriau ju nusipirkti daugiau, kad darbas vyktu greiciau ir darbuotojai nelauktu vieni kitu.\n\n{00ff00}Sekmes jums!";

				case 3:
					global_str = !"{00ff00}[Sarasas augalu ir ju augimo laikas ]\n\n{ffffff}1. Rugiai {cccccc}(auga 5 minutes)\n{ffffff}2. Morka {cccccc}(auga 6 minutes)\n{ffffff}3. Bulves {cccccc}(auga 8 minutes)\n{ffffff}4. Linas {cccccc}(auga 6 minutes)\n{ffffff}5. Medvilne {cccccc}(auga 5 minutes)\n{ffffff}6. Kvieciai {cccccc}(auga 8 minutes)\n{ffffff}7. Agurkai {cccccc}(auga 5 minutes)\n{ffffff}8. Pomidorai {cccccc}(auga 8 minutes)\n{ffffff}9. Balta vynuoge {cccccc}(auga 8 minutes)\n{ffffff}10. Arbata {cccccc}(auga 10 minutes)\n{ffffff}11. Prieskonines zoleles {cccccc}(auga 12 minutes)\n{ffffff}12. Kanapes {cccccc}(auga 5 minutes)\n{ffffff}13. Kukuruzai {cccccc}(auga 8 minutes)\n{ffffff}14. Violetine vynuoge {cccccc}(auga 10 minutes)\n{ffffff}15. Gydomoji zolele {cccccc}(auga 10 minutes)\n{ffffff}16. Saulegraza {cccccc}(auga 10 minutes)";
			}

			return SPD(playerid, 15189, DIALOG_STYLE_MSGBOX, !"{00ff00}Ukininkavimo veikla", global_str, !"Atgal", !"Uzdaryti");
		}

		case 15189:
		{
