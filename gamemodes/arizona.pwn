stock LoadOther()
{
	CreatePickup(1239, 2, -2190.0881, 1034.2991, 80.007, -1);
	CreatePickup(1239, 2, 823.4389, -1552.9161, 13.5238, -1);
	CreateDynamic3DTextLabel("{ffffff}Noredami pasiimti automobili {FFFF00}ALT", 0xFFFF00FF, 823.4389, -1552.9161, 13.5238, 10.0);
	CreateDynamic3DTextLabel("{ffffff}Noredami grazinti automobili {FFFF00}paspauskite ALT", 0xFFFF00FF, -2190.0881, 1034.2991, 80.007, 10.0);

	cr_spawn = CreateDynamic3DTextLabel(!"Centrine Rinka {99CC00}\nParkuoti{FFFFFF} auto kieme, draudziama!\nTransporto spawnas prie rinkos per 30 sekundziu!\nNaudokite pozemini parkinga!", 0xFFFFFFFF, 1113.5105, -1412.7322, 14.4744, 13.0000);
	Bitcoin3DText = CreateDynamic3DTextLabel(!"[ Operacija su kriptovaliuta ]\n{ffffff}Dabar banke: 0 BTC\n\nBankas perka 1 BTC uz $-1\nBankas parduoda 1 BTC uz $-1\n\n{cccccc}Paspauskite N", 0xFFFF00FF, -2666.7024, 792.7377, 1500.9688, 10.0);

	for(new i; i < sizeof(LiftInfo); i++) UpdateLiftText(i,0,LiftPosition[LiftInfo[i][liftID]], -1);

	for new i; i < sizeof(RinokCarsPos); i++ do
		f(global_str, 100, "{ffffff}Nusipirkti {FA5858}%s\n\n{cccccc}[ ALT ]", RinokCarNames[i]),
		CreateDynamic3DTextLabel(global_str, 0x73B461FF, RinokCarsPos[i][0], RinokCarsPos[i][1], RinokCarsPos[i][2], 5.0000),
		CreateDynamicPickup(1239, 23, RinokCarsPos[i][0], RinokCarsPos[i][1], RinokCarsPos[i][2], 0);

	CarSletInfo[0] = slet_car_models[random ( sizeof slet_car_models )];
	CarSletInfo[1] = 28800 + gettime();

	for new i; i < sizeof TerInfo; i++ do
	{
		f(global_str, 128, "[ {D45B5B}Teritorija ¹%d {ffffff}]\n\n{cccccc}Paspauskite ALT, noredami\npaimti isteklius", TerInfo[i][terZoneId] = GetGangZone(TerInfo[i][terPosX], TerInfo[i][terPosY]));
		CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, TerInfo[i][terPosX], TerInfo[i][terPosY], TerInfo[i][terPosZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
		CreateDynamicPickup(1274, 23, TerInfo[i][terPosX], TerInfo[i][terPosY], TerInfo[i][terPosZ], -1);
	}

    for(new i; i < MAX_QUESTS_ZONES; i++)
	{
     	questzone[i][qArea] = CreateDynamicSphere(questzone[i][qEnter_x], questzone[i][qEnter_y], questzone[i][qEnter_z], questzone[i][qDistance], 0, 0, -1);
	}

	for new i; i < sizeof FamilyTerInfo; i++ do
	{
	    f(global_str, 128, "[ {D45B5B}Teritorija ¹%d {ffffff}]\n\n{cccccc}Paspauskite ALT, noredami\npaimti isteklius", FamilyTerInfo[i][famZoneId] = GetGangZone(FamilyTerInfo[i][familyPosX], FamilyTerInfo[i][familyPosY]));
	    CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, FamilyTerInfo[i][familyPosX], FamilyTerInfo[i][familyPosY], FamilyTerInfo[i][familyPosZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
        CreateDynamicPickup(1274, 23, FamilyTerInfo[i][familyPosX], FamilyTerInfo[i][familyPosY], FamilyTerInfo[i][familyPosZ], -1);
	}

	for(new i; i < sizeof(DoorLift); i++)
	{
		DoorLift[i] = CreateDynamicObject(DoorLiftInfo[i][doorModel], DoorLiftInfo[i][doorPos][0], DoorLiftInfo[i][doorPos][1], DoorLiftInfo[i][doorPos][2],
	 		DoorLiftInfo[i][doorPos][3], DoorLiftInfo[i][doorPos][4], DoorLiftInfo[i][doorPos][5], DoorLiftInfo[i][doorWorld], DoorLiftInfo[i][doorInterior]);
	}

	for new i; i < max_trains; i++ do TrainArea[i] = CreateDynamicCircle(TrainLocationPos[i][0], TrainLocationPos[i][1], 300.0, 0, 0, -1);

	BuildsInfo[0][blBuildText] = CreateDynamic3DTextLabel("{23BA8F}Koncertu sale{FFFFFF}\nIejimas: ALT\nPastatas: {EBA22D}Neisnuomota", -1, 649.3248,-1353.8834,13.5470, 15.0);
    SetString(BuildsInfo[0][blArenderID],"The State");

	for new i; i < sizeof NeftBizID; i++ do
	{
		CreateDynamicPickup(1559, 23, NeftPos[i][0], NeftPos[i][1], NeftPos[i][2]-0.5, 0);
		NeftText[i] = CreateDynamic3DTextLabel("Naftos platforma", 0x4CD10FF, NeftPos[i][0], NeftPos[i][1], NeftPos[i][2], 10.0);
		UpdateNeftText(NeftBizID[i]);
	}
	NeftPick[0] = CreateDynamicPickup(1239, 23, -2082.9087, 1343.1514, 7.0990, 0);
	NeftPick[1] = CreateDynamicPickup(1559, 23, -2072.3931, 1363.2417, 7.1016, 0);

	for(new i; i < sizeof(parking); i++)
	{
	    CreateDynamic3DTextLabel("Pozeminis parkingas\nIeiti: {F7E352}ALT{FFFFFF}\nIvaziuoti: {F7E352}ALT", -1, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z] + 1.4, 20.0);
		CreateDynamicPickup(19134, 1, parking[i][pEnter_x], parking[i][pEnter_y], parking[i][pEnter_z], -1);
		Create3DTextLabel("Vartai\nIsejimas: {F7AA5A}ALT{FFFFFF}\nIsvaziavimas: {F7AA5A}ALT{FFFFFF}\n\nAsmeniniai automobiliai, kurie yra parkuoti\n\
								 naudojant /park sioje vietoje, automatiskai\nisvengia transporto mokescio!\n\n\
								 Bet kokie automobiliai, kurie yra sioje aiksteleje,\n\
								 nepasitraukia po serverio ar administratoriaus respawno.", -1, parking[i][pExit_x], parking[i][pExit_y], parking[i][pExit_z] + 1.0, 10.0, parking[i][pVWorld], 0);
		CreateDynamicPickup(19134, 1, parking[i][pExit_x], parking[i][pExit_y], parking[i][pExit_z], parking[i][pVWorld]);
		//Antras aukstas parkingo
		Create3DTextLabel("Vartai\nIsejimas: {F7AA5A}ALT{FFFFFF}\nIsvaziavimas: {F7AA5A}ALT{FFFFFF}\n\nAsmeniniai automobiliai, kurie yra parkuoti\n\
								 naudojant /park sioje vietoje, automatiskai\nisvengia transporto mokescio!\n\n\
								 Bet kokie automobiliai, kurie yra sioje aiksteleje,\n\
								 nepasitraukia po serverio ar administratoriaus respawno.", -1, parking[i][pVExit_x], parking[i][pVExit_y], parking[i][pVExit_z] + 1.0, 10.0, parking[i][pVWorld], 0);
