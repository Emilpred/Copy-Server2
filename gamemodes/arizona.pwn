				 		if LavkaInfo[i][lavStatus] == 2 *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Parduotuves savininkas redaguoja prekes, kol kas negalima perziureti asortimento!");
				 		else
				 		{
				 			for(new s; s < 300; s++)
				 			{
				 				if LavkaInfo[i][lavItem][s] *then break;
				 				else if s == 299 *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Sioje parduotuveje nera prekiu!");
				 			}
				 		}
				 		SetPVarInt(playerid, "LavkaINF", i);
				 		return CreateShopTD(playerid, 99);
					}
					else if Lavka[playerid] == -1 && !Int_GetPlayerData(playerid,"DialogOpen") && !Int_GetPlayerData(playerid, "OtherInventOpen") *then
					{
					    if(PI[playerid][pLevel] < 3) return SCM(playerid, COLOR_GREY, "[Klaida] Norint issinuomoti suoleli, reikia tureti 3 lygi!");
						SetPVarInt(playerid, "LavkaINF", i);
						return SendLavkaDialog(playerid, 0);
					}
				}
				else if(LavkaInfo[i][lavColor] && Lavka[playerid] == i && IsPlayerInRangeOfPoint(playerid, 1.0, LavkaPos[i][3],LavkaPos[i][4],LavkaPos[i][5])) return SendLavkaDialog(playerid, 4);
			}
		}

		for new i; i < MAX_MUSORS; i++ do
		{
		 	if(IsPlayerInRangeOfPoint(playerid, 6.0, MusorPos[i][0], MusorPos[i][1], MusorPos[i][2]) && !(musorka[playerid] == -1))
		  	{
		  	    if(PI[playerid][pLevel] < 3) return SCM(playerid, COLOR_GREY, "[Klaida] Naudotis siuksliadeze galima nuo 3 lygio!");
