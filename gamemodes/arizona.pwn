{
    static const LauncherStatus[][] = {"{FF2B2B}neoficialaus client", "{4EFF2B}PC Lancher'io"};

    f(global_str, 144, "Zaidejas %s[%d] prisijunges per %s!", PN(id), id, LauncherStatus[GetPlayerLauncher(id)]);
    return SCM(playerid, -1, global_str);
}
stock PutTexnicalModCar(playerid, vehicleid, click) {
	new id = GetInvID(playerid, click, 0), vehId = GetVehicleID(vehicleid);
	for new i; i < 10; i++ do {
		if CarInfo[vehId][InvTexnicalCar][i] *then continue;
		CarInfo[vehId][InvTexnicalCar][i] = Inventory[playerid][0][id];
		Inventory[playerid][0][id] = Inventory[playerid][0][id] = 0;
		UpdateCarSlotTD(playerid, CarInvTechicalSlot[playerid][i], CarInfo[vehId][InvTexnicalCar][i]);
	}
	setVehicleParams(playerid, vehicleid, 1, Inventory[playerid][0][id], 1);
	InvSlotUpdate(playerid, click, id);
	return SaveInvCar(vehicleid);
}
stock DeletePlayerTexModCar(playerid, vehicleid, Id){
	new vehId = GetVehicleID(vehicleid);
	if !CarInfo[vehId][InvTexnicalCar][Id] *then return false;
	if GetInvSet(playerid) >= PI[playerid][pInvCell] *then return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite pakankamai vietos inventoriuje!");
	PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
	AddItem(playerid, CarInfo[vehId][InvTexnicalCar][Id], 1);
	if CarInfo[vehId][InvCar][Id] *then InstallTun(vehicleid, Id, 1);
	CarInfo[vehId][InvTexnicalCar][Id] = 0;
	setVehicleParams(playerid, vehicleid, 1, Inventory[playerid][0][Id], 0);
	SaveInvCar(vehicleid);
	return UpdateCarSlotTD(playerid, CarInvTechicalSlot[playerid][Id], 0);
}
stock setVehicleParams(playerid, vehid, type, item, plus){
	new cPowerr = 0, cSustainabittitt = 0, ccVelosity = 0, ccMaxSpeed = 0;
	if(type == 1){
		switch(item) {
			case 1561..1563: cPowerr = 50, cSustainabittitt = 0, ccVelosity = 30, ccMaxSpeed = 50;
			case 1564..1565: cPowerr = 50, cSustainabittitt = -20, ccVelosity = 30, ccMaxSpeed = 40;
			case 1566..1568: cPowerr = 5, cSustainabittitt = -30, ccVelosity = 0, ccMaxSpeed = 0;
			case 1569..1571: cPowerr = 5, cSustainabittitt = -30, ccVelosity = 0, ccMaxSpeed = 0;
			case 1572..1574: cPowerr = 70, cSustainabittitt = 0, ccVelosity = 50, ccMaxSpeed = 30;
			case 1575..1577: cPowerr = 0, cSustainabittitt = 100, ccVelosity = 30, ccMaxSpeed = 0;
			case 1578..1580: cPowerr = 0, cSustainabittitt = 0, ccVelosity = 0, ccMaxSpeed = 70;
			case 1581..1583: cPowerr = 0, cSustainabittitt = -50, ccVelosity = 50, ccMaxSpeed = 0;
			case 1584..1586: cPowerr = 0, cSustainabittitt = 200, ccVelosity = 0, ccMaxSpeed = 0;
			case 1587..1589: cPowerr = 0, cSustainabittitt = 100, ccVelosity = 0, ccMaxSpeed = 0;
		}
	}
	if(plus == 1){
		CarInfo[vehid][cMaxSpeed] += ccMaxSpeed;
		CarInfo[vehid][cPower] += cPowerr;
		CarInfo[vehid][cVelosity] += ccVelosity;
		CarInfo[vehid][cSUSTAINABILLITY] += cSustainabittitt;
	}
	else {
		CarInfo[vehid][cMaxSpeed] -= ccMaxSpeed;
		CarInfo[vehid][cPower] -= cPowerr;
		CarInfo[vehid][cVelosity] -= ccVelosity;
		CarInfo[vehid][cSUSTAINABILLITY] -= cSustainabittitt;
	}
	SaveInvCar(GetPlayerVehicleID(playerid));
	return 1;
}
stock IsGiftUsed(string[])
{
    f(mysql_string, 128, "SELECT `Name` FROM `gift` WHERE BINARY `Name` = '%s' LIMIT 1", string);
	mysql_query(mysql, mysql_string);

    return cache_get_row_count(mysql);
}

public: setgiftusage(playerid, gift[])
{
	if !cache_get_row_count() *then
		f(mysql_string, 256, "SELECT * FROM gift WHERE Name = '%s' AND Active > 0 LIMIT 1;", gift),
		mysql_tquery(mysql, mysql_string, "@gift_active", "ds", playerid, gift);
	else
		SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Sios dovanos pakartotinai naudoti negalima!");
}

public: @gift_active(playerid, gift[])
{
	if !cache_get_row_count() *then
		return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Dovana nerasta!");

	else if cache_get_row_int(0, 1, mysql) <= 0 *then
		return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Sios dovanos aktyvaciju skaiciuss isnaudotas!");

	new count = cache_get_row_int(0, 3, mysql), dataId = cache_get_row_int(0, 6, mysql);

	SQL("UPDATE gift SET Active = `Active` - 1 WHERE Name = '%s'", gift);
	SQL("INSERT INTO gift_use (`giftId`, `gift`, `playerId`, `playerName`) VALUES ('%d', '%s', '%d', '%s')", cache_get_row_int(0, 0, mysql), gift, PI[playerid][pID], PlayerName[playerid]);

	switch cache_get_row_int(0, 5, mysql) do
	{
		case 0:
		{
			f(mysql_string, 100, "Daiktas %s (%d vnt.)", ItemsInfo[dataId][ItemName2], count);

			if !(dataId == 1501) *then
				AddItem(playerid, dataId, count);
			else
			    AddItem(playerid, dataId, count, 1);
		}
		case 1:
		{
			f(mysql_string, 100, "Daiktas %s (%d vnt.)", ItemsInfo[dataId][ItemName2], count);

			if !(dataId == 1501) *then
				AddItem(playerid, dataId, count);
			else
			    AddItem(playerid, dataId, count, 1);
		}

		case 2:
		{
			f(mysql_string, 100, "Automobilis %s", GetVehicleName(dataId, true));

			SQL("INSERT INTO `ownable` (`Model`, `Owner`, `Cost`, `Keyer`, `ParkedInPark`) VALUES ('%d', '%s', '10000', 'The State', '1')", dataId, PlayerName[playerid]);
		}
		case 3:
		{
			f(mysql_string, 100, "ADMIN teises %d LVL", count);

			if PI[playerid][pAdmin] < count *then
			{
				SQL("INSERT INTO `admin` (`name`, `level`, `last_connect`, `put_admin`, `data`) VALUES ('%s', '%d', CURDATE(), 'Server', CURDATE())", PN(playerid), count);
				SQL("UPDATE accounts SET Admin = %d WHERE NickName = '%s'", PI[playerid][pAdmin] = count, PN(playerid));

				amlf("<a href=../pages/user?name=%s>%s</a> gavo ADMIN %d LVL is /present", 4, PN(playerid), "", PN(playerid), PN(playerid), count);
			}
		}
		case 4:
		{
		    f(mysql_string, 100, "VIP teises %d LVL", count);

		    if PI[playerid][pVIP] < count *then
		    {
		    	SQL("UPDATE `accounts` SET `VIP` = '%d', `VipTime` = '%d' WHERE `ID` = '%d'", PI[playerid][pVIP] = count, PI[playerid][pVipTime] = Global_Time + (1800 * 86400), PI[playerid][pID]);

		    	amlf("<a href=../pages/user?name=%s>%s</a> gavo VIP %d LVL is /present", 4, PN(playerid), "", PN(playerid), PN(playerid), count);
		    }
		}
		case 5:
		{
		    f(mysql_string, 100, "%d valandu skaicius (/bonus)", count);

		    GiveHours(playerid, count, "aktivacija /present");
		}
	}
	SCMF(playerid, COLOR_VALIK, "[Informacija] {FFFFFF}Jus sekmingai aktivavote dovana \"%s\". Uz aktivavima jus gavote priza: %s", gift, mysql_string);

	f(global_str, 256, "[A] {FFFFFF}Zaidejas %s[%d] aktivavo dovana \"%s\" [prizas: %s]", PlayerName[playerid], playerid, gift, mysql_string);
	return SendAdminsMessage(COLOR_VALIK, global_str);
}
stock UseAddVip(playerid, itemId)
{
    if GetPlayerADDVIP(playerid) *then
		return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Jus jau turite \"Papildymas VIP-Paskyrai\"!");

	switch itemId do
	{
	    case 1896:
	        UpdatePlayerDataInt(playerid, "AddVip", PI[playerid][pAddVIP] = Global_Time + 3600 * 24 * 30),
			UpdatePlayerDataInt(playerid, "AddVipInfninity", PI[playerid][pAddVipInfninity] = 0);

	    case 1897:
	        UpdatePlayerDataInt(playerid, "AddVip", PI[playerid][pAddVIP] = Global_Time + 1800 * 86400),
			UpdatePlayerDataInt(playerid, "AddVipInfninity", PI[playerid][pAddVipInfninity] = 1);
	}
	return DeleteItem(playerid, itemId), SCM(playerid, COLOR_VALIK, (str_f("[Informacija]{ffffff} Jus sekmingai aktivavote %s", ItemsInfo[itemId][ItemName])) );
}
/*Antisliv*/
stock CheckAntiSliv(playerid)
{
	if(PI[playerid][pAdminSlivWarn] == 0)
	{
		SCM(playerid, -1, "{ff0000}[Informacija]{ffffff} Jums buvo isduotas ispejimas del anti-skridimo sistemos!");
		SCM(playerid, -1, "{ff0000}[Informacija]{ffffff} Pakartotiniu bandymu atveju jus busite pasalinti");
		PI[playerid][pAdminSlivWarn] = 1;
	}
	else if(PI[playerid][pAdminSlivWarn] == 1)
	{
		new
			second, minuite, hour,
			day, month, year;

		gettime(hour, minuite, second);
		getdate(year, month, day);

		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"{FF0000}Baudos skyrimas vyresniajam administratoriui", (str_f("{ffffff}Nick: {633169}%s\n{ffffff}IP: [REG/LAST] {633169}[%s | %s]\n{ffffff}Administratoriaus lygis: {633169}%d\n{ffffff}Nuemimo priezastis: {633169}Baudos skyrimas vyresniajam administratoriui\n{ffffff}laikas: {633169}%d/%d/%d | %d:%d:%d\n \n{633169}Jei tai ivyko klaidingai, padarykite ekrano nuotrauka paspaude F8 ir atsiuskite Ikurejui: %s\n{633169}Demesio! Jei neturesite sio pranesimo ekrano nuotraukos, atstatymo negausite!", PN(playerid), PlayerRegIP[playerid], PlayerIp[playerid], PI[playerid][pAdmin], day, month, year, hour, minuite, second, Server_VKontakte)), !"OK", !"");

		SCM(playerid, COLOR_RED, !"Demesio! Jei neturesite sio pranesimo ekrano nuotraukos, atstatymo negausite!");
		SCMF(playerid, COLOR_RED, "Jei tai ivyko klaidingai, padarykite ekrano nuotrauka paspaude F8 ir atsiuskite Ikurejui: %s", Server_VKontakte);

		SQL("DELETE FROM `admin` WHERE `name` = '%s'", PN(playerid));

		UpdatePlayerDataInt(playerid, "Admin", PI[playerid][pAdmin] = 0);
		UpdatePlayerDataInt(playerid, "afulldostup", AdminInfo[playerid][admFullDostup] = 0);
	}
	return false;
}
