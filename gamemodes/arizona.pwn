				    AttentionCarOpen{playerid} = false;
				}
				if(AttentionClose{playerid} != 0) AttentionClose{playerid} --;
				if(AttentionClose{playerid} == 0 && AttentionOpen{playerid} == true)
				{
				    for(new i; i < 16; i++) DestroyPlayerTD(playerid, attention_a[playerid][i]);
				    AttentionOpen{playerid} = false;
				}
				if(AttentionClose{playerid} == 0 && AttentionOpenn{playerid} == true)
