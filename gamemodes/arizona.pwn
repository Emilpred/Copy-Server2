public FCNPC_OnTakeDamage(npcid, issuerid, Float:amount, weaponid, bodypart)
{
	new id = Bodyguard[npcid][bodyguardPlayerId];
	if(id != issuerid)
	{
	    if safeguardAnim[id] *then safeguardAnim[id] = false;
	    Bodyguard[npcid][bodyguardAttackId] = issuerid;
		Bodyguard[npcid][bodyguardType] = true;

		if FCNPC_GetWeapon(npcid) != 0 *then
		{
			FCNPC_Stop(npcid);
			FCNPC_UseReloading(npcid, true);
			new Float:x, Float:y, Float:z;
			GetPlayerPos(issuerid, x,y,z);
			//FCNPC_AimAt(npcid, x, y, z, .shoot = true);
			FCNPC_AimAtPlayer(npcid, issuerid, .shoot = true);
		}
		else
		{
			FCNPC_MeleeAttack(npcid, -1, true);
			BodyguardMain(id, 4, Bodyguard[npcid][bodyguardslotUse], -1, randomF(0,1));
		}
	}
	else BodyguardMain(id, 4, Bodyguard[npcid][bodyguardslotUse], -1, 4);

	if IsPlayerAttachedObjectSlotUsed(npcid, 4) && FCNPC_GetArmour(npcid) <= 0 *then RemovePlayerAttachedObject(npcid, 4);

	return 1;
}

public FCNPC_OnGiveDamage(npcid, damagedid, Float:amount, weaponid, bodypart)
{
	if FCNPC_GetWeapon(npcid) != 0 *then
	{
		new
			id = Bodyguard[npcid][bodyguardPlayerId],
			slot = Bodyguard[id][bodyguardslotUse];

		safeguardGunAmmo[id][slot] = FCNPC_GetAmmo(npcid);

		if FCNPC_GetAmmo(npcid) <= 0 *then
		{
		    FCNPC_StopAim(npcid);
		    FCNPC_SetWeapon(npcid, 0);
		    safeguardGunAmmo[id][slot] = 0;
		    safeguardGun[id][slot] = 0;
		    FCNPC_MeleeAttack(npcid, -1, true);
		}
		SQL("UPDATE Bodyguard SET safeguardGun = '%d', safeguardGunAmmo = '%d' WHERE safeguardSearch = '%s[%d]'", safeguardGun[id][slot], safeguardGunAmmo[id][slot], PN(id), slot);
	}

	return 1;
}

public FCNPC_OnReachDestination(npcid)
{

	return 1;
}

public FCNPC_OnDeath(npcid, killerid, reason)
{

	return 1;
