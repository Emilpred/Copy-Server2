	        {
		        if(PRESSED(KEY_ANALOG_LEFT))
				{
				    if(!PI[playerid][LauncherData][0])
	                {
		                PlayerTextDrawColor(playerid, speedometr[playerid][15], 0xFFFF00FF);
						PlayerTextDrawColor(playerid, speedometr[playerid][14], 0xFFFF00FF);
						ShowPlayerTD(playerid, speedometr[playerid][15]);
						ShowPlayerTD(playerid, speedometr[playerid][14]);
					}
					DestroyDynamicObject(LightsObject[carid][0]);
		            DestroyDynamicObject(LightsObject[carid][1]);
		            LightsObject[carid][0] = -1;
		            LightsObject[carid][1] = -1;
				    if(Signal[carid] == 1)
		            {
		                SignalTick[carid][0] = 0;
		                SignalTick[carid][1] = -1;
		                Signal[carid] = 0;
		                SetPlayerChatBubble(playerid, "Ijunge kairiji posukio signala", COLOR_PURPLE, 30.0, 5000);
		                if(!PI[playerid][LauncherData][0])
		                {
			                PlayerTextDrawColor(playerid, speedometr[playerid][15], 0x282828FF);
							PlayerTextDrawColor(playerid, speedometr[playerid][14], 0x282828FF);
							ShowPlayerTD(playerid, speedometr[playerid][15]);
							ShowPlayerTD(playerid, speedometr[playerid][14]);
						}
				    }
				    else
				    {
				        LightsObject[carid][0] = CreateDynamicObject(19294, 0, 0, 0, 0, 0, 0);
		                LightsObject[carid][1] = CreateDynamicObject(19294, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(LightsObject[carid][0], carid, -LightsPos[model][0], LightsPos[model][1], LightsPos[model][2], 0, 0, 0);
		                AttachDynamicObjectToVehicle(LightsObject[carid][1], carid, -LightsPos[model][3], LightsPos[model][4], LightsPos[model][5], 0, 0, 0);
				        GetVehicleZAngle(carid, SignalAngle[carid]);
				        SignalTick[carid][0] = 0;
				        SignalTick[carid][1] = -1;
				    	Signal[carid] = 1;
				    }
				    return 1;
				}
				else if(PRESSED(KEY_ANALOG_RIGHT))
				{
				    if(!PI[playerid][LauncherData][0])
	                {
		                PlayerTextDrawColor(playerid, speedometr[playerid][17], 0xFFFF00FF);
						PlayerTextDrawColor(playerid, speedometr[playerid][16], 0xFFFF00FF);
						ShowPlayerTD(playerid, speedometr[playerid][17]);
						ShowPlayerTD(playerid, speedometr[playerid][16]);
					}
				    DestroyDynamicObject(LightsObject[carid][0]);
		            DestroyDynamicObject(LightsObject[carid][1]);
		            LightsObject[carid][0] = -1;
		            LightsObject[carid][1] = -1;
				    if(Signal[carid] == 2)
		            {
		                SignalTick[carid][0] = 0;
		                SignalTick[carid][1] = -1;
				        //PlayerSignalOFF(playerid);
		                Signal[carid] = 0;
		                SetPlayerChatBubble(playerid, "Ijunge desiniji posukio signala", COLOR_PURPLE, 30.0, 5000);
		                if(!PI[playerid][LauncherData][0])
		                {
			                PlayerTextDrawColor(playerid, speedometr[playerid][17], 0x282828FF);
							PlayerTextDrawColor(playerid, speedometr[playerid][16], 0x282828FF);
							ShowPlayerTD(playerid, speedometr[playerid][17]);
							ShowPlayerTD(playerid, speedometr[playerid][16]);
						}
				    }
				    else
				    {
						LightsObject[carid][0] = CreateDynamicObject(19294, 0, 0, 0, 0, 0, 0);
		                LightsObject[carid][1] = CreateDynamicObject(19294, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(LightsObject[carid][0], carid, LightsPos[model][0], LightsPos[model][1], LightsPos[model][2], 0, 0, 0);
		                AttachDynamicObjectToVehicle(LightsObject[carid][1], carid, LightsPos[model][3], LightsPos[model][4], LightsPos[model][5], 0, 0, 0);
				        GetVehicleZAngle(carid, SignalAngle[carid]);
				        SignalTick[carid][0] = 0;
				        SignalTick[carid][1] = -1;
				    	Signal[carid] = 2;
				    }
				    return 1;
				}
			}
			if(GetPlayerState(playerid) == 2)
			{
				if(newkeys & KEY_SUBMISSION)
				{
				    switch(VehicleInfo[carid][vJob])
				    {
				        case 1:
				        {
				            if(rabden[playerid] == 1) SPD(playerid, RABOTABUS+5, 0, !"Darbdavys", !"Ar tikrai norite pradeti?", !"Taip", !"Ne");
					    	else SPD(playerid, RABOTABUS+5, 0, !"Darbdavys", !"Ar tikrai norite baigti?", !"Taip", !"Ne");
				        }
				        case 5: callcmd::taxi(playerid,"");
				    }
				}
			}
			if(PRESSED(KEY_ACTION)) return callcmd::lights(playerid);
	        if(PRESSED(KEY_SUBMISSION))
	        {
			    if(IsACopCar(carid) && IsACop(playerid))
			    {
				    if(CarStrips[carid] > 0)
				    {
						if(StripCount < 50)
						{
							if(TempStripObject[carid] == -1)
							{
							    TempStripObject[carid] = CreateDynamicObject(2899,0,0,0,0,0,0);
							    AttachDynamicObjectToVehicle(TempStripObject[carid], carid, 0.0, -2.2, -0.3, 0.0, 0.0, 90.0);
								SCM(playerid,COLOR_GREY, !"Spygliai numetami...");
								if(IsPlayerInVehicle(playerid, carid))
								{
								    if(CarStrips[carid] > 0)
								    {
										if(StripCount < MAX_STRIPS)
										{
											new Float:X,Float:Y,Float:Z,Float:A;
											GetVehicleShiftPos(carid, 1, X, Y, Z, 3.0);
											GetVehicleZAngle(carid, A);
											DestroyDynamicObject(TempStripObject[carid]);
											TempStripObject[carid] = CreateDynamicObject(2899, X, Y, Z-0.5, 0, 0, A-90);
											TempStripTimer[carid] = CallTimeOutFunction("DestroyTempStrip", 10000, false, "ii", StripCount, carid);
											TStripPos[StripCount][0] = X;
											TStripPos[StripCount][1] = Y;
											TStripPos[StripCount][2] = Z-0.5;
											NoStrip[playerid] = StripCount;
											SetPlayerTimer(playerid,"PlayerUnStrip",1000,false);
											SCM(playerid,COLOR_VALIK, !"[Informacija] {FFFFFF}Jus numetete juosta su spygliais");
											PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
											CarStrips[carid] --;
											f(global_str, 100,"[Informacija] {FFFFFF}Liko spygliu: %d",CarStrips[carid]);
											SCM(playerid,COLOR_GREY, global_str);
											StripCount ++;
										}
										else
										{
										    DestroyDynamicObject(TempStripObject[carid]);
											SCM(playerid,COLOR_GREY, !"Visame mieste irengta daugiau nei "#StripCount#" spygliu, siek tiek palaukite...");
										}
									}
									else
									{
										SCM(playerid,COLOR_GREY, !"[Klaida] {FFFFFF}Siame transporte nera spygliu");
										DestroyDynamicObject(TempStripObject[carid]);
									}
								}
								else DestroyDynamicObject(TempStripObject[carid]);
							}
							else SCM(playerid,COLOR_GREY, !"[Informacija] {FFFFFF}Juostos su spygliais nuleidimo intervalas yra 10 sekundziu...");
						}
						else SCM(playerid,COLOR_GREY, !"[Klaida] {FFFFFF}Visame mieste irengta daugiau nei 50 spygliu, prasome siek tiek palaukti...");
					}
					else SCM(playerid,COLOR_GREY, !"[Klaida] {FFFFFF}Siame transporte nera spygliu");
				}
				return 1;
			}
			if(PRESSED(KEY_NO))
            {
                callcmd::en(playerid,"");
                return 1;
			}
		}
	}
	else
	{
	    if(PRESSED(KEY_NO))
	    {
			if(TazerPlayer[playerid] != INVALID_PLAYER_ID)
			{
			    new target = TazerPlayer[playerid];
			    if(IsPlayerConnected(target))
			    {
				    if(ProxDetectorS(1.5, playerid, target, 1))
				    {
				        callcmd::cuff(playerid, IntToStr(target));
				        return 1;
				    }
			    }
			    else TazerPlayer[playerid] = INVALID_PLAYER_ID;
			}
         	if(PI[playerid][pHeal] > 0)
	        {
             	if(Healttime[playerid]>Global_Time)return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Ne FLOODink!");
	            if(!PlayerLie{playerid})
	            {
                    for(new i; i < sizeof(HealInfo); i ++)
                    {
		                if(IsPlayerInRangeOfPoint(playerid,1,HealInfo[i][hCP][0],HealInfo[i][hCP][1],HealInfo[i][hCP][2]) && GetPlayerVirtualWorld(playerid)==HealInfo[i][hWorld])
				        {
				            if(!GetString(HealInfo[i][hName],"The State")) return SCM(playerid,COLOR_GREY, !"[Klaida] {FFFFFF}Si lova yra uzimta!");
							f(global_str, 150,"Lova{FF0000} [Uzimta]\n\n{FF9900}Pacientas: {9ACD32}%s", PN(playerid));
							UpdateDynamic3DTextLabelText(HealText[i],COLOR_WHITE,global_str);
							UpdatePlayerPos(playerid,HealInfo[i][hBed][0],HealInfo[i][hBed][1],HealInfo[i][hBed][2]+1);
                            ApplyAnimationEx(playerid, "CRACK", "crckidle2", 4.1, 0, 1, 1, 1, 0, 1);
                            SetPlayerFacingAngle(playerid,HealInfo[i][hBed][3]);
                            PlayerBed[playerid] = i;
							PlayerLie{playerid} = true;
							SetString(HealInfo[i][hName],PN(playerid));
							SCM(playerid, COLOR_LIME, "[Informacija] {FFFFFF}Uzemete lova. Noredami atsikelti, dar karta paspauskite N");
							Healttime[playerid]=Global_Time+5;
							break;
				        }
			        }
	            }
	            else
	            {
	                Healttime[playerid]=Global_Time+5;
	                new bed = PlayerBed[playerid];
	                Controllable{playerid} = true;
					TogglePlayerControllable(playerid, true);
					UpdatePlayerPos(playerid,HealInfo[bed][hCP][0],HealInfo[bed][hCP][1],HealInfo[bed][hCP][2]);
     				CheckBed(playerid);
					SetPlayerTimer(playerid, "ClearAnim", (GetPlayerPing(playerid)*2)+100, false);
	            }
	        }
	        else if !(InfoBiz[playerid] == -1) *then
	        {
				new biz = InfoBiz[playerid];
				if(BizData[biz][bState] == 13) return 0;
	            if(IsPlayerInRangeOfPoint(playerid,2.0,BizData[biz][bEnter_X],BizData[biz][bEnter_Y],BizData[biz][bEnter_Z]))
		    	{
					if !IsValidPassport(playerid) *then return SCM(playerid, COLOR_GREY , !"[Klaida] {FFFFFF}Neturite paso, ji galite gauti savivaldybeje");
		        	else if(GetPlayerBizes(playerid))
		        	{
				        if(GetString(BizData[biz][bOwner],"The State"))
			     	    {
			 				new money;
			 				switch BizData[biz][bCostType] do
			 				{
			 					case 1: money = PI[playerid][pVirMoney];
			 					case 2: money = PI[playerid][pRoubles];
			 					case 3: money = GetCount(playerid, 2308);
			 					default: money = PI[playerid][pMoney];
			 				}
			 				if(PI[playerid][pLevel] < 6) return SCM(playerid, COLOR_GREY, "[Klaida] Norint isigyti versla, reikia 6 lygio!");
							if money >= BizData[biz][bCost] *then CreateCaptcha_BOT(playerid, 2);
			     	        else SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums nepakanka pinigu. Galite papildyti savo saskaita [/donate]");
		     	        }
                		else SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Sis verslas jau yra kazkieno nupirktas!");
	     	        }
					else
					{
						SCM(playerid, COLOR_RED, !"[Klaida] {ffffff}Jus negalite isigyti daugiau verslu! Pirkite patobulinima \"Verslininkas\", kad turetumete iki 5 verslu!");
					    SCM(playerid, COLOR_RED, !"[Klaida] {ffffff}Arba pirkite patobulinima \"Septyni verslai\", kad galetumete tureti iki 7 verslu!");
					}
	     	    }
	     	    else InfoBiz[playerid] = -1;
	        }
	        else if(IsPlayerInRangeOfPoint(playerid, 2.5, -2683.9232, 807.4161, 1500.9094) ||
					IsPlayerInRangeOfPoint(playerid, 2.5, -2676.5600, 807.4161, 1500.9094) ||
					IsPlayerInRangeOfPoint(playerid, 2.5, -2669.0400, 807.4161, 1500.9094) ||
					IsPlayerInRangeOfPoint(playerid, 2.5, -2666.4729, 805.8691, 1500.9094) ||
					IsPlayerInRangeOfPoint(playerid, 2.5, -2666.4665, 799.2879, 1500.9094) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 495.2409,1305.6490,774.4839) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 495.2459,1307.4744,774.4839)||
			IsPlayerInRangeOfPoint(playerid, 2.0, 495.2454,1309.2797,774.4839)||
			IsPlayerInRangeOfPoint(playerid, 2.0, 495.2461,1311.0074,774.4839) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 495.2460,1312.8225,774.4839) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 951.8005, 2458.6746, 1601.9771) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 954.9710,2463.5288,1601.9771) ||
			IsPlayerInRangeOfPoint(playerid, 2.5, -14.5615,1882.9138,17.6982) ||
			IsPlayerInRangeOfPoint(playerid, 2.0, 946.6893,2456.3723,1601.9771))return ShowBankMenu(playerid);
			else if(IsAtBankomat(playerid,2.0)) return ShowBankMenu(playerid);
			else
			{
				if(BizEntered[playerid] != -1 && BizData[BizEntered[playerid]][bState] == B_BUY)
				{
					if(BizData[BizEntered[playerid]][bState] == B_BUY) {
	    			 	if(IsPlayerInRangeOfPoint(playerid, 2.0, 2580.1340,1424.8770,1800.9688)) {
						    f(global_str, 150, "{42B02C}-{FFFFFF} Nusipirkti\n{42B02C}-{FFFFFF} Parduoti\n{42B02C}- {FFFFFF}Apmokejimas: %s", PI[playerid][pVID] ? ("{E5D02D}Kortele") : ("{E5D02D}Grynaisiais"));
							SPD(playerid, 103, DIALOG_STYLE_LIST, !"", global_str, !"Isrinkti", !"Atsaukti");
	    			 	}
    			 	}
				}
	        }
	        return 1;
	    }
	}
	return 1;
}

stock EnterBiz(playerid, bizid)
{
    if IsNoEnterBiz(bizid) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} I si versla negalima patekti, nes jis neturi interjero.");
	else if BizData[bizid][bLock] *then return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Durys uzrakintos, negalima ieiti");
	else if GetPlayerVirtualWorld(playerid) *then return false;

	NoEnterPickup[playerid] = 2;
	BizEntered[playerid] = bizid;

	SetPlayerVirtualWorld(playerid, bizid+100), SetPlayerInterior(playerid, BizData[bizid][bInt]);
	UpdatePlayerPos(playerid, BizData[bizid][bExit_X], BizData[bizid][bExit_Y], BizData[bizid][bExit_Z], -1);
	SetCameraBehindPlayer(playerid);
	return BizData[bizid][bVisit] ++;
}

stock ClearAnimationsEx(playerid)
{
    ClearAnimations(playerid);
    ApplyAnimationEx(playerid, "BD_FIRE", "BD_Fire1", 4.1, 0, 0, 0, 0, 1, 1);
	AnimPlayed{playerid} = false;
	return true;
}

stock IsNoEnterBiz(bizid)
{
	if(BizData[bizid][bExit_X] == 0.0 && BizData[bizid][bExit_Y] == 0.0 && BizData[bizid][bExit_Z] == 0.0) return 1;
	return 0;
}

public OnPlayerUpdate(playerid)
{
	if(GetPlayerPing(playerid) > 1000) return SCM(playerid, COLOR_LIGHTRED, "Buvote ismestas is serverio del auksto pingo!"), Kick(playerid);
	if !IsPlayerLogged{playerid} *then
		return false;
	else if IsPlayerLogged{playerid} && IsPlayerConnected(playerid) *then
	{
        if(PlayerAFKTime[playerid] > 10)
        {
            if(PlayerAFKTime[playerid] <= MAX_AFK_TIME) SCMF(playerid, -1, "{FFFFFF}Jus buvote AFK {FF9900}%s.",Convert(PlayerAFKTime[playerid]));
            else SCMF(playerid, -1, "{FFFFFF}Jus buvote AFK {FF9900}%s. {FFFFFF}Is ju {FF9900}%s{FFFFFF} nebuvo uzskaityti!",Convert(PlayerAFKTime[playerid]), Convert(PlayerAFKTime[playerid]-MAX_AFK_TIME));
            SetPlayerChatBubble(playerid, " ", -1, 30.0, 1);
        }
        PlayerAFK[playerid] ++;
        PlayerAFKTime[playerid] = 0;
	}
	return true;
}

stock CheckBed(playerid)
{
	if(PI[playerid][pHeal] > 0)
	{
	    if(PlayerLie{playerid})
	    {
	    	new bed = PlayerBed[playerid];
	    	PlayerLie{playerid} = false;
	    	TogglePlayerControllable(playerid,true);
	    	SetString(HealInfo[PlayerBed[playerid]][hName],"The State");
			PlayerBed[playerid] = -1;
			UpdateDynamic3DTextLabelText(HealText[bed],COLOR_WHITE, !"Lova {33AA33}[Laisva]\n{AFAFAF}Paspauskite N, kad uzimtumete.\nReikia pradeti gydyma!");
		}
	}
	return 1;
}

stock ShowLoginDialog(playerid)
	return SPDF(playerid, 2, DIALOG_STYLE_PASSWORD, !"Autorizacija", "{FFFFFF}Sveiki atvyke i {205CA2}San Andreas Gyvenimas{ffffff}\nJusu Nick: {205CA2}%s{ffffff}\n\nNorint prisijungti, reikia ivesti slaptazodi\n\n{42B02C}Serveryje galioja premiju programa: {FFFFFF}/bonus{FFFFFF}\n{42B02C}Uz kiekviena zaidimo valanda gausite po 1 unikalu bilieta{ffffff} (/bilet)\n\n{FF69B4}Rask dovanas ir atidaryk skrynias. Pagrindinis prizas {ffffff}BMW X5!\n\n{FFFFFF}Liko bandymu ivesti slaptazodi: {28910B}%d", !"Priimti", !"Kontekstas", PN(playerid), gPlayerLogTries{playerid});

stock ShowGrandRegiserDialog(playerid)
{
	f(global_str, 1000, "{FFFFFF}Sveiki atvyke i {205CA2}San Andreas Gyvenimas{ffffff}\nJusu Nick: {205CA2}%s\n\n{42B02C}Serveryje galioja premiju programa:{ffffff} /bonus\n{42B02C}Uz kiekviena zaidimo valanda gausite po 1 unikalu bilieta{ffffff} (/bilet)\n\n{FF69B4}Rask dovanas ir atidaryk skrynias. Pagrindinis prizas {ffffff}BMW X5!\n\nSi paskyra {FF6347}nera registruota {FFFFFF}musu serveryje.\nNoredami uzsiregistruoti, iveskite slaptazodi.\nJis bus naudojamas prisijungimui prie musu serverio.\n\n{C2A2DA}Registruojantis gausite premija: 3000$, 1 lvl\n\n{BF2F2F}\tPastabos:\n\t- Slaptazodzio ilgis turi buti nuo 6 iki 30 simboliu\n\t- Slaptazodis turi buti sudarytas is raidziu ir skaiciu\n\t- Slaptazodis yra jautrus raidziu dydziui\n", PN(playerid));
	return SPD(playerid, 1, DIALOG_STYLE_INPUT, !"{E88813}(1/5) Slaptazodis", global_str, !"Priimti", !"Iseiti");
}
stock ShowJobInfo(playerid = INVALID_PLAYER_ID, job = 1)
{
	global_str = "";
    ShowJobID[playerid] = job;
	switch(job)
	{
		case 1:
		{
            strcat(global_str,"{4F943D}Darbas 'Autobuso vairuotojas'{FFFFFF}\n");
            strcat(global_str,"Kad pradeti, jums reikia issinuomoti laisva autobusa. Nuomos kaina priklauso\n");
            strcat(global_str,"nuo mero nustatytos kainos valstijoje.\n");
            strcat(global_str,"Kai issinuomosite autobusa, jums reikes nustatyti vaziavimo kaina ir\n");
            strcat(global_str,"pasirinkti marsruta, kuriuo vaziuosite. Po marsruto pasirinkimo\n");
            strcat(global_str,"jums reikes vaziuoti per CheckPointus ir sustoti stotelese.\n");
            strcat(global_str,"Uz kiekviena CheckPointa gausite tiek pinigu, kiek nustatys meras!\n\n");
            strcat(global_str,"Sekmes darbe!");
		}
		case 3:
		{
            strcat(global_str,"{4F943D}Darbas 'Produktu isveziotojas'{FFFFFF}\n");
            strcat(global_str,"Kad pradeti, jums reikia rasti laisva transporta produktu pervezimui, tam iveskite /gps - Pagal darbus - Produktoveziai.\n");
            strcat(global_str,"Po to, kai rasite laisva automobili, jums reikia nusipirkti produktus. Juos galima isigyti ukio sandelyje – tai suteiks galimybe isvezioti produktus uzkandinems,\n");
            strcat(global_str,"arba iskrovimo stoties sandelyje, kas suteiks galimybe isvezioti produktus 24/7 parduotuvems, aksesuaru parduotuvems, drabuziu parduotuvems ir kt.\n");
            strcat(global_str,"Pirkimo ir perpardavimo kainos gali skirtis, nes ju kaina reguliuoja meras ir verslo savininkai, kurie savo ruožtu pateikia užsakymus pirkimui.\n");
            strcat(global_str,"Noredami rasti produktu uzsakova, naudokite /orderlist ir pasirinkite jums reikalinga versla. Atkreipkite demesi, kad kai kurie verslai gali buti nepasiturintys ir negales apmoketi\n");
            strcat(global_str,"uzsakymo, todel stebekite ju banko bukle. Taip pat bukite atsargus, nes uzkandines nepriima kroviniu is iskrovimo stociu!\nStebekite pardavimo pelninguma, nes galite patirti nuostoliu.");
            strcat(global_str,"Kad uzdirbtumete dar daugiau, pirkite produktus is naujo ir ieskokite verslininku!\n\n");
            strcat(global_str,"Sekmes darbe!\n");
		}
		case 4:
		{
            strcat(global_str,"{4F943D}Darbas 'Mechanikas' - ant firmos{FFFFFF}\n");
            strcat(global_str,"Darbo esme yra automobilio taisymas, remonto darbai ir transporto pristatymas i automobiliu dirbtuve.\n");
            strcat(global_str,"Kad pradeti darba, reikia nuvykti i automobiliu dirbtuve, kuri galima rasti su\n");
            strcat(global_str,"komanda /gps. Po to persirenkite ir laukite klientu pradziai darbo.\n");
            strcat(global_str,"Paspaudus ALT klavisa prie masinos, kurioje sedi zaidejas, pradesite ja taisyti. Jei zaidejo ten nebus,\n");
            strcat(global_str,"niekas neivyks. Variklio remontas sumazina automobilio rida ir mazesni sansa gedimu ateityje.\n");
            strcat(global_str,"Kad taisyti varikli, stovekite prie kapoto ir spauskite ALT.\n");
