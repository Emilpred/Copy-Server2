    if(TextFind(ItemsInfo[id][ItemName], "Sertifikatas")) return 1;
	return 0;
}

stock IsAChange(biz)
{
	switch BizData[biz][bState] do
	{
	    case 7,1,B_BUY,0,13,B_GAS,B_RENTCAR,26,24: return true;
