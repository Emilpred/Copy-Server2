		CreateDynamic3DTextLabel(!"Vieta, kurioje atliekamas remontas\n\n{ffffff}Paspauskite ALT, noredami pradeti remonta", 0xFFFF00FF, AutoService[i][asPosX], AutoService[i][asPosY], AutoService[i][asPosZ], 10.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	}

	for new i; i < sizeof ArizonaMobile; i++ do
	{
		ArizonaMobile[i][arzmob_VehicleId] = J_AddStaticVehicleEx(ArizonaMobile[i][arzmob_ModelId], ArizonaMobile[i][arzmob_PosX], ArizonaMobile[i][arzmob_PosY], ArizonaMobile[i][arzmob_PosZ],  ArizonaMobile[i][arzmob_PosA], random(255), random(255), 1000000, 0, 0);

		VehicleInfo[ArizonaMobile[i][arzmob_VehicleId]][vARZMob] = i;

		ArizonaMobile[i][arzmob_3DText] = CreateDynamic3DTextLabel("[ SAGMobile ]\n{CCCCCC}Prieinama nuomai per mobiliaja programele", 0x28E1B9FF, 0.0000, -0.1500, 0.2500, 3.5000, INVALID_PLAYER_ID, ArizonaMobile[i][arzmob_VehicleId]);
	}

	return true;
}
