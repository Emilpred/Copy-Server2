	return SCMALL(0xFF6666FF, !"================== [ San Andreas Gyvenimas ] ==================\n"),
		SCMALL(0xFF6666FF, !""),
		SCMALL(0xFF6666FF, !"		Serverio Site -> {FFFFFF}"Mode_Site""),
		SCMALL(0xFF6666FF, !"		Serverio Forumas -> {FFFFFF}"Mode_Forum""),
		SCMALL(0xFF6666FF, !"		Discord Grupe -> {FFFFFF}"Server_VKontakte""),
		SCMALL(0xFF6666FF, !"\n		{FFFFFF}Prisijunkite prie Discord grupes, kad zinotumete apie musu renginius!"),
		SCMALL(0xFF6666FF, !""),
		SCMALL(0xFF6666FF, !"\n================== [ San Andreas Gyvenimas ] ==================");

public: StartViktorina()
{
	viktorinas = 1;
	switch(random(2))
	{
	    case 0:
	    {
	        new a = 1+random(99),
	            b = 1+random(1999);
			SCMALL(COLOR_YELLOW, " ");
			SCMALLF(COLOR_YELLOW, "[Serveris] Jei pamatete cheateri, rasykite administracijai /report", a, b);
			SCMALL(COLOR_GREEN, "[Serveris]{ffffff} Musu Discord Grupe: discord.gg/p4qz7aTY!");
			SCMALL(COLOR_YELLOW, " ");
			viktorinav = a+b;
		}
	    case 1:
	    {
	        new a = 1+random(99),
	            b = 1+random(1999);
			SCMALL(COLOR_YELLOW, " ");
			SCMALLF(COLOR_YELLOW, "[Serveris] Jei pamatete cheateri, rasykite administracijai /report", b, a);
			SCMALL(COLOR_GREEN, "[Serveris]{ffffff} Musu Discord Grupe: discord.gg/p4qz7aTY!");
			SCMALL(COLOR_YELLOW, " ");
			viktorinav = b-a;
		}
	}
	return 1;
}
public: ServerTimer()
{
	Reklam ++;
	new year,month,day,minuite,second,hour;
   	getdate(year,month,day);
   	Global_Time = gettime(hour,minuite,second);

	if second == 0 *then
	{
		MinuteTimer();
	}
	if(GLS[71])
	{
	    if(minuite == 0 && second == 0 || minuite == 5 && second == 0 || minuite == 10 && second == 0 || minuite == 15 && second == 0 || minuite == 20 && second == 0 || minuite == 25 && second == 0 || minuite == 30 && second == 0 ||
	    minuite == 35 && second == 0 || minuite == 40 && second == 0 || minuite == 45 && second == 0 || minuite == 50 && second == 0) StartViktorina();
	}
	if(minuite == 7 && second == 0 || minuite == 21 && second == 0 || minuite == 28 && second == 0 ||
	minuite == 42 && second == 0 || minuite == 49 && second == 0) ReklamaReferal();
	if(minuite == 10 && second == 0 || minuite == 20 && second == 0 || minuite == 30 && second == 0 || minuite == 40 && second == 0 || minuite == 50 && second == 0 || minuite == 0 && second == 0) ReklamaDonateLink();

 	if AutoSletMP[aTime] == 0 && AutoSletMP[aWork] == 1 *then
	{
	    new id = AutoSletMP[aID_State];
	    switch AutoSletMP[aState] do
	    {
	        case 0:
	        {
				for new z; z < 5; z++ do
				{
					SetString(HRoomOwner[id][z], "The State");
					HRoomNalog[id][z] = HRoomPay[id][z] = 0;
				}
				SetString(HouseInfo[id][hOwner], "The State");
				HouseInfo[id][hNalog] =
				HouseInfo[id][hNalog2] = 0;
				UpdateHouse(id);
				ResetHouse(id);
			}
			case 1:
			{
				SetString(BizData[id][bOwner], "The State");
				SetString(BizData[id][bZam], "none");
				BizData[id][bLevel] = 0;
				UpdateBusinessText(id, 1);
			}
		}
		AutoSletMP[aWork] = 0;
		AutoSletMP[aTimeSpawn] = 3;
		AutoSletMP[aSpawnWork] = 1;
	}
	else AutoSletMP[aTime]--;

	for(new i; i < 4; i++)
	{
		if(ObInfo[i][obTime] > 0)
		{
			ObInfo[i][obTime] --;
			UpdateDynamic3DTextLabelTextf(ObInfo[i][ob3DText], 0xFFFFFFFFFFFF00FF, "Turto mainu dalyviai:\n{ffffff}%s ir %s\n\n{ffff00}Iki mainu pabaigos liko:\n{ffffff}%i sek.", PN(ObInfo[i][obPlayer]), PN(ObInfo[i][obID]), ObInfo[i][obTime]);
			if(ObInfo[i][obTime] == 0) ResetObmen(i);
		}
	}

    for(new k; k < FAMILYZONES; k++)
    {
        if(FamilyZone[k][fAttack] >= 0 && FamilyZone[k][fDay] == day && FamilyZone[k][fHour] == hour && FamilyZone[k][fMinut] == minuite && FamilyZone[k][famAttack] == false)
        {
			FamCaptureZone = k;
			FamCaptureDef = FamilyZone[k][fZoneOwnerId];
			FamCaptureAtac = FamilyZone[k][fAttack];
			FamCaptureAtacKill = 0;
			FamCaptureDefKill = 0;
			FamCaptureTime[0] = 10;
			FamCaptureTime[1] = 0; //10 minuciu
			FamilyZone[FamCaptureZone][famAttack] = true;
			GangZoneFlashForAll(FamilyZone_gang[FamCaptureZone], FZColors[GetFamilyDataInt(FamCaptureAtac, "color")]);

            SendFamilyMessage(FamilyZone[FamCaptureZone][fAttack], (str_f("{%s}[Family War] Jusu seima dabar pradejo susitikima su kita seima %s teritorijoje ¹%i", FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fAttack], "color")], GetFamilyDataString(FamilyZone[FamCaptureZone][fZoneOwnerId], "name"), k)) );
            SendFamilyMessage(FamilyZone[FamCaptureZone][fAttack], (str_f("{%s}[Family War] Seimos nariai turi {FF0000}raudona {%s}spalva, o priesininkai - {00ff00}zalia {%s}spalva.", FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fAttack], "color")], FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fAttack], "color")], FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fAttack], "color")])) );

			SendFamilyMessage(FamilyZone[FamCaptureZone][fZoneOwnerId], (str_f("{%s}[Family War] Jusu seima dabar pradejo susitikima su kita seima %s teritorijoje ¹%i", FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fZoneOwnerId], "color")], GetFamilyDataString(FamilyZone[FamCaptureZone][fAttack], "name"), k)) );
			SendFamilyMessage(FamilyZone[FamCaptureZone][fZoneOwnerId], (str_f("{%s}[Family War] Seimos nariai turi {FF0000}raudona {%s}spalva, o priesininkai - {00ff00}zalia {%s}spalva.", FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fZoneOwnerId], "color")], FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fZoneOwnerId], "color")], FamilyColor[GetFamilyDataInt(FamilyZone[FamCaptureZone][fZoneOwnerId], "color")])) );
        }
    }

	if AutoSletMP[aTimeSpawn] == 0 && AutoSletMP[aSpawnWork] == 1 *then
	{
	 	foreach(Player, i) if IsPlayerInRangeOfPoint(i, 100, TeleportFloat[0], TeleportFloat[1], TeleportFloat[2]) *then PlayerSpawn(i);
	    SendAdminsMessage(COLOR_LIGHTBLUE, "[AutoSlet] {633169}Visi zaidejai, esantys 100 metru atstumu nuo iskritimo vietos, buvo uzspawninti..");
	    AutoSletMP[aSpawnWork] = 0;
	}
	else AutoSletMP[aTimeSpawn]--;

	if !(PAYDAY_LAST_TIME == hour) && minuite == 0 *then
   	{
		day_of_week = getDayEx();

		PAYDAY_LAST_TIME = hour;
		SetWorldTime(hour);
 		PayDay(1);
	}

	if !(AUTO_NALOG_LAT_TIME == hour) && minuite == 55 *then
	{
		AUTO_NALOG_LAT_TIME = hour;
		AUTO_NALOG_GO();
	}

	if !(LAST_RAZDACHA_TIME == hour) && minuite > 5 && RazdachaData[razdacha_itemid] *then
	{
		LAST_RAZDACHA_TIME = hour;
		// razdacha system
		foreach(Player, i) {

			AddItem(i, RazdachaData[razdacha_itemid], RazdachaData[razdacha_count]);

		}

		SCMALL(-1, (str_f("Informacija: {FF6347}Visiems buvo suteiktas daiktas %s kiekis %d vnt.", ItemsInfo[RazdachaData[razdacha_itemid]][ItemName2], RazdachaData[razdacha_count])));
		//
	}

	if SERVER_RESTART *then
	{
		if hour == 5 && minuite == 5 *then
			SCMALL(COLOR_LIGHTRED, "Demesio! Po 5 minuciu bus atliktas automatinis serverio restartas!");
		if hour == 5 && minuite == 9 *then
			SCMALL(COLOR_LIGHTRED, "Demesio! Po 1 minutes bus atliktas automatinis serverio restartas!");
		if hour == 5 && minuite == 10 *then
			SCMALL(COLOR_LIGHTRED, "Demesio! Vyksta automatiniss serverio restartas!"),
			Mode[RESTART_ETAPE] = 0, ServerRestart();
	}

	if hour == ConceptTime && minuite == 00 && second == 1 *then
	{
	    ConceptTime = randomF(1, 24), ConceptCount = randomF(10, 15);

		f(global_str, 256, "[Dezute Concept Car Luxury]{FFFFFF}\n\nYra: {C87D6D}%dvnt.\n{FFFFFF}Kitass pristatymas {C87D6D}%d:00\n\n{FFFFFF}Noredami nusipirkti, paspauskite ALT", ConceptCount, ConceptTime);
		UpdateDynamic3DTextLabelText(ConceptLuxury, COLOR_YELLOW, global_str);
	}

