{
	switch item do
	{
/*1 langelis*/ case 349..351,360,390,391,398..400,342,416..419,414,412,410,409,429..462,516..520,512,513,491..495,545,618,619,971,1159,647..655,411,1446,1447,1429,1464..1467,1808,1809,1812,1819..1825,1844..1848,1849..1853,1854..1857,1867..1876,1883,1887,1888,1918..1920,2289,2291..2293,2296,2299,2309..2314,2317,2318,2363,2399,2410..2412,2422,2426,2430,2432,2433,2435,2438,2442,2446,2448,2450,2455,2458,2461,2585..2590,2608,2609,2610,2723,2728,2729,2733,2755,2765,2797..2801,2805,2826,2828,2829,2831..2833,2836..2842,2911,2912,2913,2917,2919,2922,2924..2927,2929..2932,2953,2955,2956,2958,2960,2963,2969,3004: return 0;
/*2 langelis*/ case 392,406,1158,463..480,674..682,537,408,340,343..345,1442,1460,1459,1556,1900,1906,2301,2304..2307,2315,2316,2327,2364,2365,2373,2385,2388,2417,2437,2440,2449,2462,2717..2720,2726,2796,2802..2804,2813,2827,2830,2834,2835,2882,2923,2928,2954,2957,2959,2961,2962,2964..2967,2968: return 1;
/*3 langelis*/ case 481..490,953..957,982..987,1161,1833..1839,1805,1806,1810,1811,1816,1817,1946,2288,2356,2360,2369,2372,2374,2392,2398,2401,2413,2418,2419,2423,2424,2428,2429,2431,2439,2459,2721,2722,2949..2952,2971..2978,2979,2980: return 2;
/*4 langelis*/ case 2714,3041: return 3;
/*5 langelis*/ case 2881, 1441,353,425..428,544,606..612,972,541,1157,1445,1124,1625..1627,1886,1921,2272..2278,2287,2295,2320,2322..2325,2456,2611,2612,2715,2716,2724,2727,2730..2732,2754,2814,2854..2860,2916,2921,3005,3035..3037, 2350: return 4;
/*6 langelis*/ case 1440,1162..1171,684,685,334,336,337,338,339,594,593,595,604,596,597,598,599,600,601,602,614,348,354,355,357,358,359,369,397,395,394,393,401..405,413,420,421,423,509,510,511,424,543,542,584,585,586,352,361,582,620..646,656..664,970,980,1132..1155,1156,1160, 1438,1448..1456,1458,1462..1463,1552,1554..1555,1557,1621..1624,1802..1804,1807,1813,1814,1815,1818,1826..1832,1863..1866,1877..1880,1884,1892,1885,1890,1891,1898,1901..1905,1907..1910,1911..1917,1922..1933, 1934..1937, 1941,1942,1943,1944,1945,1947..1951,1952,1953,1954..1958,2281..2283,2294,2298,2300,2302,2303,2326,2328..2344,2351,2357..2359,2361,2362,2366,2367,2370,2371,2375..2384,2387,2389,2400,2402..2409,2414..2416,2425,2427,2434,2436,2441,2443..2445,2447,2453,2457,2460,2463..2466,2601..2607,2725,2734..2738,2756..2764,2806..2808,2815..2821,2844,2851,2853,2864..2876,2914,2915,2933..2935,2941..2948,2991..2999,3000,3001,3002: return 5;
/*7 langelis*/ case 499..508,1125,1801,1889,1893,1894,1959..1963, 1964..1968,2279,2280,2290, 2591..2595,2741..2753,2809..2812, 2883,2936,2937: return 6;
/*8 langelis*/ case 341,415,605,1457,1551,1121,2297,2345..2347, 2596..2600,2822,2823,2845..2850, 1938..1940, 2885..2887: return 7;
