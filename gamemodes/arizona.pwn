	HouseInfo[ID][hGarage_Y] = AhGaragePositionY;
	HouseInfo[ID][hGarage_Z] = AhGaragePositionZ;
	HouseGaragePickup[ID] = CreateDynamicPickup(
		19133,
		0,
		HouseInfo[ID][hGarage_X],
		HouseInfo[ID][hGarage_Y],
		HouseInfo[ID][hGarage_Z],
		0, 0, -1, 25.0
	);

	f(global_str, 84,
		"{FFFFFF}Garazas ( %i )\n\
		Ieiti: {f4e451}ALT{FFFFFF}\n\
		Ivaziuoti: {f4e451}ALT",
		ID
	);

	HouseInfo[ID][hGarage_X] = AhGaragePositionX;
	HouseInfo[ID][hGarage_Y] = AhGaragePositionY;
