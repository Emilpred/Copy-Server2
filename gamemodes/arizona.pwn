      		ItemChangeColor[playerid][0] = 0,
			PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][26], 0);
			PlayerTextDrawSetPreviewModel(playerid, ChangeColor_PTD[playerid][26], 1649);
			PlayerTextDrawSetPreviewRot(playerid, ChangeColor_PTD[playerid][26], 0.000,  0.000,  90.00,  2.0);
			PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][26]);
			InvSlotUpdate(playerid, SCC[playerid][0], SlotChangeColor[playerid][0]);
			SetPVarInt(playerid, "idcolorchange", 0);
		    if InfoChanColor[playerid] *then
		    {
				for(new k; k < 6; k++) DestroyPlayerTD(playerid, InfColorChange[playerid][k]);
				InfoChanColor[playerid] = false;
			}
        }
    }

	if !(PhoneOpen[playerid] == -1) *then
		ClickPhoneTD(playerid, playertextid);

	if Int_GetPlayerData(playerid, "OtherInventOpen") || EnchantWork{playerid} || InventoryOpen{playerid} || tradeopen{playerid} || ChangeColorOpen{playerid} *then
	{
		for new i,j; i < 36; i++ do
	    {
	    	if i < 30 *then
	    	{
	    		if playertextid == OtherKletka[playerid][i] *then
	    		{
	    			if Int_GetPlayerData(playerid,"DialogOpen") *then return 0;

	    			j = i+30*Int_GetPlayerData(playerid, "OtherInventPage");

	    			if GetInvSet(playerid) >= PI[playerid][pInvCell] *then return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums neuztenka vietos inventoriuje!");

	    			new id;

	    			switch Int_GetPlayerData(playerid, "OtherInventOpen") do
	    			{
	    				case 1:
	    				{
			    			id = HouseEntered[playerid];
			    			if id == -1 || !GetString(HouseInfo[id][hOwner], PN(playerid)) *then return OtherInvClose(playerid);
			    			if !HouseInfo[id][hItem][j] || !HouseInfo[id][hItemCount][j] *then return 0;
							else if HouseInfo[id][hItemCount][j] == 1 *then
							{
								AddItem(playerid, HouseInfo[id][hItem][j], 1, HouseInfo[id][hItemLevel][j], HouseInfo[id][hItemProc][j], HouseInfo[id][hItemNashivka][j], HouseInfo[id][hItemNashivkaLevel][j], 0, 0, HouseInfo[id][hItemColor][j]);
								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> paeme inventoriaus daikta ¹%d is spintos %s (id:%d) kiekyje %d (galastuvas: +%d) (zenkliuko lygis: %d)", 4, PN(playerid), "", PN(playerid), PN(playerid), id, ItemsInfo[HouseInfo[id][hItem][j]][ItemName2], HouseInfo[id][hItem][j], 1, HouseInfo[id][hItemLevel][j], HouseInfo[id][hItemNashivkaLevel][j]);
								HouseInfo[id][hItem][j]  = HouseInfo[id][hItemCount][j] = HouseInfo[id][hItemLevel][j]  = HouseInfo[id][hItemProc][j] = 0;
								OtherInventSlotUpdateAll(id, 1, HouseInfo[id][hItem][j], i, HouseInfo[id][hItemCount][j], j);
								SaveItemHouse(id);
							}
							else if HouseInfo[id][hItemCount][j] > 1 *then
							{
								PickInvent[playerid] = j, PickInventSlot[playerid] = i;
								return SPD(playerid, 8251, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite paimti", !"Isrinkti", !"Atsaukti");
							}
						}
						case 2:
						{
							id = musorka[playerid];
							if id == -1 *then return OtherInvClose(playerid);
							else if !MusorInfo[id][mItem][j] || !MusorInfo[id][mItemCount][j] *then return 0;
							else if MusorInfo[id][mItemCount][j] == 1 *then
							{
								AddItem(playerid, MusorInfo[id][mItem][j], 1, MusorInfo[id][mItemLevel][j], MusorInfo[id][mItemProc][j], MusorInfo[id][mItemNashivka][j], MusorInfo[id][mItemNashivkaLevel][j], 0, 0, MusorInfo[id][mItemColor][j]);
								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> paeme inventoriaus daikta ¹%d is siuksliadezes %s (id:%d) kiekyje %d (galastuvas: +%d) (zenkliuko lygis: %d)", 4, PN(playerid), "", PN(playerid), PN(playerid), id, ItemsInfo[MusorInfo[id][mItem][j]][ItemName2], MusorInfo[id][mItem][j], 1, MusorInfo[id][mItemLevel][j], MusorInfo[id][mItemNashivkaLevel][j]);
								MusorInfo[id][mItem][j] = MusorInfo[id][mItemCount][j] = MusorInfo[id][mItemLevel][j] = MusorInfo[id][mItemProc][j] = 0;
								OtherInventSlotUpdateAll(id, 2, MusorInfo[id][mItem][j], i, MusorInfo[id][mItemCount][j], j, 0);
							}
							else if MusorInfo[id][mItemCount][j] > 1 *then
							{
								PickInvent[playerid] = j, PickInventSlot[playerid] = i;
								return SPD(playerid, 8251, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite paimti", !"Isrinkti", !"Atsaukti");
							}
						}
						case 3:
						{
							id = trunk[playerid];
							new Float:X,Float:Y,Float:Z;
							if !IsValidVehicle(id) || !TrunkInfo[id][tOpen] *then return OtherInvClose(playerid);
							GetVehiclePos(id, X,Y,Z);
							if !IsPlayerInRangeOfPoint(playerid, 5.0, X,Y,Z) *then return OtherInvClose(playerid);
							else if !TrunkInfo[id][tItem][j] || !TrunkInfo[id][tItemCount][j] *then return false;
							else if TrunkInfo[id][tItemCount][j] == 1 *then
							{
								AddItem(playerid, TrunkInfo[id][tItem][j], 1, TrunkInfo[id][tItemLevel][j], TrunkInfo[id][tItemProc][j], TrunkInfo[id][tItemNashivka][j], TrunkInfo[id][tItemNashivkaLevel][j], 0, 0, TrunkInfo[id][tItemColor][j]);
								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> paeme inventoriaus daikta ¹%d is bagazines %s (id:%d) kiekyje %d (galastuvas: +%d) (zenkliuko lygis: %d)", 4, PN(playerid), "", PN(playerid), PN(playerid), id, ItemsInfo[TrunkInfo[id][tItem][j]][ItemName2], TrunkInfo[id][tItem][j], 1, TrunkInfo[id][tItemLevel][j], TrunkInfo[id][tItemNashivkaLevel][j]);
								TrunkInfo[id][tItem][j] = TrunkInfo[id][tItemCount][j] = TrunkInfo[id][tItemLevel][j] = TrunkInfo[id][tItemProc][j] = 0;
								OtherInventSlotUpdateAll(id, 3, TrunkInfo[id][tItem][j], i, TrunkInfo[id][tItemCount][j], j, TrunkInfo[id][tItemLevel][j]);
								if IsAOwnableCar(id) *then SaveTrunk(id);
							}
							else if TrunkInfo[id][tItemCount][j] > 1 *then
							{
								PickInvent[playerid] = j, PickInventSlot[playerid] = i;
								return SPD(playerid, 8251, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite paimti", !"Isrinkti", !"Atsaukti");
							}
						}
/*						case 4:
						{
							id = SkladEntered2[playerid];
							if id == -1 *then return OtherInvClose(playerid);
							else if !SkladData[id][skItem][j] || !SkladData[id][skItemCount][j] *then return false;
							else if SkladData[id][skItemCount][j] == 1 *then
							{
								AddItem(playerid, SkladData[id][skItem][j], 1, SkladData[id][skItemLevel][j], SkladData[id][skItemProc][j], SkladData[id][skItemTypeNashiv][j], SkladData[id][skItemLvlNashiv][j], 0, 0, SkladData[id][skItemColor][j]);
								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> paeme preke is ¹%d sandelio %s (id:%d) kiekyje %d (galastuvas: +%d) (zenkliuko lygis: %d)", 4, PN(playerid), "", PN(playerid), PN(playerid), id, ItemsInfo[SkladData[id][skItem][j]][ItemName2], SkladData[id][skItem][j], 1, SkladData[id][skItemLevel][j], SkladData[id][skItemLvlNashiv][j]);
								SkladData[id][skItem][j] = SkladData[id][skItemCount][j] = SkladData[id][skItemLevel][j] = SkladData[id][skItemProc][j] = SkladData[id][skItemTypeNashiv] = SkladData[id][skItemLvlNashiv] = SkladData[id][skItemColor] = 0;
								OtherInventSlotUpdateAll(id, 4, SkladData[id][skItem][j], i, SkladData[id][skItemCount][j], j, SkladData[id][skItemLevel][j]);
								SaveItemSklad(id);
							}
							else if SkladData[id][skItemCount][j] > 1 *then
							{
								PickInvent[playerid] = j, PickInventSlot[playerid] = i;
								return SPD(playerid, 8251, DIALOG_STYLE_INPUT, "", "{FFFFFF}Iveskite kieki, kuri norite paimti", "Isrinkti", "Atsaukti");
							}
						}*/
					}
	    			return 1;
	    		}
	    	}

			if playertextid == Kletka[playerid][i] *then
			{
				if Int_GetPlayerData(playerid,"DialogOpen") *then return false;

				j = GetInvID(playerid, i, 0);

				if bool:InventSlotUse[playerid][j] == true *then return false;

				switch InventoryPage[playerid] do
				{
					case E_INVENTORY_TYPE_TRADE:
					{
					    if(PI[playerid][pLevel] < 10) return SCM(playerid, COLOR_GREY, "[Klaida] Norint perduoti daikta/pinigus kitam zaidejui, jums reikia 10 lygio!");
						if ArendaInfo_INT[playerid][0][j] *then
							return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Issinuomoto aksesuaro cia deti negalima!");

						if !Inventory[playerid][0][j] || !Inventory[playerid][1][j] *then return false;

						if !IsPlayerOnline(GetDataTrade(playerid, tradePlayer)) or GetDataTrade(GetDataTrade(playerid, tradePlayer), tradeAccept) or GetDataTrade(playerid, tradeAccept) *then return false;

						else if !IsValidItem(Inventory[playerid][0][j]) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Sio daikto negalima perduoti!");

						if Inventory[playerid][1][j] == 1 *then
						{
							for new idx; idx < 10; idx ++ do
							{
								if TradeInfo[playerid][tradeItem][idx] == -1 *then
								{
									TradeInfo[playerid][tradeItem][idx] = j;
									TradeInfo[playerid][tradeItemCount][idx] = 1;
									TradeInfo[playerid][tradeItemNashivka][idx] = j;
									TradeInfo[playerid][tradeItemNashivkaLevel][idx] = j;
									TradeInfo[playerid][tradeItemColor][idx] = PI[playerid][pColor][j];
									InventSlotUse[playerid][j] = true;
									InvSlotUpdate(playerid, i, j);
									return UpdateTradeSlot(playerid, idx, Inventory[playerid][0][j], 1, Inventory[playerid][2][j]);
								}
							}
						}
						else PickInvent[playerid] = j, PickInventSlot[playerid] = i, SPD(playerid, 8249, DIALOG_STYLE_INPUT, !"Prekyba", !"{FFFFFF}Iveskite kieki, kuri norite perduoti", !"Isrinkti", !"Atsaukti");
						return true;
					}

					case E_INVENTORY_TYPE_ENCHANT_2:
					{
						if ArendaInfo_INT[playerid][0][j] *then
							return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Issinuomoto aksesuaro cia deti negalima!");

						if IsAAks(Inventory[playerid][0][j]) && !(Inventory[playerid][3][j] == 100) && !(BizEntered[playerid] == -1) *then
							return PickInvent[playerid] = j, PickInventSlot[playerid] = i, SPDF(playerid, 8510, DIALOG_STYLE_MSGBOX, !"Dirbtuve | Remontas", "{FFFFFF}Restauravimo stiprybes kastai {A1FF96}%d BTC{FFFFFF}\nAr tikrai norite pataisyti?", !"Isrinkti", !"Atsaukti", BizData[BizEntered[playerid]][bItem][1]);

						return true;
					}
					case E_INVENTORY_TYPE_ENCHANT:
					{
						if ArendaInfo_INT[playerid][0][j] *then
							return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Issinuomoto aksesuaro cia deti negalima!");

						if IsAAks(Inventory[playerid][0][j]) &&  !EnchantWorkItem[playerid][0] *then EnchantWorkItem[playerid][0] = j + 1;
						else if !EnchantWorkItem[playerid][1] && (Inventory[playerid][0][j] == 1130 or Inventory[playerid][0][j] == 1502) *then EnchantWorkItem[playerid][1] = j + 1;
						else return false;

						if IsAAks(Inventory[playerid][0][j]) || Inventory[playerid][0][j] == 1130 || Inventory[playerid][0][j] == 1502 *then
							PlayerTextDrawColor(playerid, Kletka[playerid][i], 0x666666FF),
							InventSlotUse[playerid][j] = true,
							PlayerTextDrawSetSelectable(playerid, Kletka[playerid][i], false),
							PlayerTextDrawHide(playerid, Kletka[playerid][i]),
							ShowPlayerTD(playerid, Kletka[playerid][i]),
							UpdateEnchantWork(playerid);

						return true;
					}

					case E_INVENTORY_TYPE_OTHER_INV:
					{
						if ArendaInfo_INT[playerid][0][j] *then
							return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Issinuomoto aksesuaro cia deti negalima!");

						if !Inventory[playerid][0][j] || !Inventory[playerid][1][j] *then return false;
						else if !(Lavka[playerid] == -1) *then return false;

						switch Int_GetPlayerData(playerid, "OtherInventOpen") do
						{
							case 1:
							{
								if HouseEntered[playerid] == -1 *then return OtherInvClose(playerid);
								else if !IsValidItem(Inventory[playerid][0][j]) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Sio daikto negalima perduoti!");
								else if Inventory[playerid][1][j] == 1 *then
									AddItemHouse(playerid, HouseEntered[playerid], Inventory[playerid][0][j], 1, Inventory[playerid][2][j], Inventory[playerid][3][j], Inventory[playerid][4][j], Inventory[playerid][5][j], PI[playerid][pColor][j]),
									ClearItem(playerid, j, 1),
									SaveItemHouse(HouseEntered[playerid]);

								else if Inventory[playerid][1][j] > 1 *then
								{
									PickInvent[playerid] = j, PickInventSlot[playerid] = i;
         							return SPD(playerid, 8248, DIALOG_STYLE_INPUT, !"", "!{FFFFFF}Iveskite kieki, kuri norite ideti", !"Isrinkti", !"Atsaukti");
								}
							}
							case 2:
							{
								if musorka[playerid] == -1 *then return OtherInvClose(playerid);
								else if !IsValidItem(Inventory[playerid][0][j]) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Sio daikto negalima perduoti!");
								else if Inventory[playerid][1][j] == 1 *then
									AddItemMusor(playerid, musorka[playerid], Inventory[playerid][0][j], 1, Inventory[playerid][2][j], Inventory[playerid][3][j]),
									ClearItem(playerid, j, 1);

								else if Inventory[playerid][1][j] > 1 *then
								{
									PickInvent[playerid] = j, PickInventSlot[playerid] = i;
									return SPD(playerid, 8248, DIALOG_STYLE_INPUT, !"", "!{FFFFFF}Iveskite kieki, kuri norite ideti", !"Isrinkti", !"Atsaukti");
								}
							}
							case 3:
							{
								if !IsValidVehicle(trunk[playerid]) *then return OtherInvClose(playerid);
								else if !IsValidItem(Inventory[playerid][0][j]) *then return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Sio daikto negalima perduoti!");
								else if Inventory[playerid][1][j] == 1 *then
								{
									AddItemTrunk(playerid, trunk[playerid], Inventory[playerid][0][j], 1, Inventory[playerid][2][j], Inventory[playerid][3][j], Inventory[playerid][4][j], Inventory[playerid][5][j], PI[playerid][pColor][j]);
									ClearItem(playerid, j, 1);
									if IsAOwnableCar(trunk[playerid]) *then SaveTrunk(trunk[playerid]);
								}
								else if Inventory[playerid][1][j] > 1 *then
								{
									PickInvent[playerid] = j, PickInventSlot[playerid] = i;
									return SPD(playerid, 8248, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite ideti", !"Isrinkti", !"Atsaukti");
								}
							}
/*							case 4:
							{
								if SkladEntered2[playerid] == -1 *then return OtherInvClose(playerid);
								else if !IsValidItem(Inventory[playerid][0][j]) *then return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Sio daikto negalima perduoti!");
								else if Inventory[playerid][1][j] == 1 *then
									AddItemSklad(playerid, SkladEntered2[playerid], Inventory[playerid][0][j], 1, Inventory[playerid][2][j], Inventory[playerid][3][j], Inventory[playerid][4][j], Inventory[playerid][5][j], PI[playerid][pColor][j]),
									ClearItem(playerid, j, 1),
									SaveItemSklad(SkladEntered2[playerid]);

								else if Inventory[playerid][1][j] > 1 *then
								{
									PickInvent[playerid] = j, PickInventSlot[playerid] = i;
									return SPD(playerid, 8248, DIALOG_STYLE_INPUT, "", "{FFFFFF}Iveskite kieki, kuri norite ideti", "Isrinkti", "Atsaukti");
								}
							}*/
						}
						return true;
					}

					case E_INVENTORY_TYPE_PLAYER:
					{
						new ID = PickInvent[playerid], slot = PickInventSlot[playerid];

						if UseNashivka{playerid} *then
						{
							new iditem = Inventory[playerid][0][j];

							ClickNashivka[playerid] = j;

                           	if !Inventory[playerid][5][j] *then
                           	{
                           	    static const Nashivka[][] = {"apsaugos", "regeniracijos", "zalos", "sekmes", "maks. HP"};

                           	    if IsAAks(iditem) *then return SPD(playerid, 25691, DIALOG_STYLE_MSGBOX, !"Patvirtinimas", (str_f("{ffffff}Ar tikrai norite prisiuti %d lygio zenkliuka %s prie aksesuaro {FFF200}%s", Inventory[playerid][2][NashivkaSlot[playerid]], Nashivka[NashivkaType[playerid]-1], ItemsInfo[iditem][ItemName2])), !"Prisiuti", !"Atsaukti");
								else return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Tai nera aksesuaras!");
							}
							return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Zenkliukas jau idiegtas aksesuare!");
						}
						if UseSharpening{playerid} *then
						{
							new iditem = Inventory[playerid][0][j];

							ClickSharp[playerid] = j;

                           	if !Inventory[playerid][5][j] *then
                           	{
                           	    if IsAAks(iditem) *then return SPD(playerid, 25692, DIALOG_STYLE_MSGBOX, !"Patvirtinimas", (str_f("{ffffff}Ar tikrai norite paastrinti pasirinkta daikta iki {ff6666}+13 lygio{ffffff}?\n\nPasirinktas daiktas: {ff6666}%s\nGalandimo tikimybe %s%", ItemsInfo[iditem][ItemName2], SharpeningItem[playerid] == 2879 ? "15" : "100")), !"Priimti", !"Atsaukti");
								else return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Tai nera aksesuaras!");
							}
							return SCM(playerid, COLOR_RED, "[Klaida]{FFFFFF} Zenkliukas jau idiegtas aksesuare!");
						}
						if PickInvent[playerid] == 145 *then
						{
							if !Inventory[playerid][0][j] *then
							{
								if IsPlayerTextDrawVisible(playerid, InventMenuTD[playerid][0]) && pTemp[playerid][tItemId] *then
								{
									switch pTemp[playerid][tType] do
									{
										case 2:
										{
											new vehicle = GetVehicleID(GetPlayerVehicleID(playerid)), t_Slot = pTemp[playerid][tSlot];

											Inventory[playerid][0][j] = CarInfo[vehicle][InvCar][t_Slot];
											Inventory[playerid][1][j] = 1;

											InstallTun(GetPlayerVehicleID(playerid), t_Slot , 1);

											UpdateCarSlotTD(playerid, CarInvVisualSlot[playerid][t_Slot], CarInfo[vehicle][InvCar][t_Slot] = 0);

											InvSlotUpdate(playerid, i, j);

											SaveInvCar(GetPlayerVehicleID(playerid));
										}
										case 3:
										{
										    new vehicle = GetVehicleID(GetPlayerVehicleID(playerid)), t_Slot = pTemp[playerid][tSlot];

											Inventory[playerid][0][j] = CarInfo[vehicle][InvTexnicalCar][t_Slot];
											Inventory[playerid][1][j] = 1;

											InstallTun(GetPlayerVehicleID(playerid), t_Slot , 1);

											UpdateCarSlotTD(playerid, CarInvTechicalSlot[playerid][t_Slot], CarInfo[vehicle][InvTexnicalCar][t_Slot] = 0);

											InvSlotUpdate(playerid, i, j);

											SaveInvCar(GetPlayerVehicleID(playerid));
										}
									}

									pTemp[playerid][tItemId] = 0;
									pTemp[playerid][tType] = 0;
									pTemp[playerid][tSlot] = 0;

									HideInventMenuTD(playerid);
								}

								return true;
							}

							PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
							PickInvent[playerid] = j, PickInventSlot[playerid] = i;

							PlayerTextDrawHide(playerid, Kletka[playerid][i]);
							PlayerTextDrawSetSelectable(playerid, Kletka[playerid][i], 0);
							PlayerTextDrawHide(playerid, Kletka[playerid][i]), ShowPlayerTD(playerid, Kletka[playerid][i]);

							OnPlayerClickSlot(playerid, i);
						}
						else
						{
							if Inventory[playerid][0][j] *then
							{
								//if(PI[playerid][pTrashOpen] == 1 || ShkafOpen{playerid} == 1 || BagazhnikOpen{playerid} == 1 || TradeInfo[playerid][tradeID] != INVALID_PLAYER_ID || PI[playerid][pTrashOpen] == 1 || PickInvent[playerid] == j || shopopen{playerid}) return 1;
								ChangeItemPos(playerid, ID, j);

								PlayerTextDrawColor(playerid, KletkaText[playerid][slot], 0xAAAAAAFF);
								PlayerTextDrawColor(playerid, KletkaText[playerid][i], 0xAAAAAAFF);

								if(Inventory[playerid][0][j] == Inventory[playerid][0][ID])
								{
									if(PickInvent[playerid] == j) return 1;
									new quantity = ItemsInfo[Inventory[playerid][0][j]][ItemQuantity],
										quantity2 = Inventory[playerid][1][j]+Inventory[playerid][1][ID];

									if(quantity2 >= quantity)
									{
										if(quantity2 == quantity)
										{
											Inventory[playerid][1][j] += Inventory[playerid][1][ID];
											Inventory[playerid][0][ID] = Inventory[playerid][1][ID] = 0;
										}
										else
										{
											Inventory[playerid][1][ID] = quantity2 - quantity;
											Inventory[playerid][1][j] = quantity;
										}
										InvSlotUpdate(playerid, slot, ID);
										InvSlotUpdate(playerid, i, j);
										PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
										return 1;
									}
									Inventory[playerid][1][j] += Inventory[playerid][1][ID];
									Inventory[playerid][0][ID] = Inventory[playerid][1][ID] = 0;
								}
							}
							else if !Inventory[playerid][0][j] *then
							{
								if shopopen{playerid} *then return false;

								ChangeItemPos(playerid, j, ID);

								Inventory[playerid][0][ID] = Inventory[playerid][1][ID] = Inventory[playerid][2][ID] = Inventory[playerid][3][ID] = 0;

								PlayerTextDrawColor(playerid, KletkaText[playerid][slot], 0xAAAAAAFF);
								PlayerTextDrawColor(playerid, KletkaText[playerid][i], 0xAAAAAAFF);
							}
							ColorSlotReset(playerid);
							InvSlotUpdate(playerid, slot, ID);
							InvSlotUpdate(playerid, i, j);
							PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
							HideInventMenuTD(playerid);
						}
					}
					case E_INVENTORY_TYPE_COLOR:
					{
						if ArendaInfo_INT[playerid][0][j] *then
							return SCM(playerid,COLOR_RED,"[Klaida] {ffffff}Issinuomoto aksesuaro cia deti negalima!");

						new item = Inventory[playerid][0][j];

						if IsAAks(item) *then
						{
						    if !ItemChangeColor[playerid][0] *then
						    {
	                            InventSlotUse[playerid][j] = true,
	                            ItemChangeColor[playerid][0] = item,
	                            SlotChangeColor[playerid][0] = j;
	                            SCC[playerid][0] = i;
						        PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][26], item ? 1 : 0);
						        PlayerTextDrawSetPreviewModel(playerid, ChangeColor_PTD[playerid][26], ItemsInfo[item][ItemModel]);
						        PlayerTextDrawSetPreviewRot(playerid, ChangeColor_PTD[playerid][26], ItemsInfo[item][POSTDx], ItemsInfo[item][POSTDy], ItemsInfo[item][POSTDz], ItemsInfo[item][POSTDc]);
						        PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][26]);
						        InvSlotUpdate(playerid, i, j);
							}
							else
							{
							    InventSlotUse[playerid][SlotChangeColor[playerid][0]] = false,
							    InvSlotUpdate(playerid, i, SlotChangeColor[playerid][0]);
	                            InventSlotUse[playerid][j] = true,
	                            ItemChangeColor[playerid][0] = item,
	                            SlotChangeColor[playerid][0] = j;
	                            SCC[playerid][0] = i;
						        PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][26], item ? 1 : 0);
						        PlayerTextDrawSetPreviewModel(playerid, ChangeColor_PTD[playerid][26], ItemsInfo[item][ItemModel]);
						        PlayerTextDrawSetPreviewRot(playerid, ChangeColor_PTD[playerid][26], ItemsInfo[item][POSTDx], ItemsInfo[item][POSTDy], ItemsInfo[item][POSTDz], ItemsInfo[item][POSTDc]);
						        PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][26]);
						        InvSlotUpdate(playerid, i, j);
							}

							UpdateColorSlot(playerid);
						}
						else if item == 1130 *then
						{
						    if !ItemChangeColor[playerid][1] *then
						    {
                            	ItemChangeColor[playerid][1] = Inventory[playerid][1][j];
                            	SlotChangeColor[playerid][1] = j;
                            	SCC[playerid][1] = i;
                            	InventSlotUse[playerid][j] = true;
						        PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][28], "%d/1", ItemChangeColor[playerid][1]);
						        PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][27], ItemChangeColor[playerid][1] ? -1 : -1717986817);
						        PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][27], ItemChangeColor[playerid][1] ? 1 : 0);
						        PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][27]);
						        InvSlotUpdate(playerid, i, j);
                            }
                            else SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Jus jau idejote galastuva.");
                            UpdateColorSlot(playerid);
						}
						else if item == 2739 *then
						{
						    if ItemChangeColor[playerid][2] < 7 *then
						    {
						        ItemChangeColor[playerid][2] = Inventory[playerid][1][j];
                            	SlotChangeColor[playerid][2] = j;
                            	SCC[playerid][2] = i;
                            	InventSlotUse[playerid][j] = true;
						        PlayerTextDrawSetStringf(playerid, ChangeColor_PTD[playerid][25], "%d/7", ItemChangeColor[playerid][2]);
						        PlayerTextDrawColor(playerid, ChangeColor_PTD[playerid][24], ItemChangeColor[playerid][2] >= 7 ? -1 : -1717986817);
						        PlayerTextDrawSetSelectable(playerid, ChangeColor_PTD[playerid][24], ItemChangeColor[playerid][2] >= 7 ? 1 : 0);
						        PlayerTextDrawShow(playerid, ChangeColor_PTD[playerid][24]);
                            	InvSlotUpdate(playerid, i, j);
						    }
						    else if ItemChangeColor[playerid][2] >= 7 *then SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Jus jau idejote dazus.");
						    UpdateColorSlot(playerid);
						}

						return true;
					}
				}

				break;
			}

			if i < 6 && PI[playerid][OpenGunMenu] *then
			{
				if playertextid == UpgradeMenuSlot[playerid][i] *then
				{
					if UpgradeSlot[playerid][i] *then
						UpdateUpgradeSlot(playerid, i, 0, 0);
				}
			}
 		}
	}

	if IsTextDrawVisibleForPlayer(playerid, BoxEat[0]) *then
	{
		if playertextid == BoxEatPlayer[playerid][2] or playertextid == BoxEatPlayer[playerid][5] *then
		{
			new
				Click = playertextid == BoxEatPlayer[playerid][2] ? 2:5, NoClick = Click == 2 ? 5:2;

			PlayerTextDrawColor(playerid, BoxEatPlayer[playerid][Click], 0xA52A2AFF);
			PlayerTextDrawColor(playerid, BoxEatPlayer[playerid][NoClick], 0xC0C0C018);

			ShowPlayerTD(playerid, BoxEatPlayer[playerid][Click]);
			ShowPlayerTD(playerid, BoxEatPlayer[playerid][NoClick]);

			return SetPVarInt(playerid, "SelectBoxEat", Click);
		}
	}

	if !(pTemp[playerid][kladID] == -1) *then
	{
		if playertextid == KladTD[playerid][1] *then
			return pTemp[playerid][kladID] = -1, ShowPlayerKlad(playerid, false);

		for new i, id, count; i < sizeof PrizeKladTD[]; i++ do
		{
			if playertextid == PrizeKladTD[playerid][i][0] *then
			{
				if GetInvSet(playerid) >= PI[playerid][pInvCell] *then
					return SCM(playerid, COLOR_VALIK, !"[Hitch-System]{FFFFFF} Jusu inventorius uzblokuotas arba neturite pakankamai vietos!");

				id = pTemp[playerid][kladPrize][i];
				count = prize_klad[id][1] + random(prize_klad[id][2]);

				pTemp[playerid][kladPrize][i] = 0;

				AddItem(playerid, prize_klad[id][0], count);

				SCMF(playerid, COLOR_YELLOW, "Jus pasiemete priza is lobio:{FFFFFF} %s [kiekis: %d]", ItemsInfo[prize_klad[id][0]][ItemName2], count);

				for new z; z < 5; z++ do
					DestroyPlayerTD(playerid, PrizeKladTD[playerid][i][z]);
                ShowPlayerKlad(playerid, false);
				return true;
			}
		}
	}

	//
	if AuctionData_player[playerid][p_status_open] *then
	{
		if playertextid == AuctionTD[playerid][3] *then
			SelectAuctionType(playerid, 0);

		else if playertextid == AuctionTD[playerid][4] *then
			SelectAuctionType(playerid, 1);

		else if playertextid == AuctionTD[playerid][5] *then
			SelectAuctionType(playerid, 2);

		else if playertextid == AuctionTD[playerid][6] *then
			SelectAuctionType(playerid, 3);

		else if playertextid == AuctionTD[playerid][22] *then
			CloseAuctionTD(playerid);

		else if playertextid == AuctionTD[playerid][24] *then
		{
			if !AuctionData_player[playerid][p_auction_page] *then
				return false;

			AuctionData_player[playerid][p_auction_page]--;

			SelectAuctionType(playerid, AuctionData_player[playerid][p_select_id], AuctionData_player[playerid][p_auction_page]);
		}

		else if playertextid == AuctionTD[playerid][25] *then
		{
			if AuctionData_player[playerid][p_auction_page] >= 5 *then
				return false;

			AuctionData_player[playerid][p_auction_page] ++;

			SelectAuctionType(playerid, AuctionData_player[playerid][p_select_id], AuctionData_player[playerid][p_auction_page]);
		}

		for new i; i < 6; i++ do
		{
			if playertextid == AuctionData_TD[playerid][i][5] *then
				return ShowAuctionDialog(playerid, AuctionData_player[playerid][p_auction_showId][i]);
		}
	}
	//

	if SecondHand_Open{playerid} *then
	{
		if Int_GetPlayerData(playerid, "SecondHandBLOCK") > Global_Time *then
			return SCMF(playerid, COLOR_GREY, "Del netinkamai pasalintu drabuziu kursorius laikinai neveikia. Iki kursoriaus aktyvavimo liko: %d sek.", Int_GetPlayerData(playerid, "SecondHandBLOCK") - Global_Time);

		else if SecondHandTD[playerid][0] == playertextid *then
			return DestroySecondHandTD(playerid);

		for new i; i < 10; i++ do
		{
			if !(playertextid == SecondHandTD_Click[playerid][i]) *then continue;

			switch i do
			{
				case 0..4:
				{
					DestroyPlayerTD(playerid, SecondHandTD_Click[playerid][i]);

					for new z; z < 5; z ++ do
					{
						if IsValidPlayerTextDraw(playerid, SecondHandTD_Click[playerid][z]) && !(_:SecondHandTD_Click[playerid][z] == -1) *then
							return false;
					}

					new id = Int_GetPlayerData(playerid, "SecondIDPICK");
					DestroySecondHandTD(playerid);

					if !SecondHand_Pos[id][secondCreate] *then
						return false;

					SecondHand_Pos[id][secondCreate] = false;
					DestroyDynamicPickup(SecondHand_Pos[id][secondPickup]);
					DestroyDynamic3DTextLabel(SecondHand_Pos[id][secondTextSkin]);

					ApplyAnimationEx(playerid, !"COP_AMBIENT", !"COPBROWSE_IN", 4.1, 0, 0, 0, 0, 0, 1);
					GiveBizMoney(BizEntered[playerid], 50000);

					AddItem(playerid, 1244 + random(6), 1);
					GiveMoney(playerid, -50000, "second-hand - drabuziu gaudymas");

					return SCM(playerid, COLOR_VALIK, !"[Informacija]{FFFFFF} Jus nusipirkote drabuzius is Second-Hand uz 50000$.");
				}

				case 5..9:
				{
					Int_SetPlayerData(playerid, "SecondHandBLOCK", Global_Time + 5);
					SCM(playerid, COLOR_OLDRED, !"Demesio!");
					SCM(playerid, -1, !"Jus pasalinote gerus drabuzius, todel dabar turesite rusiuoti daiktus 5 sekundemis ilgiau.");
					SCM(playerid, COLOR_GREY, !"(kursorius neveiks 5 sekundes, kad pasalintumete likusius drabuzius)");
					return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Informacija", !"{ff0000}Demesio!\n\n{ffffff}Jus pasalinote gerus drabuzius, todel dabar turesite rusiuoti daiktus 5 sekundemis ilgiau.\n{cccccc}(kursorius neveiks 5 sekundes, kad pasalintumete likusius drabuzius)", !"Uzdaryti", !"");
				}
			}

		}
	}

	if Int_GetPlayerData(playerid, "RussianBonus") *then
	{
		if playertextid == BonusTD[playerid][1] *then
			return HideBonus(playerid);

		else if playertextid == BonusTD[playerid][6] *then
			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"Rusiskas standartas", !"{ffffff}Rusiskas standartas - tai galimybe nemokamai gauti unikalu rusiska automobili.\n\n{ffffff}Turite pakviesti {ffff00}12 zaideju {ffffff}(Kad jie nurodytu jusu Nick registracijos metu),\nir kad visi pakviesti zaidejai pasiektu {ffff00}8 lygi{ffffff}.\n\nNoredami pamatyti, kiek zaideju jau pasieke 10 lygi, atidarykite InterFace: \n{ffff00}/mm > Rusiskas Standartas{ffffff}, ten matysite savo progresa.\n\nKai progresas bus 12/12, tada galesite pasirinkti viena is triju automobiliu.\n\n\n{ff0000}Atkreipkite demesi! \n{cccccc}Gauto automobilio negalima parduoti zaidejui ar keistis.\nJi galima parduoti tik valstybei!", !"Uzdaryti", !"");

		else if playertextid == BonusTD[playerid][19] or playertextid == BonusTD[playerid][17] or playertextid == BonusTD[playerid][15] *then
			return TakeBonus(playerid, playertextid);
	}
	else if Int_GetPlayerData(playerid, "AutoDrive") *then
	{
		if playertextid == DriveAutoTD[playerid][8] or playertextid == DriveAutoTD[playerid][9] *then
		{
			new page = Int_GetPlayerData(playerid, "AutoDrive") + (playertextid == DriveAutoTD[playerid][8] ? 1:-1);

			if page < 1 or page > 10 *then return false;

			return ShowCarList(playerid, page);
		}
		else if playertextid == DriveAutoTD[playerid][1] *then
			return HideMenuDrive(playerid);

		else if playertextid == DriveAutoTD[playerid][7] *then
		{
			if !GetPlayerLauncher(playerid) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Noredami pasinaudoti Test-Drive, turite prisijungti su SAG Launcher arba su mobiliaja programa!");

			else if !GetPlayerLicense(playerid, 0) *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida]{FFFFFF} Jus neturite vairuotojo pazymejimo.");

			else if auto_drive_select[playerid] == -1 *then
				return false;

			return AutoDriveRent(playerid, auto_drive_select[playerid] + (8 * (Int_GetPlayerData(playerid, "AutoDrive") - 1)));
		}

		for new i; i < 8; i++ do
		{
			if playertextid == DriveAutoTD_Click[playerid][i] *then
			{
				if !(auto_drive_select[playerid] == -1) *then
					PlayerTextDrawColor(playerid, DriveAutoTD_Click[playerid][auto_drive_select[playerid]], 0xA52A2A59),
					ShowPlayerTD(playerid, DriveAutoTD_Click[playerid][auto_drive_select[playerid]]);

				PlayerTextDrawColor(playerid, DriveAutoTD_Click[playerid][i], 0xA52A2AFF),
				ShowPlayerTD(playerid, DriveAutoTD_Click[playerid][i]);

				return auto_drive_select[playerid] = i;
			}
		}
	}

	if tradeopen{playerid} *then
	{
		if playertextid == TradeTD[playerid][1] *then
		{
			new target = GetDataTrade(playerid, tradePlayer), slot;

			f(global_str, 1024, "{BEA555}Mainai su zaideju %s\n\n{FFFFFF}Jus siulote:", PN(target));

			for new idx; idx < 10; idx++ do
			{
				slot = TradeInfo[playerid][tradeItem][idx];
				if  slot == -1 *then continue;
				f(mysql_string, 128, "\n - %s", ItemsInfo[Inventory[playerid][0][slot]][ItemName2]),
				strcat(global_str, mysql_string);
			}

			strcat(global_str, "\n\n\n\nJums siulo:");

			for new idx; idx < 10; idx++ do
			{
				slot = TradeInfo[target][tradeItem][idx];
				if  slot == -1 *then continue;
				f(mysql_string, 128, "\n - %s", ItemsInfo[Inventory[target][0][slot]][ItemName2]),
				strcat(global_str, mysql_string);
			}

			return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"{BFBBBA}Mainai", global_str, !"Iseiti", !"");
		}
		else if playertextid == TradeTD[playerid][3] *then return HideTrade(playerid, 1);

		else if playertextid == TradeTD[playerid][5] *then
		{
			if !IsPlayerOnline(GetDataTrade(playerid, tradePlayer)) *then return false;

			new target = GetDataTrade(playerid, tradePlayer),
				sender = GetDataTrade(playerid, tradeSendTrade),
				accept_player = GetDataTrade(playerid, tradeAccept),
				accept_target = GetDataTrade(target, tradeAccept),

				sendId_player = GetDataTrade(playerid, tradeSendId),
				sendId_target = GetDataTrade(target, tradeSendId),
				send_player = GetDataTrade(playerid, tradeSEND),
				send_target = GetDataTrade(target, tradeSEND);

			if accept_player == 2 && accept_target == 2 && sender *then
			{
				for new idx, slot[7], item[2]; idx < 10; idx++ do
				{
					slot[0] = TradeInfo[playerid][tradeItem][idx];
					slot[1] = TradeInfo[target][tradeItem][idx];
					slot[2] = TradeInfo[target][tradeItemNashivka][idx];
					slot[3] = TradeInfo[target][tradeItemNashivkaLevel][idx];
					slot[4] = TradeInfo[playerid][tradeItemNashivkaLevel][idx];
					slot[5] = TradeInfo[playerid][tradeItemNashivkaLevel][idx];
					slot[6] = TradeInfo[playerid][tradeItemColor][idx];

					if !(slot[0] == -1) *then
						item[0] = Inventory[playerid][0][slot[0]],
						AddItem(target, item[0], TradeInfo[playerid][tradeItemCount][idx], Inventory[playerid][2][slot[0]], Inventory[playerid][3][slot[0]], Inventory[playerid][4][slot[4]], Inventory[playerid][5][slot[5]], 0, 0, slot[6]),
						ClearItem(playerid, slot[0], TradeInfo[playerid][tradeItemCount][idx]),
						amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> inventoriaus daikta %s (id:%d) kiekyje %d", 4, PN(playerid), PN(target), PN(playerid), PN(playerid), PN(target), PN(target), ItemsInfo[item[0]][ItemName2], item[0], TradeInfo[playerid][tradeItemCount][idx]);

					if !(slot[1] == -1) *then
						item[1] = Inventory[target][0][slot[1]],
						AddItem(playerid, item[1], TradeInfo[target][tradeItemCount][idx], Inventory[target][2][slot[1]], Inventory[target][3][slot[1]], Inventory[target][4][slot[2]], Inventory[target][5][slot[2]], 0, 0, slot[6]),
						ClearItem(target, slot[1], TradeInfo[target][tradeItemCount][idx]),
						amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> inventoriaus daikta %s (id:%d) kiekyje %d", 4, PN(playerid), PN(target), PN(target), PN(target), PN(playerid), PN(playerid), ItemsInfo[item[1]][ItemName2], item[1], TradeInfo[target][tradeItemCount][idx]);
				}

				if send_player *then
				{
					switch sendId_player do
					{
						case 0:
						{
							if PI[playerid][pMoney] >= send_player *then
								GiveMoney(target, send_player, "pinigu perdavimas per mainus"),
								GiveMoney(playerid, -send_player, "pinigu perdavimas per mainus");
						}

						case 1:
						{
							if send_player <= GetCount(playerid, 615) *then
							{
								AddItem(target, 615, send_player);
								DeleteItem(playerid, 615, send_player);

								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> EURO kiekyje %d", 4, PN(playerid), PN(target), PN(playerid), PN(playerid), PN(target), PN(target), send_player);
							}
						}

						case 2:
						{
							if send_player <= GetCount(playerid, 1461) *then
							{
								AddItem(target, 1461, send_player);
								DeleteItem(playerid, 1461, send_player);

								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> BTC kiekyje %d", 4, PN(playerid), PN(target), PN(playerid), PN(playerid), PN(target), PN(target), send_player);
							}
						}
					}
				}

				if send_target *then
				{
					switch sendId_target do
					{

						case 0:
						{
							if send_target <= PI[target][pMoney] *then
								GiveMoney(playerid, send_target, "pinigu perdavimas per mainus"),
								GiveMoney(target, -send_target, "pinigu perdavimas per mainus");
						}

						case 1:
						{
							if send_target <= GetCount(target, 615) *then
							{
								AddItem(playerid, 615, send_target);
								DeleteItem(target, 615, send_target);

								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> EURO kiekyje %d", 4, PN(playerid), PN(target), PN(target), PN(target), PN(playerid), PN(playerid), send_target);
							}
						}

						case 2:
						{
							if send_target <= GetCount(target, 1461) *then
							{
								AddItem(playerid, 1461, send_target);
								DeleteItem(target, 1461, send_target);

								amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> perdave <a href=../pages/user?name=%s>%s</a> BTC kiekyje %d", 4, PN(playerid), PN(target), PN(target), PN(target), PN(playerid), PN(playerid), send_target);
							}
						}
					}
				}

				HideTrade(playerid), HideTrade(target);
				ClearTrade(playerid), ClearTrade(target);
				CancelSelectTextDraw(playerid), CancelSelectTextDraw(target);

				SCM(target, COLOR_GREEN, !"Sandoris sekmingai ivykdytas!");
				return SCM(playerid, COLOR_GREEN, !"Sandoris sekmingai ivykdytas!");
			}
			else if accept_player or accept_target *then
				return SetDataTrade(playerid, tradeAccept, 2),
					SCM(target, COLOR_GREY, !"Zaidejas patvirtino sandori!"),
					SCM(playerid, COLOR_GREY, !"Jus patvirtinote sandori!"),
					SPD(playerid, 0, DIALOG_STYLE_MSGBOX, !"{ff0000}Ispejimas!", !"{ffffff}Pries patvirtindami sandori, rekomenduojame viska kruopsciai patikrinti.", !"Uzdaryti", !"");

			PlayerTextDrawSetString(playerid, TradeTD[playerid][4], ( !accept_player ? (PI[playerid][pLanguage] ? FixText("MAINAI"):"TRADE"):(PI[playerid][pLanguage] ? FixText("PRIIMTI"):"ACCEPT")) );
			PlayerTextDrawColor(playerid, TradeTD[playerid][5], !accept_player ? 0x68BE55FF:0xAAAAAAFF), ShowPlayerTD(playerid, TradeTD[playerid][5]);

			return TradeInfo[playerid][tradeAccept] = !TradeInfo[playerid][tradeAccept];
		}
		else if playertextid == TradeTD[playerid][15] *then
		{
		    if(PI[playerid][pLevel] < 10) return SCM(playerid, COLOR_GREY, "[Klaida] Noredami perduoti daikta/pinigus kitam zaidejui, jums reikia 10 lygio!");
		    if !TradeInfo[playerid][tradeAccept] *then
				return SPDF(playerid, 8257, DIALOG_STYLE_TABLIST_HEADERS, !"Prekyba", "{FFFFFF}Valiuta\t{73B461}Balansas\t{cccccc}Komisija (su WARN)\nIveskite suma, valiutoje $$$$\t{73B461}$%d\t{cccccc}6% (10%)\nIveskite suma, EURO valiutoje\t{73B461}%d EURO\t{cccccc}3% (5%)\nIveskite suma, BTC valiutoje\t{73B461}%d BTC\t{cccccc}0% (0%)", !"Isrinkti", !"Atsaukti", PI[playerid][pMoney], GetCount(playerid, 615), GetCount(playerid, 1461));
			else
   				return false;
		}

		for new i; i < 20; i++ do
		{
			if playertextid == KletkaTrade[playerid][i] *then
			{
				new slot;
				switch i do
				{
					case 0..9:
					{
						if !IsPlayerOnline(GetDataTrade(playerid, tradePlayer)) or GetDataTrade(GetDataTrade(playerid, tradePlayer), tradeAccept) or GetDataTrade(playerid, tradeAccept) *then return false;

						slot = TradeInfo[playerid][tradeItem][i];
						if slot == -1 *then return false;

						InventSlotUse[playerid][slot] = false;

						InvSlotUpdate(playerid, GetInvID(playerid, slot, 1), slot);

						TradeInfo[playerid][tradeItem][i] =
						TradeInfo[playerid][tradeItemNashivka][i] =
						TradeInfo[playerid][tradeItemNashivkaLevel][i] =
						TradeInfo[playerid][tradeItemColor][i] =
						TradeInfo[playerid][tradeItemCount][i] = -1;

						return UpdateTradeSlot(playerid, i, 0, 0, 0);
					}
					case 10..19:
					{
						new target = GetDataTrade(playerid, tradePlayer);
						slot = TradeInfo[target][tradeItem][i-10];
						new item = Inventory[target][0][slot];


						if !IsAAks(item) *then return
							GetItemInfo(playerid, item);

						f(global_str, sizeof global_str, "{FFFFFF}%s\n\
      					%s\n\n\
						{FFFFFF}Charakteristikos:\n\
						- Spalva: %s{FFFFFF}\n\
						- Tobulinimai: {FDCF28}%d/13\n\
						{FFFFFF} - Tvirtumas: {73B461}%d/100\n\n\
						{FFFFFF}* Tobulinant padideja kritinio smugio tikimybe", ItemsInfo[item][ItemName], GetItemStory(playerid, item), GetItemColorName(item), Inventory[target][2][slot], Inventory[target][3][slot]);

						SPD(playerid, 0, 0, !"Informacija apie daikta", global_str, !"Isejimas", !"");
						return PlayerPlaySound(playerid, 6801, 0.0, 0.0, 0.0);
					}
				}
			}
		}
	}

	if playertextid == InvBorderTD[playerid][9] *then CancelSelectTextDraw(playerid);
	else if GetInventoryType(playerid, E_INVENTORY_TYPE_PLAYER) *then
	{
		if playertextid == InvBorderTD[playerid][1] *then
		{
			if Int_GetPlayerData(playerid, "CortTimer") > Global_Time *then return false;
			if !(Lavka[playerid] == -1) *then
				return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Nuomodami suoleli negalite rusiuoti prekiu.");

			for new s; s < PI[playerid][pInvCell]; s++ do
			{
				for(new j; j < PI[playerid][pInvCell]; j++)
				{
					if Inventory[playerid][0][j] > Inventory[playerid][0][s] && Inventory[playerid][0][s] *then
						ChangeItemPos(playerid, s, j);
					else if Inventory[playerid][0][s] && !Inventory[playerid][0][j] *then
						ChangeItemPos(playerid, s, j);
				}
			}

			for new s; s < PI[playerid][pInvCell]; s++ do
			{
				if Inventory[playerid][0][s] == 313 *then
					ChangeItemPos(playerid, 0, s);
			}

			SelectPage(playerid, PI[playerid][pInvPage]);
			SetPVarInt(playerid, "CortTimer", Global_Time+5);
		}
		else if playertextid == InvBorderTD[playerid][3] *then
		{
            SPD(playerid, 7655, DIALOG_STYLE_MSGBOX, !"{BFBBBA}Spalvos keitimas", !"{FFFFFF}Ijungete pagrindines inventoriaus spalvos redaktoriu!\nNoredami pakeisti spalva, naudokite {FFBD3F}RODYKLES{FFFFFF} savo klaviaturoje\nJei norite issaugoti pakeitimus, paspauskite '{FFBD3F}F{FFFFFF}' arba '{FFBD3F}ENTER{FFFFFF}'", !"Isejimas", !"");
			PlayerTextDrawColor(playerid, InvBorderTD[playerid][3], PI[playerid][pColorInv]);
			PlayerTextDrawBackgroundColor(playerid, InvBorderTD[playerid][3], PI[playerid][pColorInv]);
			ShowPlayerTD(playerid, InvBorderTD[playerid][3]);

			InventoryUpdate[playerid] = 2;
			InvUpdateTimer[playerid] = CallTimeOutFunction("InventoryUpdateKeys", 125, true, "dd", playerid, 2);

			return TogglePlayerControllable(playerid, false);
		}
		else if playertextid == InvBorderTD[playerid][5] *then
		{
		    SPD(playerid, 7655, DIALOG_STYLE_MSGBOX, !"{BFBBBA}Pozicijos keitimas", !"{FFFFFF}Ijungete inventoriaus pozicijos redaktoriu!\nNoredami pakeisti pozicija, naudokite {FFBD3F}RODYKLES{FFFFFF} savo klaviaturoje\nLaikykite nuspaude '{FFBD3F}ALT{FFFFFF}', kad judetu leciau, arba '{FFBD3F}SHIFT{FFFFFF}', kad greiciau\nJei norite issaugoti pakeitimus, paspauskite '{FFBD3F}F{FFFFFF}' arba '{FFBD3F}ENTER{FFFFFF}'", !"Isejimas", !"");
			PlayerTextDrawColor(playerid, InvBorderTD[playerid][5], PI[playerid][pColorInv]);
			PlayerTextDrawBackgroundColor(playerid, InvBorderTD[playerid][5], PI[playerid][pColorInv]);
			ShowPlayerTD(playerid, InvBorderTD[playerid][5]);

			InventoryUpdate[playerid] = 1;
			InvUpdateTimer[playerid] = CallTimeOutFunction("InventoryUpdateKeys", 125, true, "dd", playerid, 1);

			return TogglePlayerControllable(playerid, false);
		}
		else if playertextid == InvBorderTD[playerid][7] *then
		{
		    SPD(playerid, 7655, DIALOG_STYLE_MSGBOX, !"{BFBBBA}Dydzio keitimas", !"{FFFFFF}Ijungete inventoriaus dydzio redaktoriu!\nNoredami pakeisti dydi, naudokite {FFBD3F}RODYKLES{FFFFFF} savo klaviaturoje\nLaikykite nuspaude '{FFBD3F}ALT{FFFFFF}', kad keistumete dydi leciau, arba '{FFBD3F}SHIFT{FFFFFF}', kad greiciau\nJei norite issaugoti pakeitimus, paspauskite '{FFBD3F}F{FFFFFF}' arba '{FFBD3F}ENTER{FFFFFF}'", !"Isejimas", !"");
			PlayerTextDrawColor(playerid, InvBorderTD[playerid][7], PI[playerid][pColorInv]);
			PlayerTextDrawBackgroundColor(playerid, InvBorderTD[playerid][7], PI[playerid][pColorInv]);
			ShowPlayerTD(playerid, InvBorderTD[playerid][7]);

			InventoryUpdate[playerid] = 3;
			InvUpdateTimer[playerid] = CallTimeOutFunction("InventoryUpdateKeys", 125, true, "dd", playerid, 3);

			return TogglePlayerControllable(playerid, false);
		}
	}
	//
	if( Int_GetPlayerData(playerid, "QuickPanel") || InventoryOpen{playerid} || donateopen{playerid} || tradeopen{playerid} || Int_GetPlayerData(playerid, "OtherInventOpen") || craftopen{playerid} || Int_GetPlayerData(playerid,"BoomOPEN"))
	{
		for new i; i < 94; i++ do
		{
			if i < 20 *then
			{
				if playertextid == QuickPanel[playerid][i] *then
				{
					switch i do
					{
						case 8: return ShowQuickDialog(playerid, -1);
						case 0..7:
						{
							new
								int = Int_GetPlayerData(playerid, "QuickSelectLobby"),
									id = GetSlotQuick(playerid, i),
										targetid = QuickPlayer[playerid];

							if int == i *then
							{
								if id == -1 *then return SCM(playerid, -1, "Turite nustatymuose nurodyti veiksma siam langeliui");
								else
								{
									if targetid == INVALID_PLAYER_ID *then return false;
									switch id do
									{
										case 0: callcmd::hi(playerid, IntToStr(targetid));
										//case 1: callcmd::trade(playerid, IntToStr(targetid));
										case 2: return SPD(playerid, 21004, DIALOG_STYLE_INPUT, !"{FFFFFF}Pastaba | {ae433d}Pasnibzdeti", !"{FFFFFF}\nIveskite teksta, kuri norite pasnibzdeti zaidejui\n\n", !"»", !"x");
										case 3: SPD(playerid, 400, DIALOG_STYLE_LIST, !"Isrinkite dokumento tipa", !"[1] Pasas\n[2] Licencijos\n[3] Asmens tapatybes kortele\n[4] Medicinine kortele", !"Isrinkti", !"Uzdaryti");
										case 4: callcmd::showskill(playerid, IntToStr(targetid));
										case 5: callcmd::showcarskill(playerid, IntToStr(targetid));
										case 6: callcmd::kiss(playerid, IntToStr(targetid));
										case 7: return SPD(playerid, 21004, DIALOG_STYLE_INPUT, !"{FFFFFF}Pastaba | {ae433d}Parodyti verslo statistika", !"{FFFFFF}\nIveskite verslo ID:\n\n", !"»", !"x");
									}
									return HideQuickPanel(playerid);
								}
							}
							SetPVarInt(playerid, "QuickSelectLobby", i);
							PlayerTextDrawSetString(playerid, QuickPanel[playerid][8], id == -1 ? "Set value":QuickName[id]);
						}
					}
					break;
				}
			}

			if( i < 11)
			{
				if(playertextid == CraftColor[playerid][i])
				{
					for(new q; q < 11; q++) DestroyPlayerTD(playerid, CraftColor[playerid][q]);
					new color;
					switch(i)
					{
						case 1: color =0xCC2426FF;
						case 2: color =0xCC7824FF;
						case 3: color =0xE6BC1EFF;
						case 4: color =0xD5D73CFF;
						case 5: color =0x3CD740FF;
						case 6: color =0x3CD7D7FF;
						case 7: color =0x3C3ED7FF;
						case 8: color =0xD73CD4FF;
						case 9: color =0xD73C7EFF;
					}
					CraftSuper[playerid][1] = CreatePlayerTextDraw(playerid, 334.000000, 232.079178, "LD_SPAC:white");
					PlayerTextDrawLetterSize(playerid, CraftSuper[playerid][1], 0.480000, 1.120000);
					PlayerTextDrawTextSize(playerid, CraftSuper[playerid][1], 37.000000, 15.145828);
					PlayerTextDrawAlignment(playerid, CraftSuper[playerid][1], 1);
					PlayerTextDrawColor(playerid, CraftSuper[playerid][1], 0x1C1F21FF);
					PlayerTextDrawUseBox(playerid, CraftSuper[playerid][1], 0);
					PlayerTextDrawBoxColor(playerid, CraftSuper[playerid][1], 0xFFFFFFFF80808080);
					PlayerTextDrawSetShadow(playerid, CraftSuper[playerid][1], 2);
					PlayerTextDrawSetOutline(playerid, CraftSuper[playerid][1], 0);
					PlayerTextDrawBackgroundColor(playerid, CraftSuper[playerid][1], 0x000000FF);
					PlayerTextDrawFont(playerid, CraftSuper[playerid][1], 4);
					PlayerTextDrawSetProportional(playerid, CraftSuper[playerid][1], 1);
					PlayerTextDrawSetSelectable(playerid, CraftSuper[playerid][1], 1);

					CraftSuper[playerid][0] = CreatePlayerTextDraw(playerid, 352.500000, 236.477921, "VIBRATb CVET");
					PlayerTextDrawLetterSize(playerid, CraftSuper[playerid][0], 0.107949, 0.634835);
					PlayerTextDrawTextSize(playerid, CraftSuper[playerid][0], 1280.000000, 1280.000000);
					PlayerTextDrawAlignment(playerid, CraftSuper[playerid][0], 2);
					PlayerTextDrawColor(playerid, CraftSuper[playerid][0], 0xFFFFFFFFFFFFFFFF);
					PlayerTextDrawUseBox(playerid, CraftSuper[playerid][0], 0);
					PlayerTextDrawBoxColor(playerid, CraftSuper[playerid][0], 0xFFFFFFFF80808080);
					PlayerTextDrawSetShadow(playerid, CraftSuper[playerid][0], 0);
					PlayerTextDrawSetOutline(playerid, CraftSuper[playerid][0], 0);
					PlayerTextDrawBackgroundColor(playerid, CraftSuper[playerid][0], 0x00000000);
					PlayerTextDrawFont(playerid, CraftSuper[playerid][0], 2);
					PlayerTextDrawSetProportional(playerid, CraftSuper[playerid][0], 1);
					PlayerTextDrawSetSelectable(playerid, CraftSuper[playerid][0], 0);

					DestroyPlayerTD(playerid, CraftColor[playerid][11]);
					CraftColor[playerid][11] = CreatePlayerTextDraw(playerid, 289.174988, 203.850006, "usebox");
					PlayerTextDrawLetterSize(playerid, CraftColor[playerid][11], 0.000000, 0.185949);
					PlayerTextDrawTextSize(playerid, CraftColor[playerid][11], 282.390625, 0.000000);
					PlayerTextDrawAlignment(playerid, CraftColor[playerid][11], 1);
					PlayerTextDrawColor(playerid, CraftColor[playerid][11], 0xFFFFFFFFE1E1E1FF);
					PlayerTextDrawUseBox(playerid, CraftColor[playerid][11], 1);
					PlayerTextDrawBoxColor(playerid, CraftColor[playerid][11], color);
					PlayerTextDrawSetShadow(playerid, CraftColor[playerid][11], 2);
					PlayerTextDrawSetOutline(playerid, CraftColor[playerid][11], 0);
					PlayerTextDrawBackgroundColor(playerid, CraftColor[playerid][11], 0x000000FF);
					PlayerTextDrawFont(playerid, CraftColor[playerid][11], 0);
					PlayerTextDrawSetProportional(playerid, CraftColor[playerid][11], 1);
					PlayerTextDrawSetSelectable(playerid, CraftColor[playerid][11], 0);

					ShowPlayerTD(playerid, CraftColor[playerid][11]);
					ShowPlayerTD(playerid, CraftSuper[playerid][1]);
					ShowPlayerTD(playerid, CraftSuper[playerid][0]);
					SetPVarInt(playerid, "CraftColor", i);
					break;
				}
			}
			if( i < 37)
			{
				if(playertextid == CraftSuper[playerid][i])
				{
					switch(i)
					{
						case 1:{
						if(!CraftInfo[Int_GetPlayerData(playerid, "CraftSelect")][craftColor][0]) return SCM(playerid, COLOR_GREY, "Sio aksesuaro spalvos pasirinkimas laikinai nepasiekiamas.");
						AddSelectCraftColor(playerid);
						}
						case 25:
						{
							if(Int_GetPlayerData(playerid, "CraftPage") == 5) return 0;
							SetPVarInt(playerid, "CraftPage", Int_GetPlayerData(playerid, "CraftPage")+1);
							UpdateMenuCraft(playerid);
						}
						case 27:
						{
							if(Int_GetPlayerData(playerid, "CraftPage") == 1) return 0;
							SetPVarInt(playerid, "CraftPage", Int_GetPlayerData(playerid, "CraftPage")-1);
							UpdateMenuCraft(playerid);
						}
						case 29..33:
						{
							switch(i)
							{
								case 33: global_str = "Accessory";
								case 32: global_str = "Clothes";
								case 31: global_str = "Chemistry";
								case 30: global_str = "Working";
								case 29: global_str = "Phone";
							}
							SetPVarString(playerid, "CraftType", global_str);
							UpdateMenuCraft(playerid);
						}
						case 3: return DelCraft(playerid);
						case 8:
						{
							if(Int_GetPlayerData(playerid, "CraftScore") == 10) return 0;
							SetPVarInt(playerid, "CraftScore", Int_GetPlayerData(playerid, "CraftScore")+1);
							UpdateCraftCounts(playerid);
							SetInfoCraftPlayer(playerid);
							return 1;
						}
						case 9: SPD(playerid, 3771, DIALOG_STYLE_INPUT, !"", !"{FFFFFF}Iveskite kieki, kuri norite pagaminti", !"Isrinkti", !"Atsaukti");
						case 11:
						{
							if(Int_GetPlayerData(playerid, "CraftScore") == 1) return 0;
							SetPVarInt(playerid, "CraftScore", Int_GetPlayerData(playerid, "CraftScore")-1);
							UpdateCraftCounts(playerid);
							SetInfoCraftPlayer(playerid);
							return 1;
						}
					}
				}
				if(i < 5)
				{
					if(playertextid == CraftNeedTD[playerid][i])
					{
						if(!CraftInfo[Int_GetPlayerData(playerid, "CraftSelect")][craftNeed][i]) return 1;
						GetItemInfo(playerid, CraftInfo[Int_GetPlayerData(playerid, "CraftSelect")][craftNeed][i]);
						break;
					}
				}
			}
			if(playertextid == DonateBox[playerid][i] && donateopen{playerid})
			{
				if !donateopen{playerid} *then {
					SAMF(COLOR_OLDRED, "<Warning> {FFFFFF}Zaidejas %s(%d) bande atidaryti Donate is inventoriaus, kai Donate buvo uzdarytas.", PlayerName[playerid], playerid);
					return 1;
				}
				switch i do
				{
					case 2:	SPD(playerid, 913, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}Nuimti {6bc02e}WARN\n{FFFFFF}Kaina: {6bc02e}10 {FFFFFF}SAG-Euru\n\nPirkdami pasalinate 1 WARN is savo personazo.\nPaspauskite {6bc02e}Enter {FFFFFF}noredami isigyti.", !"Mainai", !"Atsaukti");
					case 6: SPD(playerid, 912, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}Pakeisti {6bc02e}Nick\n{FFFFFF}Kaina: {6bc02e}5000 {FFFFFF}SAG-Coins\n\nSuteikia galimybe pakeisti jusu personazo Nick.\nPaspauskite {6bc02e}Enter {FFFFFF}noredami isigyti.", !"Mainai", !"Atsaukti");
					case 14:
					{
					    CloseDonateMenu(playerid);

					    return SPD(playerid, 9502, DIALOG_STYLE_TABLIST, !"", !"\
						{FFFF00}10.000 craft skill\t{FAAC58}5000 SAG-Coins\n\
						{FFFF00}Nusipirkti galandimo amuleta\t{FAAC58}60 SAG-Coins\n\
						{FFFFFF}Iseiti is Juodojo saraso \t{FAAC58}275 SAG-Coins\n\
						{FFFFFF}Maks. ukininko igudis\t{FAAC58}850 SAG-Coins\n\
						{FFFFFF}Maks. taksisto igudis\t{FAAC58}800 SAG-Coins\n\
						{FFFFFF}Maks. maisto pristatymo igudis\t{FAAC58}950 SAG-Coins\n\
						{FFFFFF}Maks. sunkvezimio vairuotojo igudis\t{FAAC58}1500 SAG-Coins\n\
						{FFFFFF}Maks. advokato igudis\t{FAAC58}8000 SAG-Coins\n\
						{FFFFFF}Maks. lakuno igudis\t{FAAC58}5800 SAG-Coins\n\
						{FFFFFF}Maks. motociklininko igudis\t{FAAC58}800 SAG-Coins\n\
						{FFFFFF}Maks. dviratininko igudis\t{FAAC58}2000 SAG-Coins\n\
						{FFFF00}Galimybe tureti 2 ukius\t{FAAC58}5000 SAG-Coins\n\
						{FFFFFF}Karine kortele\t{FAAC58}50 SAG-Coins\n\
						{FFFFFF}+1 teisetvarka\t{FAAC58}3 SAG-Coins\n\
						{FFFFFF}Visi kovos igudziai\t{FAAC58}300 SAG-Coins\n\
						{FFFFFF}Maksimalus jegos lygis\t{FAAC58}5500 SAG-Coins\n\
						{FFFFFF}Atsikratyti narkomanijos\t{FAAC58}300 SAG-Coins\n\
						{FFFFFF}Nustatyti automobilio rida is naujo\t{FAAC58}500 SAG-Coins\n\
						{FF332C}Iseiti is kalejimo\t{FFFFFF}400 SAG-Coins\n\
						{FFF52B}Unikalus sokis 'Fortnite'\t{FFFFFF}550 SAG-Coins\n\
						{FFF52B}Unikalus sokis 'Gangnam Style'\t{FFFFFF}550 SAG-Coins\n\
						{FFF52B}Unikalus sokis 'Kaubojus'\t{FFFFFF}550 SAG-Coins\n\
						{FFF52B}Pasveikti nuo koronaviruso\t{FFFFFF}350 SAG-Coins", !"Isrinkti", !"Atsaukti");
					}
					case 16: SPD(playerid, 903, DIALOG_STYLE_MSGBOX, !"", (str_f("{FFFFFF}2-3 skaitmenu {6bc02e}telefono numeris\n{FFFFFF}Kaina: {6bc02e}2500 {FFFFFF}SAG-Coins\n\nSuteikia galimybe tureti atsitiktini 2 arba 3\nskaitmenu telefono numeri bet kuriems telefonams.\n\n{FFFF00}Laisvu numeriu liko: %d vnt.\n\n{FFFFFF}Paspauskite {6bc02e}Enter {FFFFFF}noredami isigyti.", AmountNumbers)), "Mainai", "Atsaukti");
					case 18: SPD(playerid, 8999, DIALOG_STYLE_MSGBOX, !"", !"{FFFFFF}Patobulinimas: {6BC02E}Titan VIP{FFFFFF}\nKaina: {6BC02E}3000{FFFFFF} SAG-Coins\n\n{FFB252}Privilegijos Titan statuso{FFFFFF}\n1)Kiekviena PayDay gaunate po 2 SAG-Coins (donat taskai){FFFFFF}\n2)Galimybes visu VIP [/help - papildymai VIP]\n3)VIP Chatas (Visiems serverio turtuoliams) (/vr)\n4)VIP statuso nereikia pratesti {FFE741}Neribotas galiojimo laikas{FFFFFF} )\n5)Didesne indelio procentine dalis banke.\n6)Banke galima laikyti daugiau nei 40 milijonu.\n7)3 reputacijos taskai seimai kiekviena PayDay\n8)Galimybe tureti 4 automobilius, 5 jei turite nama ar viesbuti.\n9)Jus neprarandate narkotiku pateke i ligonine\n10)Prieiga prie komandos /out (Iseiti is organizacijos savo noru) \n\nPaspauskite {6BC02E}Enter{FFFFFF} noredami isigyti.", !"Mainai", !"Atsaukti");
					case 33: SPD(playerid, 15331, DIALOG_STYLE_MSGBOX, !"Prekes patvirtinimas", "{ffffff}VIP-Paskyros papildymas.\nKaina menesiui: {6BC02E}777{FFFFFF} SAG-Euru.\n\nTai ne kieicia VIP-Paskyros, o prideda ja.\nIsigijus isduodamas papildymo daiktas.\nNoredami ji aktyvuoti, turiti ji naudoti per inventoriu.\nPries aktyvacija daikta galima pardavineti/perdavineti/supirkineti.\nPo aktyvavimo papildymas galio lygiai 1 menesi.\n\n\n{ffff00}Papildymo privilegijos:{cccccc}\n1. Jums nereikia maisto.\n2. Nera KD ant report.\n3. Nemokamas skelbimu siuntimas ziniasklaidai (nemokamai kas 30 minuciu).\n4. Nemokami skambuciai ir SMS.\n5. Nemokama suolelio nuoma Centrineje Rinkoje.\n6. Nemokamas iejimas i casino ir barus.\n7. Visur perpus mazesnis mokestis uz lesu pervedima ir perdavima.\n8. Daiktu patobulinimo tikimybe dvigubai didesne.\n9. Kiekviena PayDay gausite po 6 SAG-Coins.\n10. Per 30 minuciu, dirbant ant naftos greziniu, galima pervezti 26 statines.\n11. Per /pay galima perdavineti suma iki 1 000.000$.\n12. Gydymas ligonineje vyksta 5 kartu greiciau.\n13. Jus neprarandate ginklus atsirasdami ligonineje.\n14. Kaukes veikimo laikas padidintas 10 minuciu.\n15. Apiplesus armija, gausite 4 ingredientus vietoj 2.\n16. Atsiranda galimybe gauti platinumo rulete naudojant skrynias.\n17. Naudojant antibiotikus, narkotiku priklausomybe sumazinama 10 vienetais daugiau.\n18. 6 reputacijos taskai jusu seimai kiekviena PayDay.\n19. Isilauzus i automobili naudojant /breakcar, lauztuvas nesulus.\n20. Padideja galimybe gauti kalejimo spyna atliekant uzduotis MSK.\n21. Dezes su ruletemis laikas sumazintas iki 60 minuciu.\n22. Atliekant seimos uzduotis bus isduodama dvigubai daugiau seimos kuponu.\n23. Galima ikrauti iki 5 automobiliu.\n24. Mokescius galima sumoketi be 40 minuciu zaidimo.\n25. Laikas, skirtas isigyti dezute Concept Car Luxury, sumazintas iki 2 dezuciu per 10 sekundziu.\n26. Galite ieiti bet kur, budami nevakcinuoti.\n27. Nera bendro VIP Chat laiko limito.\n28. Galimybe moketi mokescius naudojantis Online-Bankininkyste telefone.\n29. Iejus i zaidima galima pasirinkti spawno vieta / paskutine isejimo vieta.\n\n\n{00ff00}Aktyvavus papildyma gausite 10 skirtingu automobiliu dezuciu.", "Nusipirkti", "Uzdaryti");
