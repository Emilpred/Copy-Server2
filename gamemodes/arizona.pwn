				case 2: SPD(playerid, 8247, DIALOG_STYLE_INPUT, !"{BFBBBA}Spinta > Nuimti", !"{FFFFFF}Iveskite kieki, kuri norite nuimti", !"Isrinkti", !"Atsaukti");			}
