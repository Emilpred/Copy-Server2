public OnEnterExitModShop(playerid, enterexit, interiorid)
{
	new
		vehicleid = GetPlayerVehicleID(playerid),
		model = GetVehicleModel(vehicleid) - 400;
	if model < 0 || model > 211 *then
		return 1;

	if interiorid > 0 && strcmp(CarsInfo[model][csCategory], "Lowriders", true) == 0 *then
		SCM(playerid, 0xFF0000FF, !"Demesio! Siuo metu sios rusies transporto priemones negalima tuninguoti");

	return 1;
}
