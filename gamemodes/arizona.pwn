	        if(IsPlayerInRangeOfPoint(playerid, 1.0, InfoTSRPos[i][0], InfoTSRPos[i][1], InfoTSRPos[i][2]))
	        {
	            if(JailTSR[playerid] != -1) return SPD(playerid, 9938, DIALOG_STYLE_LIST, !"", !"{FFFFFF}1. Kur as?\n{FFFFFF}2. Kaip man is cia iseiti?\n{FFFFFF}3. Kokius {34eb40}pataisos{FFFFFF} darbus turiu atlikti?\n{FFFFFF}4. Uz ka galiu gauti ilgesni bausmes laika?\n{FFFFFF}5. Kaip iseiti {34eb40}anksciau laiko?", !"Isrinkti", !"Atsaukti");
			}
		}
	    for(new i; i < countPickups; i++)
		{
		    new idios = 2;
	    	if(JailTm[i][typeff] == 3 || JailTm[i][typeff] == 4) idios = 1;
		    if(IsPlayerInRangeOfPoint(playerid, idios, JailTm[i][Xpick], JailTm[i][Ypick], JailTm[i][Zpick]))
			{
		        switch(JailTm[i][typeff])
				{
			        case 0:
					{
				        if(JailTSR[playerid] != -1 && !itemtake[playerid][0] && !itemtake[playerid][1] && !itemtake[playerid][2] && !IsPlayerInAnyVehicle(playerid))
						{
						    if(!mewoktake{playerid}) {
								CarryAnim(playerid);
								mewoktake{playerid} = true;
								SetPlayerAttachedObjectEx(playerid, 6, 1220, 5, 0.022999, 0.139999, 0.184000, -82.300048, 0.000000, 9.900000, 0.601000, 0.708999, 0.437000);
								SetPlayerChatBubble(playerid, !"Paeme deze", COLOR_PURPLE, 10.0, 5000);
								GameTextForPlayer(playerid, !"go to stock", 0, 1);
							}
							else {
							    mewoktake{playerid} = false;
						    	RemovePlayerAttachedObject(playerid, 6);
						    	ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
						    	SetPlayerChatBubble(playerid, !"Padejo deze", COLOR_PURPLE, 10.0, 5000);
						    	SCM(playerid, COLOR_VALIK, !"[Uzuomina] {FFFFFF}Jus grazinote deze i savo vieta.");
							}
						}
					}
					case 1:
					{
					    if(!mewoktake{playerid} && JailTSR[playerid] != -1) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite dezes rankose!");
					    if(JailTSR[playerid] != -1 && !itemtake[playerid][0] && !itemtake[playerid][1] && mewoktake{playerid} && !itemtake[playerid][2] && !IsPlayerInAnyVehicle(playerid)) {
						    if(Mewki[playerid] != 0) Mewki[playerid]--;
						    ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
						    mewoktake{playerid} = false;
						    RemovePlayerAttachedObject(playerid, 6);
						    SetPlayerChatBubble(playerid, !"Padejo dezes", COLOR_PURPLE, 10.0, 5000);
						    GameTextForPlayer(playerid, !"successful", 0, 1);
						}
					}
					case 2:
					{
					    if(!itemtake[playerid][0] && JailTSR[playerid] != -1) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite siuksliu rankose!");
					    if(JailTSR[playerid] != -1 && itemtake[playerid][0] && !itemtake[playerid][1] && !mewoktake{playerid} && !itemtake[playerid][2] && !IsPlayerInAnyVehicle(playerid)) {
						    if(Trashs[playerid] != 0) Trashs[playerid]--;
						    itemtake[playerid][0] = false;
						    RemovePlayerAttachedObject(playerid, 6);
						    GameTextForPlayer(playerid, !"successful", 0, 1);
						    SetPlayerChatBubble(playerid, !"Ismete siuksles", COLOR_PURPLE, 10.0, 5000);
						    ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
						}
					}
					case 3:
					{
					    if(JailTSR[playerid] != -1 && !itemtake[playerid][1] && !mewoktake{playerid} && !itemtake[playerid][0] && itemtake[playerid][2] && !IsPlayerInAnyVehicle(playerid)) {
			                ApplyAnimationEx(playerid, "CARRY", "PUTDWN", 4.1, 0, 1, 1, 0, 0, 1);
			                if(clothes[playerid] != 0) clothes[playerid] --;
			                RemovePlayerAttachedObject(playerid, 6);
						    itemtake[playerid][2] = false;
						    SetPlayerChatBubble(playerid, !"Padejo svarius drabuzius", COLOR_PURPLE, 10.0, 5000);
						    GameTextForPlayer(playerid, !"successful", 0, 1);
						    return 1;
						}
						if(!itemtake[playerid][2] && JailTSR[playerid] != -1) SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite svariu drabuziu rankose!");
					}
					case 4:
					{
					    if(JailTSR[playerid] != -1 && !mewoktake{playerid} && !itemtake[playerid][0] && !itemtake[playerid][2] && !IsPlayerInAnyVehicle(playerid))
						{
							if(!itemtake[playerid][1]) {
				                SetPlayerAttachedObjectEx(playerid, 6, 2846, 5, -0.163999, 0.027000, -0.127999, 79.199943, 0.000000, -22.300006, 0.547999, 0.523999, 0.574000);
							    itemtake[playerid][1] = true;
							    SCM(playerid, -1, !"Jus paemete nesvarius drabuzius. Nuneskite juos i {97F85E}skalbimo masina {FFFFFF}!");
							    SetPlayerChatBubble(playerid, !"Paeme drabuzius", COLOR_PURPLE, 10.0, 5000);
							    ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);
							    GameTextForPlayer(playerid, !"go to washer", 0, 1);

						    }
						    else {
						        RemovePlayerAttachedObject(playerid, 6);
						        itemtake[playerid][1] = false;
						        SCM(playerid, COLOR_VALIK, !"[Uzuomina] {FFFFFF}Jus grazinote drabuzius i savo vieta.");
						        ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);
							}
						}
					}
					case 5:
					{
					    if(JailTSR[playerid] != -1 && !mewoktake{playerid} && !itemtake[playerid][0] && !itemtake[playerid][1] && !itemtake[playerid][2] && !itemtake[playerid][4] && !IsPlayerInAnyVehicle(playerid))
						{
							if(!itemtake[playerid][3]) {
				                SetPlayerAttachedObjectEx(playerid, 6, 2804, 5, 0.121000, 0.039999, 0.009000, 71.899909, -9.599990, 0.000000, 0.412999, 0.403000, 0.570000);
							    itemtake[playerid][3] = true;
							    SCM(playerid, -1, !"Jus paemete mesos gabala. Nuneskite ji i {97F85E}orkaite {FFFFFF}ir ijunkite ja!");
							    SetPlayerChatBubble(playerid, !"Paeme mesa", COLOR_PURPLE, 10.0, 5000);
							    GameTextForPlayer(playerid, !"go to stove", 0, 1);
							    ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);

						    }
						    else {
						        RemovePlayerAttachedObject(playerid, 6);
						        itemtake[playerid][3] = false;
						        SCM(playerid, COLOR_VALIK, !"[Uzuomina] {FFFFFF}Jus grazinote mesa i savo vieta.");
						        ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);
							}
						}
					}
					case 6:
					{
					    if(!itemtake[playerid][4] && JailTSR[playerid] != -1) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus neturite paruosto maisto rankose!");
					    if(JailTSR[playerid] != -1 && !mewoktake{playerid} && !itemtake[playerid][0] && !itemtake[playerid][1] && !itemtake[playerid][2] && !itemtake[playerid][3] && itemtake[playerid][4] && !IsPlayerInAnyVehicle(playerid))
						{
			                RemovePlayerAttachedObject(playerid, 6);
						    itemtake[playerid][4] = false;
						    SCM(playerid, -1, !"Jus sekmingai idejote {97F85E}paruosta {FFFFFF}maiska i saldytuva.");
						    SetPlayerChatBubble(playerid, !"Idejo mesa", COLOR_PURPLE, 10.0, 5000);
						    GameTextForPlayer(playerid, !"successful", 0, 1);
						    TSRFood++;
						    if(meat[playerid] != 0) meat[playerid]--;
						    ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);
						    f(global_str, 80, "Yra %d maisto.\n{FFFFFF}Kalejimo {34eb40}valgykla{FFFFFF}", TSRFood);
						    UpdateDynamic3DTextLabelText(eda, -1, global_str);
						    f(global_str, 200, "UPDATE `orgsinfo` SET `TSRFood` = '%d' WHERE `ID` = '28'", TSRFood);
						    mysql_tquery(mysql, global_str);
						}
					}
				}
				break;
			}
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 343.3261,2430.3489,1500.9797))
		{
		    if(PI[playerid][pHealth] > 100) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus ir taip sveiki!");
			SPD(playerid, 9940, 0, !"", !"{FFFFFF}Ar tikrai norite pradeti nemokama gydyma?", !"Priimti", !"Atsaukti");
		}
		for(new i; i < countTrash; i++)
		{
	        if(IsPlayerInRangeOfPoint(playerid, 2.0, jailtrash[i][Xtrash], jailtrash[i][Ytrash], jailtrash[i][Ztrash]))
			{
				switch(jailtrash[i][typetrash])
				{
				    case 0:
					{
					    if(JailTSR[playerid] != -1 && !itemtake[playerid][0] && !itemtake[playerid][1] && !itemtake[playerid][2] && !mewoktake{playerid} && jailtrash[i][idtrash] != INVALID_STREAMER_ID)
						{
						    ApplyAnimationEx(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 1, 0, 0, 0, 1);
						    SetPlayerAttachedObjectEx(playerid, 6, 1265, 5, 0.254000, 0.000000, -0.064999, 0.000000, -106.699996, 0.000000, 0.543999, 0.518999, 0.624999);
						    itemtake[playerid][0] = true;
						    SCM(playerid, -1, !"Jus paemete siuksles, kurios gulejo ant grindu. Nuneskite jas i kalejimo {F8CA5E}savartyna{FFFFFF}, kuris yra lauke!");
						    DestroyDynamicObject(jailtrash[i][idtrash]);
						    DestroyDynamic3DTextLabel(jailtrash[i][idlabel]);
						    jailtrash[i][idtrash] = INVALID_STREAMER_ID;
						    SetPlayerChatBubble(playerid, !"Surinko siuksles", COLOR_PURPLE, 10.0, 5000);
						    EnableGPSForPlayer(playerid,-29.0191,1797.4017,17.7146);
						    GameTextForPlayer(playerid, !"TRASH REMOVED", 1000, 3);
						    return 1;
					    }
					}
				}
				break;
			}
		}
		OpenFood(playerid);
		for(new i; i < countStirka; i++)
		{
	        if(IsPlayerInRangeOfPoint(playerid, 1, stirkatrash[i][Xstirka], stirkatrash[i][Ystirka], stirkatrash[i][Zstirka]))
			{
			    if(JailTSR[playerid] != -1 && !itemtake[playerid][0] && itemtake[playerid][1] && !itemtake[playerid][2] && stirkatrash[i][timestirka] == 0 && !stirkatrash[i][stirkadone]) {
			        stirkatrash[i][timestirka] = 60;
					RemovePlayerAttachedObject(playerid, 6);
				    itemtake[playerid][1] = false;
				    SetPlayerChatBubble(playerid, !"Idejo drabuzius i skalbimo masina", COLOR_PURPLE, 10.0, 5000);
				    ApplyAnimationEx(playerid,"CRIB","CRIB_Use_Switch",4.0,0,0,0,0,0);
				    SCM(playerid, -1, !"Jus sudejote nesvarius drabuzius i {F8CA5E}skalbimo masina{FFFFFF}. Drabuziai bus isskalbti po 5 minuciu!");
					UpdateDynamic3DTextLabelText(stirkatrash[i][idlabels], -1, !"Skalbimo masina\n[ {FF6347}Veikia{FFFFFF} ]\nLiko {FF6347}1 min.");
			    }
			    if(JailTSR[playerid] != -1 && !itemtake[playerid][0] && !itemtake[playerid][1] && !itemtake[playerid][2] && stirkatrash[i][timestirka] == 0 && stirkatrash[i][stirkadone]) {
			        SetPlayerAttachedObjectEx(playerid, 6, 2384, 1, 0.131999, 0.396000, -0.020000, 1.200000, 99.600028, 89.699989, 1.000000, 1.000000, 1.000000);
			        SCM(playerid, -1, !"Jus paemete svarius drabuzius is {FF6347}skalbimo masinos{FFFFFF}. Nuneskite juos i palatas!");
			        SetPlayerChatBubble(playerid, !"Istrauke drabuzius is skalbimo masinos", COLOR_PURPLE, 10.0, 5000);
			        EnableGPSForPlayer(playerid, 338.7405,2429.8569,1500.9797);
			        itemtake[playerid][2] = true;
			        CarryAnim(playerid);
			        UpdateDynamic3DTextLabelText(stirkatrash[i][idlabels], -1, !"Skalbimo masina\n[ {34eb40}Laisva{FFFFFF} ]\nNaudokite {FAAC58}ALT{FFFFFF}, kad sudetumete nesvarius drabuzius!");
				}
				break;
			}
		}
		for new i = 0; i < sizeof FamilyPickups; i++ do
		{
		    if IsPlayerInRangeOfPoint(playerid, 1, FamilyPickups[i][famX],FamilyPickups[i][famY],FamilyPickups[i][famZ]) *then {
		        ShowFamilyCars(playerid); break;
      		}
		}
		for new i = 0; i < sizeof DeskInfo; i++ do
		{
			if IsPlayerInRangeOfPoint(playerid, 3.0, DeskInfo[i][deskX], DeskInfo[i][deskY], DeskInfo[i][deskZ])
			   && GetPlayerVirtualWorld(playerid) == DeskInfo[i][deskWorld] *then {

				if PI[playerid][pRank] < 9 && PI[playerid][pLeader] == 0
				   || PI[playerid][pMember] != DeskInfo[i][deskID]*then
						return SCM(playerid,COLOR_RED,!"Prieiga uzdrausta!");

				return ShowDeskMenu(playerid);
   			}
		}
		for new i = 0; i < sizeof CompanyText; i++ do {

			if IsPlayerInRangeOfPoint(playerid, 1, CompanyText[i][compX],CompanyText[i][compY],CompanyText[i][compZ]) *then {
		        ClearCompanyData(playerid),Show_Company(playerid); break;
      		}
		}
		for new i = 0; i < sizeof EatOrgInfo; i++ do {

			if IsPlayerInRangeOfPoint(playerid, 1, EatOrgInfo[i][eX],EatOrgInfo[i][eY],EatOrgInfo[i][eZ]) *then {


				if PI[playerid][pMember] != EatOrgInfo[i][eOrg] *then
				    return SCM(playerid,COLOR_RED,"[Klaida] {FFFFFF}Jus nesate sios organizacijos narys!");

                if Global_Time < Int_GetPlayerData(playerid, "AntiFlood") *then
					return false;

				if OrgInfo[EatOrgInfo[i][eOrg]][oMats] < 100 *then
				    return SCM(playerid,COLOR_RED,"[Klaida] {FFFFFF}Jusu organizacijai truksta maisto produktu!");


            	SetPVarInt(playerid, "AntiFlood", Global_Time+5);
				SetFullness(playerid, 100);
		    	ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
		    	SCM(playerid, COLOR_VALIK, !"[Informacija] {FFFFFF}Jus siek tiek uzkandote. Alkio busena galite pamatyti {FFFFFF}/satiety");

		    	OrgInfo[EatOrgInfo[i][eOrg]][oMats] -= 100;



		    	f(global_str,200,"Maisto automatas\n\nYra: {CD5C5C}%i vnt\n\n{cccccc}Pasiekiama tik organizacijos nariams\n\n{CD5C5C}[ Naudokite ALT ]",OrgInfo[EatOrgInfo[i][eOrg]][oMats]),
	            UpdateDynamic3DTextLabelText(EatOrgText[EatOrgInfo[i][eOrg]],COLOR_WHITE,global_str);
	            break;
            }
		}
		for new i = 0; i < TOTALFRACTIONS; i++ do {


			if IsPlayerInRangeOfPoint(playerid, 1, PrivateInfo[i][privatePickup][0],PrivateInfo[i][privatePickup][1],PrivateInfo[i][privatePickup][2]) *then {

			    if PrivateInfo[i][privateAuctionTime] *then {
			        Int_SetPlayerData(playerid,"privateid",i);
					ShowPrivateAuction(playerid);
				}
				else
					ShowPrivateInfo(playerid);

				break;
			}
			else if IsPlayerInRangeOfPoint(playerid, 1.5, PrivateInfo[i][privateJob][0],PrivateInfo[i][privateJob][1],PrivateInfo[i][privateJob][2]) *then {

				if GetPlayerVirtualWorld(playerid) != PrivateInfo[i][privateIntWorld][1] *then
				    continue;

			    if FP_Data[playerid][F_FAMILY_ID] != PrivateInfo[i][privateFamily] *then
			        return SCM(playerid,COLOR_RED, "[Klaida] {ffffff}Jus nepriklausote seimai, kuriai priklauso si organizacija!");

				ShowPrivateJob(playerid);
			    break;
	        }
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 296.6800,2440.8872,1500.9857))
		{
            if(JailTSR[playerid] == -1) return 0;
		    if(TSRFood == 0) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Valgykloje nera maisto!");
			if(Fullness[playerid] >= 50) return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus nesate alkanas!");
		    SetFullness(playerid, 100);
		    ApplyAnimationEx(playerid,"FOOD","EAT_Burger",4.1,0,0,0,0,0,1);
			SCM(playerid, COLOR_VALIK, !"[Informacija] {FFFFFF}Jus siek tiek uzkandote. Alkio busena galite pamatyti {FFFFFF}/satiety");
			TSRFood--;
			f(global_str, 100, "Yra %d maisto.\n{FFFFFF}Kalejimo {34eb40}valgykla{FFFFFF}", TSRFood);
			UpdateDynamic3DTextLabelText(eda, -1, global_str);
			f(global_str, 200, "UPDATE `orgsinfo` SET `TSRFood` = '%d' WHERE `ID` = '28'", TSRFood);
   			mysql_tquery(mysql, global_str);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2.0, 318.6648,2429.7112,1500.9797)) SPD(playerid, 6995, DIALOG_STYLE_LIST, !"", !"{FFFFFF}1. Cigaretes\t{34eb40}30.000$\n{FFFFFF}2. Ziebtuvelis\t{34eb40}30.000$\n{FFFFFF}3. Traskuciai\t{34eb40}30.000$", !"Isrinkti", !"Atsaukti");
	}

	if (newkeys & 2 && IsPlayerInAnyVehicle(playerid))
	{
		for(new i; i < MAX_STO; i++)
		{
	 		if(IsPlayerInRangeOfPoint(playerid, 2.5, StoInfo[i][boxEnterPosX],StoInfo[i][boxEnterPosY],StoInfo[i][boxEnterPosZ]))
	   		{
	   		    new id = GetPlayerVehicleID(playerid),idint = FirstBizToMe(playerid);
				if(StoInfo[i][boxEntered] != INVALID_PLAYER_ID) return 1;
    			if(GetVehicleSpeed(id) > 0) return 1;
   				SetEngineStatus(GetPlayerVehicleID(playerid), false, playerid);
   				SetPlayerInterior(playerid,BizData[idint][bInt]);
   				SetPlayerVirtualWorld(playerid,idint+100);
				LinkVehicleToInterior(id,BizData[idint][bInt]);
				SetVehicleVirtualWorld(id,idint+100);
				SetVehiclePos(id, StoInfo[i][boxExitPosX], StoInfo[i][boxExitPosY], StoInfo[i][boxExitPosZ]);
				SetVehicleZAngle(id, StoInfo[i][boxExitPosA]);
				ShowUpgradeMenu(playerid);
				SetPVarInt(playerid,"STOboxInfo",i);
				StoInfo[i][boxCar] = id;
				StoInfo[i][boxEntered] = playerid;
				StoInfo[i][boxEtap] = 1;
				BizEntered[playerid] = idint;
				UpdateCameraPosSTO(playerid, i, 0);
				UpdateSTO(i);
			}
		}
	}

	if(newkeys == PRESS_ALT)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 3.0, 1090.0826,1525.7831,1716.0868)) CreateShopTD(playerid, 4);
		else if(IsPlayerInRangeOfPoint(playerid, 3.0, 665.9795,-567.7969,1700.7394)) CreateShopTD(playerid, 1);
	}
	if(newkeys == PRESS_ALT)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 2.0, -1108.3360, -953.3210, 138.7770)) CreateShopTD(playerid, 15);
	}
	if(newkeys == KEY_CROUCH)
	{
	    if(GetPlayerVehicleID(playerid) == TruckCar[playerid] && IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid)))
	    {
	        for(new i; i < 4; i++)
	        {
	            if(GetVehicleDistanceFromPoint(TruckCar[playerid], VesiCar[i][0], VesiCar[i][1], VesiCar[i][2]) < 2 && GetVehicleDistanceFromPoint(TruckGruz[playerid], VesiGruz[i][0], VesiGruz[i][1], VesiGruz[i][2]) < 2) StartVesi(playerid);
	        }
	    }
	}
	if(newkeys == PRESS_ALT)
	{
		if(IsPlayerInRangeOfPoint(playerid, 1, -2276.9592, 257.5841, 35.3345) || IsPlayerInRangeOfPoint(playerid, 1, 1368.5862, 1112.5663, 10.8506) || IsPlayerInRangeOfPoint(playerid, 1, 2202.2417, -2687.2307, 13.5721))
	    {
	        //if(GetVehicleModelEx(pTemp[playerid][LastCar]) != 12734 || GetVehicleModelEx(pTemp[playerid][LastCar]) != 12725  ||  GetVehicleModelEx(pTemp[playerid][LastCar]) != 12740) return SendError(playerid, "Jus nesate darbo transporte! ( paskutine transporto priemone, kurioje sedejote )");
			if(GetVehicleModelEx(pTemp[playerid][LastCar]) == 12734 or GetVehicleModelEx(pTemp[playerid][LastCar]) == 12725 or GetVehicleModelEx(pTemp[playerid][LastCar]) == 12740) //return SendError(playerid, "Jus nesate darbo transporte! ( paskutine transporto priemone, kurioje sedejote )");
			{
				if(PlayerJob[playerid] != JOB_TRUCKER) return SendError(playerid, "Jus nedirbate sunkvezimio vairuotoju");
		        TruckCar[playerid] = pTemp[playerid][LastCar];
		        SetTimerEx("TimerGoToTruck2", 1500, false, "d", playerid);
			}
			else return SendError(playerid, "Jus nesate darbo transporte! ( paskutine transporto priemone, kurioje sedejote )");
		}
	}
	if(newkeys == KEY_CROUCH && GetPlayerVehicleID(playerid) == TruckCar[playerid])
	{
	    if(IsPlayerInRangeOfPoint(playerid, 10, 2167.7141, -2682.6868, 13.6090) || IsPlayerInRangeOfPoint(playerid, 10, 1334.2722, 1117.3967, 10.8876) || IsPlayerInRangeOfPoint(playerid, 10, -2311.3267, 262.6506, 35.3714))
		{
            if(TruckGruz[playerid]) return SendError(playerid, "Jus jau paemete krovini!");
            if(IsPlayerToKvadrat(playerid,-891.3302,-2950.0190,2915.9917,560.3257)) pTemp[playerid][TruckCuty] = 1;//"LS";
			else if(IsPlayerToKvadrat(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) pTemp[playerid][TruckCuty] = 2;//"SF";
			else pTemp[playerid][TruckCuty] = 3;//"LV";
		    switch(pTemp[playerid][TruckCuty])
