			for(new i; i < 8; i++)
			{
			    TextDrawShowForPlayer(playerid, Google_TD[i]);
			    if(i < 7)
					TextDrawShowForPlayer(playerid, Google_TD2[i]);
				if(i < 4)
				    TextDrawShowForPlayer(playerid, Google_TD4[i]);
			}
            gPlayerLogTries{playerid} = 3;
		    SPD(playerid, 899, DIALOG_STYLE_INPUT, !"Patvirtinimas", !"\n\n{FFFFFF}Prie sios paskyros prijungtas patvirtinimas {F1FC4C}Google Authenticator.\n{FFFFFF}Iveskite patvirtinimo koda, kad prisijungtumete prie zaidimo.\n\n{FC4C4C}Jei praradote telefona/pasalinote programele arba pametete\nidentifikacijos koda, taciau turite \nteisingai susieta el.pasta, galite\nisjungti patvirtinima Google Authenticator narsykleje:\n\n{FFFFFF}"Mode_Site"/profile/in\n", !"Priimti", !"Atsaukti");
		}
		else if(PI[playerid][pEmailAuth] != 0)
		{
		    if(!GetString(PI[playerid][pLastIP], PlayerIp[playerid]))
		    {
		        SPD(playerid, 834, DIALOG_STYLE_INPUT, !"", !"\n\n{FFFFFF}I jusu E-MAIL {ffd450}E-MAIL {FFFFFF}buvo issiustas\nlaiskas su {ffd450}kodu{FFFFFF}, kuri reikia\nivesti i zemiau esancia eilute.\n\n{ff5e50}Noredami sumazinti zaidima ir\npereiti i narsykle, naudokite\nsia klaviaturos kombinacija: ALT+TAB!\n\n", !"Issiusti", !"Uzdaryti");
		        new code = 999 + random(9000);
		        f(global_str, 35, "Autorizacijos code: %d", code);
		        SendMail(PlayerMail[playerid], ""Mode_Mail"", Mode[CFG_Name], "San Andreas Gyvenimas "Mode_City"", global_str);
		        SetPVarInt(playerid, !"authcode", code);
		    }
		    else OnPlayerLogin(playerid);
		}
		else OnPlayerLogin(playerid);
	}
	else
	{
		amlf("<a href=../pages/user?name=%s>%s</a> nesekmingas prisijungimas. IP: %s", 0, "","", PN(playerid), PN(playerid), PlayerIp[playerid]);

		gPlayerLogTries{playerid} --;

		if (gPlayerLogTries{playerid} <= 0)
			return SCM(playerid, -1, "Isnaudojote bandymu skaicius. Jus esate atjungtas nuo serverio"), Kick(playerid);

	    f(global_str, 270,"\
	    {FFFFFF}Sveiki atvyke i {EBA225}San Andreas Gyvenimas{FFFFFF}\n\n\
		{FF0000}Neteisingas slaptazodis! Pabandykite dar karta.\n\
		{FFFFFF}Bandymu ivesti slaptazodi: {28910B}%d",gPlayerLogTries{playerid});
	    return SPD(playerid,2,3,"Autorizacija",global_str, !"Priimti","Kontekstas");
	}
	return 1;
}

stock GetVehicleSpeed(vehicleid)
{
    new Float:Px,Float:Py,Float:Pz;
    GetVehicleVelocity(vehicleid,Px,Py,Pz);
    return floatround(floatsqroot(Px*Px+Py*Py+Pz*Pz) * 100.0);
}

stock LoadServerConfig()
{
	if !fexist("config.ini") *then
		return print("file 'config.ini' not found");

	new GetFile = ini_openFile("config.ini");

	ini_getString(GetFile, "hostname", Mode[CFG_Name]);
	ini_getString(GetFile, "city", Mode_City);
	ini_getInteger(GetFile, "ServerRestart", Mode[CFG_PASS_SERVER]);

	return ini_closeFile(GetFile);
}

