public: @TopFamily(playerid)
{
	global_str = "{FFFFFF}Vieta\t{FFFFFF}Pavadinimas\t{FFFFFF}Reputacija";
	for new i; i < cache_get_row_count(); i++ do
	{
	    sql_get_row(i, {0});
		strcat(global_str, (str_f("\n%d\t%s\t%d", i+1, SQL_GET_ROW_STR[0], cache_get_row_int(i, 1, mysql))));
	}
	return SPD(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, !"{FFFFFF}TOP {f4f142}"Mode_City" | {B1413D}Seimos", global_str, !"Uzdaryti", !"");
