	SCMF(playerid, COLOR_VALIK, "[Uzuomina]{FFFFFF} Jus nustatete zaidejui %s[%i] langeliu: %i", PN(params[0]), params[0], params[1]);
	return 0;
}
CMD:payday(playerid, params[])
