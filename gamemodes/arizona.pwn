enum QuestInfo { QuestName[100], QuestText[750], LastProgress, AZPrize, ExpPrize }
new QI[][QuestInfo] =
{
    {"Pasidaryti pasa {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Sveikas, broliau, tu manes gal nezinai, leisk prisistatysiu.\nAs esu imones 'Kelias i sekme' darbuotojas, ir as busiu pirmas kas pades tau\npakeisti savo gyvenima i geresne puse!\nRask autobusa arba mopeda ir vaziuok i savivaldybe, kad pasidarytum pasa!\n\n{DA9815}Uzduociai atlikti reikia nuvykti i savivaldybe ir pasidaryti pasa\npo to grizk atgal, kad gautum atlygi!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 2 EXP{ffffff}",2, 1, 2},
    {"Geriausias darbas {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Sveikas vel! Turiu pazistama, jam reikia darbo jegos ukyje, o tau kaip tik pirmasis uzdarbis. Eik ten ir padirbek truputi.\n\n{DA9815}Uzduociai atlikti reikia isidarbinti pradedanciu ukininku ir\npernesti 30 siena kuokstu i sandeli.\nPo to persirenk, pasiimk atlyginima ir grizk atgal atlygio gavimui!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 2 EXP{ffffff}",30,1,2},
    {"Reikia iskrauti vagonus! {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Netoli nuo cia, atveze vagonus su kroviniu, reikia juos iskrauti\nnes sandelyje nera prekiu paskirstymui po parduotuves!\nUzsiimk tuo, tuo paciu truputi uzsidirbsi.\n\n{DA9815}Uzduociai atlikti reikia isidarbinti krautuvu ir\nnesti 20 prekiu i Los Santos sandeli.\nPo to persirenk, pasiimk atlyginima ir grizk atgal atlygio gavimui!\n\nApdovanojimas uz ivykdyma:\n2 SAG-Coins ir 4 EXP{ffffff}",20, 1, 4},
    {"Laikas ka nors gauti {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Ech, va as stoviu ir galvoju, tu juk atrodai protingas zmogus, KET supranti, kodel gi\n tau neigyti vairavimo teisiu? Trumpai tariant, va tokia mano mintis: vaziuok i\nvairavimo mokykla, islaikyk ten teorijos ir praktikos egzaminus, tada ir pasikalbesim.\n\n{DA9815}Uzduociai atlikti reikia nuvaziuoti i vairavimo mokykla ir gauti teises, islaikius visus egzaminus.\nPo to grizk atgal, kad gautum atlygi!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 4 EXP{ffffff}",2,1,4},
    {"Gana sudetingo darbo! {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Drauge, klausyk ka sugalvojau! Trumpai tariant, pas mane vienoje is\nfirmu veziojanciu pica yra pazistamas, jis gales padeti tau ten isidarbinti.\nVaziuok i Los Santoso firma, padirbek ir pranesk man situacija!\n\n{DA9815}Uzduociai atlikti reikia nuvaziuoti i firma veziojancia pica, isidarbinti ten ir pristatyti 15 uzsakymu.\nPo to grizk atgal, kad gautum atlygi!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 4 EXP{ffffff}",15,1,4},
    {"Laikas atsisveikinti {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Ech, deja as su tavimi daugiau negaliu dirbti.\nNuvaziuok pas Michael, jis turi planu del taves. Buk atsargus!\n\n{DA9815}Uzduociai atlikti reikia nuvaziuoti pas Michael ir susipazinti su juo.\nDabar jis duos jums uzduotis!\n\nApdovanojimas uz ivykdyma: 1 SAG-Coins{ffffff}",1,1,0},

	{"Sunkios darbo dienos {ff0000}[Kuriama]{FFFFFF}","{FFFFFF}Sakysiu tiesiai, vaziuok i gamykla, ir padirbk nedaug.\nSako ten dabar neblogai moka, taigi tai eis tau i nauda.\n\n{DA9815}Uzduociai atlikti reikia nuvaziuoti i gamykla ir padaryti 25 medziagas.\nPo darbo pabaigos grizk pas Michael del atlygio!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 30 EXP{ffffff}",25,1,4},
    {"Kas tu toks be telefono? {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Klausyk manes, brangusis, ar ne metas tau nusipirkti telefona?\n Arba gal jis jau yra? Siaip man vis tiek, jei neturi, vyk i parduotuve 24/7 ir nusipirk normalu telefona,\n jis tau bet kokiu atveju pravers!\n\n{DA9815} Uzduociai atlikti reikia nuvykti i bet kuria parduotuve 24/7 ir nusipirkti telefona technikos skyriuje.\nPo to grizk pas Maikla atsiimti apdovanojimo!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 6 EXP{ffffff}",1,1,6},
    {"Ko tu kaip bomzas? {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Drauguzi, man atrodo, kad su tokiais drabuziais toli nenueisi.\nVyk i bet kuria drabuziu parduotuve ir nusipirk ka nors geresnio uz tai!\nTada grizk atgal atsiimti apdovanojimo.\n\n{DA9815} Uzduociai atlikti reikia nuvykti i bet kuria drabuziu parduotuve ir nusipirkti nauja skina.\nPo to grizk pas Michael atsiimti apdovanojimo!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 6 EXP{ffffff}",1,1,6},
    {"Zmogus su kortele! {6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Ech, dabar tau gales padaryti banko kortele, nes ji tau tikrai pravers!\nVyk i banka Las-Venturas ir uzsiimk siuo reikalu.\nAtsakingai uzpildyk dokumentus!\n\n{DA9815} Uzduociai atlikti reikia nuvykti i banko skyriu Las-Venturas ir uzregistruoti sau banko kortele, informacija apie ja galima rasti /help.\nPo to grizk pas Michael atsiimti apdovanojimo!\n\nApdovanojimas uz ivykdyma:\n1 SAG-Coins ir 4 EXP{ffffff}",1,1,4},
    {"Savigynos pamokos!{ff0000}[Kuriama]{FFFFFF}","{FFFFFF}O drauguzi, kaip matai, mes tau neblogai padejome isikurti cia. Bet beda gali ateiti jau greitai, tau bent jau mustis ismokti reikia!\nVyk i sporto sale ir siek tiek pasitreniruok.\n{DA9815} Uzduociai atlikti reikia nuvykti i LS sporto sale, persirengti ir musti krepsi 100 kartu!\nPo to grizk pas Michael atsiimti apdovanojimo!\n\nApdovanojimas uz ivykdyma:\n2 SAG-Coins ir 4 EXP{ffffff}",99,2,4},
    {"Laikas saudyti{6DA5EF}[Siuzetas]{FFFFFF}","{FFFFFF}Dabar tu zinai kur galima ismokti kovos stiliu, bet tai dar ne viskas! Kovos menais toli nenueisi\njei netiketai susidursi su banditu, turinciu ginkla, ka tu darysi?\nVyk i saudymo mokykla ir ismok saudyti!\n\n{DA9815} Uzduociai atlikti reikia nuvykti i LS saudymo mokykla ir stengtis pataikyti i 30 taikiniu.\nPo to grizk pas Michael atsiimti apdovanojimo!\n\nApdovanojimas uz ivykdyma:\n2 SAG-Coins ir 6 EXP{ffffff}",30,2,6},

    {"Vezame maisto atsargas!{6DA5EF}[Kasdieninis]{FFFFFF}","{FFFFFF}Labas, atejai del darbo?\nAs visada turiu, ka pasiulyti zmogui, kad jis butu uzimtas! I musu seima reikia papildyti maisto atsargas, nes be ju nebus isgyventa.\nPasiimk viena is sunkvezimiu ir pervezk 3 krovinius is SF uosto!\n\n{DA9815}Norint ivykdyti uzduoti, reikia paimti savo seimos sunkvezimi ir atlikti 3 reisus\npervezant maisto atsargas i seimos sandeli!\nBaigus uzduoti, reikia sugrizti pas Nathon del apdovanojimo.\n\nApdovanojimas uz ivykdyma:\n20 seimos talonu{ffffff}",3,20,0},
	{"Keistos dezes [Kasdieninis]{FFFFFF}", "{FFFFFF}Nezinau, ar zinai, bet siame mistiniame rumuose 20.00 val.\npasirodo gyvieji mirusieji ir jie troksta kraujo! Bet laimei, jie cia buna\ntik 15 minuciu, ir is to galima pasinaudoti, kad gauti nedidele nauda. Musu tyrejai \nsumokes labai gera atlygi, jei atnesi mums 30 deziu su\nsiu zombiu likuciais!\n\n{DA9815}Norint ivykdyti uzduoti, reikia surinkti ir pristatyti i sandeli\n30 baisiu deziu, kurios krenta po kiekvieno zombio mirties. Zombiai pasirodo\n 20.00 ir dingsta 20.15! Dalyvauti renginyje gali bet kokiu seimu nariai,\nkuriu lygis pasieke 7! Apdovanojimas uz ivykdyma: 3 SAG-Coins ir 4 EXP!{ffffff}", 10, 3, 4},

	{"Atsakome i reporta!", "{DA9815}Norint ivykdyti uzduoti, reikia issaugoti 30 reportu\nReikia saugoti tik tuos reportus, kuriuose pateikti teisingi atsakymai ir kurie\n nera susije su konkreciu serveriu!\nApdovanojimas uz ivykdyma: 30 admin-atlyginimas ir 1 SAG-Eur{ffffff}", 30, 30, 1},
	{"Zaidziame norma!", "{DA9815}Norint ivykdyti uzduoti, reikia isbuti serveryje\n5 PayDay. Buvimas AFK yra kontroliuojamas.\nApdovanojimas uz ivykdyma: 10 admin-atlyginimas ir 1 SAG-Eur{ffffff}", 5, 10, 1},
	{"Stebime bendravima!", "{DA9815}Norint ivykdyti uzduoti, reikia skirti\n25 MUTE zaidejams, kurie pazeidzia zaidimo procesa\nApdovanojimas uz ivykdyma: 40 admin-atlyginimas ir 2 SAG-Eur{ffffff}", 25, 40, 2},
	{"Stebime pazeidejus!", "{DA9815}Norint ivykdyti uzduoti, reikia skirti\n25 WARN zaidejams, kurie pazeidzia zaidimo procesa\nApdovanojimas uz ivykdyma: 50 admin-atlyginimas ir 2 SAG-Eur{ffffff}", 25, 50, 2},
	{"Stebime cheaterius!", "{DA9815}Norint ivykdyti uzduoti, reikia skirti\n25 BAN zaidejams, kurie pazeidzia zaidimo procesa\nApdovanojimas uz ivykdyma: 100 admin-atlyginimas ir 3 SAG-Eur{ffffff}", 25, 100, 3}
};


