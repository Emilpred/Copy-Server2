			}

			new count = strval(inputtextsave), money = count*GLS[31], list = VehicleInfo[GetPlayerVehicleID(playerid)][vListID];

			if !(1 <= count <= 500-CarproductCount[list]) *then return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus negalite isigyti tiek daug produktu!");
			else if PI[playerid][pMoney] < money *then return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jums nepakanka pinigu. Galite papildyti savo saskaita [/donate]");
			else if GLS[27] < count *then return SCM(playerid,COLOR_RED,!"Ukio sandelyje truksta produktu!");

			CarproductCount[list] += count;
			GiveMoney(playerid, -money, "maisto produktu pirkimas ukyje");
			GiveBizMoney(BIZ_ELECTRO_LS, money/2);
			GLS[27] -= count;
