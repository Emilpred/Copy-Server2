                        NextStapQI(playerid, 10);
                    }
		    	}
	    	}
    	}
	}
	return 1;
}

stock GetNumberOfPlayersOnThisIP(test_ip[])
{
	new against_ip[32+1];
	new ip_count = 0;
	foreach(new x: Player)
	{
		if(IsPlayerConnected(x))
		{
			GetPlayerIp(x,against_ip,32);
			if(!strcmp(against_ip,test_ip)) ip_count++;
		}
	}return ip_count;
}

public OnPlayerConnect(playerid)
{
//    SetPlayerInterior(playerid, 211);
	SetPlayerCameraPos(playerid, 1400.425659, -36.066555, 1001.414184);
	SetPlayerCameraLookAt(playerid, 1395.869873, -34.015586, 1001.608764);
	if ServerRestarting *then
	{
	    /*Isduodame pranesima zaidejui*/
	    SCMF(playerid, COLOR_VALIK, "[SAG loading] {ffffff}Jus buvote ismestas del priezasties \"San Andreas Gyvenimas | %s | Loading...\"", Mode_City);
        SCM(playerid, COLOR_VALIK, !"[SAG loading] {ffffff}Serveris bus pasiekiamas po keliu minuciu, nes siuo metu vyksta zaidimo modifikacijos ikelimas!");

		/*Isduodame teksta neteisingo prisijungimo*/
	    SPD(playerid, 0, 0, !"Client | {633169}Zaidimas", !"{ffffff}Aptikta pasenusi arba neteisinga zaidimo versija!\nNoredami testi zaidima serveryje, {633169}turite {ffffff}is naujo paleisti Launcheri\nir idiegti atnaujinima. Jei atnaujinimas nepavyksta, isvalykite programeles talpykla\ntelefono nustatymuose.", !"Supratau", !"");

		/*Ismetame zaideja laikui*/
		return Kick(playerid);
	}

    LoadIconARZ(playerid, 0);
    ShowQuestZone(playerid, 0);

	if !IsValidNickName(PlayerName[playerid]) *then
		return Kick(playerid);

	if ANTI_RAK_BOT *then
		SetPlayerNameInServerQuery(playerid, PlayerName[playerid]);

	PlayerPlaySound(playerid, 1062, 0.0, 0.0, 0.0);

	GetPlayerIp(playerid, PlayerIp[playerid], 16);
	new num_ip = GetNumberOfPlayersOnThisIP(PlayerIp[playerid]);
	if(num_ip > 3) BanEx(playerid, "InputOtherDisconnected");

	//SetPlayerVirtualWorld(playerid, 1228);
	SetPlayerWeather(playerid, Weather);
	ClearChatForPlayer(playerid);
	ClearPlayerData(playerid);

	SCM(playerid, COLOR_RED, !"Sveiki atvyke i San Andreas Gyvenimas!");

	pTemp[playerid][LastCar] = 0;
	attendance ++;

	f(global_str, 150, "SELECT `ID`, `Mail`, `Vkontakte` FROM accounts WHERE NickName = '%s' LIMIT 1;", PlayerName[playerid]);
    mysql_tquery(mysql, global_str, "GetPlayerDataMysql", "d", playerid);
	RemoveBuildings(playerid);
	return 1;
}
new bool:MobileAuthorization[MAX_PLAYERS][2];
stock GetPlayerMobileLauncher(playerid)
{
	new str[24];
	GetPlayerVersion(playerid, str, 24);
	return ( GetString(str, "sag-mobile") ? 1:0 );
}

stock MobileClientAuthorization(playerid, bool:function = false)
	return SPDF(playerid, 18371, DIALOG_STYLE_INPUT, !"Authorization name", "{ffffff}Sveiki atvyke i {eba225}San Andreas Gyvenimas{ffffff}\n\nIveskite savo busima NickName {bfbbba}(siuo metu: %s)%s", !"Priimti", !"Uzdaryti", PN(playerid), function ? "\n\n{ff0000}Iveskite Nick formatu Vardas_Pavarde anglu raidemis\nPavyzdys: Yevhen_Kosovskyi":"");

public: GetPlayerDataMysql(playerid)
{
	if(cache_get_row_count(mysql) > 0)
		PI[playerid][pID] = cache_get_row_int(0, 0, mysql),
		cache_get_row(0, 1, PlayerMail[playerid], mysql, 50),
		PI[playerid][pVkontakte] = cache_get_row_int(0, 2, mysql);

	else
		PI[playerid][pID] = -1;

	if(MobileAuthorization[playerid][1] != true) SetTimerEx("LoadingAutorisation", GetPlayerMobileLauncher(playerid) ? 3000:6000, false, "d", playerid);

    SpecPl(playerid, true);

    f(global_str, 150, "SELECT * FROM `banip` WHERE `IP` = '%s' LIMIT 1", PlayerIp[playerid]);
	mysql_tquery(mysql, global_str, "MysqlCheckPlayerBanIP", "d", playerid);

    if(GetPlayerMobileLauncher(playerid))
	{
		if(MobileAuthorization[playerid][1])
		{
//		    SetPlayerInterior(playerid, 211);
			SetPlayerCameraPos(playerid, 1400.425659, -36.066555, 1001.414184);
			SetPlayerCameraLookAt(playerid, 1395.869873, -34.015586, 1001.608764);
		    if(PI[playerid][pID] != -1) ShowLoginDialog(playerid);
			else
			{
				RegisterState[playerid] = 1;
				ShowRegisterDialog(playerid, RegisterState[playerid]);
			}
		}
	}
	else
	{
//	    SetPlayerInterior(playerid, 211);
		SetPlayerCameraPos(playerid, 1400.425659, -36.066555, 1001.414184);
		SetPlayerCameraLookAt(playerid, 1395.869873, -34.015586, 1001.608764);
	}
//		InterpolateCameraPos(playerid, 2172.266601, -1044.046997, 73.755760, 2172.266601, -1044.046997, 73.755760, 10000000), InterpolateCameraLookAt(playerid, 2168.682861, -1047.527832, 73.553215, 2168.682861, -1047.527832, 73.553215, 1000);

	return 1;
}

public: LoadingAutorisation(playerid)
{
	if(GetPlayerMobileLauncher(playerid))
	{
	    if(MobileAuthorization[playerid][0])
		{
            MobileClientAuthorization(playerid);
            printf("Suveike MobileClientAuthorization [%s(%d)]", PN(playerid), playerid);

      		new BitStream:authorization = BS_New();
			static const rpcId[] = {220, 84, 9, 3, 7, 0, 0, 0, 115, 117, 99, 99, 101, 115, 115};

            printf("Suveike BS_WriteValue [%s(%d)]", PN(playerid), playerid);
            for(new id; id < sizeof rpcId; id++)
                BS_WriteValue(authorization, PR_UINT8, rpcId[id]);

            printf("Suveike PR_SendPacket [%s(%d)]", PN(playerid), playerid);
            PR_SendPacket(authorization, playerid);

            printf("Suveike BS_Delete [%s(%d)]", PN(playerid), playerid);
			BS_Delete(authorization);

			SCM(playerid, -1, !"Suveike kvietimas MobileAuthorization[0] su parametru [true]");
			printf("Suveike kvietimas MobileAuthorization[0] su parametru [true] [%s(%d)]", PN(playerid), playerid);
			MobileAuthorization[playerid][0] = false;
		}
		else
		{
            MobileClientAuthorization(playerid);

            SCM(playerid, -1, !"Suveike kvietimas MobileAuthorization[0] su parametru [false]");
            printf("Suveike kvietimas MobileAuthorization[0] su parametru [false] [%s(%d)]", PN(playerid), playerid);
		}
	}
	else
	{
	    SetPlayerInterior(playerid, 211);
		SetPlayerCameraPos(playerid, 1400.425659, -36.066555, 1001.414184);
		SetPlayerCameraLookAt(playerid, 1395.869873, -34.015586, 1001.608764);
		for(new i; i < 11; i++) TextDrawShowForPlayer(playerid, IntroLogo[i]);

		if(PI[playerid][pID] != -1) ShowLoginDialog(playerid);
		else
		{
			RegisterState[playerid] = 1;
			ShowRegisterDialog(playerid,RegisterState[playerid]);
		}
	}
	return 1;
}

public: MysqlCheckBanOnLogin(playerid, namez[])
{
    new seconds;

    if cache_get_row_count(mysql) > 0 *then
    {
		sql_get_row(0, {1,2,3,5});

		seconds = cache_get_row_int(0, 4, mysql);

		if Global_Time < seconds *then
		{
			global_str = "{FFFFFF}Jusu zaidimo paskyra: {FF0000}%s{FFFFFF} uzblokuota!\n\n\
			Administratorius: {AFAFAF}%s\n\
			{FFFFFF}Priezastis: {AFAFAF}%s\n\
			{FFFFFF}Blokavimo data: {AFAFAF}%s\n\
			{FFFFFF}Atblokavimo data: {AFAFAF}%s\n\n\
			{FFFFFF}Jei nesutinkate su paskyros blokavimu,\n\
			galite pateikti paraiska del atblokavimo forume: %s";
			SPDF(playerid, 0, DIALOG_STYLE_MSGBOX, !"Si paskyra uzblokuota!", global_str, !"OK", !"", SQL_GET_ROW_STR[0], SQL_GET_ROW_STR[1], SQL_GET_ROW_STR[2], SQL_GET_ROW_STR[3], UNIX_TO_DATE(seconds), Mode_Forum);

			return Kick(playerid);
		}
		else
			SQL("UPDATE `accounts` SET `Warns` = '0' WHERE `ID` = '%d' LIMIT 1", PI[playerid][pID]),
		    SQL("DELETE FROM `bannames` WHERE `Name` = '%s' LIMIT 1", PN(playerid));
    }
	if(playerid != INVALID_PLAYER_ID)
	{
    	f(global_str, 100, "SELECT * FROM `accounts` WHERE `ID` = '%d' LIMIT 1", PI[playerid][pID]);
		mysql_tquery(mysql, global_str, "OnPlayerLoadData", "d", playerid);
	}
	return true;
}

