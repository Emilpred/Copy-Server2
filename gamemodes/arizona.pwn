CMD:checkmult(playerid, params[])
{
	if(PI[playerid][pAdmin] < 6) return SCM(playerid, COLOR_GREY, !"Prieiga atmesta!");
	if(sscanf(params, "s[16]", params[0])) return SCM(playerid, COLOR_YELLOW, "Naudokite:{ffffff} /checkmult [IP]");
	f(global_str, 256, "SELECT `ID`,`NickName`,`Money`,`Level`,`VirMoney` FROM `accounts` WHERE `RegIP` REGEXP '%s'", params[0]);
	new Cache:result = mysql_query(mysql, global_str);
	new rows = cache_num_rows();
	if(rows)
	{
		new nn[MAX_PLAYER_NAME], money, idakk, level, vm;
		format(global_str, 64, "Nickas\t\t\tPinigai\t\tSAG-Eur\t\tLygis\tID (BD)\n\n");
        for(new i; i<rows; i++)
		{
		    idakk = cache_get_field_content_int(i, "ID");
			cache_get_row(i, 1, nn, mysql, MAX_PLAYER_NAME);
			money = cache_get_field_content_int(i, "Money");
			level = cache_get_field_content_int(i, "Level");
			vm = cache_get_field_content_int(i, "VirMoney");
			f(global_str, 1024, "{ffffff}%s%s\t\t%d$\t\t%d AS-Coins\t\t%d\t\t%d\n",global_str,nn,money,vm,level,idakk);
		}
		SPD(playerid, 0, 0, params[0], global_str, "Uzdaryti", "");
	}
	else SCM(playerid, COLOR_GREY, "[Klaida] Paskyra su tokiu IP nerasta!");
	cache_delete(result);
	return 1;
}
cmd:alogo(playerid)
{
	if(PI[ playerid ][ pAdmin ] > 1) AdminText3D[playerid] = CreateDynamic3DTextLabel("Administratorius", 0xAFAFAFFF, 0.0, 0.0, 0.0, 50.0, playerid,-1, 0, -1, -1, -1);
	return 1;
}
CMD:capture(playerid, params[])
{
	if !IsAtGang(playerid) *then
		return false;

	else if PI[playerid][pRank] < 7 *then
		return SCM(playerid, COLOR_GREY, !"Sia komanda pasiekiama nuo 7 rango");

	else if 0 < CaptureTime[0] or 0 < CaptureTime[1] *then
		return SCM(playerid, COLOR_GREY, !"Jau vyksta ataka viename is rajonu miesto.");

	new
		Atac = GetTeamID(playerid),	hour,minuite,second;

    gettime(hour, minuite, second);

    if RecoveryTime[Atac] > 0 *then
		return SCM(playerid, COLOR_GREY, !"Jusu gauja jau kovoja / kovojo del teritorijos sia valanda.");

    new zone = GetPlayerGangZone(playerid);
    if zone == -1 or zone > 130 *then
		return false;

	else if !IsGangToZone(Atac, zone, 50.0) *then
		 return SCM(playerid, COLOR_GREY, !"Norint uzimti zona, bent puse visu gaujos nariu turi dalyvauti uzgrobime");

    else if GZInfo[zone][gzFracID] == Atac *then
		return true;

	else if RecoveryTime[GZInfo[zone][gzFracID]] > 0 *then
		return SCM(playerid,COLOR_GREY, !"Jusu gauja jau kovoja / kovojo del teritorijos sia valanda");

    else if minuite < 5 *then
		return SCM(playerid,COLOR_GREY, !"Reikia palaukti kelias minutes po PayDay");

	if !GZInfo[zone][gzFracID] *then
	{
	    GangZoneHideForAll(GangZone[zone]);
        GangZoneShowForAll(GangZone[zone],TeamColors[Atac]);
        GZInfo[zone][gzFracID] = Atac;
        RecoveryTime[Atac] = 1800;
        SendTeamMessage(Atac,COLOR_VALIK, !"Jusu gauja uzeme nauja teritorija");
        UpdateDorm(Atac);
        SaveGangZone(zone);
	}
	else
	{
	    //if(IsGangConnected(GZInfo[zone][gzFracID])<3) return SCM(playerid, COLOR_GREY, !"Norint uzgrobti zona, joje turi buti bent 3 gauja valdancios gaujos nariai");
	    //if(IsGangConnected(Atac)<3) return SCM(playerid, COLOR_GREY, !"Norint uzgrobti zona, joje turi buti bent 3 gaujos nariai.");
		f(global_str, 200,"[Demesio]: Jusu gauja uzpuole teritorija %s",GetGangName(GZInfo[zone][gzFracID]));
		SendTeamMessage(Atac,0x00B953AA, global_str);
		f(global_str, 200, "[Demesio]: Jusu teritorija uzpuole gauja %s",GetGangName(Atac));
		SendTeamMessage(GZInfo[zone][gzFracID],0xFF8CEFAA, global_str);
		//
		f(global_str,300,"[A] Gauja %s [%s(%d)] pradejo teritorijos uzgrobima gaujos %s",OrgInfo[Atac][oName], PN(playerid), playerid,OrgInfo[GZInfo[zone][gzFracID]][oName]);
		SendAdminsMessage(COLOR_ORANGE,global_str);
		///
		CaptureZone = zone;
		CaptureDef = GZInfo[zone][gzFracID];
		CaptureAtac = Atac;
		CaptureAtacKill = 0;
		CaptureDefKill = 0;
		CaptureTime[0] = 10;
		CaptureTime[1] = 0; //10 minuciu
		GangZoneFlashForAll(GangZone[CaptureZone], TeamColors[CaptureAtac]);
		SCM(playerid,COLOR_WHITE, !"Teritorija mirkses 10 minuciu. Laimes ta gauja, kuri liks paskutine");
		SCM(playerid,COLOR_WHITE, !"Teritorija mirkses, kol joje liks tik viena gauja");
	}

	return true;
}
CMD:captureoff(playerid, params[])
{
	if(PI[ playerid ][ pAdmin ] < 4)
		return 1;
	if(usecapt == 0)
	{
		SendClientMessage(playerid,COLOR_GREY,"Jus uzdraudete capture.");
		SAMF(COLOR_LIGHTRED,"{FFFF00}[A] {FFFFFF}Administratorius %s uzdraude capture. {CCCCCC}(/captureoff)", PN(playerid));
		usecapt = 1;
	}
	else
	{
		SendClientMessage(playerid,COLOR_GREY,"Jus leidote capture.");
		SAMF(COLOR_LIGHTRED,"{FFFF00}[A] {FFFFFF}Administratorius %s aktivavo capture. {CCCCCC}(/captureoff)", PN(playerid));
		usecapt = 0;
	}
	return 1;
}
cmd:gl(playerid, params[])
{
	if(PI[ playerid ][ pAdmin ] < 1) return SCM(playerid, -1, "Sia funkcija prieinama tik administracijai!");
	rainbow_status{playerid} = !rainbow_status{playerid};
	SendClientMessage(playerid, 0xFF6600FF, rainbow_status{playerid} ? (!"Jus sekmingai {66CC00}ijungete {FF6600}spalvotini clist") : (!"Jus sekmingai {66CC00}isjungete {FF6600}spalvotini clist"));
	return 1;
}
cmd:gg(playerid)
{
    if(GetPVarInt(playerid, #AFvr) > gettime() && !IsAOwner(playerid)) return SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Ne FLOODink!");
	if(PI[ playerid ][ pAdmin ] < 1) return SCM(playerid, -1, "Sia funkcija prieinama tik administracijai!");
	foreach(new i: Player) SCMF(i, -1, "{ffffff}Administratorius {8b00ff}%s{ffffff} palinkejo jums Gero Zaidimo {8b00ff}San Andreas Gyvenimas!", PN(playerid));
    SetPVarInt(playerid, #AFvr, gettime()+60);
	return 1;
}
