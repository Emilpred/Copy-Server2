        case 1: SendBotMessage(playerid,"Pardavejas:\n{FFFFFF}Sis kostiumas tiesiog sukurtas jums *Sypsosi*");
        case 2: SendBotMessage(playerid,"Pardavejas:\n{FFFFFF}Atrodo, kad jis tiesiog sukurtas jums *Sypsosi*");
        case 3: SendBotMessage(playerid,"Pardavejas:\n{FFFFFF}Jus tiesiog nustabiai atrodote jame.");
    }
	return 1;
}
stock SendBarBot(playerid)
