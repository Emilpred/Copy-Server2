public: BuyAdm(playerid, level)
{
	new rows, fields;
	cache_get_data(rows, fields);

	if rows *then
	{
		f(global_str, 200, "[A] %s[%d] igijo administratoriaus teisiu pakelima nuo %d lygio iki %d lygio", PN(playerid), playerid, PI[playerid][pAdmin], level);
	    SendAdminsMessage(COLOR_YELLOW, global_str);
	    PI[playerid][pAdmin] = level;
	    mysql_format(mysql, global_str, 250, "UPDATE admin SET level = %d WHERE name = '%s'", level, PN(playerid));
		mysql_tquery(mysql, global_str, "", "");
		mysql_format(mysql, global_str, 250, "UPDATE accounts SET Admin = %d WHERE NickName = '%s'", level, PN(playerid));
		mysql_tquery(mysql, global_str, "", "");
	}
	else
	{
		mysql_format(mysql, global_str, 350, "INSERT INTO admin (name,level,last_connect,put_admin,data) VALUES ('%s',%d,CURDATE(),'Server',CURDATE())", PN(playerid), level);
		mysql_tquery(mysql, global_str, "", "");
		mysql_format(mysql, global_str, 150, "UPDATE accounts SET Admin = %d WHERE NickName = '%s'", level, PN(playerid));
		mysql_tquery(mysql, global_str, "", "");
		f(global_str, 145, "[A] %s[%d] igijo administratoriaus teises. %i lygio", PN(playerid), playerid, level);
		SendAdminsMessage(COLOR_YELLOW, global_str);
		PI[playerid][pAdmin] = level;
	}
	return 1;
}

stock GiveTruck(playerid, type)
{
	new model;
	switch(pTemp[playerid][TruckCuty])
	{
	    case 1:
		{
			new r = random(5);
			switch(type)
			{
			    case 1: model = 403;
			    case 2: model = 514;
			    case 3: model = 515;
			}
			TruckCar[playerid] = J_AddStaticVehicleEx(model, TruckPosLS[r][0],TruckPosLS[r][1],TruckPosLS[r][2],TruckPosLS[r][3], 1, 1);
	        TruckCarLS--;
	        format(global_str, sizeof(global_str), "Pasiimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarLS);
			Update3DTextLabelText(TruckCarText[0],0xFFFF00FF, global_str);
	    }
	    case 2:
	    {
			new r = random(5);
			switch(type)
			{
			    case 1: model = 403;
			    case 2: model = 514;
			    case 3: model = 515;
			}
			TruckCar[playerid] = J_AddStaticVehicleEx(model, TruckPosSF[r][0],TruckPosSF[r][1],TruckPosSF[r][2],TruckPosSF[r][3], 1, 1);
	        TruckCarSF--;
	        format(global_str, sizeof(global_str), "Pasiimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarSF);
			Update3DTextLabelText(TruckCarText[2],0xFFFF00FF, global_str);
	    }
	    case 3:
	    {
			new r = random(5);
			switch(type)
			{
			    case 1: model = 403;
			    case 2: model = 514;
			    case 3: model = 515;
			}
			TruckCar[playerid] = J_AddStaticVehicleEx(model, TruckPosLV[r][0],TruckPosLV[r][1],TruckPosLV[r][2],TruckPosLV[r][3], 1, 1);
	        TruckCarLV--;
	        format(global_str, sizeof(global_str), "Pasiimti sunkvezimi\n\n{ffffff}[ Paspauskite ALT ]\n\n{cccccc}(liko sunkvezimiu: %d)",TruckCarLV);
			Update3DTextLabelText(TruckCarText[1],0xFFFF00FF, global_str);
	    }
	}
	J_SetVehicleHealth(TruckCar[playerid], 1000);
 	PutPlayerInVehicle(playerid, TruckCar[playerid], 0);
  	SetEngineStatus(TruckCar[playerid], false, playerid);
}
stock StartVesi(playerid)
{
	if(GetPVarInt(playerid, "VesiStarted")) return 1;
	SetEngineStatus(GetPlayerVehicleID(playerid),false, playerid);
	SetPVarInt(playerid, "VesiStarted", 1);
	SetTimerEx("TimerVesi", 10000, false, "d", playerid);
	return SCM(playerid, COLOR_GREEN, "[Informacija] {FFFFFF}Pradejote sverima! Jo trukme - 10 sekundziu!");
}
forward TimerVesi(playerid);
