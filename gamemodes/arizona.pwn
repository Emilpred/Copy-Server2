stock LoadCompany()
{
	for new i = 0; i < sizeof CompanyText; i++ do
	    CreateDynamic3DTextLabel("Turto draudimas\n{afafaf}[ ALT ]", 0xFFFFFFFF, CompanyText[i][compX],CompanyText[i][compY],CompanyText[i][compZ], 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,156,156);

    CreateDynamic3DTextLabel("{99CC00}Geriausi darbuotojai:\n{ffffff} -\n -\n -\n{99CC00}Geriausi darbuotojai siandien:\n{ffffff} -\n -\n -", 0xFFFFFFFF, 1506.9365,1615.5042,11.8716, 10.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,156,156);

	for new i = 0; i < sizeof EatOrgInfo; i++ do
	    f(global_str,200,"Maisto automatas\n\nYra produktu: {CD5C5C}%i vnt\n\n{cccccc}Pasiekiama tik organizacijos nariams\n\n{CD5C5C}[ Naudokite ALT ]",OrgInfo[EatOrgInfo[i][eOrg]][oMats]),
    	EatOrgText[EatOrgInfo[i][eOrg]] = CreateDynamic3DTextLabel(global_str, 0xFFFFFFFF, EatOrgInfo[i][eX],EatOrgInfo[i][eY],EatOrgInfo[i][eZ], 10.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,EatOrgInfo[i][eWorld],EatOrgInfo[i][eInt]);
}

stock ShowDeskMenu(playerid)
{
    global_str = "Eilutes numeris\tEilutes tekstas\n";

    for new x; x < 12; x ++ do
		strcat(global_str, (str_f("{FFFFFF}%i.\t{cccccc}%s\n", x+1, DeskText[PI[playerid][pMember]][x])));


    f(mysql_string,100, "{FFFFFF}%s | {ae433d}Organizacija",OrgInfo[GetTeamID(playerid)][oName]);
