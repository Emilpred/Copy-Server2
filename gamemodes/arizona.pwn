stock updateTuningEvent(playerid, component, type)
{
	new string_find[3];
    global_str = "";

	f(global_str,20, "\"id\":%d", component);

	for new i; i < sizeof tuningData; i ++ do
	{
	    if(TextFind(tuningData[i][tuningEvent], global_str))
	    {
	        switch(type)
	        {
	            case 0:
	            {
			        f(global_str, sizeof global_str, "%s", tuningData[i][tuningEvent]);

				    string_find[0] = strfind(global_str, "\"installed\":false");
			 	    strdel(global_str, string_find[0], string_find[0]+strlen("\"installed\":false"));
			 	    strins(global_str, "\"installed\":true", string_find[0]);

			 	    string_find[1] = strfind(global_str, (str_f("\"statusText\":\"%d\"", tuningData[i][tuningCost])));
			 	    strdel(global_str, string_find[1], string_find[1]+strlen((str_f("\"statusText\":\"%d\"", tuningData[i][tuningCost]))));
			 	    strins(global_str, "\"statusText\":\"idiegta\"", string_find[1]);

			 	    string_find[2] = strfind(global_str, "\"statusColor\":-1");
			 	    strdel(global_str, string_find[2], string_find[2]+strlen("\"statusColor\":-1"));
			 	    strins(global_str, "\"statusColor\":1132970495", string_find[2]);

		 	        ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.tuning.updateCategoryComponent', `[%s]`);", global_str)));
	            }
		        case 1:
		        {
			        f(global_str, sizeof global_str, "%s", tuningData[i][tuningEvent]);

				    string_find[0] = strfind(global_str, "\"inCart\":false");
			 	    strdel(global_str, string_find[0], string_find[0]+strlen("\"inCart\":false"));
			 	    strins(global_str, "\"inCart\":true", string_find[0]);

			 	    string_find[1] = strfind(global_str, (str_f("\"statusText\":\"%d\"", tuningData[i][tuningCost])));
			 	    strdel(global_str, string_find[1], string_find[1]+strlen((str_f("\"statusText\":\"%d\"", tuningData[i][tuningCost]))));
			 	    strins(global_str, "\"statusText\":\"krepsyje\"", string_find[1]);

			 	    string_find[2] = strfind(global_str, "\"statusColor\":-1");
			 	    strdel(global_str, string_find[2], string_find[2]+strlen("\"statusColor\":-1"));
			 	    strins(global_str, "\"statusColor\":-1681832961", string_find[2]);

		 	        ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.tuning.updateCategoryComponent', `[%s]`);", global_str)));
	 	        }
	 	        case 2: ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.tuning.updateCategoryComponent', `[%s]`);", tuningData[i][tuningEvent])));
 	        }

	        break;
	    }
	}
	return 1;
}

stock GetCartComponent(playerid, modelid)
{
	f(global_str,20, "\"id\":%d", modelid);

	new vehicleid = GetPlayerVehicleID(playerid);

	for new i; i < sizeof tuningData; i ++ do
	{
	    if(TextFind(tuningData[i][tuningEvent], global_str))
	    {
	        modelid = tuningData[i][tuningComponent] == 88 ? FindVehicleComponent(vehicleid, 0, modelid-73 > 6 ? 0 : modelid-73) : tuningData[i][tuningComponent] == 87 ? FindVehicleComponent(vehicleid, 2, modelid-77 > 6 ? 0 : modelid-77) : tuningData[i][tuningComponent] == 86 ? FindVehicleComponent(vehicleid, 1, modelid-82 > 6 ? 0 : modelid-82) : !tuningData[i][tuningComponent] ? 666 : tuningData[i][tuningComponent] > 100 ? getWheelModel(tuningData[i][tuningComponent]) : tuningData[i][tuningComponent];
	        break;
	    }
	}
	return modelid;
}

stock reset_CustomComponent(vehicleid)//loll
{
	for(new i; i < 4; i ++)
	{
	    if(vTuning_Other[vehicleid][i][0])
	    {
	 		if(i == 3) RemoveVehicleVisualTuning(vehicleid, wheelData[vTuning_Other[vehicleid][i][0]-1][wUID], i);
			else RemoveVehicleVisualTuning(vehicleid, vTuning_Other[vehicleid][i][0], i);
		}
	}
	return 1;
}

stock getWheelModel(wheel)
{
	for new i; i < sizeof wheelData; i ++ do
	{
	    if(wheel == wheelData[i][wUID])
	    {
	        wheel = i+1;
			break;
	    }
	}
	return wheel;
}

stock GetCartCategory(modelid)
{
	switch(modelid)
	{
	    case 30..47: return 0; // vinilai
	    case 50..66: return 1; // diskai
	    case 67..72: return 2; // Tonavimas
	    case 73..76: return 3; // kapotas
	    case 77..81: return 4; // spoileris
	    case 82..86: return 5; // duslintuvas
	    case 88: return 6; // priekiniai zibintai
	    case 91: return 7; // dumai
	    case 90,48,49: return 8; // Isblukimai
	}

	return 1;
}

stock tuning_SalonSave(playerid, carid)
{
    new
        number = GetVehicleID(carid);

	if(tuningCenter_playerData[playerid][cartCheck][0])
	{
   		global_str[0] = EOS;

   		vTuning_Vinyl[carid][0] = tuningCenter_playerData[playerid][cartCheck][0];

        for(new i; i < 4; i++)
           	f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Vinyl[carid][i]);

        SQL("UPDATE `ownable` SET `tVinyl` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);
	}
	if(tuningCenter_playerData[playerid][cartCheck][6])
	{
		global_str[0] = EOS, SQL_STRING[0] = EOS;
        for(new i; i < 3; i++)
        {
        	f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_LightBackColor[carid][i]);
       		f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_LightFrontColor[carid][i]);
        }

        SQL("UPDATE `ownable` SET `tLightBackColor` = '%s', `tLightFrontColor` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, CarInfo[number][cID]);

	}
	if(tuningCenter_playerData[playerid][cartCheck][1])
	{
		global_str[0] = EOS;

		vTuning_Other[carid][3][0] = tuningCenter_playerData[playerid][cartCheck][1];

		for(new i; i < 4; i++)
            f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][3][i]);

        SQL("UPDATE `ownable` SET `tOther_3` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

        //CarInfo[number][InvCar][find_FreeSlot(playerid, number)] = Get_WheelItem(vTuning_Other[carid][3][0]);
	}
	if(tuningCenter_playerData[playerid][cartCheck][4])
	{
		global_str[0] = EOS;

		vTuning_Other[carid][2][0] = tuningCenter_playerData[playerid][cartCheck][4];

		for(new i; i < 4; i++)
            f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][2][i]);

        SQL("UPDATE `ownable` SET `tOther_2` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);
	}
	if(tuningCenter_playerData[playerid][cartCheck][3])
	{
		global_str[0] = EOS;

		vTuning_Other[carid][0][0] = tuningCenter_playerData[playerid][cartCheck][3];

		for(new i; i < 4; i++)
            f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][0][i]);

        SQL("UPDATE `ownable` SET `tOther_0` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);
	}
	if(tuningCenter_playerData[playerid][cartCheck][5])
	{
		global_str[0] = EOS;

		vTuning_Other[carid][1][0] = tuningCenter_playerData[playerid][cartCheck][5];

		for(new i; i < 4; i++)
            f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Other[carid][1][i]);

        SQL("UPDATE `ownable` SET `tOther_1` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);
	}

	if(tuningCenter_playerData[playerid][cartCheck][7])
	{
		global_str[0] = EOS;

		for(new i; i < 3; i++)
        	f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_SmokeColor[carid][i]);

        SQL("UPDATE `ownable` SET `tSmokeColor` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, CarInfo[number][cID]);

	}

	if(tuningCenter_playerData[playerid][cartCheck][8])
	{
    	SQL("UPDATE `ownable` SET `tVipadVehicle_1` = '%.3f', `tVipadVehicle_2` = '%.3f', `tVipadVehicle_3` = '%.3f', `tVipadVehicle_4` = '%.3f',\
		`tRazvalVehicle_1` = '%.3f', `tRazvalVehicle_2` = '%.3f', `tRazvalVehicle_3` = '%.3f', `tRazvalVehicle_4` = '%.3f', `tWheelSize` = '%f' WHERE `ID` = '%i' LIMIT 1",\
		vTuning_WheelSettings[carid][0][0][0], vTuning_WheelSettings[carid][0][1][1], vTuning_WheelSettings[carid][0][1][0], vTuning_WheelSettings[carid][0][0][1],\
		vTuning_WheelSettings[carid][1][0][0], vTuning_WheelSettings[carid][1][1][1], vTuning_WheelSettings[carid][1][1][0], vTuning_WheelSettings[carid][1][0][1], vTuning_WheelSettings[carid][2][2][2], CarInfo[number][cID]);
	}

	if(tuningCenter_playerData[playerid][cartCheck][2])
 	{
		global_str[0] = EOS, SQL_STRING[0] = EOS, mysql_string[0] = EOS;
        for(new i; i < 4; i++)
        {
        	f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Blackout[carid][0][i]);
            f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_Blackout[carid][1][i]);
            f(mysql_string, sizeof(mysql_string), "%s%i,", mysql_string, vTuning_Blackout[carid][2][i]);
        }
        SQL("UPDATE `ownable` SET `tBlackout_0` = '%s', `tBlackout_1` = '%s', `tBlackout_2` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, mysql_string, CarInfo[number][cID]);

        global_str[0] = EOS, SQL_STRING[0] = EOS;
		new str[256];
        for(new i; i < 4; i++)
        {
        	f(global_str, sizeof(global_str), "%s%i,", global_str, vTuning_Blackout[carid][3][i]);
         	f(SQL_STRING, sizeof(SQL_STRING), "%s%i,", SQL_STRING, vTuning_Blackout[carid][4][i]);
         	f(str, sizeof(str), "%s%i,", SQL_STRING, vTuning_Blackout[carid][5][i]); //vovka
       	}
        SQL("UPDATE `ownable` SET `tBlackout_3` = '%s', `tBlackout_4` = '%s', `tBlackout_5` = '%s' WHERE `ID` = '%i' LIMIT 1", global_str, SQL_STRING, str, CarInfo[number][cID]);
	}
	return CallTimeOutFunction("SetLoadTune", 500, false, "ii", playerid, GetPlayerVehicleID(playerid));
}

stock FindVehicleComponent(vehicleid, component_type, componentId)
{
	for new i; i < sizeof global_TuningData; i ++ do
	{
		switch component_type do
		{
			case 0:
			{
				static const
					bonnetId[][] = {"b", "c", "d", "e"};

			    global_str = "";

				f(global_str, sizeof global_str, "bnt_b_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name], componentId == 181 ? "b" : bonnetId[componentId]);

			    if GetString(global_TuningData[i][tunName], global_str) *then
			        return global_TuningData[i][tunUID];
			}
			case 1:
			{
				static const
					vixlopId[][] = {"a", "b", "c", "d", "f"};

			    global_str = "";

				f(global_str, sizeof global_str, "rbmp_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name],\
				componentId == 172 ? "b" : vixlopId[componentId]);

			    if GetString(global_TuningData[i][tunName], global_str) *then
			        return global_TuningData[i][tunUID];
			}
			case 2:
			{
				static const
					spoilerId[][] = {"a", "b", "c", "d", "e"};

			    global_str = "";

				f(global_str, sizeof global_str, "spl_b_%s_%s", InfoConfigVehicle[SearchVehicleName(GetVehicleModelEx(vehicleid))][Txd_Name],\
				componentId == 177 ? "a" : spoilerId[componentId]);

			    if GetString(global_TuningData[i][tunName], global_str) *then
			        return global_TuningData[i][tunUID];
			}
		}
	}
	return 0;
}

stock UpdateVehicleDataLocal(vehicleid, playerid)
{
	new
		uId = playerTun_GetSelectUID{playerid},
		color = playerTun_GetSelectColor{playerid};

	switch(playerTun_GetSelectCat{playerid})
	{
		case 0,1:
		{
			vTuning_Other[vehicleid][3][0] = uId-50 > 16 ? 1 : uId-50+1;
			vTuning_Other[vehicleid][3][1] = tunDataColors[color][0];
			vTuning_Other[vehicleid][3][2] = tunDataColors[color][1];
			vTuning_Other[vehicleid][3][3] = tunDataColors[color][2];

			SetVehicleWheel(vehicleid, playerid);
		}
		case 2:
		{
      		vTuning_Other[vehicleid][0][0] = FindVehicleComponent(vehicleid, 0, uId-73 > 6 ? 0 : uId-73);

		    SetVehicleEventEx(vehicleid, vTuning_Other[vehicleid][0][0]);
		}
		case 3:
		{
		    vTuning_Other[vehicleid][2][0] = FindVehicleComponent(vehicleid, 2, uId-77 > 6 ? 0 : uId-77);

		    SetVehicleEventEx(vehicleid, vTuning_Other[vehicleid][2][0]);
		}
		case 4:
		{
		    vTuning_Other[vehicleid][1][0] = FindVehicleComponent(vehicleid, 1, uId-82 > 6 ? 0 : uId-82);

		    SetVehicleEventEx(vehicleid, vTuning_Other[vehicleid][1][0]);
		}
		case 5:
		{
			vTuning_Vinyl[vehicleid][0] = uId-30 == 0 ? 666 : uId-30;

			vTuning_Vinyl[vehicleid][1] = tunDataColors[color][0];
			vTuning_Vinyl[vehicleid][2] = tunDataColors[color][1];
			vTuning_Vinyl[vehicleid][3] = tunDataColors[color][2];

			if(uId-30 == 0)
			{
			    SetVehicleVinyl(vehicleid, playerid),
			    SetVehicleColor(vehicleid, playerid);
			}
			else
				SetVehicleVinyl(vehicleid, playerid);
		}
		case 8:
		{
			vTuning_LightFrontColor[vehicleid][0] = tunDataColors[color][0];
			vTuning_LightFrontColor[vehicleid][1] = tunDataColors[color][1];
			vTuning_LightFrontColor[vehicleid][2] = tunDataColors[color][2];

			SetVehicleLightFrontColor(vehicleid, playerid);
		}
		case 9:
		{
			vTuning_SmokeColor[vehicleid][0] = tunDataColors[color][2];
			vTuning_SmokeColor[vehicleid][1] = tunDataColors[color][1];
			vTuning_SmokeColor[vehicleid][2] = tunDataColors[color][0];

			SetVehicleSmokeColor(vehicleid, playerid);
		}
	}
	return 1;
}

stock OnPlayerInitializingBrowser(playerid)
{
	for new i; i < 2; i++ do
		playerCefInitiliaze[playerid][i] = false;

	return CreateBrowser(playerid, "file:///frontend/svelte_js/index.html", "or7lq8Q8heur");
}

stock UseNewDonate(playerid, type = 0)
{
	switch(type)
	{
	    case 0:
	    {
	        ExecuteEvent(playerid, 0, "window.executeEvent('event.donationshop.updateDonateJsonUrl', '[\"http://wh9207.web3.maze-host.ru/cef/donate_new.json\"]');");
			ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"DonationShop\"]');");
			ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.donationshop.ShopCountDonate', '[[%i]]');", PI[playerid][pVirMoney])));
			OnFocusBrowser(playerid, 0, true);
			HidePlayerHud(playerid);
			donateopen{playerid} = true;
		}
		case 1:
		{
		    ExecuteEvent(playerid, 0, "window.executeEvent('event.setActiveView', '[\"null\"]');");
			ShowPlayerHud(playerid);
		    OnFocusBrowser(playerid, 0, false);
		    donateopen{playerid} = false;
		}
		case 2:
		{
		    ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.donationshop.ShopCountDonate', '[[%i]]');", PI[playerid][pVirMoney])));
		}
	}
	return 1;
}

stock InfoBrowser(call[])
{
	for new i; i < sizeof CefInfo; i++ do
		if(GetString(call, CefInfo[i][uname])) return CefInfo[i][uid];
	return -1;
}

stock OnFocusBrowser(playerid, browserid, bool:toggle)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, 25);
	// ------------------------------------
	BS_WriteValue(bs, PR_UINT32, browserid);
	BS_WriteValue(bs, PR_BOOL, toggle);
	playerCefFocus[playerid] = toggle;
	BS_WriteValue(bs, PR_UINT8, 555);
	// ------------------------------------
	PR_SendPacket(bs, playerid);
	BS_Delete(bs);
}

stock NoDonate(playerid)
{
	SCM(playerid, COLOR_GREY, !"[Klaida]{FFFFFF} Jusu saskaitoje nepakanka pinigu.");
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FF6666}Klaida", "{FF6666}- {FFFFFF}Jusu saskaitoje nepakanka pinigu", "Uzdaryti", "");
	return PlayerNotification(playerid, "error", "Donate", "Jusu saskaitoje nepakanka pinigu", 2000);
}

stock PlayerNotification(playerid, type[], name[], text[], timeout)
{
    /*
		success
		info
		error
		hallowen
	*/
	ExecuteEvent(playerid, 0, (str_f("window.executeEvent('event.notify.initialize', '[\"%s\",\"%s\",\"%s\",%i]');", type, name, text, timeout)));
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	if IsPlayerCefInit(playerid) *then
	{
		if PI[forplayerid][pAdmin] *then
		{
			new BitStream:adminTag = BS_New();

			BS_WriteValue(adminTag, PR_UINT8, 220);
			BS_WriteValue(adminTag, PR_UINT8, 120);
			BS_WriteValue(adminTag, PR_UINT8, forplayerid);
			BS_WriteValue(adminTag, PR_UINT8, 0);
			BS_WriteValue(adminTag, PR_UINT8, 133);
			BS_WriteValue(adminTag, PR_UINT8, 52);
			BS_WriteValue(adminTag, PR_UINT8, 177);
			BS_WriteValue(adminTag, PR_UINT8, 183);
			BS_WriteValue(adminTag, PR_UINT8, 183);
			BS_WriteValue(adminTag, PR_UINT8, 47);
			BS_WriteValue(adminTag, PR_UINT8, 176);
			BS_WriteValue(adminTag, PR_UINT8, 178);
			BS_WriteValue(adminTag, PR_UINT8, 54);
			BS_WriteValue(adminTag, PR_UINT8, 180);
			BS_WriteValue(adminTag, PR_UINT8, 183);

			PR_SendPacket(adminTag, playerid), BS_Delete(adminTag);
		}
		if GetPlayerADDVIP(forplayerid) *then
		{
			new BitStream:addVipTag = BS_New();

			BS_WriteValue(addVipTag, PR_UINT8, 220);
			BS_WriteValue(addVipTag, PR_UINT8, 120);
			BS_WriteValue(addVipTag, PR_UINT8, forplayerid);
			BS_WriteValue(addVipTag, PR_UINT8, 0);
			BS_WriteValue(addVipTag, PR_UINT8, 132);
			BS_WriteValue(addVipTag, PR_UINT8, 52);
			BS_WriteValue(addVipTag, PR_UINT8, 177);
			BS_WriteValue(addVipTag, PR_UINT8, 183);
			BS_WriteValue(addVipTag, PR_UINT8, 183);
			BS_WriteValue(addVipTag, PR_UINT8, 47);
			BS_WriteValue(addVipTag, PR_UINT8, 187);
			BS_WriteValue(addVipTag, PR_UINT8, 52);
			BS_WriteValue(addVipTag, PR_UINT8, 184);
			BS_WriteValue(addVipTag, PR_UINT8, 0);

			PR_SendPacket(addVipTag, playerid), BS_Delete(addVipTag);
		}

	}

	UpdatePlayerSyncAks(playerid, forplayerid);

	return 1;
}

