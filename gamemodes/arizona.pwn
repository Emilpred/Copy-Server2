stock ShowPlayerHud(playerid)
{
	if IsPlayerCefInit(playerid) *then
	{
		HideLogo(playerid);
	    HidePlayerHud(playerid);

		UpdateBrowser(playerid, 8, !PI[playerid][LauncherData][1] ? 0 : 2), UpdateBrowser(playerid, 3, Fullness[playerid]);

		ExecuteEvent(playerid, 0, ( str_f("window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[%s]');", PI[playerid][LauncherData][1] == 4 ? "true" : "false")));
		ExecuteEvent(playerid, 0, ( str_f("window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[%s]');", PI[playerid][LauncherData][1] == 5 ? "true" : "false")));
		ExecuteEvent(playerid, 0, ( str_f("window.executeEvent('event.arizonahud.serverInfo', '[{\"id\":1,\"title\":\""Mode_City"\",\"project\":\"San Andreas\",\"type\":\"Gyvenimas\",\"onLine\":%d,\"flag\":0,\"logo\":11,\"multiplier\":%d}]');", Iter_Count(Player), XDonate)));

		ExecuteEvent(playerid, 0, ( str_f("window.executeEvent('event.%s', '[%d]');", PI[playerid][LauncherData][1] == 4 ? "hudViceCity.updateSatiety" : "arizonahud.playerSatiety", Fullness[playerid])));

		return SpeedometrSetting(playerid), SpeedometrSetting(playerid, GetPlayerState(playerid) == 2 ? 1 : 0), ShowPlayerHotKeys(playerid);
	}
	else if(GetPlayerMobileLauncher(playerid))
	{
	    PI[playerid][LauncherData][1] = 4;
	    Hunger(playerid, 1);
	    HideLogo(playerid);
		new BitStream:bs = BS_New();
		BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 8, PR_UINT8, 3);
		PR_SendPacket(bs, playerid), BS_Delete(bs);
		UpdateBrowser(playerid, 8, 3);
	}
	else if !IsPlayerCefInit(playerid) && GetPlayerLauncher(playerid) && PI[playerid][LauncherData][1] *then
		return Interface_Arizona(playerid, Arz_Hud, PI[playerid][LauncherData][1]-2);

	if(GetPlayerMobileLauncher(playerid))
	{
	    PI[playerid][LauncherData][1] = 4;
        Hunger(playerid, 1);
	    HideLogo(playerid);
		new BitStream:bs = BS_New();
		BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 8, PR_UINT8, 3);
		PR_SendPacket(bs, playerid), BS_Delete(bs);
		UpdateBrowser(playerid, 8, 3);
	}
	return true;
}

stock UpdateBrowser(playerid, arg0, arg1=-1, arg2=-1, arg3=-1, arg4=-1, arg5=-1, arg6=-1)
{
	new BitStream:browserUpdate = BS_New();

	BS_WriteValue(browserUpdate, PR_UINT8, 220);
	BS_WriteValue(browserUpdate, PR_UINT8, arg0);
	if(arg1 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg1);
	if(arg2 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg2);
	if(arg3 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg3);
	if(arg4 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg4);
	if(arg5 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg5);
	if(arg6 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg5);
	if(arg5 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg5);

	return PR_SendPacket(browserUpdate, playerid);
}

stock ExecuteEvent(playerid, browserid, const event[])
{
	if !playerCefInitiliaze[playerid][browserid] *then
	return false;

	new BitStream:eventExecute = BS_New();

	BS_WriteValue(eventExecute, PR_UINT8, 220);
	BS_WriteValue(eventExecute, PR_UINT8, 17);

	BS_WriteValue(eventExecute, PR_UINT32, browserid);

	BS_WriteValue(eventExecute, PR_UINT32, strlen(event));
	BS_WriteValue(eventExecute, PR_STRING, event, strlen(event));

	BS_WriteValue(eventExecute, PR_UINT32, 255);

	return PR_SendPacket(eventExecute, playerid);
}

stock HidePlayerHud(playerid)
{
	if !IsPlayerCefInit(playerid) *then
		return false;

	ExecuteEvent(playerid, 0, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[false]');");
	ExecuteEvent(playerid, 0, "window.executeEvent('event.arizonahud.hotkeysVisible', '[false]');");
	ExecuteEvent(playerid, 0, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[false]');");
	return ExecuteEvent(playerid, 0, "window.executeEvent('event.arizonahud.speedometerType', '[ null ]');");
}

stock IsPlayerCefInit(playerid, type = 0)
{
	for new i, count; i < 2; i++ do
	{
		if !playerCefInitiliaze[playerid][i] *then continue;

		count ++;

		if i && count == 2 *then
			return true;
	}
	if GetPlayerMobileLauncher(playerid) && !type *then
	    return true;

	return false;
}

