stock CreateBodyguardTexts(playerid, Float:Pos[], type, text)
{
	static const Float:positionCorrection[][] = { {86.271179, 29.318756}, {123.401703, 26.100006},
		{85.071594, 41.050003}, {55.670319, 63.887512}, {90.271179, 26.100006}
	};

	Pos[0] -= positionCorrection[text][0];
	Pos[1] += positionCorrection[text][1];

	switch text do
	{
		case 0:
		{
			BodyguardNameTextDraws[playerid][type] = CreatePlayerTextDraw(playerid, Pos[0], Pos[1] + 55.5 * type, FixText(safeguardNickName[playerid][type]));
			PlayerTextDrawLetterSize(playerid, BodyguardNameTextDraws[playerid][type], 0.107292, 0.643750);
			PlayerTextDrawTextSize(playerid, BodyguardNameTextDraws[playerid][type], 417.116119, 6.437501);
			PlayerTextDrawAlignment(playerid, BodyguardNameTextDraws[playerid][type], 1);
			PlayerTextDrawColor(playerid, BodyguardNameTextDraws[playerid][type], 0xFFFFFFFF);
			PlayerTextDrawUseBox(playerid, BodyguardNameTextDraws[playerid][type], 0);
			PlayerTextDrawBoxColor(playerid, BodyguardNameTextDraws[playerid][type], 0x80808080);
			PlayerTextDrawSetShadow(playerid, BodyguardNameTextDraws[playerid][type], 0);
			PlayerTextDrawSetOutline(playerid, BodyguardNameTextDraws[playerid][type], 0);
			PlayerTextDrawBackgroundColor(playerid, BodyguardNameTextDraws[playerid][type], 0x00000000);
			PlayerTextDrawFont(playerid, BodyguardNameTextDraws[playerid][type], 2);
			PlayerTextDrawSetProportional(playerid, BodyguardNameTextDraws[playerid][type], 1);
			PlayerTextDrawSetSelectable(playerid, BodyguardNameTextDraws[playerid][type], false);
			PlayerTextDrawShow(playerid, BodyguardNameTextDraws[playerid][type]);
		}
		case 1:
		{
			for new i; i < 2; i++ do
			{
				BodyguardLevelTextDraws[playerid][type][i] = CreatePlayerTextDraw(playerid, Pos[0], Pos[1] + ( 3.513046 * i + 55.5 * type ), i ? (str_f("%d/%d", safeguardData[playerid][type][1], (safeguardData[playerid][type][0] + 1) * 4 )) : (str_f("lv. %d", safeguardData[playerid][type][0])));
				PlayerTextDrawLetterSize(playerid, BodyguardLevelTextDraws[playerid][type][i], 0.093681, 0.562088);
				PlayerTextDrawTextSize(playerid, BodyguardLevelTextDraws[playerid][type][i], 1280.000000, 1280.000000);
				PlayerTextDrawAlignment(playerid, BodyguardLevelTextDraws[playerid][type][i], 1);
				PlayerTextDrawColor(playerid, BodyguardLevelTextDraws[playerid][type][i], i ? 0x999999FF : 0xFFFFFFFF);
				PlayerTextDrawUseBox(playerid, BodyguardLevelTextDraws[playerid][type][i], 0);
				PlayerTextDrawBoxColor(playerid, BodyguardLevelTextDraws[playerid][type][i], 0x80808080);
				PlayerTextDrawSetShadow(playerid, BodyguardLevelTextDraws[playerid][type][i], 0);
				PlayerTextDrawSetOutline(playerid, BodyguardLevelTextDraws[playerid][type][i], 0);
				PlayerTextDrawBackgroundColor(playerid, BodyguardLevelTextDraws[playerid][type][i], 0x00000000);
				PlayerTextDrawFont(playerid, BodyguardLevelTextDraws[playerid][type][i], 2);
				PlayerTextDrawSetProportional(playerid, BodyguardLevelTextDraws[playerid][type][i], 1);
				PlayerTextDrawSetSelectable(playerid, BodyguardLevelTextDraws[playerid][type][i], false);
				PlayerTextDrawShow(playerid, BodyguardLevelTextDraws[playerid][type][i]);
			}
		}
		case 2:
		{
			static const bodyguardFeatureNames[][] = {"maxhp", "defence", "damage"};

			for new i; i < 3; i++ do
			{
				for new id; id < 2; id++ do
				{
					BodyguardFeatureTextDraws[playerid][type][i][id] = CreatePlayerTextDraw(playerid, Pos[0] + 45.583587 * id, ( ( Pos[1] + 55.5 * type ) - 0.206726 * id ) + 7.524994 * i, id ? (str_f("%d", safeguardFeature[playerid][type][i])) : (str_f("%s", bodyguardFeatureNames[i])));
					PlayerTextDrawLetterSize(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0.107500 + 0.008269 * id, 0.537500 + 0.041346 * id);
					PlayerTextDrawTextSize(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 1280.000000, 1280.000000);
					PlayerTextDrawAlignment(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 1 + 2 * id);
					PlayerTextDrawColor(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0xAAAAAAFF);
					PlayerTextDrawUseBox(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0);
					PlayerTextDrawBoxColor(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0x80808080);
					PlayerTextDrawSetShadow(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0);
					PlayerTextDrawSetOutline(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0);
					PlayerTextDrawBackgroundColor(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 0x00000000);
					PlayerTextDrawFont(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 2);
					PlayerTextDrawSetProportional(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], 1);
					PlayerTextDrawSetSelectable(playerid, BodyguardFeatureTextDraws[playerid][type][i][id], false);
					PlayerTextDrawShow(playerid, BodyguardFeatureTextDraws[playerid][type][i][id]);
				}
			}
		}
		case 3:
		{
			static const
				bodyguardRarityNames[][] = {"usual", "unusual", "rare", "unique"},
				bodyguardRarityColor[] = {0xAAAAAAFF, 0x82FA58FF, 0x25CAFFFF, 0xD239CCFF};

			BodyguardRarityTextDraws[playerid][type] = CreatePlayerTextDraw(playerid, Pos[0], Pos[1] + 55.5 * type, bodyguardRarityNames[safeguardTall[playerid][type][0]]);
			PlayerTextDrawLetterSize(playerid, BodyguardRarityTextDraws[playerid][type], 0.107000, 0.535000);
			PlayerTextDrawTextSize(playerid, BodyguardRarityTextDraws[playerid][type], 1280.000000, 1280.000000);
			PlayerTextDrawAlignment(playerid, BodyguardRarityTextDraws[playerid][type], 2);
			PlayerTextDrawColor(playerid, BodyguardRarityTextDraws[playerid][type], bodyguardRarityColor[safeguardTall[playerid][type][0]]);
			PlayerTextDrawUseBox(playerid, BodyguardRarityTextDraws[playerid][type], 0);
			PlayerTextDrawBoxColor(playerid, BodyguardRarityTextDraws[playerid][type], 0x80808080);
			PlayerTextDrawSetShadow(playerid, BodyguardRarityTextDraws[playerid][type], 0);
			PlayerTextDrawSetOutline(playerid, BodyguardRarityTextDraws[playerid][type], 0);
			PlayerTextDrawBackgroundColor(playerid, BodyguardRarityTextDraws[playerid][type], 0x00000000);
			PlayerTextDrawFont(playerid, BodyguardRarityTextDraws[playerid][type], 2);
			PlayerTextDrawSetProportional(playerid, BodyguardRarityTextDraws[playerid][type], 1);
			PlayerTextDrawSetSelectable(playerid, BodyguardRarityTextDraws[playerid][type], false);
			PlayerTextDrawShow(playerid, BodyguardRarityTextDraws[playerid][type]);
		}
		case 4:
		{
			static const bodyguardSpawnedColor[] = {0xFF0000FF, 0xFFC300FF, 0xAAAAAAFF};

			for new i; i < 3; i++ do
			{
				BodyguardSpawnedTextDraws[playerid][type][i] = CreatePlayerTextDraw(playerid, Pos[0], Pos[1] + ( 3.513046 * i + 55.5 * type ), !"-1");
				PlayerTextDrawLetterSize(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0.093681, 0.562088);
				PlayerTextDrawTextSize(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 1280.000000, 1280.000000);
				PlayerTextDrawAlignment(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 3);
				PlayerTextDrawColor(playerid, BodyguardSpawnedTextDraws[playerid][type][i], bodyguardSpawnedColor[i]);
				PlayerTextDrawUseBox(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0);
				PlayerTextDrawBoxColor(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0x80808080);
				PlayerTextDrawSetShadow(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0);
				PlayerTextDrawSetOutline(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0);
				PlayerTextDrawBackgroundColor(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 0x00000000);
				PlayerTextDrawFont(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 2);
				PlayerTextDrawSetProportional(playerid, BodyguardSpawnedTextDraws[playerid][type][i], 1);
				PlayerTextDrawSetSelectable(playerid, BodyguardSpawnedTextDraws[playerid][type][i], false);
			}
			UpdateBodyguardTextDraw(playerid, 2);
		}
	}
}

stock ShowBodyguardTextDraw(playerid, Float:X, Float:Y)
{
	if BodyguardOpen{playerid} *then
		CloseBodyguardTextDraw(playerid);

	HideInvent(playerid);

	if AddVIPOpen{playerid} *then HideAddVIP(playerid);

	BodyguardOpen{playerid} = true, ShowInvent(playerid);

	for new i; i < 27; i++ do
	{
		if i < 8 *then
			DestroyPlayerTD(playerid, InvItemSlot[playerid][i]);

		DestroyPlayerTD(playerid, InvTextDraws[playerid][i]);
	}
	for new s; s < 36; s++ do
	    DestroyPlayerTD(playerid, InvColorSlot[playerid][s]);

	for new i, Float:Pos[2]; i < 4; i++ do
	{
		Pos[0] = X - 125.401703, Pos[1] = Y + 58.600006, CreateBodyguardDecorationTD(playerid, Pos, i),
		Pos[0] = X - 124.401703, Pos[1] = Y + 26.100006, CreateBodyguardSkinsTD(playerid, Pos, i),
		Pos[0] = X - 37.288452, Pos[1] = Y + 39.975006, CreateBodyguardInventorySlots(playerid, Pos, i),
		Pos[0] = X - 85.071594, Pos[1] = Y + 62.550018, CreateBodyguardWeaponTD(playerid, Pos, i);

		if i < safebodyguardCount[playerid] *then
		{
			Pos[0] = X - 26.049988, Pos[1] = Y + 27.100006, CreateBodyguardMenuButtons(playerid, Pos, i);

			for new id; id < 5; id++ do
				Pos[0] = X, Pos[1] = Y, CreateBodyguardTexts(playerid, Pos, i, id);

			Pos[0] = X - 68.61615, Pos[1] = Y + 70.575012, CreateBodyguardInventoryButtons(playerid, Pos, i);
		}
	}

	return true;
}

stock CloseBodyguardTextDraw(playerid)
{
    if !BodyguardOpen{playerid} *then
		return false;

	for new i; i < 4; i++ do
	{
		for new td; td < 12; td++ do
			DestroyPlayerTD(playerid, BodyguardInventoryCells[playerid][i][td]);

		DestroyPlayerTD(playerid, BodyguardBackGround[playerid][i]);
		DestroyPlayerTD(playerid, BodyguardNameTextDraws[playerid][i]);
		DestroyPlayerTD(playerid, BodyguardRarityTextDraws[playerid][i]);

		for new id; id < 4; id++ do
		{
			if id < 3 *then
			{
				DestroyPlayerTD(playerid, BodyguardDecorationTD[playerid][i][id]);
				DestroyPlayerTD(playerid, BodyguardSpawnedTextDraws[playerid][i][id]);

				for new td; td < 2; td++ do
					DestroyPlayerTD(playerid, BodyguardFeatureTextDraws[playerid][i][id][td]);
			}
			if id < 2 *then
				DestroyPlayerTD(playerid, BodyguardMenuButtons[playerid][i][id]),
				DestroyPlayerTD(playerid, BodyguardInventoryButtons[playerid][i][id]),
				DestroyPlayerTD(playerid, BodyguardWeaponTextDraws[playerid][i][id]),
				DestroyPlayerTD(playerid, BodyguardSkinsTextDraws[playerid][i][id]),
				DestroyPlayerTD(playerid, BodyguardLevelTextDraws[playerid][i][id]);

			DestroyPlayerTD(playerid, BodyguardInventorySlots[playerid][i][id]);
		}
	}

	return BodyguardOpen{playerid} = bodyguardInventoryOpen{playerid} = false;
}

stock UpdateBodyguardTextDraw(playerid, textdrawId)
{
	switch textdrawId do
	{
		case 0:
		{
			for(new i; i < safebodyguardCount[playerid]; i++)
			{
				PlayerTextDrawSetSelectable(playerid, BodyguardWeaponTextDraws[playerid][i][0], safeguardSpawned[playerid][i] ? true : false);
				PlayerTextDrawColor(playerid, BodyguardWeaponTextDraws[playerid][i][0], safeguardSpawned[playerid][i] ? 0xFFFFFFFF : 0x999999FF);

				PlayerTextDrawSetString(playerid, BodyguardWeaponTextDraws[playerid][i][1], !"WEAPON");

				for new id; id < 2; id++ do
					PlayerTextDrawHide(playerid, BodyguardWeaponTextDraws[playerid][i][id]),
					PlayerTextDrawShow(playerid, BodyguardWeaponTextDraws[playerid][i][id]);
			}
		}
		case 1:
		{
			for(new i; i < safebodyguardCount[playerid]; i++)
			{
				for new id; id < 2; id++ do
				{
					if !safeguardSpawned[playerid][i] *then
						PlayerTextDrawHide(playerid, BodyguardInventoryButtons[playerid][i][id]);
					else
						PlayerTextDrawShow(playerid, BodyguardInventoryButtons[playerid][i][id]);
				}
			}
		}
		case 2:
		{
			for(new i, npcid; i < safebodyguardCount[playerid]; i++)
			{
				if safeguardSpawned[playerid][i] *then
				{
//     				npcid = Bodyguard[playerid][bodyguardNpcId];

					for new id; id < 3; id++ do
					{
/*						switch id do
						{
							case 0:
//								PlayerTextDrawSetString(playerid, BodyguardSpawnedTextDraws[playerid][i][id], (str_f("hp. %.0f", FCNPC_GetHealth(npcid))));

							case 1:
								PlayerTextDrawSetString(playerid, BodyguardSpawnedTextDraws[playerid][i][id], (str_f("%d", safeguardFood[playerid][i])));

							case 2:
//								PlayerTextDrawSetString(playerid, BodyguardSpawnedTextDraws[playerid][i][id], (str_f("%.0f", FCNPC_GetArmour(npcid))));
						}*/

						PlayerTextDrawShow(playerid, BodyguardSpawnedTextDraws[playerid][i][id]);
					}
				}
				else
				{
					for new id; id < 3; id++ do
						PlayerTextDrawHide(playerid, BodyguardSpawnedTextDraws[playerid][i][id]);
				}
			}
		}
		case 3:
		{
			for(new i; i < safebodyguardCount[playerid]; i++)
			{
				for new id; id < 2; id++ do
				{
				    static const bodyguardRarityColor[] = {0xAAAAAAFF, 0x82FA58FF, 0x25CAFFFF, 0xD239CCFF};

					if id *then
						PlayerTextDrawSetPreviewModel(playerid, BodyguardSkinsTextDraws[playerid][i][id], safeguardTall[playerid][i][1]),
						PlayerTextDrawSetPreviewRot(playerid, BodyguardSkinsTextDraws[playerid][i][id], 0.0, 0.0, 0.0, 1.0);
					else
						PlayerTextDrawColor(playerid, BodyguardSkinsTextDraws[playerid][i][id], bodyguardRarityColor[safeguardTall[playerid][i][0]]),
						PlayerTextDrawHide(playerid, BodyguardSkinsTextDraws[playerid][i][id]);

					PlayerTextDrawShow(playerid, BodyguardSkinsTextDraws[playerid][i][id]);
				}
			}
		}
	}
}

stock CreateBodyguardInventoryCells(playerid, Float:Pos[], type)
{
	for new i, td; i < 2; i++ do
	{
		for new id; id < 6; id++ do
		{
			td = id + i * 6;

			new item = safeguardInventory[playerid][td][type];

			BodyguardInventoryCells[playerid][type][td] = CreatePlayerTextDraw(playerid, Pos[0] + 19.266968 * id, Pos[1] + ( 25.0 * i + 55.5 * type ), !"LD_SPAC:white");
			PlayerTextDrawLetterSize(playerid, BodyguardInventoryCells[playerid][type][td], 0.480000, 1.120000);
			PlayerTextDrawTextSize(playerid, BodyguardInventoryCells[playerid][type][td], 18.266953, 24.000004);
			PlayerTextDrawAlignment(playerid, BodyguardInventoryCells[playerid][type][td], 1);
			PlayerTextDrawColor(playerid, BodyguardInventoryCells[playerid][type][td], 0xFFFFFFFF);
			PlayerTextDrawUseBox(playerid, BodyguardInventoryCells[playerid][type][td], 0);
			PlayerTextDrawBoxColor(playerid, BodyguardInventoryCells[playerid][type][td], 0x80808080);
			PlayerTextDrawSetShadow(playerid, BodyguardInventoryCells[playerid][type][td], 2);
			PlayerTextDrawSetOutline(playerid, BodyguardInventoryCells[playerid][type][td], 0);
			PlayerTextDrawBackgroundColor(playerid, BodyguardInventoryCells[playerid][type][td], 0x333333FF);
			PlayerTextDrawFont(playerid, BodyguardInventoryCells[playerid][type][td], 5);
			PlayerTextDrawSetProportional(playerid, BodyguardInventoryCells[playerid][type][td], 1);
			PlayerTextDrawSetSelectable(playerid, BodyguardInventoryCells[playerid][type][td], true);
			PlayerTextDrawSetPreviewModel(playerid, BodyguardInventoryCells[playerid][type][td], ItemsInfo[item][ItemModel]);
			PlayerTextDrawSetPreviewRot(playerid, BodyguardInventoryCells[playerid][type][td], ItemsInfo[item][POSTDx], ItemsInfo[item][POSTDy], ItemsInfo[item][POSTDz], ItemsInfo[item][POSTDc]);

			PlayerTextDrawShow(playerid, BodyguardInventoryCells[playerid][type][td]);
		}
	}
}

stock CreateBodyguardBackGround(playerid, Float:Pos[], type)
{
	BodyguardBackGround[playerid][type] = CreatePlayerTextDraw(playerid, Pos[0], Pos[1] + 55.5 * type, !"LD_SPAC:white");
	PlayerTextDrawLetterSize(playerid, BodyguardBackGround[playerid][type], 0.480000, 1.120000);
	PlayerTextDrawTextSize(playerid, BodyguardBackGround[playerid][type], 120.101715, 52.500008);
	PlayerTextDrawAlignment(playerid, BodyguardBackGround[playerid][type], 1);
	PlayerTextDrawColor(playerid, BodyguardBackGround[playerid][type], 0x11111190);
	PlayerTextDrawUseBox(playerid, BodyguardBackGround[playerid][type], 0);
	PlayerTextDrawBoxColor(playerid, BodyguardBackGround[playerid][type], 0x80808080);
	PlayerTextDrawSetShadow(playerid, BodyguardBackGround[playerid][type], 2);
	PlayerTextDrawSetOutline(playerid, BodyguardBackGround[playerid][type], 0);
	PlayerTextDrawBackgroundColor(playerid, BodyguardBackGround[playerid][type], 0x000000FF);
	PlayerTextDrawFont(playerid, BodyguardBackGround[playerid][type], 4);
	PlayerTextDrawSetProportional(playerid, BodyguardBackGround[playerid][type], 1);
	PlayerTextDrawSetSelectable(playerid, BodyguardBackGround[playerid][type], false);
	PlayerTextDrawShow(playerid, BodyguardBackGround[playerid][type]);
}

public: @LoadPlayerBodyguards(playerid)
{
    BodyguardType[playerid] = PI[playerid][pSafeGuardCount]+1;
//	BodyguardMain(playerid, 2, BodyguardType[playerid]);

	if(BodyguardOpen{playerid})
		for(new i; i < 4; i++)
			UpdateBodyguardTextDraw(playerid, i);

	return 1;
}

stock GiveWeaponBodyguard(playerid, item, count = 1, slot, type = 0)
{
	new npcid = Bodyguard[playerid][bodyguardNpcId];

	static const GuardWeap[] = {24, 25, 29, 30, 31, 33};

//	FCNPC_SetWeapon(npcid, GuardWeap[item-531]);
//	FCNPC_GiveAmmo(npcid, count);

	if type *then
	{
		safeguardGun[playerid][slot] = item;
		safeguardGunAmmo[playerid][slot] = count;
		PlayerTextDrawHide(playerid, BodyguardWeaponTextDraws[playerid][slot][0]);
		PlayerTextDrawSetPreviewModel(playerid, BodyguardWeaponTextDraws[playerid][slot][0], ItemsInfo[item][ItemModel]);
		PlayerTextDrawSetPreviewRot(playerid, BodyguardWeaponTextDraws[playerid][slot][0], ItemsInfo[item][POSTDx], ItemsInfo[item][POSTDy], ItemsInfo[item][POSTDz], ItemsInfo[item][POSTDc]);
		ShowPlayerTD(playerid, BodyguardWeaponTextDraws[playerid][slot][0]);
		ApplyAnimationEx(npcid, "RIFLE", "RIFLE_load", 4.0, 0, 0, 0, 0, 0, 1);
//		BodyguardMain(playerid, 4, Bodyguard[playerid][bodyguardslotUse], -1, 7);
		DeleteItem(playerid, item, count);
		timeaks[playerid] = 0;
		SCMF(playerid, COLOR_VALIK, "[Informacija] {FFFFFF}Jus perdavete ginkla %s (%i sov) jusu apsauginiui %s!", ItemsInfo[item][ItemNameLavka], count, safeguardNickName[playerid][slot]);
		SQL("UPDATE Bodyguard SET safeguardGun = '%d', safeguardGunAmmo = '%d' WHERE safeguardSearch = '%s[%d]'", safeguardGun[playerid][slot], safeguardGunAmmo[playerid][slot], PN(playerid), slot);
	}

	return 1;
}

stock AddBodyguardItem(playerid, item, npcid, slot, say)
{
    if !safeguardSpawned[playerid][slot] *then
        return SCM(playerid, COLOR_RED, "[Klaida] {ffffff}Apsauginis nera uzspawnintas.");

	new i = GetFreeSlot(playerid, slot);

	switch item do
	{
		case 314:
	    {
/*			if FCNPC_GetHealth(npcid) >= safeguardFeature[playerid][slot][0] *then
		    {
				if safeguardInventory[playerid][i][slot] *then return false;

				safeguardInventory[playerid][i][slot] = item;
			    ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
			}
			else
			{
				new safeguardHealth;
//				FCNPC_GetHealth(npcid);
				safeguardHealth += 100;
//				FCNPC_GiveHealth(npcid, safeguardHealth);
				ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
			}*/
		}
		case 330:
		{
/*			if FCNPC_GetArmour(npcid) >= 100 *then
   			{
			    SetPlayerAttachedObject(npcid, 4, 19142, 1, 0.0540, 0.0410, 0.0050, 1.8000, -1.5000, 4.0000, 1.1190, 1.2540, -1, -1);
			    safeguardInventory[playerid][i][slot] = item;
		    }
		    else
		    {
				new safeguardArmour;
				FCNPC_GetArmour(npcid);
				if safeguardArmour > 100 *then FCNPC_GiveArmour(npcid, 100);
				safeguardArmour += 100;
                FCNPC_GiveArmour(npcid, safeguardArmour);
				SetPlayerAttachedObject(npcid, 4, 19142, 1, 0.0540, 0.0410, 0.0050, 1.8000, -1.5000, 4.0000, 1.1190, 1.2540, -1, -1);
			}*/
		}
		case 525:
		{
/*			if FCNPC_GetHealth(npcid) >= safeguardFeature[playerid][slot][0] *then
		    {
		        safeguardInventory[playerid][i][slot] = item;
		        ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
			}
			else
			{
				new safeguardHealth;
//				FCNPC_GetHealth(npcid);
				safeguardHealth += 30;
//				FCNPC_GiveHealth(npcid, safeguardHealth);
				ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
			}*/
		}
		case 715..721:
		{
		    if safeguardFood[playerid][slot] >= 100 *then
	        {
		    	ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
		        safeguardInventory[playerid][i][slot] = item;
            }
			else
			{
		    	static const FullnessAdd[] = {10, 15, 25, 30, 35, 45, 100};
		        safeguardFood[playerid][slot] += FullnessAdd[item-715];
			}
		}
//		case 326,722,723: FCNPC_ApplyAnimation(npcid, !"BAR", !"dnk_stndF_loop", 4.1, 0, 0, 0, 0, 0), safeguardFood[playerid][slot] += 15;
	}

//	BodyguardMain(playerid, 4, Bodyguard[playerid][bodyguardslotUse], -1, say);
	DeleteItem(playerid, item, 1);
	timeaks[playerid] = 0;
	SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
	safeguardInventory[playerid][0][slot],safeguardInventory[playerid][1][slot],safeguardInventory[playerid][2][slot],safeguardInventory[playerid][3][slot], safeguardInventory[playerid][4][slot],safeguardInventory[playerid][5][slot],safeguardInventory[playerid][6][slot],safeguardInventory[playerid][6][slot],\
	safeguardInventory[playerid][8][slot],safeguardInventory[playerid][9][slot],safeguardInventory[playerid][10][slot],safeguardInventory[playerid][11][slot],\
	PN(playerid), slot);
	return 1;
}

stock CheckBodyguardNeed(playerid, npcid)
{
	new slot = Bodyguard[playerid][bodyguardslotUse];

	if safeguardFeature[playerid][slot][0] *then
	{
		new s = GetFreeSlot(playerid, slot, 1);
		if safeguardInventory[playerid][s][slot] == 314 or safeguardInventory[playerid][s][slot] == 525 *then
		{
			if safeguardInventory[playerid][s][slot] == 314 *then
		    {
				new safeguardHealth;
//		   		FCNPC_GetHealth(npcid);
				safeguardHealth += 100;
//				FCNPC_GiveHealth(npcid, safeguardHealth);
				ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
				safeguardInventory[playerid][s][slot] = 0;
				SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
				safeguardInventory[playerid][0][slot],safeguardInventory[playerid][1][slot],safeguardInventory[playerid][2][slot],safeguardInventory[playerid][3][slot], safeguardInventory[playerid][4][slot],safeguardInventory[playerid][5][slot],safeguardInventory[playerid][6][slot],safeguardInventory[playerid][6][slot],\
				safeguardInventory[playerid][8][slot],safeguardInventory[playerid][9][slot],safeguardInventory[playerid][10][slot],safeguardInventory[playerid][11][slot],\
				PN(playerid), slot);
			}
			else if safeguardInventory[playerid][s][slot] == 525 *then
			{
				new safeguardHealth;
//		   		FCNPC_GetHealth(npcid);
				safeguardHealth += 30;
//				FCNPC_GiveHealth(npcid, safeguardHealth);
				ApplyAnimationEx(npcid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
				safeguardInventory[playerid][s][slot] = 0;
				SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
				safeguardInventory[playerid][0][slot],safeguardInventory[playerid][1][slot],safeguardInventory[playerid][2][slot],safeguardInventory[playerid][3][slot], safeguardInventory[playerid][4][slot],safeguardInventory[playerid][5][slot],safeguardInventory[playerid][6][slot],safeguardInventory[playerid][6][slot],\
				safeguardInventory[playerid][8][slot],safeguardInventory[playerid][9][slot],safeguardInventory[playerid][10][slot],safeguardInventory[playerid][11][slot],\
				PN(playerid), slot);
			}
		}
	}
	new i = GetFreeSlot(playerid, slot, 2);
	if safeguardInventory[playerid][i][slot] == 330 *then
	{
		new safeguardArmour;
//		FCNPC_GetArmour(npcid);
//		if safeguardArmour > 100 *then FCNPC_GiveArmour(npcid, 100);
		safeguardArmour += 100;
//		FCNPC_GiveArmour(npcid, safeguardArmour);
		SetPlayerAttachedObject(npcid, 4, 19142, 1, 0.0540, 0.0410, 0.0050, 1.8000, -1.5000, 4.0000, 1.1190, 1.2540, -1, -1);
		safeguardInventory[playerid][i][slot] = 0;
		SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
		safeguardInventory[playerid][0][slot],safeguardInventory[playerid][1][slot],safeguardInventory[playerid][2][slot],safeguardInventory[playerid][3][slot], safeguardInventory[playerid][4][slot],safeguardInventory[playerid][5][slot],safeguardInventory[playerid][6][slot],safeguardInventory[playerid][6][slot],\
		safeguardInventory[playerid][8][slot],safeguardInventory[playerid][9][slot],safeguardInventory[playerid][10][slot],safeguardInventory[playerid][11][slot],\
		PN(playerid), slot);
	}
	new j = GetFreeSlot(playerid, slot, 3);
	if safeguardFood[playerid][slot] < 30 *then
	{
	    if safeguardInventory[playerid][j][slot] == 715 or safeguardInventory[playerid][j][slot] == 716 or safeguardInventory[playerid][j][slot] == 717 or safeguardInventory[playerid][j][slot] == 718 or safeguardInventory[playerid][j][slot] == 719 or safeguardInventory[playerid][j][slot] == 720 or safeguardInventory[playerid][j][slot] == 721 *then
		{
			static const FullnessAdd[] = {10, 15, 25, 30, 35, 45, 100};
			safeguardFood[playerid][slot] += FullnessAdd[safeguardInventory[playerid][j][slot]-715];
			safeguardInventory[playerid][j][slot] = 0;
			SQL("UPDATE `Bodyguard` SET `safeguardInventory` = '%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d' WHERE safeguardSearch = '%s[%d]'",\
			safeguardInventory[playerid][0][slot],safeguardInventory[playerid][1][slot],safeguardInventory[playerid][2][slot],safeguardInventory[playerid][3][slot], safeguardInventory[playerid][4][slot],safeguardInventory[playerid][5][slot],safeguardInventory[playerid][6][slot],safeguardInventory[playerid][7][slot],\
			safeguardInventory[playerid][8][slot],safeguardInventory[playerid][9][slot],safeguardInventory[playerid][10][slot],safeguardInventory[playerid][11][slot],\
			PN(playerid), slot);
		}
	}
}

stock GetFreeSlot(playerid, slot, type = 0)
{
	new inv;

	for new i; i < 12; i++ do
	{
		switch type do
		{
			case 0: if !safeguardInventory[playerid][i][slot] *then inv = i;
			case 1: if safeguardInventory[playerid][i][slot] == 314 or safeguardInventory[playerid][i][slot] == 525 *then inv = i;
			case 2: if safeguardInventory[playerid][i][slot] == 330 *then inv = i;
			case 3: if safeguardInventory[playerid][i][slot] == 715 or safeguardInventory[playerid][i][slot] == 716 or safeguardInventory[playerid][i][slot] == 717 or safeguardInventory[playerid][i][slot] == 718 or safeguardInventory[playerid][i][slot] == 719 or safeguardInventory[playerid][i][slot] == 720 or safeguardInventory[playerid][i][slot] == 721 *then inv = i;
		}
	}

	return inv;
}

stock CheckSpeed(playerid)
{
	if !PI[playerid][LauncherData][0] or !PI[playerid][LauncherData][0] *then return true;
	return false;
}

stock GiveDonate(playerid, money)
{
	if !IsPlayerLogged{playerid} *then
		return false;

	PI[playerid][pVirMoney] += money;
	if(PI[playerid][pVirMoney] < 0) PI[playerid][pVirMoney] = 0;
	UpdatePlayerDataInt(playerid, "VirMoney", PI[playerid][pVirMoney]);

	f(global_str, 100, "%s %d ~n~SAG-Coins", money > 0 ? "I saskaita iskaityta" : "Is saskaitos nurasyta", money),
	ShowAttention(playerid, "Informacija", global_str);

	return 1;
}

stock GiveRoubles(playerid, roubles, reason[] = "")
{
	if !IsPlayerLogged{playerid} *then
		return false;

 	PI[playerid][pRoubles] += roubles;
 	UpdatePlayerDataInt(playerid, "SAG-Eur", PI[playerid][pRoubles]);

	if !(roubles == 0) *then
		f(global_str, 100, "%s %d ~n~SAG-Eur", roubles > 0 ? "I saskaita iskaityta" : "Is saskaitos nurasyta", roubles),
		ShowAttention(playerid, "Informacija", global_str);
		//GameTextForPlayer(playerid, global_str, 3000, 3);

	amlf("Zaidejas <a href=../pages/user?name=%s>%s</a> %s SAG-Eur %.0f priezastis %s (SAG-Eur: %d).", 4, PN(playerid), "", PN(playerid), PN(playerid), roubles > 0 ? "gavo" : "pamete", floatabs(roubles), reason, PI[playerid][pRoubles]);

	return 1;
}

stock GiveMoney(playerid, money, reason[] = "")
{
	if !IsPlayerLogged{playerid} *then
		return false;

	PI[playerid][pMoney] += money;
 	if(PI[playerid][pMoney] > 2000000000 || PI[playerid][pMoney] < 0)
  	{
   		SCM(playerid, COLOR_GREY, "Jusu grynuju likutis virsijo 2 milijardus pinigu, todel jis buvo sumazintas iki 2 milijardu pinigu");
     	PI[playerid][pMoney] = 2000000000;
   	}

	SetPlayerMoney(playerid, PI[playerid][pMoney]);

	f(global_str, 100, "%s %d$", money > 0 ? "I saskaita iskaityta" : "Is saskaitos nurasyta", money),
	ShowAttention(playerid, "Informacija", global_str);

	f(mysql_string, 300, "UPDATE  `accounts` SET  `Money` = '%d' WHERE  `NickName`='%s';", PI[playerid][pMoney], PN(playerid));
	mysql_tquery(mysql, mysql_string);

	if strlen(reason) *then
		f(mysql_string, 400, "Zaidejas <a href=../pages/user?name=%s>%s</a> %s pinigai $%.0f priezastis %s (Money:%d) (Bank:%d btc) (MyBank:%d$) (Deposit:%d) (Donat: %d).",
		PN(playerid), PN(playerid), money > 0 ? "gavo":"pamete", floatabs(money), reason, PI[playerid][pMoney], PI[playerid][pBank],PI[playerid][pMyBank], PI[playerid][pDeposit], PI[playerid][pVirMoney]),
		aml(mysql_string, 4, PN(playerid),"");

	return 1;
}

stock LoadOrgs()
{
	for(new i; i < 10; i ++) RankName[0][i] = "Pilietis";
	new Cache:result = mysql_query(mysql, "SELECT * FROM `orgsinfo`");
	new num = cache_get_row_count(mysql);
	for(new i = 1;i <= num;i ++)
	{
		OrgInfo[i][oID] = cache_get_row_int(i-1, 0, mysql);
		cache_get_row(i-1, 1, OrgInfo[i][oName], mysql,32);
		cache_get_row(i-1, 2, OrgInfo[i][oLeader], mysql,24);
		OrgInfo[i][oBank] = cache_get_row_int(i-1, 3, mysql);
		OrgInfo[i][oDrugs] = cache_get_row_int(i-1, 4, mysql);
		OrgInfo[i][oMats] = cache_get_row_int(i-1, 5, mysql);
		OrgInfo[i][Max_Rang] = cache_get_row_int(i-1, 6, mysql);
		cache_get_row(i-1, 7, RankName[i][0], mysql, 50);
		cache_get_row(i-1, 8, RankName[i][1], mysql, 50);
		cache_get_row(i-1, 9, RankName[i][2], mysql, 50);
		cache_get_row(i-1, 10, RankName[i][3], mysql, 50);
		cache_get_row(i-1, 11, RankName[i][4], mysql, 50);
		cache_get_row(i-1, 12, RankName[i][5], mysql, 50);
		cache_get_row(i-1, 13, RankName[i][6], mysql, 50);
		cache_get_row(i-1, 14, RankName[i][7], mysql, 50);
		cache_get_row(i-1, 15, RankName[i][8], mysql, 50);
		cache_get_row(i-1, 16, RankName[i][9], mysql, 50);
		OrgInfo[i][oBenz] = cache_get_row_int(i-1, 17, mysql);
		OrgInfo[i][oRemont] = cache_get_row_int(i-1, 18, mysql);
		OrgInfo[i][oMask] = cache_get_row_int(i-1, 19, mysql);
		OrgMoney[i] = cache_get_row_int(i-1, 20, mysql);
		TSRFood = cache_get_row_int(i-1, 21, mysql);
		cache_get_field_content(i-1, "OrgSalary", global_str), sscanf(global_str, "p<,>a<i>[14]", OrgSalary[i]);
		OrgInfo[i][oAutoInvite] = cache_get_row_int(i-1, 24, mysql);
		OrgInfo[i][oAutoRank] = cache_get_row_int(i-1, 25, mysql);
		cache_get_row(i-1, 26, global_str, mysql), String_UnPackMassive(global_str, DeskText[i]);
	}
	cache_delete(result, mysql);

	for new i = 0; i < sizeof DeskInfo; i++ do
	{
		CreateDynamic3DTextLabel(!"Noredami atlikti pakeitimus\n{ffffff}Paspauskite ALT", 0xFFFF00FF, DeskInfo[i][deskX], DeskInfo[i][deskY], DeskInfo[i][deskZ], 3.0000,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0,DeskInfo[i][deskWorld]);
	    DeskObject[i] = CreateDynamicObject(3077, DeskInfo[i][deskX],DeskInfo[i][deskY],DeskInfo[i][deskZ],DeskInfo[i][deskRX],DeskInfo[i][deskRY],DeskInfo[i][deskRZ],DeskInfo[i][deskWorld]);

        global_str = "\n";

		for new x = 0, orgid = DeskInfo[i][deskID]; x < 12; x++ do
			strcat(global_str,(str_f("     %s\n",DeskText[orgid][x])));

		if DeskInfo[i][deskWorld] *then
			SetDynamicObjectMaterial(DeskObject[i], 1, 14584, "ab_abbatoir01", "cj_sheetmetal", 0);

		SetDynamicObjectMaterialText(DeskObject[i], 0, global_str, 130, "Ariel", 18, 1, 0xFFFFFFFF, 0xFF363636, 0);

	}

	return 1;
}

stock SaveOrg(orgid)
{
	f(global_str, 320, "UPDATE `orgsinfo` SET `Leader` = '%s', `Bank` = '%d', `Drugs` = '%d', `Mats` = '%d', `Benz` = '%d', `Remont` = '%d', `Mask` = '%d', `OrgMoney` = '%d', `AutoInvite` = '%d', `AutoRank` = '%d' WHERE `ID` = '%i'",OrgInfo[orgid][oLeader],OrgInfo[orgid][oBank],OrgInfo[orgid][oDrugs],OrgInfo[orgid][oMats],OrgInfo[orgid][oBenz],OrgInfo[orgid][oRemont],OrgInfo[orgid][oMask], OrgMoney[orgid], OrgInfo[orgid][oAutoInvite], OrgInfo[orgid][oAutoRank], orgid);
	mysql_tquery(mysql, global_str);
	return 1;
}

stock SaveOrgs()
{
	for(new i = 1; i < MAX_ORGS; i ++) SaveOrg(i);
	return 1;
}

