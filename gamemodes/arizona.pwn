		default: f(mysql_string,43,"{ffff00}ID %i{ffffff}]",Int_GetPlayerData(playerid,"strahovka2"));
	}
    strcat(global_str,mysql_string);


	strcat(global_str,"\nDraudimo tipas\t[");
	switch Int_GetPlayerData(playerid,"strahovka3") do {
