		SCM(playerid, COLOR_OLDRED, !"Pranesimas is serverio:");

		for new i; i < count; i++ do
		{
			sql_get_row(i, {2,3});
			SCMF(playerid, COLOR_YELLOW, "[%s] %s", SQL_GET_ROW_STR[1], SQL_GET_ROW_STR[0]);
		}

		SQL("DELETE FROM notif WHERE ownerid = %d", PI[playerid][pID]);
	}

	return true;
}

public: LoadQuestMysql(playerid)
{
	new maxt = cache_get_row_count(mysql);
	for(new i; i< maxt; i++)
	{
	    new idquest = cache_get_row_int(i, 0, mysql);
		QuestProgress[playerid][idquest] = cache_get_row_int(i, 1, mysql);
		AcceptQuest[playerid][idquest] = cache_get_row_int(i, 2, mysql);
	}
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if !IsPlayerLogged{playerid} or pTemp[playerid][tAddVipSpawn] == 1 *then
		return false;

    if(result == -1 && IsPlayerLogged{playerid} &&  GetString(cmd,"/rec"))
	{
		SCM(playerid, COLOR_RED, !"[Klaida]{FFFFFF} Nezinoma komanda! Iveskite /help, kad pamatytumete prieinamas funkcijas.");
		return 0;
	}

    return true;
}

public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	if !IsPlayerLogged{playerid} or pTemp[playerid][tAddVipSpawn] == 1 *then
		return false;
	if !CheckAdminCommand(playerid, cmd) *then
	    return false;

	return true;
}

stock CheckAdm(playerid, level, CheckAutorizaction = 1, CheckAcceptAdmin = 1)
{
	if PI[playerid][pAdmin] < level *then  {
		SCM(playerid, COLOR_OLDRED, !"[Klaida] {cccccc}Jus neturite prieigos prie sios komandos.");
		return 0;
	}

	else if !ADuty{playerid} && CheckAutorizaction *then {
		SCM(playerid, COLOR_GREY, !"[A] Jus nesate autorizave. Naudokite {33CCFF}/apanel");
		return 0;
	}

	else if CheckAcceptAdmin && CheckIsASuccesIP(playerid) *then return 0;

 	return 1;
}

stock CheckFD(playerid, fdlevel)
{
	if !PI[playerid][pAdmin] *then
		return 0;

	if AdminInfo[playerid][admFullDostup] < fdlevel *then
		return 0;

 	return 1;
}

stock CheckAdminCommand(playerid, command[])
{
	for new i; i < sizeof AdminCommandList; i++ do {

		if !GetString(AdminCommandList[i][adminCommand], command) && !TextFind(AdminCommandList[i][adminCommandAlias], (str_f("|%s|", command))) *then
			continue;

		if !CheckAdm(playerid, AdminCommandList[i][adminLevel], AdminCommandList[i][adminCheckAuthorization], AdminCommandList[i][adminCheckAccept]) *then
			return false;

		if AdminCommandList[i][adminAccess] && !CheckFD(playerid, AdminCommandList[i][adminAccess]) *then
			return false;

		if(AdminCommandList[i][adminAntiSlivTime])
		{
		    if !IsAOwner(playerid) *then
		    {
				if Int_GetPlayerData(playerid, command) > Global_Time *then
				{
					SCMF(playerid, COLOR_OLDRED, "[Klaida]{cccccc} Sia komanda galesite naudoti po {FFFFFF}%d{cccccc} sekundziu!", Int_GetPlayerData(playerid, command) - Global_Time);
					return false;
				}
				else Int_SetPlayerData(playerid, command, Global_Time + AdminCommandList[i][adminAntiSlivTime]);
			}
			else Int_SetPlayerData(playerid, command, Global_Time + 0);
		}
		AdminCommandList[i][adminAntiSlivTime] = 5;
	}
	return true;
}

stock IsARPPN(Name[])
{
	if(strlen(Name)>19) return 0;
	if(!strlen(Name)) return 0;
	new simb_, num; static RP_Name[2][24];
	for(new i = 0;i < strlen(Name);i ++)
	{
	    if(Name[i] == '_') {simb_ ++; num=i;}
	}
	if(simb_ != 1) return 0;
	strmid(RP_Name[0], Name, 0, num-1);
	strmid(RP_Name[1], Name, num+1, strlen(Name));
	if( !IsAGoodPN(RP_Name[0]) || !IsAGoodPN(RP_Name[1]) ) return 0;
	return 1;
}
stock IsAGoodPN(Name[])
{
	new NameChars;
	if(strlen(Name) < 2) return 0;
	if(Name[0] < 'A' || Name[0] > 'Z') return 0;
	for(new i = 1;i < strlen(Name);i ++)
	{
	    if(Name[i] < 'a' || Name[i] > 'z')
		{
		    if(Name[i] >= 'A' && Name[i] <= 'Z') NameChars ++;
		    else return 0;
		}
	    if(NameChars > 1) return 0;
	}
	return 1;
}
stock IsAFireGun(gunid)
{
	return (gunid >= 22 && gunid <= 38);
}
stock EnableGPSForPlayer(playerid, Float:x, Float:y, Float:z, gpsint = 0, gpsworld = 0)
{
	gpss[playerid]=1;
	SetPlayerRaceCheckpoint(playerid, 1, Float:x, Float:y, Float:z, Float:x, Float:y, Float:z, 4.0);
	GameTextForPlayer(playerid, "GPS: ON", 0, 1);

	SetPlayerGPSInfo(playerid, G_POS_X, x);
	SetPlayerGPSInfo(playerid, G_POS_Y, y);
	SetPlayerGPSInfo(playerid, G_POS_Z, z);

	SetPlayerGPSInfo(playerid, G_INTERIOR, gpsint);
	SetPlayerGPSInfo(playerid, G_WORLD, gpsworld);

	if(ADuty{playerid} == true)
	{
		return SPD(playerid, 231, DIALOG_STYLE_MSGBOX, !"{277ECD}Teleportas", "{FFFFFF}Ar norite pereiti i nustatyta taska?", "Taip", "Ne");
	}
	if SettingData[playerid][sdPlaySoundGPS] *then {
		global_str = "";
		f(global_str, sizeof(global_str), "http://%s", GpsStart);
		PlayAudioStreamForPlayer(playerid, global_str);
	}
	return 1;
}
