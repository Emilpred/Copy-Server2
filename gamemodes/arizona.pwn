	return SCMALL(COLOR_ORANGE, !"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"),
		SCMALL(COLOR_ORANGE, !"- Pagrindines serverio komandos: /menu /help /gps /settings"),
		SCMALL(COLOR_ORANGE, !"- Pakviesk drauga ir gauk $30 000!"),
		SCMALL(COLOR_ORANGE, !"- Musu Site: discord.gg/p4qz7aTY"),
		SCMALL(COLOR_ORANGE, !"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~");

