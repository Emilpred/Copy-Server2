		case 4: f(mysql_string,64,"{ffff00}Turto iskritimas(100 procentu){ffffff}]");

	}
    strcat(global_str,mysql_string);


	strcat(global_str,"\nLaikas\t[");
	switch Int_GetPlayerData(playerid,"strahovka4") do {
		case 0: f(mysql_string,32,"{afafaf}Isrinkti{ffffff}]");
		case 1: f(mysql_string,32,"{ffff00}1 menesis{ffffff}]");
		case 2: f(mysql_string,32,"{ffff00}3 menesiai{ffffff}]");
		case 3: f(mysql_string,32,"{ffff00}6 menesiu{ffffff}]");
		case 4: f(mysql_string,32,"{ffff00}1 metas{ffffff}]");
		case 5: f(mysql_string,32,"{ffff00}5 metai{ffffff}]");
