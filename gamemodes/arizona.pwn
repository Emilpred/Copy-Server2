					if(sscanf(inputtextsave,"s[150]",reason)) return SPD(playerid,1221,DIALOG_STYLE_INPUT,"Priezastis","Iveskite ispejimo priezasti\n\tPavyzdziui: keiksmazodis","Atlikta", !"Atsaukti");
					if(IsPlayerConnected(id))
					{
