									if(PI[id][pWarns] > 0) return SCM(playerid,COLOR_RED,!"Zaidejo su WARN negalima priimti i organizacija");
									if(IsAtFrakcia(playerid, 1) && PI[id][pZKP] <35)
									{
									    SCM(playerid,COLOR_RED,!"[Klaida] {FFFFFF}Sio piliecio teisetvarkos taskai neleidzia jam prisijungti prie organizacijos! (Reikia 35 teisetvarkos tasku!)");
									    SCM(id,COLOR_RED,!"[Klaida] {FFFFFF}Jusu neprieme i organizacija, nes turite per mazai teisetvarkos tasku! (Reikia 35 teisetvarkos tasku!)");
									    return 0;
									}
//									if IsAtFrakcia(playerid, 1) && VoenikTimer[id] < Global_Time *then
//										return 	SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Sis zaidejas neturi karinio bilieto!");
									if(PI[playerid][pLeader] > 0) Leader = "Lyderis";
									else Leader = "Lyderio pav.";
									InviteOffer[id] = playerid;
									f(global_str,sizeof(global_str),"Jus kvieciate %s prisijungti prie organizacijos",PN(id));
									SCM(playerid,COLOR_LIGHTBLUE,global_str);
									f(global_str,sizeof(global_str),"%s %s kviecia jus prisijungti prie organizacijos %s",Leader, PN(playerid),OrgInfo[GetTeamID(playerid)][oName]);
									SPD(id,8,0,"Invite",global_str, !"Priimti", !"Atsaukti");
								}
								else
								{
									SCM(playerid,COLOR_GREY, !"Siam zaidejui jau buvo issiustas kvietimas prisijungti prie organizacijos");
									return 1;
								}
							}
							else
							{
								SCM(playerid,COLOR_GREY, !"Turite buti salia zaidejo");
								return 1;
							}
						}
						else
						{
							SCM(playerid,COLOR_GREY, !"Sis zaidejas jau priklauso vienai is organizaciju");
							return 1;
						}
					}
				}
			}
		}
		case 1217:
		{
			if(response)
			{
				switch(listitem)
				{
					case 0: return SPD(playerid, 1218, DIALOG_STYLE_INPUT, !"Rangas", !"Iveskite ranga\n\tPavyzdziui: 1", !"Atlikta", !"Atsaukti");
					case 1: return SPD(playerid, 1219, DIALOG_STYLE_INPUT, !"Priezastis", !"Iveskite atleidimo priezasti\n\tPavyzdziui: S/N", !"Atlikta", !"Atsaukti");
					case 2:
					{
						new id = ViborSERIU[playerid];
						if(PI[id][pFMuteTime] == 0) return SPD(playerid, 1220, DIALOG_STYLE_INPUT, !"MUTE", !"Iveskite MUTE laika ir priezasti\n\tPavyzdziui: 5,keiksmazodis", !"Atlikta", !"Atsaukti");
						else
						{
							if(GetTeamID(id) == GetTeamID(playerid))
							{
								f(global_str,sizeof(global_str),"Lyderis %s nueme nutildyma %s",PN(playerid),PN(id));
								SendTeamMessage(GetTeamID(playerid), COLOR_RED, global_str);
								PI[id][pFMuteTime] = 0;
							}
						}
					}
					case 3: return SPD(playerid, 1221, DIALOG_STYLE_INPUT, !"Priezastis", !"Iveskite ispejimo priezasti\n\tPavyzdziui: keiksmazodis", !"Atlikta", !"Atsaukti");
				}
			}
		}
		case 1213:
		{
		    if(response)
			{
                new id = strval(inputtextsave);
                if(!IsPlayerConnected(id) || !IsPlayerLogged{id}) return SCM(playerid,COLOR_RED,!"Neteisingas ID!");
				if(!ProxDetectorS(5.0, playerid, id, 1)) return SCM(playerid,COLOR_RED,!"Jus toli nuo zaidejo!");
				if(id==playerid)return 0;
				if(!IsAArmy(playerid) && PI[id][pMember] != TEAM_LSPD && PI[id][pMember] != TEAM_RCPD && PI[id][pMember] != TEAM_LVPD && PI[id][pMember] != TEAM_SFPD) return SCM(playerid,COLOR_RED,!"Sis zaidejas nepriklauso reikiamai organizacijai!");
				if(PI[id][pRank] < 4) return SCM(playerid,COLOR_RED,!"Sis zaidejas dar nepasieke reikiamo 4 rango!");
				if(PI[id][pRank] >= 9) return SCM(playerid,COLOR_RED,!"Negalite pervesti pas save pavaduotoja ar lyderio!");
				if(PI[playerid][pMember]==TEAM_FBI && PI[id][pMember]!=TEAM_LSPD && PI[id][pMember]!=TEAM_RCPD && PI[id][pMember]!=TEAM_LVPD && PI[id][pMember]!=TEAM_SFPD) return SCM(playerid,COLOR_RED,!"I FBI galima pervesti tik policijos darbuotojus!");
				if((PI[playerid][pMember] == TEAM_FBI) && PI[id][pRank] < 5) return SCM(playerid,COLOR_RED,!"I FBI galima pervesti tik 5 rango policijos darbuotojus!");
				PI[id][pMember]=PI[playerid][pMember];
                PI[id][pFWarns] = 0;
				PI[id][pRank] = 1;
				PI[id][pDCTime]=2;
    			SCM(id, COLOR_WHITE, !">> {FF6347} Spawno vieta automatiskai priskirta organizacijai. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");
				SCM(playerid,COLOR_VALIK, !"Jus sekmingai pervedete zaideja i savo organizacija");
				f(global_str,sizeof(global_str),"Sveikiname, jus buvote pervestas i organizacija: %s i pareigas: %s",OrgInfo[GetTeamID(id)][oName],GetRankName(GetTeamID(id),PI[id][pRank]));
				SCM(id,COLOR_VALIK,global_str);
				PlayerSpawn(id);
			}
		}
     	case 1218:
		{
			if(response)
			{
				new id;
			 	new rank = strval(inputtextsave);
				id = ViborSERIU[playerid];
				if(id == playerid) return SCM(playerid,COLOR_RED,!"Negalima suteikti rango sau");
				if(rank<1)return 0;
				if(GetTeamID(playerid) == PI[id][pMember])
				{
					static change[10];
					if(PI[id][pLeader] > 0 ) return SCM(playerid,COLOR_RED,!"Jus negalite pakeisti lyderio rango");

					if(Clother[id]!=-1)return 0;
					if(GetPlayerVirtualWorld(playerid)!=GetPlayerVirtualWorld(id))return 0;

					if(PI[playerid][pRank] == 9 && id > 8) return SCM(playerid,COLOR_RED,!"Negalima suteikti rango, didesnio nei 8");
					if(rank > 9) return SCM(playerid,COLOR_GREY, !"Negalima paaukstinti iki sio rango");
					if(PI[id][pRank] > rank) change = "pazemino";
					else if(PI[id][pRank] < rank) change = "paauks.";
					else return SCM(playerid,COLOR_VALIK, !"Zaidejas jau turi ranga, kuri norite jam suteikti");
					f(global_str,sizeof(global_str),"Jusu organizacijos lyderis %s %s jus pareigose.",PN(playerid),change);
					SCM(id,COLOR_LIGHTBLUE,global_str);
					f(global_str,sizeof(global_str),"Jus %s zaideja %s iki %d rango",change,PN(id),rank);
					SCM(playerid,COLOR_LIGHTBLUE,global_str);
					PI[id][pRank] = rank;
					if(PI[id][pSex] == 2)
					{
					    if(TeamDuty{id})
						{
							SetPlayerSkinEx(id,GOrgSkins[GetTeamID(id)][rank]);
							TogglePlayerControllable(id,true);
						}
					}
					else
					{
					    if(TeamDuty{id})
						{
							SetPlayerSkinEx(id,MOrgSkins[GetTeamID(id)][rank]);
							TogglePlayerControllable(id,true);
						}
					}
				}
				else SCM(playerid,COLOR_VALIK, !"Sis zaidejas nepriklauso jusu organizacijai");
			}
		}
		case 1219:
		{
			if(response)
			{
				new id; static reason[100];
				id = ViborSERIU[playerid];
				if(PI[playerid][pLeader] > 0 || PI[playerid][pRank] >= 9)
				{
					if(sscanf(inputtextsave,"s[100]",reason)) return SPD(playerid,1219,DIALOG_STYLE_INPUT,"Priezastis","Iveskite atleidimo priezasti\n\tPavyzdziui: S/N","Atlikta", !"Atsaukti");
					if(IsGiveWarn(playerid, id))
					{
						if(id != playerid)
						{
							if(PI[id][pLeader] > 0) return SCM(playerid,COLOR_RED,!"Negalite pasalinti lyderio is organizacijos!");
							if(PI[playerid][pRank]==PI[id][pRank])return 0;
							//if(pSportZal[id] == 1) return SCM(playerid,COLOR_RED,!"Jisai dabar sporto saleje!");

							UnInvite(id);

							SCMF(id, COLOR_LIGHTBLUE, "{FFFFFF}%s jus pasalino is organizacijos.\nPriezastis: %s", PN(playerid), reason);

							SCMF(playerid, COLOR_LIGHTBLUE, "Jus pasalinote %s. Priezastis: %s",PN(id), reason);

						}
						else SCM(playerid,COLOR_GREY, !"Saves negalima");
					}
					else SCM(playerid,COLOR_GREY, !"Sis zaidejas priklauso kitai organizacijai");
				}
				else SCM(playerid,COLOR_GREY, !"Jus nesate lyderis ir ne lyderio pavaduotojas");
			}
		}
		case 1220:
		{
			if(response)
			{
				if(PI[playerid][pLeader] > 0 || PI[playerid][pRank] >= 9)
				{
					new id, time;
					id = ViborSERIU[playerid];
					if(sscanf(inputtextsave,"p<,>ds[100]",time, global_str)) return SPD(playerid,1220,DIALOG_STYLE_INPUT,"MUTE","Iveskite MUTE laika ir priezasti\n\tPavyzdziui: 5,keiksmazodis","Atlikta", !"Atsaukti");
					if(GetTeamID(id) == GetTeamID(playerid))
					{
						if(time > 0)
						{
						    if(PI[id][pLeader] > 0 ) return SCM(playerid,COLOR_RED,!"Jus ne galite nutildyti Lyderi");
							f(global_str, 256,"Lyderis %s nutilde zaideja %s %d minutems. Priezastis: %s",PN(playerid),PN(id),time,global_str);
							SendTeamMessage(GetTeamID(playerid), COLOR_RED, global_str);
							PI[id][pFMuteTime] = time*60;
						}
					}
				}
			}
		}
		case 1221:
		{
			if(response)
			{
				if(PI[playerid][pLeader] > 0 || PI[playerid][pRank] >= 9)
				{
