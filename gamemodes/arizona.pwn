stock UnInvite(playerid)
{
	if IsACop(playerid) *then
	{
		if UsingShield{playerid} *then RemovePlayerAttachedObject(playerid, 7);
		PI[playerid][pShield] = 0.0;
	}

	PI[playerid][pLeader] =
	PI[playerid][pMember] =
	PI[playerid][pDCTime]=
	PI[playerid][pRank] =
	PlayerJob[playerid] =
	pSportZal[playerid] = 0;

	SCM(playerid, COLOR_WHITE, !">> {FF6347} Spawno vieta automatiskai paskirta gelezinkelio stotyje. Pakeisti spawno vieta {FFFFFF}>> {FF6347}/setspawn!");
	TeamDuty{playerid} = false;
	SetPlayerColor(playerid, 0xFDFCFC15);
	ResetSpawnInfo(playerid, 0);
	_ResetGun(playerid);
	UpdatePlayerArmour(playerid, 0);
	SaveAccount(playerid);
	return SetBumSkin(playerid);
}

stock BuyVIP(playerid, caseId, VIP = 0)
{
	if PI[playerid][pVIP] >= VIP *then
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Jus jau turite si VIP lygi!");

	switch caseId do
	{
		case 8999:
		{
            if PI[playerid][pVirMoney] < 3000 *then
				return SCM(playerid, COLOR_OLDRED,!"[Klaida] {FFFFFF}Neturite pakankamai SAG-Coins!");

		    GiveDonate(playerid, -3000);
			PI[playerid][pVIP] = 5;
			PI[playerid][pVipTime] = Global_Time+(1800*24*60*60);

			SPD(playerid,0,0,!"","{5FDA27}Sveikiname su pirkiniu Titan VIP!\n\n{FFFFFF}Savo galimybes galite perziureti /help.", !"Priimti","");

			global_str = "Titan VIP.";
		}
		case 8997:
		{
            if PI[playerid][pVirMoney] < 7500 *then
				return SCM(playerid, COLOR_OLDRED, !"[Klaida] {FFFFFF}Neturite pakankamai SAG-Coins!");

			GiveDonate(playerid, -7500);
			PI[playerid][pVIP] = 6;
			PI[playerid][pVipTime] = Global_Time+(1800*24*60*60);
			AddItem(playerid, 703, 1);

			SPD(playerid,0,0,!"","{5FDA27}Sveikiname su pirkiniu PREMIUM VIP!\n\n{FFFFFF}Savo galimybes galite perziureti /help.", !"Priimti","");

			global_str = "PREMIUM VIP.";
		}
	}

	SQL("UPDATE `accounts` SET `VIP` = '%d', `VipTime` = '%d' WHERE `ID` = '%d'", PI[playerid][pVIP], PI[playerid][pVipTime], PI[playerid][pID]);

	f(global_str, 100, "[Informacija]{FFFFFF} Zaidejas %s isigyjo %s", PN(playerid), global_str);
	SCMALL(COLOR_RED, global_str);

	return true;
}

stock SavePlayerLauncher(playerid)
{
	global_str = "";

	for new i; i < 9; i++ do
		f(global_str, 50, "%s%d,", global_str, PI[playerid][LauncherData][i]);
	return SQL("UPDATE `accounts` SET `LauncherSettings` = '%s' WHERE `ID` = '%d'", global_str, PI[playerid][pID]);
}

stock UpdatePlayerLauncher(playerid)
{
	if !IsPlayerCefInit(playerid) *then
	{
		for new i; i < 3; i++ do
		{
			if PI[playerid][LauncherData][i] >= (i == 1 ? 4:3) *then
				PI[playerid][LauncherData][i] = 2;
		}
	}
	else
	{
		for new i; i < 2; i++ do
		{
			if 1 <= PI[playerid][LauncherData][i] <= 2 *then
				PI[playerid][LauncherData][i] = (i ? 5:3);
		}
	}

	for new i; i < 9; i++ do
	{
		switch i do
		{
			case 0:
				SavePlayerLauncher(playerid);

			case 1:
			{
				for new j; j < 3; j++ do
				{
					if !PI[playerid][LauncherData][i] *then
						TextDrawShowForPlayer(playerid, Logotype[j]);

					else
						TextDrawHideForPlayer(playerid, Logotype[j]);
				}

				ShowPlayerHud(playerid);
			}
			case 2..5, 7:
		 	{
				static const browserId[] = {9, 33, 39, 42, -1, 53};

				if IsPlayerCefInit(playerid) *then
					UpdateBrowser(playerid, browserId[i - 2], PI[playerid][LauncherData][i]);

				else
				{
					switch i do
					{
						case 2:
							Interface_Arizona(playerid, Arz_Radar, PI[playerid][LauncherData][i]);

						case 3:
							Interface_Arizona(playerid, Arz_TransparentChat, PI[playerid][LauncherData][i]);

						case 4:
							Interface_Arizona(playerid, Arz_SaveDialog, PI[playerid][LauncherData][i]);

						case 5:
							Interface_Arizona(playerid, Arz_NewNametag, PI[playerid][LauncherData][i]);

						case 7:
							Interface_Arizona(playerid, Arz_RenderDialog, PI[playerid][LauncherData][i]);
					}
				}
			}
			case 6: ShowPlayerSnow(playerid);
			case 8: ShowPlayerHotKeys(playerid);
		}
	}

	if PI[playerid][LauncherData][1] *then
	{
		if !IsPlayerCefInit(playerid) and GetPlayerLauncher(playerid) *then
			Interface_Arizona(playerid, Arz_Hunger, Fullness[playerid]);

		Hunger(playerid, 1);
	}

	return SavePlayerLauncher(playerid);
}

stock ShowPlayerSnow(playerid)
{
	if IsPlayerCefInit(playerid) *then
	{
		new BitStream:snow = BS_New();

		BS_WriteValue(snow, PR_UINT8, 220);
		BS_WriteValue(snow, PR_UINT8, !PI[playerid][LauncherData][6] ? 48 : 47);
		BS_WriteValue(snow, PR_UINT8, 8);
		BS_WriteValue(snow, PR_UINT8, 83);
		BS_WriteValue(snow, PR_UINT8, 78);
		BS_WriteValue(snow, PR_UINT8, 79);
		BS_WriteValue(snow, PR_UINT8, 87);
		BS_WriteValue(snow, PR_UINT8, 70);
		BS_WriteValue(snow, PR_UINT8, 88);
		BS_WriteValue(snow, PR_UINT16, 73);
		BS_WriteValue(snow, PR_UINT32, 0);
		BS_WriteValue(snow, PR_UINT32, 0);
		BS_WriteValue(snow, PR_UINT8, 128);
		BS_WriteValue(snow, PR_UINT8, 63);
		BS_WriteValue(snow, PR_UINT8, 0);
		BS_WriteValue(snow, PR_UINT8, 0);
		BS_WriteValue(snow, PR_UINT8, 0);
		BS_WriteValue(snow, PR_UINT8, 64);
		BS_WriteValue(snow, PR_UINT8, 0);
		BS_WriteValue(snow, PR_UINT8, 208);
		BS_WriteValue(snow, PR_UINT8, 7);
		BS_WriteValue(snow, PR_UINT8, 0);
		BS_WriteValue(snow, PR_UINT8, 0);

		return PR_SendPacket(snow, playerid);
	}
	else if !IsPlayerCefInit(playerid) && GetPlayerLauncher(playerid) *then
		return Interface_Arizona(playerid, Arz_Snow, PI[playerid][LauncherData][6]);

	return true;
}

