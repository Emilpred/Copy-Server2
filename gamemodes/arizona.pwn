					case 14355: return 732;
					case 14279: return 733;
					case 14276: return 734;
					case 6662: return 737;
					case 6663: return 738;
					case 6664: return 739;
					case 6665: return 740;
					case 6666: return 741;
					case 6667: return 742;
					case 6668: return 743;
					case 6669: return 744;
					case 6670: return 745;
					case 6671: return 746;
					case 6672: return 747;
					case 14339: return 748;
					case 6689: return 749;
					case 6690: return 750;
					case 6691: return 751;
					case 6692: return 752;
					case 12629: return 753;
					case 14358: return 754;
				}
			}
			case 5:
			{
				switch item do
				{
					case 1172..1242: return item - 1172; /*70*/
					case 1253..1258: return 71 + item - 1253; /*76*/
					case 1331..1340: return 77 + item - 1331; /*86*/
					case 2014..2094: return 87 + item - 2014; /*167*/
					case 2100..2206: return 168 + item - 2100; /*274*/
					case 2234..2271: return 275 + item - 2234; /*312*/
					case 2468..2510: return 313 + item - 2468; /*355*/
					case 2613..2636: return 356 + item - 2613; /*379*/
					case 2637..2651: return 380 + item - 2637; /*394*/
					case 2652..2660: return 395 + item - 2652; /*403*/
					case 2779..2795	: return 404 + item - 2779; /* 421 */
				}
			}
		}
	}
	else return item;

	return true;
}

