	{C2A2DA}Malonaus zaidimo San Andreas Gyvenime!", !"Uzdaryti", !"", XDonate, XPayDay, Mode_Site, Mode_Forum, Server_VKontakte, Mode_Site);
	SCM(playerid, COLOR_WHITE, !"{DFCFCF}[Uzuomina] {DC4747}Serveryje yra inventorius, naudokite klavisa 'Y', kad galetumete su juo dirbti.");
 	SCM(playerid, COLOR_WHITE, !"{DFCFCF}[Uzuomina] {DC4747}Galite uzduoti klausima musu techninei pagalbai per /report.");
    if(PI[playerid][pSkin] != 0) SCMF(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Siuo metu turite {FFF000}%d{ffffff} Laimes rato sukimu", GetCount(playerid, 2511));

	if(GetPlayerLauncher(playerid))
	{
		ShowPlayerHud(playerid);
		UpdatePlayerLauncher(playerid);
		SavePlayerLauncher(playerid), ShowLogo(playerid);
	}

	if !PI[playerid][pSkin] *then
		Inventory[playerid][0][0] = 313, Inventory[playerid][1][0] = 1, SCM(playerid, COLOR_YELLOW, !"Jums buvo pridetas daiktas 'Ruletes skrynia'. Noredami atidaryti inventoriu, naudokite klavisa 'Y' arba /invent");
	if !PI[playerid][pSkin] *then AddItem(playerid, 2511), SCM(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Jus gavote nemokama Laimes rato sukima!"), SCM(playerid, COLOR_VALIK, "[Laimes ratas] {FFFFFF}Laimes rato sukima galite atlikti Casino (/gps - Ivairus - Casino 4 Dragons)");
	SPDF(playerid, 15330, DIALOG_STYLE_MSGBOX, !"\
				San Andreas Gyvenimo akcijos", "{ffffff}Mes dziaugiames matydami jus serveryje.\n\
				Dabar serveryje veikia akcija {FA5858}X1 saskaitos papildymas {ffffff}ir {FA5858}X1 PayDay\n\n\
				{42B02C}Prekes uz SAG-Eurus:{cccccc} /donate\n\
				{42B02C}Veikia premiju programa:{cccccc} /bonus\n\
				{42B02C}Uz kiekviena suzaista valanda gausite po 1 bilieta:{cccccc} /bilet\n\n\
				{FF69B4}Rask dovanas ir atidaryk dezutes. Pagrindinis prizas {ffffff}BMW X5!\n\
				{ffffff}Musu Site: {cccccc}%s\n\
				{ffffff}Forumas: {cccccc}%s\n\
				{ffffff}Discord Grupe: {cccccc}%s\n\
				{ffffff}Atsisiusti Launcher: {cccccc}"Mode_Site"\n\
				{ffffff}Donate Site: {cccccc}%s\n\n\
	{C2A2DA}Gero zaidimo San Andreas Gyvenimas!", !"Uzdaryti", !"", XDonate, XPayDay, Mode_Site, Mode_Forum, Server_VKontakte, Mode_Site);
 	if GiveMeBackMyBTC[playerid] *then
 	{
		AddItem(playerid, 1461, GiveMeBackMyBTC[playerid]);
		GiveMeBackMyBTC[playerid] = 0;
		SCM(playerid, COLOR_VALIK, "Jus sekmingai pardavete nama aukcione!");
 	}
	if BitcoinUpdate *then
	{
		if BitcoinUpdate > 0 *then
			AddItem(playerid, 1461, BitcoinUpdate);
		else
			DeleteItem(playerid, 1461, abs(BitcoinUpdate));
		UpdatePlayerDataInt(playerid, "BitcoinUpdate", BitcoinUpdate = 0);
	}
	foreach(Admin, i)
	{
		if PI[i][pAdmin] && ADuty{i} *then
		{
			if !AdminInfo[i][admIP] *then f(global_str, 256, "Zaidejas/admin %s[%d] uzejo [reg ip:%s] -- [norm ip: %s]", PN(playerid), playerid, PlayerRegIP[playerid], PlayerIp[playerid]);
			else f(global_str, 128, "zaidejas/admin %s[%d] uzejo.", PN(playerid), playerid);
			SCM(i, COLOR_OLDRED, global_str);
		}
	}
	if PI[playerid][pLeader] *then
	{
	    if !GetString(OrgInfo[PI[playerid][pLeader]][oLeader], PN(playerid)) *then
	    {
	        if IsACop(playerid) *then
			{
				if(UsingShield{playerid}) RemovePlayerAttachedObject(playerid, 7);
				PI[playerid][pShield] = 0.0;
			}
	    	SCM(playerid, COLOR_WHITE, ">> {FF6347}Spawno vieta automatiskai priskirta gelezinkelio stotyje. Pakeisti spawno vieta {ffffff}>> {FF6347}/setspawn!");
	    	SCM(playerid, COLOR_GREY, !"Jus buvote nusalintas nuo lyderio pareigu");
	    	PI[playerid][pLeader] =
	    	PI[playerid][pMember] =
	    	PI[playerid][pDCTime] =
	    	PI[playerid][pRank] = 0;
	    	SetBumSkin(playerid);
	    }
	}
	if PI[playerid][pRank] > 0 && PI[playerid][pMember]==0 *then
		PI[playerid][pRank] = 0;
	if(PI[playerid][pCredit] > 200000)
	{
	    SCMF(playerid, COLOR_ACHAT, "Isiskolinimas centrinio banko yra: %d$. Sumokekite kredita, kad isvengtumete paskyros blokavimo.", PI[playerid][pCredit]);
	    SAMF(COLOR_ORANGE, "[A] %s[%d] isijunge i zaidima. Siuo metu jo banke yra %d$ isiskolinimas", PN(playerid), playerid, PI[playerid][pCredit]);
	    OrgInfo[TEAM_BANK][oBank] += 100000;
	    if(OrgInfo[TEAM_BANK][oBank] > 2000000000) OrgInfo[TEAM_BANK][oBank] = 2000000000;
	    SaveOrg(TEAM_BANK);
	}
	if(GetTrailer(playerid) != -1)
	{
	    if(IsValidTrailer(GetTrailer(playerid)))
	    {
			if(!TrailerInfo[GetTrailer(playerid)][tParked] && PI[playerid][pDCTime] == 4) PI[playerid][pDCTime] = 0;
			PI[playerid][pTrailerKey] = GetTrailer(playerid);
		}
	}
	if(PI[playerid][pWarns] > 0)
	{
		PI[playerid][pMember] = 0;
		PI[playerid][pLeader] = 0;
		PI[playerid][pRank] = 0;
		if(PI[playerid][pDCTime] == 2) PI[playerid][pDCTime]=0;
	}
    if(PI[playerid][pWarns] > 2)
	{
	    SCM(playerid, COLOR_RED, !"Jusu paskyra uzblokuota!");
	    PI[playerid][pWarns] = 0;
		BanPlayer(playerid);
	}
	switch(PI[playerid][pDCTime])
	{
	    case 1: if(PI[playerid][pHouseKey] == -1) PI[playerid][pDCTime] = 0;
	    case 2: if(!PI[playerid][pMember]) PI[playerid][pDCTime] = 0;
	}
	foreach(Vehicle, i)
	{
	    if !IsValidVehicle(OwnableCar[i]) *then
			continue;
	    if GetString(CarInfo[i][cOwner], PN(playerid)) *then
			DestroyVehicleEx(OwnableCar[i]);
	}
	NoEnterPickup[playerid] = 6;
	if PI[playerid][pVIP] < 5 *then
	{
		if !( floatround( (PI[playerid][pVipTime] - Global_Time)/3600/24, floatround_ceil )>= 1) *then
	    {
	        if(PI[playerid][pVIP] > 0)
	     	{
		        if(PI[playerid][pVIP] > 1)
		    	{
			     	SCM(playerid, COLOR_LIGHTBLUE, "[Svarbu] {FFFFFF}Jusu VIP paskyros galiojimo laikas baigesi, VIP lygis buvo sumazintas ir pratestas!");
			    	PI[playerid][pVipTime] = Global_Time + (30 * 24 * 60 * 60);
		    	}
                else if(PI[playerid][pVIP] == 1) SCM(playerid, COLOR_LIGHTBLUE, "[Svarbu] {FFFFFF}Jusu VIP paskyros galiojimo laikas baigesi, VIP lygis buvo panaikintas.");
	       		PI[playerid][pVIP] --;
     		}
    	}
	}
	if IsValidHouse(PI[playerid][pHouseKey]) *then
	{
	    new bool: on = false;
		new s = GetHouseStyle(PI[playerid][pHouseKey]);
		if(s != -1)
		{
			for(new i; i < HouseRooms[s]; i++)
			{
				if(GetString(HRoomOwner[PI[playerid][pHouseKey]][i], PN(playerid)))
				{
	                on = true;
	                break;
				}
			}
			if(on == false && !GetString(HouseInfo[PI[playerid][pHouseKey]][hOwner], PN(playerid))) PI[playerid][pHouseKey] = -1;
		}
	}
	else
		PI[playerid][pHouseKey] = -1;
	if !(PI[playerid][pFarmOwner] == -1) && !GetString(FarmData[PI[playerid][pFarmOwner]][farmOwner], PlayerName[playerid]) *then
		UpdatePlayerDataInt(playerid, "FarmOwner", PI[playerid][pFarmOwner] = -1);
	if PI[playerid][pInvCell] == 144 *then
		UpdatePlayerDataInt(playerid, "InvCell", PI[playerid][pInvCell] = 144);
	if !(FP_Data[playerid][F_FAMILY_ID] == -1) *then
		LoadFamilyDataPlayer(playerid, FP_Data[playerid][F_FAMILY_ID]);
	if !GetString(PI[playerid][pLastIP], PlayerRegIP[playerid]) *then
		AcceptAdm{playerid} = false;
	GetPlayerIp(playerid, PI[playerid][pLastIP], 16);
	GangZoneShowForPlayer(playerid, ZoneFix, 0x000000FF);
	if GetPlayerADDVIP(playerid) *then
	    return PlayerADDVIPSpawn(playerid), pTemp[playerid][tAddVipSpawn] = 1;
	else
		return PlayerSpawn(playerid);
}

