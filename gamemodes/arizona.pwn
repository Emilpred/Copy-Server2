				\n{FFFFFF}Namo klase: {AFAFAF}%d\
				\n{FFFFFF}Kaina: {AFAFAF}$%d\
				\n{FFFFFF}Garazas: {AFAFAF}%s",
				house,
				HouseInfo[house][hKlass],
				HouseInfo[house][hCost],
				hgarage_status[HouseInfo[house][hGarage]]);
			}
			case 1:
			{
				f(global_str, 300,
				"{FF9900}*** Namas parduodamas ***\
				\n\n{FFFFFF}Namo numeris: {AFAFAF}%d\
				\n{FFFFFF}Namo klase: {AFAFAF}%d\
				\n{FFFFFF}Kaina: {AFAFAF}%d SAG-Coins\
				\n{FFFFFF}Garazas: {AFAFAF}%s",
				house,
				HouseInfo[house][hKlass],
				HouseInfo[house][hCost],
				hgarage_status[HouseInfo[house][hGarage]]);
			}
			case 2: { f(global_str, 300,
				"{FF9900}*** Butas parduodamas ***\
				\n\n{FFFFFF}Buto numeris: {AFAFAF}%d\
				\n{FFFFFF}Kaina: {AFAFAF}$%d", house, HouseInfo[house][hCost]);
			}
		}
		if(HouseInfo[house][hType] != 2) HouseIcon[house] = CreateDynamicMapIcon(HouseInfo[house][hEnter_X], HouseInfo[house][hEnter_Y], HouseInfo[house][hEnter_Z], 31, 0, 0, 0);
	}
	else
	{
		switch HouseInfo[house][hType] do
		{
			case 0,1:
			{
				GetMysqlData("houses", "Name", house);
				if strlen(mysql_string) > 3 *then
				{
					f(global_str, 300,
						"{FF9900}*** Namas uzimtas ***\n\
						{FFFF00}%s\
						\n\n{FFFFFF}Namo numeris: {AFAFAF}%d\
						\n{FFFFFF}Namo klase: {AFAFAF}%d\
						\n{FFFFFF}Durys: %s\
						\n{FFFFFF}Garazas: {AFAFAF}%s",
						mysql_string,
						house,
						HouseInfo[house][hKlass],
						dour_status[HouseInfo[house][hLock]],
						hgarage_status[HouseInfo[house][hGarage]]
					);
				}
				else
				{
					f(global_str, 300,
						"{FF9900}*** Namas uzimtas ***\
						\n\n{FFFFFF}Namo numeris: {AFAFAF}%d\
						\n{FFFFFF}Namo klase: {AFAFAF}%d\
						\n{FFFFFF}Durys: %s\
						\n{FFFFFF}Garazas: {AFAFAF}%s",
						house,
						HouseInfo[house][hKlass],
						dour_status[HouseInfo[house][hLock]],
						hgarage_status[HouseInfo[house][hGarage]]
					);
				}
			}
			case 2:
			{
				f(global_str, 300,
				"{FF9900}*** Butas uzimtas ***\
				\n\n{FFFFFF}Buto numeris: {AFAFAF}%d\
				\n{FFFFFF}Savininkas: {AFAFAF}%s\
				\n{FFFFFF}Durys: %s",house,HouseInfo[house][hOwner], dour_status[HouseInfo[house][hLock]]);
			}
		}

		if(HouseInfo[house][hType] != 2) HouseIcon[house] = CreateDynamicMapIcon(HouseInfo[house][hEnter_X], HouseInfo[house][hEnter_Y], HouseInfo[house][hEnter_Z], 32, 0, 0, 0);
	}

	HouseInfo[house][H_PICKUP_ID] = CreateDynamicPickup( !GetString(HouseInfo[house][hOwner], "The State") ? 19522:1273, 23, HouseInfo[house][hEnter_X], HouseInfo[house][hEnter_Y], HouseInfo[house][hEnter_Z], 0, -1);
	HouseInfo[house][H_AREA_ID] = CreateDynamicSphere(HouseInfo[house][hEnter_X], HouseInfo[house][hEnter_Y], HouseInfo[house][hEnter_Z], 1.25, 0);

	return UpdateDynamic3DTextLabelText(House3DText[house], COLOR_WHITE, global_str);
}

stock SellHouse(houseid)
{
    HouseInfo[houseid][hLevel] = 1;
    SetString(HouseInfo[houseid][hOwner], "The State");
    HouseInfo[houseid][hLock] =
	HouseInfo[houseid][hRent] =
    HouseInfo[houseid][hMoney] =
    HouseInfo[houseid][hDrugs] =
    HouseInfo[houseid][hMats] =
    HouseInfo[houseid][hBar] =
    HouseInfo[houseid][hPodval] =
    HouseInfo[houseid][hNalog] =
    HouseInfo[houseid][hNalog2] =
    HouseInfo[houseid][hNoOwner] =
    HouseInfo[houseid][hMed] = 0;
	ResetHouse(houseid);
    UpdateHouse(houseid);
	return true;
}
stock WipeSklad(skladid)
{
    for new i; i < 150; i++ do
    {
        SkladData[skladid][skItem][i] = 0;
        SkladData[skladid][skItemCount][i] = 0;
        SkladData[skladid][skItemLevel][i] = 0;
		SkladData[skladid][skItemProc][i] = 0;
        SkladData[skladid][skItemTypeNashiv][i] = 0;
        SkladData[skladid][skItemLvlNashiv][i] = 0;
        SkladData[skladid][skItemColor][i] = 0;
    }
    SetString(SkladData[skladid][skOwner], "The State");
    SetString(SkladData[skladid][skPassword], "1111");
	SkladData[skladid][skMoney] = 0;
	UpdateSklad(skladid);

	return true;
}
stock SellBiz(bizid)
{
    SetString(BizData[bizid][bOwner], "The State");
