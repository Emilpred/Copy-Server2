	AddItem(playerid, 716, 1);
	SCM(playerid, COLOR_GREEN, "[Informacija] {FFFFFF}Svorio patikra buvo sekmingai atlikta!");
}
stock GiveGruz(playerid, type)
{
	new model, Float:X, Float:Y, Float:Z;
	switch(pTemp[playerid][TruckCuty])
	{
	    case 1:
		{
			new r = random(5);
			switch(type)
			{
			    case 1: model = 584, TruckGruzFuelLS--;
			    case 2: model = 591, TruckGruzAmmoLS--;
			    case 3: model = 435;
			}
			TruckGruz[playerid] = J_AddStaticVehicleEx(model, TruckPosLS[r][0],TruckPosLS[r][1],TruckPosLS[r][2],TruckPosLS[r][3], 1, 1);
			SCM(playerid, COLOR_YELLOW, "[Informacija] Jus gavote dokumentus del automobilinio kuro. Pakrauta priekaba su kuru yra aiksteleje, prijunkite ja prie sunkvezimio.");
			SCM(playerid, COLOR_GREY, "[Uzuomina] Norint prijungti priekaba/cisterna, reikia privaziuoti atgal prie priekabos prikabinimo irenginio. Sulyginimas ivyks automatiskai.");
	    }
	    case 2:
	    {
			new r = random(5);
			switch(type)
			{
			    case 1: model = 584, TruckGruzFuelSF--;
			    case 2: model = 591, TruckGruzAmmoSF--;
			    case 3: model = 435;
			}
			TruckGruz[playerid] = J_AddStaticVehicleEx(model, TruckPosSF[r][0],TruckPosSF[r][1],TruckPosSF[r][2],TruckPosSF[r][3], 1, 1);
			SCM(playerid, COLOR_YELLOW, "[Informacija] Jus gavote dokumentus del ginklu medziagu. Pakrauta priekaba su medziagomis yra aiksteleje, prijunkite ja prie sunkvezimio.");
			SCM(playerid, COLOR_GREY, "[Uzuomina] Norint prijungti priekaba/cisterna, reikia privaziuoti atgal prie priekabos prikabinimo irenginio. Sulyginimas ivyks automatiskai.");
	    }
	    case 3:
	    {
			new r = random(5);
			switch(type)
			{
			    case 1: model = 584, TruckGruzFuelLV--;
			    case 2: model = 591, TruckGruzAmmoLV--;
			    case 3: model = 435;
			}
			TruckGruz[playerid] = J_AddStaticVehicleEx(model, TruckPosLV[r][0],TruckPosLV[r][1],TruckPosLV[r][2],TruckPosLV[r][3], 1, 1);
			SCM(playerid, COLOR_YELLOW, "[Informacija] Jus gavote dokumentus del produktu. Pakrauta priekaba su produktais yra aiksteleje, prijunkite ja prie sunkvezimio.");
			SCM(playerid, COLOR_GREY, "[Uzuomina] Norint prijungti priekaba/cisterna, reikia privaziuoti atgal prie priekabos prikabinimo irenginio. Sulyginimas ivyks automatiskai.");
	    }
	}
	GetVehiclePos(TruckGruz[playerid], X, Y, Z);
	EnableGPSForPlayer(playerid, X, Y, Z);
	GruzPlayer[playerid] += type;
	TruckTime{playerid} = 0;
	VehicleHealth[TruckGruz[playerid]] = 1000;
 	SetEngineStatus(TruckGruz[playerid], false, playerid);
}
