public: @GiveOfflineDemote(playerid, demote_type, params[])
{
	if !cache_get_row_count() *then
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Tokios paskyros neegzistuoja.");

	if TextFind(params, "'") *then
		return SCM(playerid, COLOR_RED, !"[Klaida] {FFFFFF}Priezastyje nurodan draudziama naudoti spec. simbolius (_ @ $ ir t.p.)");

	new data = cache_get_row_int(0, 1, mysql);

	switch demote_type do
	{
		case offline_demote_mute, offline_demote_jail:
			sscanf(params, "s[24]ds[144]", demote_name, demote_time, demote_reason);

		case offline_demote_ban:
			sscanf(params, "ds[24]ds[144]", demote_typeban, demote_name, demote_time, demote_reason);

		case offline_demote_warn:
			sscanf(params, "s[24]s[144]", demote_name, demote_reason);
	}

	if strlen(demote_reason) > 30 *then
		return SCM(playerid, COLOR_RED, !"Ne daugiau nei 30 simboliu!");

	switch demote_type do
	{
		case offline_demote_mute:
		{
			if !(1 <= demote_time <= 300) *then
				return SCM(playerid,COLOR_RED, !"Negalima isduoti MUTE ilgiau nei 300 minutems!");

			SQL("UPDATE `accounts` SET `MuteTime`= %d WHERE `NickName`= BINARY('%s') LIMIT 1;", demote_time * 60, demote_name);

			f(global_str, 300, "A: %s nustate offline %d minuciu MUTE zaidejui %s. Priezastis: %s", PlayerName[playerid], demote_time, demote_name, demote_reason);
			ASCMALL(COLOR_RED,global_str);

			ANL(demote_name, global_str);

			return amlf("Administratorius <a href=../pages/user?name=%s>%s</a> nustate offline %d minuciu MUTE zaidejui <a href=../pages/user?name=%s>%s</a>. Priezastis: %s", 5, PN(playerid),demote_name, PlayerName[playerid], PlayerName[playerid], demote_time, demote_name, demote_name, demote_reason);
		}

		case offline_demote_jail:
		{
			if !(1 <= demote_time <= 3000) *then
				return SCM(playerid, COLOR_RED, !"Negalima pasodinti (0-3000)");

			SQL("UPDATE `accounts` SET `Demorgan` = '%d', `Pcix` = `Pcix` + 1 WHERE `NickName` = BINARY('%s') LIMIT 1;", demote_time * 60, demote_name);

			f(global_str, 200, "A: %s nustate offline %d minuciu kalejime zaidejui %s. Priezastis: %s", PlayerName[playerid], demote_time, demote_name, demote_reason);
			ASCMALL(COLOR_RED, global_str);

			ANL(demote_name, global_str);

			return amlf("Administratorius <a href=../pages/user?name=%s>%s</a> pasodino offline zaideja <a href=../pages/user?name=%s>%s</a> i demorgana ant %d minuciu. Priezastis: %s", 5, PN(playerid),demote_name, PlayerName[playerid], PlayerName[playerid], demote_name, demote_name, demote_time, demote_reason);

		}

		case offline_demote_warn:
		{
			if data >= 3 *then
				return SCM(playerid, COLOR_OLDRED, !"Sis zaideja jau turi 3 WARN.");

			SQL("UPDATE `accounts` SET `Warns`= '%d', `TimeToLastWarn`= '%d' WHERE `NickName` = BINARY('%s') LIMIT 1;", data + 1, Global_Time, demote_name);


			f(global_str, 300, "A: %s isdave WARN offline zaidejui %s (%d/3), priezastis: %s", PlayerName[playerid], demote_name, data + 1, demote_reason);
			ASCMALL(COLOR_RED, global_str);
		}

		case offline_demote_ban:
		{
			if !(1 <= demote_time <= 2000) *then
				return SCM(playerid, COLOR_OLDRED, !"Naudokite: /banoff [0 be anuliavimu/1 su anuliavimu] [name] [dienu] [Priezastis]");

			if demote_typeban *then
			{
				SQL("UPDATE `accounts` SET `Admin` = '0', `Member` = '0', `Rank` = '0', `VIP` = '0', `VipTime` = '0', `Skin` = '0', `Item` = '0', `ItemKolvo` = '0', `ItemLevel` = '0', `ItemProc` = '0', `Aks` = '0,0,0,0,0,0,0,0,', `VirMoney` = '0', `Roubles` = '0', `Money` = '0', `Bank` = '0', `Deposit` = '0', `Bitcoin` = '0', `Euro` = '0' WHERE `NickName` = BINARY('%s') LIMIT 1;", demote_name);
				SQL("UPDATE `ownable` SET `Owner` = 'The State', `Keyer` = 'The State' WHERE `Owner` = BINARY('%s')", demote_name);
				SCMF(playerid, COLOR_VALIK, "[Informacija] {FFFFFF}Jus anuliavote pakyra zaidejui %s", demote_name);
			}

			f(global_str, 150 , "A: %s uzblokavo offline zaideja %s. Priezastis: %s", PlayerName[playerid], demote_name, demote_reason);
			ASCMALL(COLOR_RED, global_str);
			ANL(demote_name, global_str);

			BanName(demote_name, PlayerName[playerid], demote_time, demote_reason);

			return amlf("Administratorius <a href=../pages/user?name=%s>%s</a> uzblokavo <a href=../pages/user?name=%s>%s</a> ant %d dienu%s. Priezastis: %s", 5, PN(playerid),demote_name, PlayerName[playerid], PlayerName[playerid], demote_name, demote_name, demote_time, demote_typeban ? " [su anuliavimu]" : "", demote_reason);
		}

		default:
			return false;
	}

	return true;
}

new
	BackgroundTimer[MAX_PLAYERS],
	BackgroundBox[MAX_PLAYERS],
 	PlayerText:Background[MAX_PLAYERS] = {PlayerText:INVALID_TEXT_DRAW, ...};

stock OpenBackgroundPlayer(playerid) {

    if !BackgroundBox[playerid] *then {

        Background[playerid] = CreatePlayerTextDraw(playerid, -12.0000, -10.3555, "Box");

        PlayerTextDrawLetterSize(playerid, Background[playerid], 0.0000, 53.6333),
        	PlayerTextDrawTextSize(playerid, Background[playerid], 680.0000, 0.0000),
        		PlayerTextDrawUseBox(playerid, Background[playerid], 1),
        			PlayerTextDrawBoxColor(playerid, Background[playerid], 255);

        BackgroundBox[playerid] = 0;
        BackgroundTimer[playerid] = CallTimeOutFunction("@_BackgroundTimer", true, 60, "ii", playerid, 1);
    }

}

stock HideBackgroundPlayer(playerid)
    if BackgroundBox[playerid] > 0 *then
        BackgroundBox[playerid] = 255,
        	BackgroundTimer[playerid] = CallTimeOutFunction("@_BackgroundTimer", true, 60, "ii", playerid, 2);

public: @_BackgroundTimer(playerid, type)
{
    PlayerTextDrawBoxColor(playerid, Background[playerid], BackgroundBox[playerid]);
    PlayerTextDrawShow(playerid, Background[playerid]);

    if type == 1 *then {

        if ++ BackgroundBox[playerid] >= 255 *then
			KillTimer(BackgroundTimer[playerid]);

    } else {

        if -- BackgroundBox[playerid] <= 0 *then {

            DestroyPlayerTD(playerid, Background[playerid]);
            KillTimer(BackgroundTimer[playerid]);

        }
    }

    return true;
}

stock srlenchar(const Text[], const symbol)
{
	new Result;

	for new i; i < strlen(Text); i++ do {

		if Text[i] == symbol *then
			Result ++;

	}

	return Result;
}
