	}
    for(new i;i < sizeof(ZfarmCP);i ++)
	{
	    if(i < sizeof(ZfarmCP)-1) Zfarm_CP[i] = CreateDynamicRaceCP(3,ZfarmCP[i][0],ZfarmCP[i][1],ZfarmCP[i][2],ZfarmCP[i+1][0],ZfarmCP[i+1][1],ZfarmCP[i+1][2],7.0,-1,-1,-1,1000.0);
