			SCMF(playerid, COLOR_YELLOW, "JUs isemete {ffffff}%d BTC{ffff00}, liko vaizdo plokstes saskaitoje: {ffffff}%f BTC.", cardOutput, MiningBTC[hId][cardPos][card_balance]);

			return SaveMiningBTC(hId);
