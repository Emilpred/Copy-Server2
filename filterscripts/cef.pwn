			[49,1,0,50,100], [50,1,0,50,100], [51,1,0,50,100], [52,1,0,50,100], \
	    	[53,1,0,50,100], [54,1,0,50,100], [55,1,0,50,100], [56,1,0,50,100], \
			[57,1,0,50,100], [58,1,0,50,100], [59,1,0,50,100], [60,1,0,50,100], \
			[61,1,0,50,100], [62,1,0,50,100], [63,1,0,50,100], [64,1,0,50,100], \
			[65,1,0,50,100], [66,1,0,50,100], [67,1,0,50,100], [68,1,0,50,100], \
			[69,1,0,50,100], [70,1,0,50,100], [71,1,0,50,100], [72,1,0,50,100], \
			[73,1,0,50,100], [74,1,0,50,100], [75,1,0,50,100], [76,1,0,50,100], \
			[77,1,0,50,100], [78,1,0,50,100], [79,1,0,50,100], [80,1,0,50,100], \
			[81,1,0,50,100], [82,1,0,50,100], [83,1,0,50,100], [84,1,0,50,100], \
			[85,1,0,50,100], [86,1,0,50,100], [87,1,0,50,100], [88,1,0,50,100], \
			[89,1,0,50,100], [90,1,0,50,100], [91,1,0,50,100], [92,1,0,50,100], \
			[93,1,0,50,100], [94,1,0,50,100], [95,1,0,50,100], [96,1,0,50,100], \
			[97,1,0,50,100], [98,1,0,50,100], [99,1,0,50,100], [100,1,0,50,100] \
		]}]`);", BattlePassStatus, PremBattlePassStatus, BattleEXP, (BattleLevel+1)*20);

	ExecuteEventf(playerid, svelte, "window.executeEvent('event.sagpass.initializeStats', \
		`[{\"level\":%d,\"dailyComplete\":%d,\"totalComplete\":0,\"fact\": \"\
		1843 metais Londone buvo isspausdinta pirmoji naujametine atvirute. \
		Seras Henris Kolas is Londono nusprende sukurti kazka visiskai naujo per Kaledas.\"}]`);", BattleLevel, CallRemoteFunction("CheckBattleQuestDone", "dd", playerid, 0));
		 
	return 1;
}
public: CloseBattlePass(playerid) return HideCEF_Interface(playerid);

public: LoadBattlePass(playerid, BattlePassStatus, PremBattlePassStatus, BattleLevel, BattleEXP, unixtime)
{
	IsPlayerBattlePass[playerid] = !IsPlayerBattlePass[playerid];
	HideCEF_Interface(playerid, IsPlayerBattlePass[playerid]);
	if(IsPlayerBattlePass[playerid] != false)
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.setActiveView', '[\"SAGPass\"]');");
	    
	    CallRemoteFunction("initializeBattlePass", "ddddd", playerid, BattlePassStatus, PremBattlePassStatus, BattleLevel, BattleEXP);
	    
	    CallRemoteFunction("initializeDailyQuest", "dd", playerid, unixtime);
			
        CallRemoteFunction("CloseQuestVisible", "d", playerid);

 	 	SetFocusBrowser(playerid, svelte, true);
	}
	return 1;
}

