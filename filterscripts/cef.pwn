public: TuningSalon_closePlayer(playerid, box)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	ExecuteEvent(playerid, vue, "vue.set('default')"), SetFocusBrowser(playerid, vue, false);
	CallRemoteFunction("HudsLoad", "ddd", playerid, box, 1);
	CallRemoteFunction("TuningSalon_closeSalon", "ddd", playerid, vehicleid, box);
}

public: TuningSalon_click(playerid)
{
	SetFocusBrowser(playerid, vue, true);
}

public: SetCarWad(carid, wad, color)
{
	new BitStream:bs = BS_New();

	static const newWad[][] = {"fire_8years", "eagle_8years", "blue_8years", "wad_lveneno_rick", "wad_chevrolet_shrek"};

	new global_str[120];
	format(global_str, 120, "%s", wad < 20 ? (str_f("wad%i", wad)) : newWad[wad-20]);

	BS_WriteValue(bs, PR_UINT16, carid, PR_UINT16, 256, PR_UINT16, wad > 25 || wad < 1 ? 259 : 260),
	BS_WriteValue(bs, PR_UINT16, strlen((str_f("%s_wad", InfoCar[FindCar_Array(GetVehicleModel(carid))][carname_td]))), PR_STRING, (str_f("%s_wad", InfoCar[FindCar_Array(GetVehicleModel(carid))][carname_td])));
	BS_WriteValue(bs, PR_UINT8, 255, PR_UINT8, tuningColors[color][0], PR_UINT8, tuningColors[color][1], PR_UINT8, tuningColors[color][2]),
	BS_WriteValue(bs, PR_UINT16, strlen(global_str), PR_STRING, global_str);

	tuningWadData[carid][0] = wad,
	tuningWadData[carid][1] = color;

	return BS_Delete(bs);
}

public: SetTintWindow(carid, window, size, color)
{
	new BitStream:bs = BS_New(),
		wnd_str[][] = {"wndfrl", "wnd", "wdor_f", "wdor_r", "wnd_rr", "wndrrl"};

	BS_WriteValue(bs, PR_UINT32, carid, PR_UINT8, 4, PR_UINT8, 1),
	BS_WriteValue(bs, PR_UINT16, strlen((str_f("%s_%s", InfoCar[FindCar_Array(GetVehicleModel(carid))][carname_td], wnd_str[window]))), PR_STRING, (str_f("%s_%s", InfoCar[FindCar_Array(GetVehicleModel(carid))][carname_td], wnd_str[window]))),
	BS_WriteValue(bs, PR_UINT8, size, PR_UINT8, tuningColors[color][0], PR_UINT8, tuningColors[color][1], PR_UINT8, tuningColors[color][2]),
	BS_WriteValue(bs, PR_UINT16, strlen("white"), PR_STRING, "white");

	tuningTintData[carid][window][0] = size,
	tuningTintData[carid][window][1] = color;

    return BS_Delete(bs);
}

public: SetWheelCollapse(carid, type, Float:lunge, Float:collapse)
{
	static const WheelType[][] = {"wheel_lf_dummy", "wheel_rf_dummy", "wheel_lb_dummy", "wheel_rb_dummy"};

	if(type == 2) return CallRemoteFunction("SetWheelSize", "df", carid, tuningWheelData[carid][2][2]);

 	for(new i; i < 2; i++) {
 	    new BitStream:bs = BS_New();

		BS_WriteValue(bs, PR_UINT16, carid),
	    BS_WriteValue(bs, PR_UINT8, 0, PR_UINT8, 0),
	    BS_WriteValue(bs, PR_UINT8, 2, PR_UINT8, 1),
	    BS_WriteValue(bs, PR_UINT16, strlen(WheelType[type == 1 ? i : i+2])),
	    BS_WriteValue(bs, PR_STRING, WheelType[type == 1 ? i : i+2]),
	    BS_WriteValue(bs, PR_FLOAT, i ? lunge : -lunge, PR_FLOAT, 0.000000, PR_FLOAT, 0.000000, PR_FLOAT, i ? type == 1 ? -collapse : collapse : type == 1 ? collapse : -collapse);

		tuningWheelData[carid][type][0] = lunge,
		tuningWheelData[carid][type][1] = collapse;

	    BS_Delete(bs);

	}
	return true;
}

stock FindCar_Array(model)
{
	for(new i; i < sizeof(InfoCar); i++)
		if(InfoCar[i][id_model] == model) return i;

	return -1;
}

stock FindCar_Component(carid, type, set)
{
	new model;

	switch(type)
	{
	    case 0: model = InfoCar[FindCar_Array(GetVehicleModel(carid))][car_capot][set];
	    case 1: model = InfoCar[FindCar_Array(GetVehicleModel(carid))][car_spoiler][set];
	    case 2: model = InfoCar[FindCar_Array(GetVehicleModel(carid))][car_exhaust][set];
	}

	return model;
}

public: SetVehicleComponent(carid, type, component, itsModel)
{
    new BitStream:bs = BS_New(), model = itsModel ? component : FindCar_Component(carid, type, component);

    if(!model || model == -1) return false;
	BS_WriteValue(bs, PR_UINT8, 255, PR_UINT8, 255, PR_UINT32, 2),
	BS_WriteValue(bs, PR_UINT32, carid, PR_UINT32, model, PR_UINT32, 2, PR_UINT8, 0);
	tuningDetailData[carid][type] = component;
	return BS_Delete(bs);
}

public: SetVisualTuning(carid, type, color)
{
	new BitStream:bs = BS_New(), packetCef[] = {142, 132, 139};

	BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, packetCef[type], PR_UINT16, carid);

	if(type == 2)
		BS_WriteValue(bs, PR_UINT8, 205, PR_UINT8, 204, PR_UINT8, 204, PR_UINT8, 62);

	BS_WriteValue(bs, PR_UINT8, type == 2 ? tuningColors[color][2] : 255, PR_UINT8, tuningColors[color][type == 2 ? 1 : 0], PR_UINT8, tuningColors[color][type == 2 ? 0 : 1], PR_UINT8, type == 2 ? 255 : tuningColors[color][2]),

	tuningVisualData[carid][type] = color;

	return BS_Delete(bs);
}

stock UnSetVehicleComponent(carid, type, component)
{
    new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT16, carid, PR_UINT16, FindCar_Component(carid, type, component)),
	BS_WriteValue(bs, PR_UINT8, 0, PR_UINT8, 0);
	return BS_Delete(bs);
}

public: SetWheelSize(carid, Float:size)
{
    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 135, PR_UINT16, carid, PR_FLOAT, size);
	tuningWheelData[carid][2][2] = size;
	return BS_Delete(bs);
}

stock SearchAnimationInfo(uid)
{
	for(new i; i < sizeof(animInfo); i++) if(animInfo[i][animUID] == uid) return i;
	return -1;
}
