public: LoadFuel(playerid, kind, costone, costtwo, fuel)
{
	ExecuteEvent(playerid, svelte, "window.executeEvent('event.setActiveView', '[\"GasStation\"]');");

	if(kind == 0)
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.gasstation.initializeFuelTypes', \
			'[[{\"id\":0,\"title\":\"Dizelis\",\"price\":400,\"available\": 1},\
			{\"id\":1,\"title\":\"92\",\"price\":400,\"available\": 0},\
			{\"id\":2,\"title\":\"95\",\"price\":400,\"available\": 0},\
			{\"id\":3,\"title\":\"98\",\"price\":400,\"available\": 0}]]');");
	}
	else if(kind == 1)
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.gasstation.initializeFuelTypes', \
			'[[{\"id\":0,\"title\":\"Dizelis\",\"price\":400,\"available\": 0},\
			{\"id\":1,\"title\":\"92\",\"price\":400,\"available\": 1},\
			{\"id\":2,\"title\":\"95\",\"price\":400,\"available\": 0},\
			{\"id\":3,\"title\":\"98\",\"price\":400,\"available\": 0}]]');");
	}
	else if(kind == 2)
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.gasstation.initializeFuelTypes', \
			'[[{\"id\":0,\"title\":\"Dizelis\",\"price\":400,\"available\": 0},\
			{\"id\":1,\"title\":\"92\",\"price\":400,\"available\": 0},\
			{\"id\":2,\"title\":\"95\",\"price\":400,\"available\": 1},\
			{\"id\":3,\"title\":\"98\",\"price\":400,\"available\": 0}]]');");
	}
	else if(kind == 3)
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.gasstation.initializeFuelTypes', \
			'[[{\"id\":0,\"title\":\"Dizelis\",\"price\":400,\"available\": 0},\
			{\"id\":1,\"title\":\"92\",\"price\":400,\"available\": 0},\
			{\"id\":2,\"title\":\"95\",\"price\":400,\"available\": 0},\
			{\"id\":3,\"title\":\"98\",\"price\":400,\"available\": 1}]]');");
	}

	ExecuteEventf(playerid, svelte, "window.executeEvent('event.gasstation.initializeProducts', \
		'[[{\"id\":0,\"title\":\"Rem. komplektas\",\"image\":520,\"price\":%d},\
		{\"id\":1,\"title\":\"Kanistra\",\"image\":516,\"price\":%d},\
		{\"id\":2,\"title\":\"Powerbankas automobiliui\",\"image\":700054,\"price\":29999}]]');", costone, costtwo);

	ExecuteEventf(playerid, svelte, "window.executeEvent('event.gasstation.initializeMaxLiters', '[%i]');", 100);
	ExecuteEventf(playerid, svelte, "window.executeEvent('event.gasstation.initializeCurrentLiters', '[%i]');", fuel);
 	SetFocusBrowser(playerid, svelte, true);
	return 1;
}

stock ShowCefPublic(playerid, custom, request[])
{
	static
		data[500],
		sscanf_id_0,
		sscanf_id_1,
		sscanf_id_2;

    new skinid;
	new nick[4096];//string player
	new pass[4096];//string player
	new mail[4096];//string player
 	new reftype[4096];//string player
  	new referal[4096];//string player
  	new sex[4096];//string player
  	new race[4096];//string player
  	
  	//new TuningSalon_typeMenu[] = {"updateCategory", "updateDashboard", "selectTintedWindowColor", "updateTintedWindowColor", "popupResponse", "purchase", "cart", "exit"};

	if(TextFind(request, "gta_sa.exe"))
	{
	    if CefHints[playerid] *then
		{
			printf("data [%s]", request);
			SCMF(playerid, -1, "data [%s]", request);
		}
	}
	else
	{
		sscanf(request, "P<|>s[300]iii", data, sscanf_id_0, sscanf_id_1, sscanf_id_2);
		new id = SearchCefPublic(data);
		if CefHints[playerid] *then
		{
			//printf("id %i(%i) & data [%s] & sscanf_id >- [%i,%i,%i]", id, custom, data, sscanf_id_0, sscanf_id_1, sscanf_id_2);
			SCM(playerid, -1, (str_f("id %i(%i) & data [%s] & sscanf_id >- [%i,%i,%i]", id, custom, data, sscanf_id_0, sscanf_id_1, sscanf_id_2)));
			SCMF(playerid, COLOR_GREY, "[debug] data dublicate -> %s", data);
		}

	    if(id == -1)
		{
		    switch(custom)
			{
				case 1: //chat
				{
					player_Cef_ShowChat[playerid] = !player_Cef_ShowChat[playerid];
					for(new i; i < MAX_PLAYERS; i++)
					{
						if(i == playerid || !ArizonaGamesStatus(i) || CallRemoteFunction("CheckHudCef", "dd", playerid, 4) == 1) continue;
						UpdateBrowser(i, 108, playerid, 0, 0, 0, !player_Cef_ShowChat[playerid] ? 0 : 128);
					}
				}
				case 18:
				{
				    if(TextFind(data, "updateCategory")
					|| TextFind(data, "updateDashboard")
					|| TextFind(data, "selectTintedWindowColor")
					|| TextFind(data, "updateTintedWindowColor")
				 	|| TextFind(data, "resetTintedWindowColor")
				 	|| TextFind(data, "popupResponse")
				 	|| TextFind(data, "purchase")
				 	|| TextFind(data, "cart")
				 	|| TextFind(data, "exit"))
				    {
						if(TextFind(data, "@")) strdel(data,0,4);

		                if(TextFind(data, "updateCategory")) strdel(data,14,300);
		                if(TextFind(data, "updateDashboard")) strdel(data,15,300);
		                if(TextFind(data, "selectTintedWindowColor")) strdel(data,23,300);
		                if(TextFind(data, "updateTintedWindowColor")) strdel(data,23,300);
		                if(TextFind(data, "resetTintedWindowColor")) strdel(data,22,300);
		                if(TextFind(data, "popupResponse")) strdel(data,13,300);
		                if(TextFind(data, "purchase")) strdel(data,8,300);
		                if(TextFind(data, "cart")) strdel(data,4,300);
		                if(TextFind(data, "exit")) strdel(data,4,300);
	                }
					SCMF(playerid, -1, "Data: %s", data);

					if GetString(data, "updateCategory") *then
					{
						switch sscanf_id_0 do
						{
							case 14:
								InterpolateCameraPos(playerid, 1537.5338, 959.6665, 11.4604, 1537.4742, 959.5036, 11.4604, 100, CAMERA_MOVE),
								InterpolateCameraLookAt(playerid, 1532.0519, 956.1741, 9.4604, 1532.2782, 956.5036, 9.4604, 100, CAMERA_MOVE);

							case 22:
								InterpolateCameraPos(playerid, 1536.2861, 951.7866, 10.9854, 1535.8762, 951.5395, 10.9604, 100, CAMERA_MOVE),
								InterpolateCameraLookAt(playerid, 1531.4663, 958.4205, 9.9354, 1531.8762, 958.4677, 9.9604, 100, CAMERA_MOVE);

							default: SetPlayerCameraPos(playerid, 1536.8762, 962.1998, 11.4604), SetPlayerCameraLookAt(playerid, 1530.8762, 951.8074, 9.4604);
						}
					}
					else if GetString(data, "updateDashboard") *then
					{
					    new vehicle = GetPlayerVehicleID(playerid);
						switch sscanf_id_0 do
						{
							case 31..48:
							{
								CallRemoteFunction("TuningSalon_tempVinilData", "dd", playerid, sscanf_id_0-31), SetVinilCar(vehicle, sscanf_id_0-31, 1, playerid);
							}

							case 49:
								InterpolateCameraPos(playerid, 1536.8762, 962.1998, 11.4604, 1536.1262, 960.9007, 10.4604, 1200, CAMERA_MOVE),
								InterpolateCameraLookAt(playerid, 1536.3831, 961.3456, 11.2960, 1531.6262, 953.1065, 10.4604, 1200, CAMERA_MOVE);

							case 50:
								InterpolateCameraPos(playerid, 1536.1263, 960.9009, 10.4606, 1536.1262, 953.1065, 10.4604, 1200, CAMERA_MOVE),
								InterpolateCameraLookAt(playerid, 1535.6263, 960.0349, 10.4606, 1531.6262, 960.9007, 10.4604, 1200, CAMERA_MOVE);

							case 51..67: SetVehicleWheel(vehicle, sscanf_id_0-51, 1, playerid);
						}
					}
					else if GetString(data, "selectTintedWindowColor") *then CallRemoteFunction("TuningSalon_placeTunWindow", "dd", playerid, sscanf_id_0);
					else if GetString(data, "updateTintedWindowColor") *then
					{
					    new vehicle = GetPlayerVehicleID(playerid);
						CallRemoteFunction("AttachWindowBlackout", "ddd", playerid, vehicle, sscanf_id_0);
					}
					else if GetString(data, "resetTintedWindowColor") *then
					{
					    new vehicle = GetPlayerVehicleID(playerid);
						for(new i; i < 6; i++) AttachWindowBlackout(vehicle, 101, i, 0, playerid);
					}
					else if GetString(data, "popupResponse") *then
					{
						switch(sscanf_id_0)
						{
							case 1: CallRemoteFunction("TuningSalon_closePlayer", "dd", playerid, TuningSalon_boxPlayer[playerid]);
							case 2:
							{
								CallRemoteFunction("TuningSalon_popupResponse", "dd", playerid, TuningSalon_cartMoney[playerid]),
								CallRemoteFunction("TuningSalon_closePlayer", "dd", playerid, TuningSalon_boxPlayer[playerid]);
							}
						}
					}
					else if GetString(data, "purchase") *then
					{
						ExecuteEventf(playerid, vue, "vue.c('tuning/showPopup', \
							'{\"responseId\":2,\"color\":\"#a63737\",\"title\":\"Iiaoaa??aaiea\",\"text\":\"Au oioeoa iieaoeou oiaa?u a aaoae ei?ceia ia $%i?\",\
							\"buttonSecondary\":{\"name\":\"Eoieou\",\"backgroundColor\":\"#00ec4c\",\"color\":\"#000000\"},\"buttonPrimary\":{\"name\":\"Aueoe\",\
							\"backgroundColor\":\"#5a5a5a\",\"color\":\"#ffffff\"}}');", TuningSalon_cartMoney[playerid]);
					}
					else if GetString(data, "cart") *then
					{
						new i = FindArray_Detail(tunignSalonDashboard[playerid]);
						ExecuteEventf(playerid, svelte, "window.executeEvent('event.tuning.updateCategoryComponent', '\
							[{\"id\":%i,\"categoryId\":%i,\"header\":\"\",\"color\":-1,\"name\":\"%s\",\"text\":\"\",\
							\"icon\":\"%s\",\"price\":%i,\"installed\":false,\"inCart\":%s,\"available\":true,\
							\"statusText\":\"%s\",\"statusColor\":-1,\"hidePriceButton\":false,\"scale\":1.0}]');", \
							DetailInfo[i][dUid], DetailInfo[i][dCategory], DetailInfo[i][dName], DetailInfo[i][dIcon], \
							DetailInfo[i][dCost], custom == 74 ? true : false, custom == 74 ? "â êîðçèíå" : (str_f("%i", DetailInfo[i][dCost])), custom == 74 ? -1681832961 : -1);

						printf("\
							i = %i | id %i | [{\"id\":%i,\"categoryId\":%i,\"header\":\"\",\"color\":-1,\"name\":\"%s\",\"text\":\"\",\
							\"icon\":\"%s\",\"price\":%i,\"installed\":false,\"inCart\":%s,\"available\":true,\"statusText\":\"%s\",\
							\"statusColor\":-1,\"hidePriceButton\":false,\"scale\":1.0}]", \
							i, custom, DetailInfo[i][dUid], DetailInfo[i][dCategory], DetailInfo[i][dName], DetailInfo[i][dIcon], DetailInfo[i][dCost], \
							custom == 74 ? "true" : "false", custom == 74 ? "â êîðçèíå" : (str_f("%i", DetailInfo[i][dCost])), custom == 74 ? -1681832961 : -1);

						ExecuteEvent(playerid, svelte, "window.executeEvent('event.tuning.setClientVisualData', \
							'\
								[\
									{\"carName\":\"Rolls-Royce Phantom\",\"carNameScale\":1.0,\"playerMoney\":49260647,\"cartCount\":900000,\"cartColor\":\"#FFFFFF\"}\
								]\
							');");

						ExecuteEvent(playerid, svelte, "window.executeEvent('event.tuning.updateCart', '[[51]]');");
					}
					else if GetString(data, "exit") *then
					{
					    new vehicle = GetPlayerVehicleID(playerid);

						if TuningSalon_cartMoney[playerid] *then return ExecuteEvent(playerid, vue, "vue.c('tuning/showPopup', \
							'{\"responseId\":1,\"color\":\"#a63737\",\"title\":\"Iiaoaa??aaiea\",\"text\":\"O aan a ei?ceia eia?ony iaiiea?aiiua oiaa?u au oioeoa aueoe?\",\
							\"buttonSecondary\":{\"name\":\"Aueoe\",\"backgroundColor\":\"#00ec4c\",\"color\":\"#000000\"},\"buttonPrimary\":{\"name\":\"Ioiaia\",\
							\"backgroundColor\":\"#5a5a5a\",\"color\":\"#ffffff\"}}');");

						CallRemoteFunction("TuningSalon_closePlayer", "dd", playerid, TuningSalon_boxPlayer[playerid]);
						CallRemoteFunction("TuningSalon_placeTunWindow", "dd", playerid, -1);

						if vehicle_VinilData[vehicle][0] != CallRemoteFunction("TuningSalon_tempVinilDataCheck", "d", playerid) *then
						{
							SetVinilCar(vehicle, vehicle_VinilData[vehicle][0], 1, playerid);
						}
					}
				}
				default:
				{
				}
			}
		}
		//if(id != -1 && custom == 24) CallRemoteFunction("HideTextDraws", "d", playerid);
	    switch(id)
		{
			case 1: //onActiveViewChanged
			{
			}
			case 2: //useAction
			{
				CallRemoteFunction("UseRadialAction", "dd", playerid, sscanf_id_0);
			}
			case 3: //setGeoLocation
			{
				return 1;
			}
			case 4: //streetFood.close
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 5: //closeDonationShop
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 6: //streetFood.purchase
			{
			    sscanf(request, "P<|>s[50]", data), CallRemoteFunction("StreedFood_CEF", "ds", playerid, data);
			}
			case 7: //buyItemDonationButton
			{
			    //CallRemoteFunction("DonateInfoCef", "ds", playerid, data);
			    CallRemoteFunction("DonateInfoCef", "ddd", playerid, sscanf_id_0, sscanf_id_1);
			}
			case 8: //arizona-pass.purchaseCommon
			{
       			CallRemoteFunction("BuyDostupBattlePass", "d", playerid);
			}
			case 9: //arizona-pass.purchasePremium
			{
			    CallRemoteFunction("BuyPremDostupBattlePass", "d", playerid);
			}
			case 10: //arizona-pass.getDailyQuestRewards
			{
			    CallRemoteFunction("GetDailyQuestRewards", "dd", playerid, sscanf_id_0);
			}
			case 11: //arizona-pass.close
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 12: //closeContainerAuction
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 13: //LaunchedApp
			{
			    //if(custom != 18) return HideCEF_Interface(playerid);
	    		CallRemoteFunction("LaunchedApp", "ddsd", playerid, sscanf_id_0);
			}
			case 14: //closeGasStation
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 15: //auth
			{
			    sscanf(request, "P<|>s[50]s[24]s[100]i", data, data, pass, sscanf_id_0);
				//SCMF(playerid, -1, "nick %s | pass %s | type %i", data, pass, sscanf_id_0);
				CallRemoteFunction("AuthLogin", "ds", playerid, pass);
			}
			case 16: //register
			{
			    sscanf(request, "P<|>s[50]s[24]s[100]s[100]s[100]s[100]i", data, nick, pass, mail, reftype, referal, sscanf_id_0);
				//SCMF(playerid, -1, "%s", request);
				//registration|Testa|123321|null|friends|Martys_Mcfly

				//SCMF(playerid, -1, "nick %s | pass %s | mail %s | referal %s | type %i", nick, pass, mail, referal, sscanf_id_0);

				CallRemoteFunction("RegisterLogin", "dsssss", playerid, nick, pass, mail, reftype, referal);
			}
			case 17: //createCharacter
			{
			    sscanf(request, "P<|>s[50]s[10]s[10]i", data, sex, race, skinid);
				//SCMF(playerid, -1, "%s", request);
				//createCharacter|man|white|0-4 / createCharacter|man|black|0-4
				//createCharacter|girl|white|0-1 / createCharacter|girl|black|0-1

				//SCMF(playerid, -1, "sex %s | race %s | skinid %i", sex, race, skinid);

			    CallRemoteFunction("ChangeCharacterRegister", "dssd", playerid, sex, race, skinid);
			}
			case 18: //playAnimation
			{
			    if(!IsPlayerAnimationMenu[playerid]) return HideCEF_Interface(playerid);
				new animation_id = SearchAnimationInfo(sscanf_id_0);
				if(animation_id == -1) return SCM(playerid, COLOR_LIGHTRED, "[Klaida] {FFFFFF}Tokios animacijos nera!");
				ApplyAnimation(playerid, animInfo[animation_id][animLib], animInfo[animation_id][animName], 4.1, 0, 0, 0, 0, animInfo[animation_id][animtime]);

				CallRemoteFunction("AnimsStart", "d", playerid);
			}
			case 19: //closeAnimationsMenu
			{
			    CallRemoteFunction("HideTextDraws", "d", playerid);
			}
			case 20: //purchaseFuel
			{
			    CallRemoteFunction("FillingStart", "df", playerid, float(sscanf_id_1));
			}
			case 21: //purchaseProduct
			{
			    //if(custom != 18) return HideCEF_Interface(playerid);
			    CallRemoteFunction("FuelProductCef", "dd", playerid, sscanf_id_0);
			}
			/*
			case 67: CallRemoteFunction("LoadPhoneVideo", "d", playerid);
			case 68:
			{
				//switch(sscanf_id_0)
				//{
					//case 2: HideYouTubeVideoPhone(playerid), ShowYouTubeVideoPhone(playerid, URLPlayerYouTube[playerid]);
					//case 3: CallRemoteFunction("CancelPhoneVideo", "d", playerid), PhoneOpen[playerid] = -1;
				//}
			}
			case 69:
			{
				new country[5], region[24];
				sscanf(request, "P<|>s[300]s[5]s[24]", data, country, region);
				CallRemoteFunction("SetNumberRandom", "dss", playerid, country, region);
			}
			case 70: CallRemoteFunction("EndRandomNumber", "d", playerid);
			case 71:
			{
			    new jsondata[64];
				sscanf(request, "P<|>s[300]s[64]", data, jsondata);
				//tunignSalonDashboard[playerid] = GetJsonInteger(jsondata, "component");
				//SCMF(playerid, -1, " -> case 71 [%i]", GetJsonInteger(jsondata, "component"));
				SCMF(playerid, -1, " -> case 71 [%s]", jsondata);
			}
			*/
			default:
			{
			}
		}
	}
	return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
    MaxOnline -= 1;
    return 1;
}

public OnPlayerConnect(playerid)
{
    MaxOnline += 1;
    
    static version[24];
	GetPlayerVersion(playerid, version, sizeof(version));

	player_Vue_Init[playerid] = false;
	player_Svetle_Init[playerid] = false;
	IsPlayerAnimationMenu[playerid] = false;
	IsPlayerFillMenu[playerid] = false;
	IsPlayerIterCarMenu[playerid] = false;
	IsPlayerBattlePass[playerid] = false;
	IsPlayerStreetFood[playerid] = false;
	IsPlayerCustomCarMenu[playerid] = false;
	IsPlayerCustomPlayerMenu[playerid] = false;
	IsPlayerRadialCarMenu[playerid] = false;
	player_Status_Focus[playerid] = false;
	player_Cef_ShowChat[playerid] = false;
	CefHints[playerid] = false;
	
    if(GetString(version, M_LAUNCHER_VERSION) || GetString(version, M_MOBILE_VERSION))
	{
		SetLauncherStatus(playerid, true);

		CallRemoteFunction("ChangeSaveDialog", "dd", playerid, 0);//Uzeidami i serveri, si funkcija bus ijungta. Isjungiame.
		CallRemoteFunction("ChangeChat", "dd", playerid, 0);//Uzeidami i serveri, si funkcija bus ijungta. Isjungiame.
	}
	else SetLauncherStatus(playerid, false);
    return 1;
}

stock UpdateBrowser(playerid, arg0, arg1=-1, arg2=-1, arg3=-1, arg4=-1, arg5=-1, arg6=-1, arg7=-1, arg8=-1, arg9=-1, arg10=-1, arg11=-1, arg12=-1, arg13=-1, arg14=-1, arg15=-1, arg16=-1, arg17=-1, arg18=-1)
{
	new BitStream:browserUpdate = BS_New();

	BS_WriteValue(browserUpdate, PR_UINT8, 220);
	BS_WriteValue(browserUpdate, PR_UINT8, arg0);
	if(arg1 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg1);
	if(arg2 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg2);
	if(arg3 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg3);
	if(arg4 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg4);
	if(arg5 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg5);
	if(arg6 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg6);
	if(arg7 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg7);
	if(arg8 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg8);
	if(arg9 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg9);
	if(arg10 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg10);
	if(arg11 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg11);
	if(arg12 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg12);
	if(arg13 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg13);
	if(arg14 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg14);
	if(arg15 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg15);
	if(arg16 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg16);
	if(arg17 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg17);
	if(arg18 != -1) BS_WriteValue(browserUpdate, PR_UINT8, arg18);

	return PR_SendPacket(browserUpdate, playerid);
}

public: ChangePhoneBg(playerid, phone_background)
{
    ExecuteEventf(playerid, svelte, "window.executeEvent('event.phone.changePhoneBg', '[%i]');", phone_background);
	return 1;
}

public OnIncomingPacket(playerid, packetid, BitStream:bs)
{
	if(packetid == 220)
	{
		static custom;
		BS_IgnoreBits(bs, 8);
		BS_ReadUint8(bs, custom);

		switch(custom)
		{
		    case 17: return true; //flood cef
			case 20: //getplayerWindow
			{
				BS_ReadUint8(bs, player_Cef_PositionWindow_X[playerid]);
				BS_ReadUint8(bs, player_Cef_PositionWindow_Y[playerid]);
				BS_IgnoreBits(bs, 16);
				BS_ReadUint8(bs, player_Cef_PositionWindow_rX[playerid]);
				BS_ReadUint8(bs, player_Cef_PositionWindow_rY[playerid]);
			}
			case 38: //init cef
			{
       			OnPlayerInitializingBrowser(playerid);
			}
			default:
			{
				static request[300];
				BS_ReadString32(bs, request);

				ShowCefPublic(playerid, custom, request);
			}
		}
		//printf("%i -> %s", custom, query);
		//SCMF(playerid, -1, "%s - %i(custom %i)", data, id1, custom);
	}
	return 1;
}

