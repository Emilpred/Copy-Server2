stock ArizonaGamesStatus(playerid, id_cef=-1)
{
    new status = -1;
	if(player_Svetle_Init[playerid] != false && player_Vue_Init[playerid] != false)
	{
		if(id_cef != -1)
		{
			if(!CallRemoteFunction("CheckHudCef", "dd", playerid, id_cef)) status = 2; //Jeigu zaidejas turi CEF
		}
		status = 1;
	}
	return status;
}
