public: ChangeSatietyHud(playerid, satiety)
{
    if(satiety <= 0)
	{
		static version[24];
		GetPlayerVersion(playerid, version, sizeof(version));

		if(GetString(version, M_MOBILE_VERSION)) CallRemoteFunction("UpdateMobileHunger", "dd", playerid, 0);
		else ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.playerSatiety', '[0]');");
	}
	else
	{
		static version[24];
		GetPlayerVersion(playerid, version, sizeof(version));

		if(GetString(version, M_MOBILE_VERSION)) CallRemoteFunction("UpdateMobileHunger", "dd", playerid, satiety);
		else ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.playerSatiety', '[%d]');", satiety);
	}
	return 1;
}

