stock FuncPlayer_Snow(playerid, status)
{
    new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT8, 220);
	BS_WriteValue(bs, PR_UINT8, status == 1 ? 47 : 48);
	BS_WriteValue(bs, PR_UINT8, 8);
	BS_WriteValue(bs, PR_UINT8, 83);
	BS_WriteValue(bs, PR_UINT8, 78);
	BS_WriteValue(bs, PR_UINT8, 79);
	BS_WriteValue(bs, PR_UINT8, 87);
	BS_WriteValue(bs, PR_UINT8, 70);
	BS_WriteValue(bs, PR_UINT8, 88);
	BS_WriteValue(bs, PR_UINT16, 73);
	BS_WriteValue(bs, PR_UINT32, 0);
	BS_WriteValue(bs, PR_UINT32, 0);
	BS_WriteValue(bs, PR_UINT8, 128);
	BS_WriteValue(bs, PR_UINT8, 63);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 64);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 208);
	BS_WriteValue(bs, PR_UINT8, 7);
	BS_WriteValue(bs, PR_UINT8, 0);
	BS_WriteValue(bs, PR_UINT8, 0);
	PR_SendPacket(bs, playerid);
    return 1;
}

stock CheckBattleQuestPrizeImage(questid, image)
{
	new bpimage;
	switch(questid)
	{
	    case 0://Ðå÷íûå ìîíñòðû
	    {
	        switch(image)
	        {
	            case 0: bpimage = 5067;
	            case 1: bpimage = 5068;
	            case 2: bpimage = 5145;
	        }
	    }
	}
	return bpimage;
}

stock AttachWindowBlackout(vehicle, blackout_size, window, blackout_color, player = INVALID_PLAYER_ID)
{
	new BitStream:bs = BS_New(),
		wnd_str[][] = {"wndfr", "wnd", "wdor_f", "wdor_r", "wnd_rr", "wndrrl"};

	BS_WriteValue(bs, PR_UINT32, vehicle, PR_UINT8, 4, PR_UINT8, 1),

	BS_WriteValue(bs, PR_UINT16, strlen((str_f("%s_%s", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], wnd_str[window]))), PR_STRING, (str_f("%s_%s", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], wnd_str[window]))),
	BS_WriteValue(bs, PR_UINT8, blackout_size, PR_UINT8, LauncherTuning_Colors[blackout_color][colorDefault][0], PR_UINT8, LauncherTuning_Colors[blackout_color][colorDefault][1], PR_UINT8, LauncherTuning_Colors[blackout_color][colorDefault][2]);
	BS_WriteValue(bs, PR_UINT16, strlen("white"), PR_STRING, "white");

    vehicle_BlackoutData[vehicle][window][0] = blackout_size;
    vehicle_BlackoutData[vehicle][window][1] = blackout_color;

    foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicle, i) && ProxDetectorS(20.0, player, i) *then
            PR_SendRPC(bs, i, 161);
    }
    return BS_Delete(bs);
}

stock SetVinilCar(vehicle, vinil, color, player = INVALID_PLAYER_ID)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT16, vehicle, PR_UINT16, 256, PR_UINT16, vinil > 19 || vinil < 1 ? 259 : 260),
	BS_WriteValue(bs, PR_UINT16, strlen((str_f("%s_wad", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName]))), PR_STRING, (str_f("%s_wad", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName])));

    if !(vinil > 19 || vinil < 1) *then
	    BS_WriteValue(bs, PR_UINT8, 255, PR_UINT8, LauncherTuning_Colors[color][colorDefault][0], PR_UINT8, LauncherTuning_Colors[color][colorDefault][1], PR_UINT8, LauncherTuning_Colors[color][colorDefault][2]),
	    BS_WriteValue(bs, PR_UINT16, strlen((str_f("wad%i", vinil))), PR_STRING, (str_f("wad%i", vinil)));

    foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicle, i) && ProxDetectorS(20.0, player, i) *then
            PR_SendRPC(bs, i, 161);
    }
    return BS_Delete(bs);
}

stock SetVehicleTuning(vehicleid, vehicleTuning_type, color, player = INVALID_PLAYER_ID)
{
	new BitStream:bs = BS_New(),
		vehicleTuning_packetCef[] = {142, 132, 139};

	BS_WriteValue(bs, PR_UINT8, 220, \
		PR_UINT8, vehicleTuning_packetCef[vehicleTuning_type], PR_UINT16, vehicleid);

	if vehicleTuning_type == 2 *then
		BS_WriteValue(bs, PR_UINT8, 205, PR_UINT8, 204, PR_UINT8, 204, PR_UINT8, 62);

	BS_WriteValue(bs, PR_UINT8, LauncherTuning_Colors[color][colorDefault][0], PR_UINT8, vehicleTuning_type == 1 ? LauncherTuning_Colors[color][colorLight][1] : LauncherTuning_Colors[color][colorDefault][1], PR_UINT8, vehicleTuning_type == 1 ? LauncherTuning_Colors[color][colorLight][2] : LauncherTuning_Colors[color][colorDefault][2], PR_UINT8, vehicleTuning_type == 1 ? 255 : 255);

    vehicle_VisualData[vehicleid][vehicleTuning_type] = color;

    foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicleid, i) && ProxDetectorS(20.0, player, i) *then
            PR_SendPacket(bs, i);
    }
    return BS_Delete(bs);
}

stock SetComponentVehicle(veh, type, component)
{
    new data = SearchComponentVehicle(veh, type, component);
    if data > 0 *then
    {
        vehicle_TuningData[veh][type][0] = data;
        return true;
    }
    return false;
}

stock AttachComponentVehicle(vehicle, component, player = INVALID_PLAYER_ID)
{
	new BitStream:bs = BS_New();

	BS_WriteValue(bs, PR_UINT8, 255, PR_UINT8, 255, PR_UINT32, 2, PR_UINT32, vehicle, PR_UINT32, component, PR_UINT32, 0, PR_UINT8, 0);

    foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicle, i) && ProxDetectorS(20.0, player, i) *then
            PR_SendRPC(bs, i, 96);
    }
    return BS_Delete(bs);
}

stock SetWheelSetting(vehicle, num_1, num_2, num_3, player = INVALID_PLAYER_ID)
{
    new BitStream:bs = BS_New();

    BS_WriteValue(bs, PR_UINT8, 220, \
		PR_UINT8, 135, PR_UINT16, vehicle);

    BS_WriteValue(bs, PR_UINT8, num_1, PR_UINT8, num_2, PR_UINT8, num_3);

    foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicle, i) && ProxDetectorS(20.0, player, i) *then
            PR_SendPacket(bs, i);
    }
    return BS_Delete(bs);
}
//220, 135, 78, 3, 51, 51, 115, 63
stock SearchComponentVehicle(vehicle, type, component)
{
	new component_str[] = {"a", "b", "c", "d", "e"};
	temp_str = "";
	switch type do
	{
		case 0: f(temp_str, sizeof temp_str, "bnt_b_%s_%s", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], component_str[component]);
		case 1: f(temp_str, sizeof temp_str, "spl_b_%s_%s", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], component_str[component]);
		case 2: f(temp_str, sizeof temp_str, "rbmp_%s_%s", MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], component_str[component]);
	}
	for new i; i < sizeof vehicleTuning_data; i++ do if GetString(vehicleTuning_data[i][detailName], temp_str) *then return vehicleTuning_data[i][detailId];
    return printf("case %i && name %s && component %s && temp_str %s", type, MassiveCar_info[FindCarName_Tuning(GetVehicleModel(vehicle))][carName], component_str[component], temp_str);
}

stock GetComponentCar(vehicle, component) return vehicle_TuningData[vehicle][component][0];

stock FindCarName_Tuning(model)
{
	for new i; i < sizeof MassiveCar_info; i++ do
		if model == MassiveCar_info[i][carModel] *then return i;

	return false;
}

stock ResetTuning_VehicleId(vehicleid)
{
    for new ix; ix < 6; ix++ do
        vehicle_BlackoutData[vehicleid][ix][0] = 101,
        vehicle_BlackoutData[vehicleid][ix][1] = 0;

    vehicle_VisualData[vehicleid][0] = 0,
    vehicle_VisualData[vehicleid][1] = 1,
    vehicle_VisualData[vehicleid][2] = 1;

    vehicle_VinilData[vehicleid][0] = 0,
    vehicle_VinilData[vehicleid][1] = 1;

    //..vehicle_TuningData[vehicleid][3][0] = -1;
    //vehicle_TuningData[vehicleid][3][1] = -1;
}

stock UpdateTuning_PlayerId(vehicleid, player = INVALID_PLAYER_ID, view = -1)
{
    if view == 0 || view == -1 *then
    {
        for new i; i < 3; i++ do
        {
            new id = GetComponentCar(vehicleid, i);
            if id > 3 *then AttachComponentVehicle(vehicleid, id, player);
            for new j; j < 6; j++ do AttachWindowBlackout(vehicleid, vehicle_BlackoutData[vehicleid][j][0], j, vehicle_BlackoutData[vehicleid][j][1], player);
        }
    }
    if view == 1 || view == -1 *then SetVinilCar(vehicleid, vehicle_VinilData[vehicleid][0], vehicle_VinilData[vehicleid][1], player);
    if view == 2 || view == -1 *then for new i; i < 3; i++ do SetVehicleTuning(vehicleid, i, vehicle_VisualData[vehicleid][i], player);
    if view == 3 || view == -1 *then SetVehicleWheel(vehicleid, vehicle_TuningData[vehicleid][3][0], vehicle_TuningData[vehicleid][3][1], player);
}

stock SetVehicleWheel(vehicleid, wheel, color, playerid = INVALID_PLAYER_ID)
{
    AttachComponentVehicle(vehicleid, wheel_Data[wheel][wId], playerid);

    new BitStream:bs = BS_New();
    BS_WriteValue(bs, PR_UINT32, vehicleid, PR_UINT8, 4, PR_UINT8, 1);
    BS_WriteValue(bs, PR_UINT16, strlen(wheel_Data[wheel][wName]), PR_STRING, wheel_Data[wheel][wName]);
    BS_WriteValue(bs, PR_UINT8, 255, PR_UINT8, LauncherTuning_Colors[color][colorDefault][0], PR_UINT8, LauncherTuning_Colors[color][colorDefault][1], PR_UINT8, LauncherTuning_Colors[color][colorDefault][2]);
    BS_WriteValue(bs, PR_UINT16, strlen("default"), PR_STRING, "default");

    vehicle_TuningData[vehicleid][3][0] = wheel;
    vehicle_TuningData[vehicleid][3][1] = color;

	foreach(new i: Player)
    {
        if IsVehicleStreamedIn(vehicleid, i) && ProxDetectorS(20.0, playerid, i) *then
            PR_SendRPC(bs, i, 161);
    }
    return BS_Delete(bs);
}

stock ProxDetectorS(Float:radi, playerid, targetid, spec = 0)
{
    new Float:p[3];
    if(!IsPlayerConnected(playerid)) return 0;
    if(!IsPlayerConnected(targetid)) return 0;
    if(!spec)
    {
	    if(GetPlayerState(playerid) == 9) return 0;
	    if(GetPlayerState(targetid) == 9) return 0;
    }
    if(!GetPlayerPos(targetid, p[0], p[1], p[2])) return 0;
	if(!IsPlayerInRangeOfPoint(playerid, radi, p[0], p[1], p[2]))
	{
		return 0;
	}
	return 1;
}

stock FindArray_Detail(detailId)
{
	for(new i; i < sizeof(DetailInfo); i++)
		if(DetailInfo[i][dUid] == detailId) return i;

	return -1;
}

public: SetCustomData(playerid, packetUid, browser, const event[])
{
	new BitStream:bs = BS_New();
	BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 84, PR_UINT8, packetUid, PR_UINT8, browser, PR_STRING32, event);
	PR_SendPacket(bs, playerid);
	return BS_Delete(bs);
}

public: AddChatHint(playerid, mod, type)
{
	new BitStream:bs = BS_New();

	if(!mod)
		return BS_WriteValue(bs, PR_UINT8, 220, PR_UINT8, 37, PR_UINT8, strlen(chatMod[type][chatCMD]), PR_STRING, chatMod[type][chatCMD]),
		PR_SendPacket(bs, playerid), BS_Delete(bs);

	BS_WriteValue(bs,
            PR_UINT8, 220,\
            PR_UINT8, 36,\
            PR_UINT8, strlen(chatMod[type][chatCMD]),\
            PR_STRING, chatMod[type][chatCMD],\
            PR_UINT8, 255,\
            PR_UINT8, chatMod[type][chatColor][0],\
            PR_UINT8, chatMod[type][chatColor][1],\
            PR_UINT8, chatMod[type][chatColor][2],
            PR_UINT8, strlen(chatMod[type][chatInfo]),\
            PR_STRING, chatMod[type][chatInfo],\
            PR_UINT8, strlen(chatMod[type][chatName]),\
            PR_STRING, chatMod[type][chatName]);

    PR_SendPacket(bs, playerid);
    return BS_Delete(bs);
}

