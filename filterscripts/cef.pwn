public: AddKeys(playerid, phone, member, fam)
{
	ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setWorkbookKey', '["", \"M\"]')");

	if(member == 0)
	{
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFractionRadioKey', '[null]')");
	}
	else
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFractionRadioKey', '[null]')");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFractionRadioKey', '["", \"J\"]')");
	}
	
	if(fam == -1)
	{
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFamilyRadioKey', '[null]')");
	}
	else
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFamilyRadioKey', '[null]')");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setFamilyRadioKey', '["", \"K\"]')");
	}

	if(phone == -1)
	{
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setPhoneKey', '[null]')");
	}
	else
	{
	    ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setPhoneKey', '[null]')");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setPhoneKey', '[\"P\"]')");
	}
	ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.setRadialKey', '[\"R\"]')");
   	ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.hotkeysVisible', '[true]');");
	return 1;
}
