public: ChangeHud(playerid, hud, payday, satiety)
{
    static version[24];
	GetPlayerVersion(playerid, version, sizeof(version));

    if(GetString(version, M_MOBILE_VERSION))
    {
        LoadServerConfig();
        
		UpdateBrowser(playerid, 8, 0);

		ExecuteEvent(playerid, svelte, "window.executeEvent('event.auth.updateVideoBackgroundVisible', '[false]');");
		ExecuteEventf(playerid, svelte, "window.executeEvent('event.hudViceCity.updateDonateMultiplier', '[%i]');", payday);

	    switch(hud)
		{
		    case 0:
			{
				CallRemoteFunction("UpdateMobileHud", "dd", playerid, 0);

				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[false]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[false]');");

			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.serverInfo', '')");
			    
			    ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.playerSatiety', '[%d]');", satiety);
			}
			case 1..2: CallRemoteFunction("UpdateMobileHud", "dd", playerid, hud), CallRemoteFunction("UpdateMobileHunger", "dd", playerid, satiety);
			case 4:
			{
			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[true]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[true]');");
				
				ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.playerSatiety', '[%d]');", satiety);
			}
			case 3,5:
			{
			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[true]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[false]');");

			    ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.serverInfo', \
					'[{\"id\":%i,\"title\":\"%s\",\"project\":\"%s\",\"type\":\"Role play\",\"onLine\":%d,\"flag\":%i,\"logo\":%i,\"multiplier\":%d}]');",\
					playerid, ServerCFG[server_logo], ServerCFG[server_name], MaxOnline, NumberServID, NumberServID+1, payday);
					
                ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.playerSatiety', '[%d]');", satiety);
			}
			case 6: CallRemoteFunction("UpdateMobileHud", "dd", playerid, 0), CallRemoteFunction("UpdateMobileHunger", "dd", playerid, satiety);
		}
	}
	else
	{
		LoadServerConfig();
 		
 		UpdateBrowser(playerid, 8, hud);

		ExecuteEvent(playerid, svelte, "window.executeEvent('event.auth.updateVideoBackgroundVisible', '[false]');");
		ExecuteEventf(playerid, svelte, "window.executeEvent('event.hudViceCity.updateDonateMultiplier', '[%i]');", payday);

		switch(hud)
		{
		    case 0: 
		    {
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[false]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[false]');");

			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.serverInfo', '')");
		    }
			case 4: 
			{
			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[true]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[true]');");
			}
			case 3,5: 
			{
			    ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudSA.updateSanAndreasHudVisible', '[true]');");
				ExecuteEvent(playerid, svelte, "window.executeEvent('event.hudViceCity.updateViceCityHudVisible', '[false]');");

			    ExecuteEventf(playerid, svelte, "window.executeEvent('event.saghud.serverInfo', \
					'[{\"id\":%i,\"title\":\"%s\",\"project\":\"%s\",\"type\":\"Role play\",\"onLine\":%d,\"flag\":%i,\"logo\":%i,\"multiplier\":%d}]');",\
					playerid, ServerCFG[server_logo], ServerCFG[server_name], MaxOnline, NumberServID, NumberServID+1, payday);
			}
		}
		UpdateBrowser(playerid, 8, 2);
	}
	return 1;
}

