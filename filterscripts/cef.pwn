	UpdateBrowser(playerid, 73, 128);

	ExecuteEvent(playerid, svelte, "window.executeEvent('event.donationshop.updateDonateJsonUrl', \
		'[\"https://"INTERFACE"/Projects/sag/Servers/SAGyvenimas/frontend/donate/products.json\"]');");

	ExecuteEvent(playerid, svelte, "window.executeEvent('event.setActiveView', '[\"DonationShop\"]');");
	ExecuteEventf(playerid, svelte, "window.executeEvent('event.donationshop.ShopCountDonate', '[[ %i ]]');", donatemoney);

	SetFocusBrowser(playerid, svelte, true);
    return 1;
}

