public: LoadNumber(playerid, cost_sha, cost_sng, mobile)
{
	if(ArizonaGamesStatus(playerid))
	{
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.setActiveView', '[\"CarNumbers\"]');");
		ExecuteEventf(playerid, svelte, "window.executeEvent('event.carNumbers.initializeUSAPrice', '[{\"type\":\"regular\",\"value\":%i}]');", cost_sha);
		ExecuteEventf(playerid, svelte, "window.executeEvent('event.carNumbers.initializeCISPrice', '[{\"type\":\"regular\",\"value\":%i}]');", cost_sng);
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.carNumbers.setErrorMessage', '[\"\"]');");
  		SetFocusBrowser(playerid, svelte, true);
	}
	else if(mobile) SetFocusBrowser(playerid, 51, true);
	return 1;
}

public: ChangeSpeedometr(playerid, hud)
{
    static version[24];
	GetPlayerVersion(playerid, version, sizeof(version));

    if(GetString(version, M_MOBILE_VERSION))
    {
        switch(hud)
		{
		    case 0: CallRemoteFunction("UpdateMobileSpeed", "dd", playerid, 0);
			default: CallRemoteFunction("UpdateMobileSpeed", "dd", playerid, hud-2);
		}
    }
    else
    {
		switch(hud)
		{
		    case 0: ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.speedometerType', '[\"null\"]');");
			case 1..2: ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.speedometerType', '[\"advanced\"]');");
			default: ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.speedometerType', '[\"simplified\"]');");
		}
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.vehicleMileage', '[0]');");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.vehicleLiters', '[100]');");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.vehicleFuelType', '[\"petrol\"]');");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.vehiclePower', '[null]');");
		ExecuteEvent(playerid, svelte, "window.executeEvent('event.saghud.vehiclePowerIsActive', '[false]');");
	}
}

