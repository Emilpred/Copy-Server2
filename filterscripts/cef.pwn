public: LoadCefPhone(playerid, phone_id, phone_color, phone_background)
{
	LoadServerConfig();

	static const uid[] = {1,45,34,12,23};
	/*1 xiaomi 1
	12 Huawei P20 PRO 4
	23 pixel 5
	34 samsung 3
	45 iphone x 2*/
	ExecuteEvent(playerid, svelte, "window.executeEvent('event.setActiveView', '[\"Phone\"]');");

	ExecuteEventf(playerid, svelte, "window.executeEvent('event.phone.changePhoneBorder', '[%i]');", uid[phone_id-1]+phone_color);
	ExecuteEventf(playerid, svelte, "window.executeEvent('event.phone.changePhoneBg', '[%i]');", phone_background);
	ExecuteEventf(playerid, svelte, "window.executeEvent('event.phone.initializeServer', '[\"%s\"]');", ServerCFG[server_logo]);

 	SetFocusBrowser(playerid, svelte, true);
	return 1;
}

public: DonateItemID0(playerid, request[])
{
	new sscanfcef_id_0;
    strdel(request,0,22);
    strdel(request,strlen(request)-2,strlen(request));

    sscanf(request, "P<|>d", sscanfcef_id_0);
	return sscanfcef_id_0;
}

public: DonateItemID1(playerid, request[])
{
	new sscanfcef_id_1;
	strdel(request,0,22);
	
    strdel(request,0,strlen(request)-1);
    
    sscanf(request, "P<|>d", sscanfcef_id_1);
	return sscanfcef_id_1;
}

public: LoadDonate(playerid, donatemoney)
{
    UpdateBrowser(playerid, 25, 1, 0, 0, 0, 128);
	UpdateBrowser(playerid, 52, 0);
