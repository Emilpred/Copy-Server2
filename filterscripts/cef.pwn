			'[\"businessInfo\",{\"businessInfo\":{\"title\": \"%s\",\"description\":\"Baras - tai istaiga, kurioje parduodami alkoholiniai ir nealkoholiniai gerimai, taip pat uzkandziai. \
			Barai paprastai turi jaukia atmosfera, gyva muzika ir pramogines programas.\",\
			\"img\":\"82\",\"buttons\":[{\"title\": \"Ieiti\",\"keyTitle\": \"%s\",\"keyCode\": %d}],\
			\"info\":[\
			{\"title\": \"Verslo numeris\",\"value\": %d},\
			{\"title\": \"Savininkas\",\"value\": \"%s\"},\
			{\"title\": \"Kaina\",\"value\": \"$%d\"},\
			{\"title\": \"Duru statusas\",\"value\": \"%s\"}]}}]');", nottitle, notkey, nottimer, bizid, owner, coststate, (bizlock == 0) ? "Atrakinta":"Uzrakinta");
		}
	    case 14:
	    {
			ExecuteEventf(playerid, svelte, "window.executeEvent('cef.modals.showModal', \
			'[\"businessInfo\",{\"businessInfo\":{\"title\": \"%s\",\"description\":\"Prekybos kioskai su gatves maistu siulo platu greitojo maisto pasirinkima. \
			Mes naudojame tik sviezius ingredientus ir gaminame patiekalus ant atviros ugnies.\",\
