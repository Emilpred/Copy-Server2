    ExecuteEvent(playerid, svelte, "window.executeEvent('event.horizontalPhone.updateHorizontalPhoneVisible', '[false]');");

	//HideYouTubeVideoPhone(playerid);
	
	SetFocusBrowser(playerid, svelte, false);
	return 1;
}

