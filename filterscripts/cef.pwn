}

public: initializeDailyQuest(playerid, unixtime)
{
    for(new i; i < MAX_BATTLE_QUESTS; i++)
	{
		if(i == 0)
		{
			ExecuteEventf(playerid, svelte, "window.executeEvent('event.sagpass.initializeDailyQuest', \
				`\
					[\
						{ \
							\"until\":%d,\"title\":\"%s\",\"image\":8,\
							\"description\":\"Kazkada vienas keistuolis pareiske, kad isgelbejo skestancia zuvi, po to jis gavo dvejeta is biologijos.\",\
							\"target\":\"Pagaukite 50 bet kokiu zuvu\",\"currentExp\":%d,\"totalExp\":%d,\"active\":%d,\"take_rewards\": %d,\
							\"rewards\":\
							[\
								{ \"name\":\"\",\"image\":%d},\
								{ \"name\":\"\",\"image\":%d},\
								{ \"name\":\"\",\"image\":%d}\
							]\
						}\
					]\
				`);",\
				UNIX_TO_TIME(unixtime, 0, 0), BattleQuest[i][qOpis], CallRemoteFunction("CheckBattleQuestProgress", "dd", playerid, i), BattleQuest[i][qCount],\
				CallRemoteFunction("CheckBattleQuestDone", "dd", playerid, i), CallRemoteFunction("CheckBattleQuestTakeRewards", "dd", playerid, i),\
				CheckBattleQuestPrizeImage(i, 0), CheckBattleQuestPrizeImage(i, 1), CheckBattleQuestPrizeImage(i, 2));
		}
	}
    return 1;
}

